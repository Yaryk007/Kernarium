+
+/*
+ * Remove the input device, which releases its keys in the input core. Its
+ * configuration goes with it. The events that arrive after this are dropped.
+ */
+static void virtinput_unregister(struct virtio_input *vi)
+{
+	struct input_dev *idev = rcu_dereference_protected(vi->idev, true);
+
+	if (!idev)
+		return;
+	rcu_assign_pointer(vi->idev, NULL);
+	/* Wait out the event delivery that may still be using it. */
+	synchronize_rcu();
+	input_unregister_device(idev);
+	kfree(vi->config);
+	vi->config = NULL;
+}
+
+/*
+ * The host plugs and unplugs the device while the guest runs and raises a
+ * configuration change for each. The device answers what it can do when it is
+ * read and nothing ties the reads of one change together, so read it all
+ * again, and register the input device afresh when anything differs from what
+ * it was registered with. Answer every change that leaves a registered input
+ * device, also one that finds it registered already (virtio_input_uml.h).
+ */
+static void virtinput_config_work(struct work_struct *work)
+{
+	struct virtio_input *vi =
+		container_of(work, struct virtio_input, config_work);
+	struct virtinput_config *cfg;
+	unsigned long flags;
+	bool ready;
+	int err;
+
+	spin_lock_irqsave(&vi->lock, flags);
+	ready = vi->ready;
+	spin_unlock_irqrestore(&vi->lock, flags);
+	if (!ready)
+		return;
+
+	cfg = kzalloc(sizeof(*cfg), GFP_KERNEL);
+	if (!cfg) {
+		/* The change must not go unanswered; try again shortly. */
+		msleep(10);
+		virtinput_queue_config(vi);
+		return;
+	}
+	virtinput_read_config(vi, cfg);
+
+	/*
+	 * A change that came in while the device was read may have split the
+	 * reads between two states of it, and the work queued for that change
+	 * reads and answers it all again, so drop this one.
+	 */
+	if (work_pending(work)) {
+		kfree(cfg);
+		return;
+	}
+
+	if (rcu_access_pointer(vi->idev)) {
+		if (!memcmp(cfg, vi->config, sizeof(*cfg))) {
+			kfree(cfg);
+			virtinput_notify_registration(vi, true);
+			return;
+		}
+		virtinput_unregister(vi);
+		virtinput_notify_registration(vi, false);
+	}
+
+	if (virtinput_config_empty(cfg)) {
+		kfree(cfg);
+		return;
+	}
+	err = virtinput_register(vi, cfg);
+	if (err) {
+		dev_err(&vi->vdev->dev,
+			"cannot register the input device: %d\n", err);
+		kfree(cfg);
+		return;
+	}
+	virtinput_notify_registration(vi, true);
+}
+
+static void virtinput_config_changed(struct virtio_device *vdev)
+{
+	struct virtio_input *vi = vdev->priv;
+
+	/* Called with the configuration lock held, and reading is a request. */
+	virtinput_queue_config(vi);
+}
+
