+
+	err = virtinput_init_vqs(vi);
+	if (err)
+		goto err_init_vq;
+
+	cfg = kzalloc(sizeof(*cfg), GFP_KERNEL);
+	if (!cfg) {
+		err = -ENOMEM;
+		goto err_config_alloc;
+	}
+	virtinput_read_config(vi, cfg);
+
 	virtio_device_ready(vdev);
 	vi->ready = true;
-	err = input_register_device(vi->idev);
-	if (err)
-		goto err_input_register;
+	if (virtinput_config_empty(cfg)) {
+		kfree(cfg);
+	} else {
+		err = virtinput_register(vi, cfg);
+		if (err) {
+			kfree(cfg);
+			goto err_register;
