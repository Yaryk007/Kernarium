+
+/*
+ * Read the configuration again. The queue is freezable, so that an input
+ * device is never registered or unregistered while the system suspends.
+ */
+static void virtinput_queue_config(struct virtio_input *vi)
+{
+	queue_work(system_freezable_wq, &vi->config_work);
+}
+
+/*
+ * Tell the device whether the input device exists, so that it holds the
+ * events it has for it until it does (virtio_input_uml.h). The status queue
+ * can be full for a moment, and a notice that is lost leaves the device
+ * holding its events, so wait a little for room. When there is still none,
+ * the configuration work runs again, which answers the change once more
+ * rather than leave it unanswered. Returns the result of the last try.
+ */
+static int virtinput_notify_registration(struct virtio_input *vi,
+					 bool registered)
+{
+	int rc = 0, tries;
+
+	for (tries = 0; tries < 20; tries++) {
+		rc = virtinput_send_status(vi, NULL, VIRTIO_INPUT_UML_EV_NOTICE,
+					   VIRTIO_INPUT_UML_NOTICE_REGISTRATION,
+					   registered);
+		if (rc != -ENOSPC && rc != -ENOMEM)
+			break;
+		msleep(5);
+	}
+	if (rc == -ENOSPC || rc == -ENOMEM) {
+		virtinput_queue_config(vi);
+	} else if (rc && rc != -ENODEV) {
+		/* -ENODEV is the device going away, at removal or freeze. */
+		dev_warn(&vi->vdev->dev,
+			 "cannot tell the device about its input device: %d\n",
+			 rc);
+	}
+	return rc;
 }
 
