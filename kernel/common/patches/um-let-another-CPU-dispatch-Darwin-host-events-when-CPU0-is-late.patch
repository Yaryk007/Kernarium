index a2e13ae4e165e9f939f0feaed65d35d6bf7a0f1c..59be405bd11441ef261e43c60ce2763e6a62bd3d 100644
--- a/arch/um/os-Darwin/irq.c
+++ b/arch/um/os-Darwin/irq.c
@@ -9,11 +9,13 @@
 #include <unistd.h>
 #include <irq_user.h>
 #include <os.h>
+#include "internal.h"
 #include "irq.h"
 
 #define DARWIN_MAX_EVENTS 64
 #define DARWIN_NOTIFICATION_BATCH 16
 #define DARWIN_NOTIFICATION_STOP_IDENT 1
+#define DARWIN_NOTIFICATION_PARK_IDENT 2
 #define DARWIN_EVENT_READ 1
 #define DARWIN_EVENT_WRITE 2
 
@@ -31,24 +33,180 @@ static int watched_count;
 /* Orders the registry against callers that hold no kernel IRQ lock. */
 static pthread_mutex_t watched_lock = PTHREAD_MUTEX_INITIALIZER;
 static int notification_kqueue = -1;
+/* Holds the stop event and the one that CPU0's idle entry triggers; see
+ * darwin_irq_idle_begin().
+ */
+static int park_kqueue = -1;
 static int dispatch_kqueue = -1;
-static pthread_mutex_t idle_waiter_lock = PTHREAD_MUTEX_INITIALIZER;
-static pthread_cond_t idle_waiter_ready = PTHREAD_COND_INITIALIZER;
 static pthread_t idle_waiter;
 static pthread_t notification_worker;
-static int idle_waiter_valid;
 static int notification_worker_joinable;
-static int notification_stopping;
+/* CPU0's carrier is stored in idle_waiter at its first idle entry, once. */
+static int idle_waiter_set;
+/*
+ * The wake of CPU0's idle wait, shared between the notification thread and
+ * CPU0's carrier without a lock; see darwin_irq_idle_begin().  Both are
+ * accessed in sequentially consistent order only.
+ */
+static int idle_waiter_valid;
+static int idle_wake_pending;
+/* The notification thread waits on park_kqueue for CPU0's next idle entry. */
+static int notification_parked;
+
+/*
+ * The dispatch token.  triggered[] and the IRQ core's per-IRQ active and
+ * pending flags belong to whoever dispatches host events, so only one CPU
+ * dispatches at a time.  CPU0 tries at every tick and idle exit.  Another
+ * CPU tries only when no CPU has begun a dispatch for
+ * DARWIN_IRQ_TAKEOVER_NS, which bounds how long an event waits when the host
+ * keeps CPU0 from running.  Nothing waits for the token: a CPU that finds it
+ * taken skips its dispatch, and the edge stays in the dispatch queue for the
+ * holder to collect.
+ *
+ * The holder collects with a loop that ends at a kevent() that returns
+ * nothing, and releases the token a little later.  An edge that arrives in
+ * between, and a CPU0 that tried and found the token taken, would both be
+ * missed, so CPU0 leaves a note.  `dispatch_missed' and `dispatch_owner' are
+ * accessed in sequentially consistent order, and each side stores one and
+ * then loads the other:
+ *
+ *	CPU0: (1) the compare-and-swap fails, with the owner still set
+ *	      (2) store dispatch_missed = 1
+ *	      (3) load dispatch_owner
+ *	holder: (a) store dispatch_owner = -1
+ *	        (b) load dispatch_missed
+ *
+ * In the one total order either (2) precedes (b), so the holder sees the note,
+ * clears it and dispatches again, and that kevent() follows (1) and so every
+ * edge CPU0 meant to collect; or (b) precedes (2), so (a) precedes (3), and
+ * CPU0 sees the token free or taken again.  Free, it takes the token and
+ * collects.  Taken again, by a CPU whose compare-and-swap follows (a) and so
+ * (1), that CPU's collection covers the edge.  Either way a kevent() follows
+ * every failed attempt of CPU0, and no timed poll is needed.  Another CPU
+ * leaves no note: its attempt is the takeover of a late CPU0, and the next
+ * follows within DARWIN_IRQ_TAKEOVER_NS.  The compare-and-swap is sequentially
+ * consistent, so that (1) is in the total order as well.
+ */
+static int dispatch_owner = -1;
+static int dispatch_missed;
+static unsigned long long last_dispatch_ns;
 
 static void wake_signal_handler(int signal)
 {
 	(void)signal;
 }
 
+/* True once a dispatch has begun at or after `edge'. */
+static int dispatched_since(unsigned long long edge)
+{
+	return (long long)(__atomic_load_n(&last_dispatch_ns,
+					   __ATOMIC_RELAXED) - edge) >= 0;
+}
+
+static int take_token(int cpu, int *owner)
+{
+	*owner = -1;
+	return __atomic_compare_exchange_n(&dispatch_owner, owner, cpu, 0,
+					   __ATOMIC_SEQ_CST, __ATOMIC_SEQ_CST);
+}
+
+/*
+ * Dispatch the host's descriptor events if this CPU may: CPU0 always, any other
+ * CPU only when no dispatch has begun for DARWIN_IRQ_TAKEOVER_NS, and only
+ * while no other CPU holds the token.  Returns whether it dispatched.  It is
+ * called where an interrupt could arrive on this CPU, with the logical IRQs
+ * as the caller's tick has them, and may run any handler and softirq.
+ */
+int darwin_irq_dispatch(int cpu, unsigned long long now,
+			struct uml_pt_regs *registers)
+{
+	int owner;
+
+	if (cpu != 0 &&
+	    (long long)(now - __atomic_load_n(&last_dispatch_ns,
+					      __ATOMIC_RELAXED)) <
+		    (long long)DARWIN_IRQ_TAKEOVER_NS)
+		return 0;
+	if (!take_token(cpu, &owner)) {
+		/* This CPU's own dispatch is under way: its loop collects. */
+		if (cpu != 0 || owner == cpu)
+			return 0;
+		__atomic_store_n(&dispatch_missed, 1, __ATOMIC_SEQ_CST);
+		if (__atomic_load_n(&dispatch_owner, __ATOMIC_SEQ_CST) != -1 ||
+		    !take_token(cpu, &owner))
+			return 0;
+		/* What the note was left for is collected below. */
+		__atomic_store_n(&dispatch_missed, 0, __ATOMIC_SEQ_CST);
+	}
+	/* Only the holder writes the stamp, and it never goes back. */
+	if ((long long)(now - last_dispatch_ns) > 0)
+		__atomic_store_n(&last_dispatch_ns, now, __ATOMIC_RELAXED);
+	do {
+		sigio_handler(SIGIO, NULL, registers, NULL);
+		__atomic_store_n(&dispatch_owner, -1, __ATOMIC_SEQ_CST);
+	} while (__atomic_load_n(&dispatch_missed, __ATOMIC_SEQ_CST) &&
+		 __atomic_exchange_n(&dispatch_missed, 0, __ATOMIC_SEQ_CST) &&
+		 take_token(cpu, &owner));
+	return 1;
+}
+
+static struct timespec relative_time(unsigned long long target,
+				     unsigned long long now)
+{
+	unsigned long long left = target > now ? target - now : 0;
+	struct timespec time = {
+		.tv_sec = (time_t)(left / UM_NSEC_PER_SEC),
+		.tv_nsec = (long)(left % UM_NSEC_PER_SEC),
+	};
+
+	return time;
+}
+
+/*
+ * The thread that turns a descriptor's edge into a wake.  It never consumes
+ * the edge, which stays in the dispatch queue; it makes sure a CPU comes to
+ * collect it:
+ *
+ * - a CPU0 in its idle wait is signalled, which ends the wait, and one that
+ *   is not idle is signalled at its next idle entry (idle_wake_pending; a
+ *   system suspend drains nothing before it sleeps, so it relies on this); and
+ * - an edge that no dispatch has begun after for DARWIN_IRQ_TAKEOVER_NS means
+ *   CPU0 is late, busy or idle, so an idle secondary is woken to dispatch it,
+ *   and again after each interval until a dispatch begins.  A secondary that
+ *   is busy needs no wake: its own tick takes over.
+ *
+ * The thread never waits for CPU0, so it reads the next edge while CPU0 is
+ * held.  While CPU0 is not idle it stops reading edges, though, because a
+ * busy CPU0 collects them at its tick and each further edge would only wake
+ * the thread to do nothing.  It leaves idle_wake_pending set and waits on
+ * park_kqueue, which holds the stop event and the event that CPU0's next idle
+ * entry triggers, for as long as the takeover deadline allows.  The edges
+ * that arrive meanwhile coalesce in notification_kqueue; see
+ * darwin_irq_idle_begin() for why none of them waits for the deadline when
+ * CPU0 is idle.
+ *
+ * On leaving such a wait the thread polls once.  An edge that poll returns
+ * has been in the queue since some time after the previous read.  One that
+ * arrived before the last dispatch began was collected by it, so the earliest
+ * the edge can have gone unserved is the later of the previous read and that
+ * dispatch, and its deadline is counted from there, not from this read, which
+ * could keep an edge of a late CPU0 waiting for a second period.  Only a
+ * dispatch that begins after the read counts as serving it, and a dispatch
+ * that began after the oldest unserved edge was read is cleared before a
+ * later edge is counted, because it may have preceded that edge.
+ */
 static void *notification_thread(void *unused)
 {
 	struct kevent events[DARWIN_NOTIFICATION_BATCH];
 	sigset_t blocked;
+	unsigned long long seen = 0;
+	unsigned long long late_at = 0;
+	unsigned long long read_at = 0;
+	unsigned long long retry = DARWIN_IRQ_TAKEOVER_CHECK_NS;
+	int unserved = 0;
+	int parked = 0;
+	int waited;
+	int delayed = 0;
 
 	(void)unused;
 	os_set_thread_name("uml-irq-notify");
@@ -60,13 +218,25 @@ static void *notification_thread(void *unused)
 	sigaddset(&blocked, SIGALRM);
 	(void)pthread_sigmask(SIG_BLOCK, &blocked, NULL);
 	for (;;) {
-		pthread_t target;
-		int have_target;
+		struct timespec wait;
+		const struct timespec *timeout = NULL;
+		unsigned long long now;
 		int count;
 		int index;
 
-		count = kevent(notification_kqueue, NULL, 0, events,
-			       DARWIN_NOTIFICATION_BATCH, NULL);
+		if (delayed) {
+			/* Just unparked: collect what arrived meanwhile. */
+			wait.tv_sec = 0;
+			wait.tv_nsec = 0;
+			timeout = &wait;
+		} else if (unserved) {
+			wait = relative_time(late_at,
+					     (unsigned long long)os_nsecs());
+			timeout = &wait;
+		}
+		count = kevent(parked ? park_kqueue : notification_kqueue,
+			       NULL, 0, events, DARWIN_NOTIFICATION_BATCH,
+			       timeout);
 		if (count < 0) {
 			if (errno == EINTR)
 				continue;
@@ -76,21 +246,105 @@ static void *notification_thread(void *unused)
 			if (events[index].filter == EVFILT_USER &&
 			    events[index].ident == DARWIN_NOTIFICATION_STOP_IDENT)
 				return NULL;
-		pthread_mutex_lock(&idle_waiter_lock);
-		/* Keep the wake until an idle carrier can dispatch it.  Dispatch has
-		 * its own kqueue, so this helper never consumes the guest IRQ edge.
+		now = (unsigned long long)os_nsecs();
+		waited = parked;
+		if (parked) {
+			/* An event is CPU0's idle entry, which has cleared
+			 * notification_parked; none is the deadline.
+			 */
+			if (count > 0) {
+				parked = 0;
+				delayed = 1;
+			}
+			count = 0;
+		}
+		/* A dispatch that began after the oldest edge was read may
+		 * have preceded an edge read now, so this one is counted from
+		 * here: the dispatch is cleared first.
 		 */
-		while (!idle_waiter_valid && !notification_stopping)
-			pthread_cond_wait(&idle_waiter_ready, &idle_waiter_lock);
-		if (notification_stopping) {
-			pthread_mutex_unlock(&idle_waiter_lock);
-			return NULL;
+		if (unserved && dispatched_since(seen))
+			unserved = 0;
+		/* The oldest edge no dispatch has begun after sets the
+		 * deadline; later ones share its dispatch.
+		 */
+		if (count > 0 && !unserved) {
+			unsigned long long since = now;
+
+			if (delayed) {
+				since = read_at;
+				if ((long long)(__atomic_load_n(
+					&last_dispatch_ns,
+					__ATOMIC_RELAXED) - since) > 0)
+					since = __atomic_load_n(
+						&last_dispatch_ns,
+						__ATOMIC_RELAXED);
+			}
+			unserved = 1;
+			seen = now;
+			late_at = since + DARWIN_IRQ_TAKEOVER_NS;
+			retry = DARWIN_IRQ_TAKEOVER_CHECK_NS;
+			/* One that has begun since is after the read. */
+			if (dispatched_since(seen))
+				unserved = 0;
+		}
+		if (!waited) {
+			delayed = 0;
+			read_at = now;
+		}
+		if (unserved && now >= late_at) {
+			int woke = darwin_wake_idle_secondary();
+
+			if (woke < 0) {
+				/* A single CPU has nobody to take over. */
+				unserved = 0;
+			} else if (woke) {
+				late_at = now + DARWIN_IRQ_TAKEOVER_NS;
+			} else {
+				/* None is idle.  A busy one takes over at its
+				 * own tick, an idle one may be about to wait:
+				 * look again soon, then less often.
+				 */
+				late_at = now + retry;
+				retry = retry * 2 < DARWIN_IRQ_TAKEOVER_NS ?
+					retry * 2 : DARWIN_IRQ_TAKEOVER_NS;
+			}
+		}
+		if (parked) {
+			if (unserved)
+				continue;
+			/* Everything read so far has been served: read edges
+			 * again.  If CPU0 has cleared the flag meanwhile its
+			 * event is on the way, and ends the next park at once,
+			 * which costs one wake.
+			 */
+			parked = 0;
+			delayed = 1;
+			(void)__atomic_exchange_n(&notification_parked, 0,
+						  __ATOMIC_SEQ_CST);
+			continue;
+		}
+		if (count == 0)
+			continue;
+		/* Dispatch has its own kqueue, so this helper never consumes the
+		 * guest IRQ edge.  Make an idle CPU0 come and collect it; see
+		 * darwin_irq_idle_begin() for why this loses no wake.
+		 */
+		__atomic_store_n(&idle_wake_pending, 1, __ATOMIC_SEQ_CST);
+		if (__atomic_load_n(&idle_waiter_valid, __ATOMIC_SEQ_CST)) {
+			if (__atomic_exchange_n(&idle_wake_pending, 0,
+						__ATOMIC_SEQ_CST))
+				(void)pthread_kill(idle_waiter, SIGUSR2);
+		} else if (unserved) {
+			/* CPU0 is not idle: park until it is. */
+			__atomic_store_n(&notification_parked, 1,
+					 __ATOMIC_SEQ_CST);
+			if (__atomic_load_n(&idle_waiter_valid,
+					    __ATOMIC_SEQ_CST))
+				(void)__atomic_exchange_n(&notification_parked,
+							  0, __ATOMIC_SEQ_CST);
+			else
+				parked = 1;
 		}
-		have_target = idle_waiter_valid;
-		target = idle_waiter;
-		if (have_target)
-			(void)pthread_kill(target, SIGUSR2);
-		pthread_mutex_unlock(&idle_waiter_lock);
 	}
 }
 
@@ -117,8 +371,8 @@ static int update_filter(int queue, int fd, short filter, int add, void *data)
 }
 
 /* The dispatch queue keeps every registered edge, so nothing that arrives
- * while a descriptor's notification is off is lost: CPU0 dispatches it at
- * its next poll.  Only the notification queue follows `notify'.
+ * while a descriptor's notification is off is lost: a dispatch collects it at
+ * the next poll.  Only the notification queue follows `notify'.
  */
 static int update_registration(int fd, int events, void *data, int notify)
 {
@@ -212,28 +466,100 @@ int os_irq_wake_pending(void)
 	return pending;
 }
 
-void darwin_irq_idle_begin(sigset_t *previous_mask)
+/*
+ * CPU0's carrier enters an idle wait.  Returns whether an edge was left for
+ * it, in which case the wait must not sleep.
+ *
+ * The notification thread wakes CPU0 without taking anything CPU0 holds, so
+ * a carrier the host has stopped cannot hold the thread up with it.  They share
+ * `idle_waiter_valid' (CPU0 is in, or about to enter, the wait that SIGUSR2
+ * ends) and `idle_wake_pending' (an edge is waiting for CPU0), in sequentially
+ * consistent order, and each side stores one and then loads the other:
+ *
+ *	thread: (1) store idle_wake_pending = 1
+ *	        (2) load idle_waiter_valid; if set, (3) exchange idle_wake_pending
+ *	            for 0, and if that was 1, signal CPU0
+ *	CPU0:   (a) store idle_waiter_valid = 1
+ *	        (b) exchange idle_wake_pending for 0, and if that was 1, do not
+ *	            sleep
+ *
+ * In the one total order either (1) precedes (b), so CPU0 takes the edge and
+ * does not sleep; or (b) precedes (1), so (a) precedes (2), the thread sees
+ * the wait and, unless CPU0 has left it, takes the edge and signals.  If CPU0
+ * has left it, valid is clear and the edge stays pending for the next entry.
+ * The exchange gives the edge to one side only, so a signal is not repeated.
+ * A signal sent after CPU0 left the wait stays pending: SIGUSR2 is blocked on
+ * this carrier from its first idle entry on, except inside the idle
+ * pselect()'s mask, so it can never interrupt guest code (nor a carrier that
+ * is not allowed asynchronous signals, see carriers_block_async_signals()),
+ * and ends the next idle wait early at the worst.  The thread signals only
+ * after it saw `idle_waiter_valid' set, which is after the first entry, so
+ * the signal is blocked by then.  The mask changes with pthread_sigmask(), as
+ * sigprocmask() rewrites every thread's mask on Darwin.  `idle_waiter' is
+ * stored before the first (a), so a thread that saw valid set sees it.
