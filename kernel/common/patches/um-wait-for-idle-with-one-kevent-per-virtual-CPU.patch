+	EV_SET(&trigger, DARWIN_IRQ_IDLE_WAKE_IDENT, EVFILT_USER, 0,
+	       NOTE_TRIGGER, 0, NULL);
+	while (kevent(queue, &trigger, 1, NULL, 0, NULL) < 0 && errno == EINTR)
+		;
