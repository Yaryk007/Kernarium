+/*
+ * Take the bytes an idle wait reported in the wake pipe.  This CPU is the
+ * pipe's only reader and the wait saw `bytes' of them, so a read returns at
+ * once whatever the descriptor's status flags are.  The first read asks for
+ * more than was counted, which takes a byte that landed since the wait looked
+ * as well and so leaves none behind to end the next wait; the reads that may
+ * follow take no more than what is still known to be there.  Unlike
+ * darwin_ipi_idle_drain(), which does not know whether anything is there, it
+ * needs no poll() before each read.
+ */
+void darwin_ipi_idle_consume(long bytes)
+{
+	char buffer[64];
+	size_t size = sizeof(buffer);
+	int fd = darwin_ipi_idle_fd();
+	int saved_errno = errno;
+
+	if (fd < 0)
+		return;
+	while (bytes > 0) {
+		ssize_t count = read(fd, buffer, size);
+
+		if (count <= 0)
+			break;
+		bytes -= count;
+		if (bytes > 0 && bytes < (long)sizeof(buffer))
+			size = (size_t)bytes;
+	}
+	errno = saved_errno;
+}
