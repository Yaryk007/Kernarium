+/*
+ * End CPU0's idle wait.  The trigger waits in the wait's own kqueue until a
+ * kevent() collects it, so it needs no atomic signal mask, and it is posted
+ * without taking anything CPU0 holds: the host can stop CPU0's carrier,
+ * inside its wait or out of it, and the trigger returns all the same.
+ */
+static void wake_idle_waiter(void)
+{
+	struct kevent trigger;
+	int queue = __atomic_load_n(&idle_waiter_queue, __ATOMIC_RELAXED);
