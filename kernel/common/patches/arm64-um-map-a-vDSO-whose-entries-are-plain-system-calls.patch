+	ret = PTR_ERR_OR_ZERO(vma);
+#ifdef CONFIG_UML_ARM64_VDSO
+	if (!ret)
+		ret = uml_arm64_vdso_map(mm);
+#endif
 	mmap_write_unlock(mm);
-	return PTR_ERR_OR_ZERO(vma);
+	return ret;
 }
 #endif
 
diff --git a/arch/arm64/um/vdso/Makefile b/arch/arm64/um/vdso/Makefile
new file mode 100644
index 0000000000000000000000000000000000000000..9e5ee72bb482029bfe563577d91e4040421cdb40
--- /dev/null
+++ b/arch/arm64/um/vdso/Makefile
@@ -0,0 +1,44 @@
+# SPDX-License-Identifier: GPL-2.0
+#
+# The vDSO of an arm64 UML guest: an ELF shared object whose entries are plain
+# system calls, built here and embedded in the kernel image.
+#
+
+# Include the generic Makefile to check the built vdso.
+include $(srctree)/lib/vdso/Makefile.include
+
+# Files linked into the vDSO, and files linked into the kernel.
+vobjs-y := note.o syscalls.o
+obj-y += vdso.o vma.o
+
+vobjs := $(addprefix $(obj)/, $(vobjs-y))
+
+targets += $(vobjs-y) vdso.lds vdso.so vdso.so.dbg
+
+$(obj)/vdso.o: $(obj)/vdso.so
+
+# Both hash tables: glibc and bionic look a symbol up in the GNU one, and
+# musl's vDSO lookup reads the SysV one.  No relocation is needed, so the
+# image does not depend on where it is mapped.
+ldflags-y := -shared -soname=linux-vdso.so.1 --hash-style=both \
+	     -Bsymbolic --build-id=sha1 --eh-frame-hdr -z noexecstack -n
+
+ifdef CONFIG_LD_ORPHAN_WARN
+  ldflags-y += --orphan-handling=$(CONFIG_LD_ORPHAN_WARN_LEVEL)
+endif
+
+ldflags-y += -T
+
+CPPFLAGS_vdso.lds += -P -C -U$(ARCH)
+
+# The .lds file has to come first on the link line.
+$(obj)/vdso.so.dbg: $(obj)/vdso.lds $(vobjs) FORCE
+	$(call if_changed,vdsold_and_vdso_check)
+
+# Strip the image that the kernel embeds.
+$(obj)/%.so: OBJCOPYFLAGS := -S
+$(obj)/%.so: $(obj)/%.so.dbg FORCE
+	$(call if_changed,objcopy)
+
+quiet_cmd_vdsold_and_vdso_check = LD      $@
+      cmd_vdsold_and_vdso_check = $(cmd_ld); $(cmd_vdso_check)
diff --git a/arch/arm64/um/vdso/note.S b/arch/arm64/um/vdso/note.S
new file mode 100644
index 0000000000000000000000000000000000000000..6ce2101d916f32f4754c0038ce8cb7d73450f2d2
--- /dev/null
+++ b/arch/arm64/um/vdso/note.S
@@ -0,0 +1,16 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * The .note sections of the vDSO, in its PT_NOTE: the kernel version, as
+ * arm64 Linux's vDSO states it, which glibc reads as the kernel's ABI level.
+ */
+
+#include <linux/uts.h>
+#include <linux/version.h>
+#include <linux/elfnote.h>
+#include <linux/build-salt.h>
+
+ELFNOTE_START(Linux, 0, "a")
+	.long LINUX_VERSION_CODE
+ELFNOTE_END
+
+BUILD_SALT
diff --git a/arch/arm64/um/vdso/syscalls.S b/arch/arm64/um/vdso/syscalls.S
new file mode 100644
index 0000000000000000000000000000000000000000..e52dd2453e274e80af1ea2986c021d7b6e32f030
--- /dev/null
+++ b/arch/arm64/um/vdso/syscalls.S
@@ -0,0 +1,33 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * The entries of an arm64 UML guest's vDSO.  Each is the plain system call
+ * and returns its result as the call does, a negative errno included, which
+ * is how arm64 Linux's own vDSO returns the call's failure to glibc and
+ * bionic.  The guest has no counter a user program may read, so none reads
+ * the time itself.
+ *
+ * Each entry carries call frame information, so an unwinder that stops in it
+ * (a signal handler's backtrace, a profiler's sample, a debugger) finds the
+ * caller's frame through the link register.
+ */
+
+#include <asm/unistd.h>
+
+	.text
+
+	.macro	vdso_entry name, nr
+	.globl	\name
+	.type	\name, %function
+	.p2align 2
+\name:
+	.cfi_startproc
+	mov	x8, #\nr
+	svc	#0
+	ret
+	.cfi_endproc
+	.size	\name, . - \name
+	.endm
+
+	vdso_entry __kernel_clock_gettime, __NR_clock_gettime
+	vdso_entry __kernel_gettimeofday, __NR_gettimeofday
+	vdso_entry __kernel_clock_getres, __NR_clock_getres
diff --git a/arch/arm64/um/vdso/vdso.S b/arch/arm64/um/vdso/vdso.S
new file mode 100644
index 0000000000000000000000000000000000000000..a6a04b33351070d4bf37dc319da1e4678dca5a1d
--- /dev/null
+++ b/arch/arm64/um/vdso/vdso.S
@@ -0,0 +1,13 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#include <linux/init.h>
+
+	__INITDATA
+
+	.globl	uml_arm64_vdso_start
+	.globl	uml_arm64_vdso_end
+	.balign	8
+uml_arm64_vdso_start:
+	.incbin "arch/arm64/um/vdso/vdso.so"
+uml_arm64_vdso_end:
+
+	__FINIT
diff --git a/arch/arm64/um/vdso/vdso.lds.S b/arch/arm64/um/vdso/vdso.lds.S
new file mode 100644
index 0000000000000000000000000000000000000000..5400d694337a4a06a1d20f9d046d46fd9ba4d975
--- /dev/null
+++ b/arch/arm64/um/vdso/vdso.lds.S
@@ -0,0 +1,84 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * GNU linker script for the vDSO of an arm64 UML guest: one read-only,
+ * executable segment at address 0, as arm64 Linux's vDSO has, with the
+ * unwind tables of its entries.
+ */
+
+#include <linux/const.h>
+
+OUTPUT_FORMAT("elf64-littleaarch64", "elf64-bigaarch64", "elf64-littleaarch64")
+OUTPUT_ARCH(aarch64)
+
+SECTIONS
+{
+	. = SIZEOF_HEADERS;
+
+	.hash		: { *(.hash) }			:text
+	.gnu.hash	: { *(.gnu.hash) }
+	.dynsym		: { *(.dynsym) }
+	.dynstr		: { *(.dynstr) }
+	.gnu.version	: { *(.gnu.version) }
+	.gnu.version_d	: { *(.gnu.version_d) }
+	.gnu.version_r	: { *(.gnu.version_r) }
+
+	/*
+	 * Discard .note.gnu.property sections, which are unused and have a
+	 * different alignment requirement from the vDSO's note sections.
+	 */
+	/DISCARD/	: {
+		*(.note.GNU-stack .note.gnu.property)
+		*(.ARM.attributes)
+	}
+	.note		: { *(.note.*) }		:text	:note
+
+	.eh_frame_hdr	: { *(.eh_frame_hdr) }		:text	:eh_frame_hdr
+	.eh_frame	: { KEEP (*(.eh_frame)) }	:text
+
+	. = ALIGN(16);
+
+	.text		: { *(.text*) }			:text	=0xd503201f
+	PROVIDE (__etext = .);
+	PROVIDE (_etext = .);
+	PROVIDE (etext = .);
+
+	.dynamic	: { *(.dynamic) }		:text	:dynamic
+
+	.rodata		: { *(.rodata*) }		:text
+
+	_end = .;
+	PROVIDE(end = .);
+
+	/DISCARD/	: {
+		*(.data .data.* .gnu.linkonce.d.* .sdata*)
+		*(.bss .sbss .dynbss .dynsbss)
+	}
+}
+
+/*
+ * We must supply the ELF program headers explicitly to get just one
+ * PT_LOAD segment, and set the flags explicitly to make segments read-only.
+ */
+#define PT_GNU_EH_FRAME	0x6474e550
+
+PHDRS
+{
+	text		PT_LOAD		FLAGS(5) FILEHDR PHDRS; /* PF_R|PF_X */
+	dynamic		PT_DYNAMIC	FLAGS(4);		/* PF_R */
+	note		PT_NOTE		FLAGS(4);		/* PF_R */
+	eh_frame_hdr	PT_GNU_EH_FRAME;
+}
+
+/*
+ * This controls what symbols we export from the DSO.
+ */
+VERSION
+{
+	LINUX_2.6.39 {
+	global:
+		__kernel_gettimeofday;
+		__kernel_clock_gettime;
+		__kernel_clock_getres;
+	local: *;
+	};
+}
diff --git a/arch/arm64/um/vdso/vma.c b/arch/arm64/um/vdso/vma.c
new file mode 100644
index 0000000000000000000000000000000000000000..73748a9010eef978f9d6accddd748158015d2023
--- /dev/null
+++ b/arch/arm64/um/vdso/vma.c
@@ -0,0 +1,102 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Map the vDSO into an arm64 UML guest task.
+ *
+ * The image is the ELF object that this directory builds: the system calls
+ * that tell the time, each a plain system call.  Every task gets the same
+ * read-only pages, mapped where the task's address space has room, as native
+ * arm64 does, and finds them through AT_SYSINFO_EHDR.
+ */
+
+#include <linux/binfmts.h>
+#include <linux/elf.h>
+#include <linux/init.h>
+#include <linux/mm.h>
+#include <linux/printk.h>
+#include <linux/sched.h>
+#include <linux/slab.h>
+#include <linux/string.h>
+#include <asm/elf.h>
+
+extern char uml_arm64_vdso_start[], uml_arm64_vdso_end[];
+
+static unsigned long vdso_pages __ro_after_init;
+
+static int vdso_mremap(const struct vm_special_mapping *sm,
+		       struct vm_area_struct *new_vma)
+{
+	current->mm->context.vdso = new_vma->vm_start;
+	return 0;
+}
+
+static struct vm_special_mapping vdso_mapping __ro_after_init = {
+	.name	= "[vdso]",
+	.mremap	= vdso_mremap,
+};
+
+static int __init vdso_init(void)
+{
+	size_t size = uml_arm64_vdso_end - uml_arm64_vdso_start;
+	struct page **pagelist;
+	unsigned long i;
+
+	if (memcmp(uml_arm64_vdso_start, ELFMAG, SELFMAG)) {
+		pr_err("vDSO is not a valid ELF object\n");
+		return -EINVAL;
+	}
+
+	vdso_pages = DIV_ROUND_UP(size, PAGE_SIZE);
+	/* The special mapping's page list ends with a null entry. */
+	pagelist = kcalloc(vdso_pages + 1, sizeof(*pagelist), GFP_KERNEL);
+	if (!pagelist)
+		goto oom;
+
+	for (i = 0; i < vdso_pages; i++) {
+		size_t chunk = min_t(size_t, size - i * PAGE_SIZE, PAGE_SIZE);
+
+		pagelist[i] = alloc_page(GFP_KERNEL | __GFP_ZERO);
+		if (!pagelist[i])
+			goto oom_pages;
+		memcpy(page_address(pagelist[i]),
+		       uml_arm64_vdso_start + i * PAGE_SIZE, chunk);
+	}
+	vdso_mapping.pages = pagelist;
+	return 0;
+
+oom_pages:
+	while (i--)
+		__free_page(pagelist[i]);
+	kfree(pagelist);
+oom:
+	pr_err("cannot allocate the vDSO; tasks start without one\n");
+	return -ENOMEM;
+}
+subsys_initcall(vdso_init);
+
+int uml_arm64_vdso_map(struct mm_struct *mm)
+{
+	unsigned long len = vdso_pages << PAGE_SHIFT;
+	struct vm_area_struct *vma;
+	unsigned long base;
+
+	if (!vdso_mapping.pages)
+		return 0;
+
+	base = get_unmapped_area(NULL, 0, len, 0, 0);
+	if (IS_ERR_VALUE(base))
+		return base;
+
+	/*
+	 * As native arm64 maps its vDSO: sealed where system mappings are, and
+	 * writable only by a debugger's copy-on-write.
+	 */
+	vma = _install_special_mapping(mm, base, len,
+				       VM_READ | VM_EXEC | VM_MAYREAD |
+				       VM_MAYWRITE | VM_MAYEXEC |
+				       VM_SEALED_SYSMAP, &vdso_mapping);
+	if (IS_ERR(vma))
+		return PTR_ERR(vma);
+
+	mm->context.vdso = base;
+	return 0;
+}
diff --git a/arch/um/include/asm/mmu.h b/arch/um/include/asm/mmu.h
index fdc3e28675372640fbebb31155b25a035b021209..4dd32155d3f216cd86b2d5943048e6d3bd06e898 100644
--- a/arch/um/include/asm/mmu.h
+++ b/arch/um/include/asm/mmu.h
@@ -30,6 +30,10 @@ typedef struct mm_context {
 #ifdef CONFIG_COMPAT
 	/* Where the signal-return trampolines of a 32-bit task are mapped. */
 	unsigned long compat_sigpage;
+#endif
+#ifdef CONFIG_UML_ARM64_VDSO
+	/* Where the task's vDSO is mapped, or 0 if it has none. */
+	unsigned long vdso;
 #endif
 	struct mutex turnstile;
 
