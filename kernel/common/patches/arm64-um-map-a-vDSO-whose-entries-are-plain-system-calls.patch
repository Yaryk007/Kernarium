+++ b/arch/arm64/um/asm/vdso/clocksource.h
@@ -2,9 +2,10 @@
 #ifndef __UM_ARM64_ASM_VDSO_CLOCKSOURCE_H
 #define __UM_ARM64_ASM_VDSO_CLOCKSOURCE_H
 
-/* UML exposes time through Linux syscalls rather than a native guest vDSO.
- * Keep a private enum value so the generic time namespace data layout can be
- * built while every UML clocksource continues to publish VDSO_CLOCKMODE_NONE.
+/* The guest's vDSO (arch/arm64/um/vdso) reads no clock itself: each of its
+ * entries is the system call.  Keep a private enum value so the generic time
+ * namespace data layout can be built while every UML clocksource continues to
+ * publish VDSO_CLOCKMODE_NONE.
  */
 #define VDSO_ARCH_CLOCKMODES VDSO_CLOCKMODE_UML
 
