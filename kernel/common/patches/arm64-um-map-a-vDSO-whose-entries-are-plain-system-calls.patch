index dd560d7da81a046f943d8a318b50737cf2f053eb..446a558b37797739112838c80c93b3928f8c700f 100644
--- a/arch/arm64/um/signal.c
+++ b/arch/arm64/um/signal.c
@@ -66,6 +66,7 @@ int arch_setup_additional_pages(struct linux_binprm *bprm, int uses_interp)
 	};
 	struct mm_struct *mm = current->mm;
 	struct vm_area_struct *vma;
+	int ret;
 
 	if (!uml_darwin_sigpage)
 		return -ENOMEM;
@@ -78,8 +79,13 @@ int arch_setup_additional_pages(struct linux_binprm *bprm, int uses_interp)
 		UML_DARWIN_SIGRETURN_TRAMPOLINE & PAGE_MASK, PAGE_SIZE,
 		VM_READ | VM_EXEC | VM_MAYREAD | VM_MAYWRITE | VM_MAYEXEC |
