diff --git a/arch/arm64/um/asm/elf.h b/arch/arm64/um/asm/elf.h
index 2dc1b1be43dca961e4ce25ff7b2407caa3ccf894..9936ea160c79d86052dd800fdbb15574681d7472 100644
--- a/arch/arm64/um/asm/elf.h
+++ b/arch/arm64/um/asm/elf.h
@@ -142,24 +142,52 @@ extern int aarch32_setup_additional_pages(struct linux_binprm *bprm,
 					  int uses_interp);
 #endif
 
-#ifdef CONFIG_UML_ARM64_SME
 /*
- * With SME, AT_MINSIGSTKSZ gives the stack the largest signal frame needs,
- * as on native arm64; without it the vector stays as it was.
+ * What every configuration puts in the auxiliary vector beside the standard
+ * entries: AT_SYSINFO_EHDR, the vDSO's address, where the task has one; and,
+ * with SME, AT_MINSIGSTKSZ, which gives the stack the largest signal frame
+ * needs, as on native arm64.  Without SME the vector stays as it was.
  */
+#ifdef CONFIG_UML_ARM64_VDSO
+#define UML_ARM64_VDSO_DLINFO do { \
+	if (current->mm->context.vdso) \
+		NEW_AUX_ENT(AT_SYSINFO_EHDR, current->mm->context.vdso); \
+} while (0)
+#else
+#define UML_ARM64_VDSO_DLINFO do { } while (0)
+#endif
+
+#ifdef CONFIG_UML_ARM64_SME
 extern unsigned long uml_arm64_minsigstksz;
-#define ARCH_DLINFO do { \
+#define UML_ARM64_SME_DLINFO do { \
 	if (uml_arm64_minsigstksz) \
 		NEW_AUX_ENT(AT_MINSIGSTKSZ, uml_arm64_minsigstksz); \
 } while (0)
+#else
+#define UML_ARM64_SME_DLINFO do { } while (0)
 #endif
 
+#define ARCH_DLINFO do { \
+	UML_ARM64_VDSO_DLINFO; \
+	UML_ARM64_SME_DLINFO; \
+} while (0)
+
 #ifdef UML_HOST_DARWIN
-/* Maps the page that holds the sigreturn trampoline (signal.c). */
+/* Maps the page that holds the sigreturn trampoline (signal.c) and the vDSO. */
 #define ARCH_HAS_SETUP_ADDITIONAL_PAGES 1
 struct linux_binprm;
 extern int arch_setup_additional_pages(struct linux_binprm *bprm,
 				       int uses_interp);
 #endif
 
+#ifdef CONFIG_UML_ARM64_VDSO
+/*
+ * Maps the vDSO into the task being executed, which holds mm's mmap lock for
+ * writing, and records its address in mm->context.vdso.  Leaves the task
+ * with no vDSO if the kernel could not build the image.
+ */
+struct mm_struct;
+extern int uml_arm64_vdso_map(struct mm_struct *mm);
+#endif
+
 #endif
diff --git a/arch/arm64/um/asm/vdso/clocksource.h b/arch/arm64/um/asm/vdso/clocksource.h
