diff --git a/arch/um/kernel/tlb.c b/arch/um/kernel/tlb.c
index 7ce5ae0fe9820ab0e84bdfab11d201634b1bd0d5..4b3b6019b6650d789f8f339311f3b874e799383c 100644
--- a/arch/um/kernel/tlb.c
+++ b/arch/um/kernel/tlb.c
@@ -1267,28 +1267,75 @@ void darwin_tlb_flush_range(struct mm_struct *mm, unsigned long start,
 	darwin_tlb_flush_guest_range(mm, max(start, native_end), end);
 }
 
+#ifdef CONFIG_UML_ARM64_AARCH32
+/*
+ * A flush by address, as an AArch32 cacheflush() makes it: no page is held
+ * and nothing was written, so the host publishes the frames the mm maps in
+ * the range now.  A 32-bit address carries no tag.  Only a kernel that runs
+ * AArch32 tasks has it, and imports the host's entry for it.
+ */
 void darwin_flush_icache_remote_user_range(struct mm_struct *mm,
 					   unsigned long start,
 					   unsigned long len)
 {
 	if (mm == &init_mm || len == 0)
 		return;
-	/* process_vm_writev() passes the remote address as the caller gave it,
-	 * and pinning its pages ignored the tag. */
-	start = untagged_addr(start);
 	if (darwin_uml_vm_invalidate_code(mm->context.id.darwin_generation,
 					  start, len) < 0)
 		panic("Darwin: unable to invalidate guest mm %lu code %#lx+%#lx",
 		      mm->context.id.darwin_generation, start, len);
 }
+#endif
 
+/*
+ * The kernel wrote @len bytes at @addr, in one page of another process's mm,
+ * through its own alias of @page, which it still holds.  The process may map
+ * another frame at @addr by now, so name the frame written, as a mapping
+ * names it when installed, and the host publishes at that frame's holders.
+ * Without a name the host tells every mm.
+ */
+static void darwin_flush_icache_frame(struct mm_struct *mm, struct page *page,
+				      unsigned long addr, unsigned long len)
+{
+	unsigned long long offset = 0;
+	int fd = phys_mapping(page_to_phys(page), &offset);
+
+	if (darwin_uml_vm_invalidate_code_frame(mm->context.id.darwin_generation,
+						addr, len, fd,
+						fd < 0 ? 0 : offset) < 0)
+		panic("Darwin: unable to invalidate guest mm %lu frame code %#lx+%#lx",
+		      mm->context.id.darwin_generation, addr, len);
+}
+
+/* __access_remote_vm() untagged @addr before it looked the page up. */
 void darwin_flush_icache_user_page(struct vm_area_struct *vma,
 				   struct page *page, unsigned long addr,
 				   int len)
 {
-	(void)page;
-	if (len > 0)
-		darwin_flush_icache_remote_user_range(vma->vm_mm, addr, len);
+	if (vma->vm_mm != &init_mm && len > 0)
+		darwin_flush_icache_frame(vma->vm_mm, page, addr, len);
+}
+
+/*
+ * @pages are the pinned pages of the range, the first of them holding
+ * @start.  process_vm_writev() passes the remote address as the caller gave
+ * it, and pinning its pages ignored the tag.
+ */
+void darwin_flush_icache_remote_user_pages(struct mm_struct *mm,
+					   struct page **pages,
+					   unsigned long start,
+					   unsigned long len)
+{
+	if (mm == &init_mm)
+		return;
+	start = untagged_addr(start);
+	while (len) {
+		unsigned long chunk = min(len, PAGE_SIZE - offset_in_page(start));
+
+		darwin_flush_icache_frame(mm, *pages++, start, chunk);
+		start += chunk;
+		len -= chunk;
+	}
 }
 #endif
 
