 include/asm-generic/cacheflush.h            | 20 +++++--
 mm/process_vm_access.c                      |  3 +-
 7 files changed, 120 insertions(+), 15 deletions(-)

diff --git a/arch/um/include/asm/cacheflush.h b/arch/um/include/asm/cacheflush.h
index 31deab0b5c24a55cd6baf6a253f418fc98db3ed0..a18b3a62e8bc588cfcd054cdc48b04d932431945 100644
--- a/arch/um/include/asm/cacheflush.h
+++ b/arch/um/include/asm/cacheflush.h
@@ -14,17 +14,26 @@ struct page;
 /*
  * Darwin guests run translated code cached by address. A ptrace,
  * /proc/pid/mem or process_vm_writev() store reaches another process's
- * memory through the kernel's view of the frame, so tell the host which of
- * that process's pages changed.
+ * memory through the kernel's view of the frame, so name that frame to the
+ * host, which publishes the change at the frame's holders whatever the
+ * process maps at the address by now. An AArch32 cacheflush() changes no
+ * frame and is told by address, in a kernel that runs AArch32 tasks.
  */
 extern void darwin_flush_icache_user_page(struct vm_area_struct *vma,
 					  struct page *page,
 					  unsigned long addr, int len);
-extern void darwin_flush_icache_remote_user_range(struct mm_struct *mm,
+extern void darwin_flush_icache_remote_user_pages(struct mm_struct *mm,
+						  struct page **pages,
 						  unsigned long start,
 						  unsigned long len);
 #define flush_icache_user_page darwin_flush_icache_user_page
+#define flush_icache_remote_user_pages darwin_flush_icache_remote_user_pages
+#ifdef CONFIG_UML_ARM64_AARCH32
+extern void darwin_flush_icache_remote_user_range(struct mm_struct *mm,
+						  unsigned long start,
+						  unsigned long len);
 #define flush_icache_remote_user_range darwin_flush_icache_remote_user_range
+#endif
 
 /*
  * With 4 KiB pages on a 16 KiB host, a kernel alias whose host page does not
diff --git a/arch/um/include/shared/os.h b/arch/um/include/shared/os.h
index baa005982001744d04629b405948124d2e100a95..7950c3f1a95380d0bd9820dfedd28f6c9d20c532 100644
--- a/arch/um/include/shared/os.h
+++ b/arch/um/include/shared/os.h
@@ -286,6 +286,13 @@ extern int darwin_uml_vm_flush_generation(unsigned long generation);
 extern int darwin_uml_vm_invalidate_code(unsigned long generation,
 					 unsigned long address,
 					 unsigned long length);
+extern int darwin_uml_vm_invalidate_code_frame(unsigned long generation,
+					       unsigned long address,
+					       unsigned long length, int fd,
+					       unsigned long long offset);
+extern int darwin_uml_vm_invalidate_code_frames(int fd,
+						unsigned long long offset,
+						unsigned long long length);
 extern int darwin_uml_vm_unmap_generation(unsigned long generation,
 					  void *address,
