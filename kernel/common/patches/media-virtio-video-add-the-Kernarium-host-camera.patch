+/* The metadata node has one format: the device's record. */
+static int cam_meta_enum_fmt(struct file *file, void *fh,
+			     struct v4l2_fmtdesc *fmtdesc)
+{
+	if (fmtdesc->index)
+		return -EINVAL;
+
+	fmtdesc->pixelformat = V4L2_META_FMT_VIRTIO_CAMERA;
+	strscpy(fmtdesc->description, "Virtio camera metadata",
+		sizeof(fmtdesc->description));
+
+	return 0;
+}
+
+static int cam_meta_g_fmt(struct file *file, void *fh, struct v4l2_format *format)
+{
+	struct virtio_video_cam_file *f = to_cam_file(file);
+	int ret;
+
+	ret = mutex_lock_interruptible(&f->lock);
+	if (ret)
+		return ret;
+	format->fmt.meta = f->meta_fmt;
+	mutex_unlock(&f->lock);
+
+	return 0;
+}
+
+static int cam_meta_try_fmt(struct file *file, void *fh,
+			    struct v4l2_format *format)
+{
+	return cam_meta_g_fmt(file, fh, format);
+}
