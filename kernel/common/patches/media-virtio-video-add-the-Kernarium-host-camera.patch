diff --git a/drivers/media/virtio/virtio_video_camera.c b/drivers/media/virtio/virtio_video_camera.c
new file mode 100644
index 0000000000000000000000000000000000000000..dabbc29fcff0c0a1ff8af3bd31fe1055ee34c1fc
--- /dev/null
+++ b/drivers/media/virtio/virtio_video_camera.c
@@ -0,0 +1,1672 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * The Virtio camera's V4L2 nodes.
+ *
+ * A camera of the host is a capture node (video and still streams) and a
+ * metadata node (meta streams). Every open file of a node is a stream of its
+ * own on the host, created when the file first needs one (its format is set or
+ * its buffers are requested), never at open: applications open every video
+ * node, and opening must not start the host's camera, which only a queued
+ * buffer does. A file that never needs a stream, such as one that only turns
+ * the torch on, never has one.
+ *
+ * The device decides each plane's size and stride and the driver reports them,
+ * so a client that honors the stride a V4L2 device reports needs no allocator
+ * of its own. The driver's own copy of the rule (virtio_video_cam_fill_pix())
+ * answers TRY_FMT and the formats before a stream exists; S_FMT takes the
+ * device's answer.
+ *
+ * A still stream takes one capture per buffer queued. A client groups the
+ * stills of one capture (a JPEG with its Bayer still) as the HAL does: one
+ * non-zero cookie in the buffers' timestamp field and V4L2_BUF_FLAG_LAST on the
+ * group's last buffer. vb2 clears the flag and copies no timestamp on a
+ * capture queue, so the driver reads both in its VIDIOC_QBUF before vb2 does.
+ */
+#include <linux/module.h>
+#include <linux/sched.h>
+#include <linux/delay.h>
+#include <linux/ktime.h>
+#include <media/v4l2-event.h>
+#include <media/v4l2-ioctl.h>
+#include <media/videobuf2-dma-sg.h>
+
+#include "virtio_video_camera.h"
+
+/* ------------------------------------------------------------------------ */
+/* Formats                                                                  */
+/* ------------------------------------------------------------------------ */
+
+u32 virtio_video_camera_wire_to_v4l2(u32 wire)
+{
+	switch (wire) {
+	case VIRTIO_VIDEO_FORMAT_NV12:
+		return V4L2_PIX_FMT_NV12;
+	case VIRTIO_VIDEO_FORMAT_CAMERA_JPEG:
+		return V4L2_PIX_FMT_JPEG;
+	case VIRTIO_VIDEO_FORMAT_CAMERA_RAW16_RGGB:
+		return V4L2_PIX_FMT_SRGGB16;
+	case VIRTIO_VIDEO_FORMAT_CAMERA_RAW16_GRBG:
+		return V4L2_PIX_FMT_SGRBG16;
+	case VIRTIO_VIDEO_FORMAT_CAMERA_RAW16_GBRG:
+		return V4L2_PIX_FMT_SGBRG16;
+	case VIRTIO_VIDEO_FORMAT_CAMERA_RAW16_BGGR:
+		return V4L2_PIX_FMT_SBGGR16;
+	default:
+		return 0;
+	}
+}
+
+static u32 cam_v4l2_to_wire(u32 fourcc)
+{
+	switch (fourcc) {
+	case V4L2_PIX_FMT_NV12:
+		return VIRTIO_VIDEO_FORMAT_NV12;
+	case V4L2_PIX_FMT_JPEG:
+		return VIRTIO_VIDEO_FORMAT_CAMERA_JPEG;
+	case V4L2_PIX_FMT_SRGGB16:
+		return VIRTIO_VIDEO_FORMAT_CAMERA_RAW16_RGGB;
+	case V4L2_PIX_FMT_SGRBG16:
+		return VIRTIO_VIDEO_FORMAT_CAMERA_RAW16_GRBG;
+	case V4L2_PIX_FMT_SGBRG16:
+		return VIRTIO_VIDEO_FORMAT_CAMERA_RAW16_GBRG;
+	case V4L2_PIX_FMT_SBGGR16:
+		return VIRTIO_VIDEO_FORMAT_CAMERA_RAW16_BGGR;
+	default:
+		return 0;
+	}
+}
+
+/* NV12 is a video stream, everything else a capture node offers a still. */
+static u32 cam_kind_of(u32 fourcc)
+{
+	return fourcc == V4L2_PIX_FMT_NV12 ? VIRTIO_VIDEO_CAMERA_STREAM_VIDEO :
+					     VIRTIO_VIDEO_CAMERA_STREAM_STILL;
+}
+
+struct video_format *
+virtio_video_cam_find_format(struct virtio_video_camera *cam, u32 pixelformat)
+{
+	struct video_format *fmt;
+
+	list_for_each_entry(fmt, &cam->video_formats, formats_list_entry)
+		if (fmt->desc.format == pixelformat)
+			return fmt;
+	list_for_each_entry(fmt, &cam->still_formats, formats_list_entry)
+		if (fmt->desc.format == pixelformat)
+			return fmt;
+
+	return NULL;
+}
+
+static struct video_format *cam_nth_format(struct virtio_video_camera *cam,
+					   unsigned int n)
+{
+	struct video_format *fmt;
+
+	list_for_each_entry(fmt, &cam->video_formats, formats_list_entry)
+		if (fmt->desc.format && n-- == 0)
+			return fmt;
+	list_for_each_entry(fmt, &cam->still_formats, formats_list_entry)
+		if (fmt->desc.format && n-- == 0)
+			return fmt;
+
+	return NULL;
+}
+
+static u32 cam_clamp_step(u32 value, const struct virtio_video_format_range *r)
+{
+	value = clamp(value, r->min, r->max);
+	if (r->step > 1)
+		value = r->min + DIV_ROUND_CLOSEST(value - r->min, r->step) *
+				 r->step;
+
+	return min(value, r->max);
+}
+
+/* The size the format offers nearest to the one asked for. */
+static void cam_pick_size(const struct video_format *fmt, u32 *width,
+			  u32 *height)
+{
+	u64 best = U64_MAX;
+	u32 best_w = *width, best_h = *height;
+	unsigned int i;
+
+	for (i = 0; i < fmt->desc.num_frames; i++) {
+		const struct virtio_video_format_frame *frame =
+			&fmt->frames[i].frame;
+		u32 w = cam_clamp_step(*width, &frame->width);
+		u32 h = cam_clamp_step(*height, &frame->height);
+		u64 distance = (u64)abs_diff(w, *width) + abs_diff(h, *height);
+
+		if (distance < best) {
+			best = distance;
+			best_w = w;
+			best_h = h;
+		}
+	}
+
+	*width = best_w;
+	*height = best_h;
+}
+
+/*
+ * A new file's size: the largest the format offers that is no bigger than
+ * 1280 x 720, else the smallest.
+ */
+static void cam_default_size(const struct video_format *fmt, u32 *width,
+			     u32 *height)
+{
+	const struct virtio_video_format_frame *best = NULL, *smallest = NULL;
+	unsigned int i;
+
+	for (i = 0; i < fmt->desc.num_frames; i++) {
+		const struct virtio_video_format_frame *frame =
+			&fmt->frames[i].frame;
+		u64 area = (u64)frame->width.min * frame->height.min;
+
+		if (frame->width.min <= 1280 && frame->height.min <= 720 &&
+		    (!best || area > (u64)best->width.min * best->height.min))
+			best = frame;
+		if (!smallest ||
+		    area < (u64)smallest->width.min * smallest->height.min)
+			smallest = frame;
+	}
+	if (!best)
+		best = smallest;
+	if (best) {
+		*width = best->width.min;
+		*height = best->height.min;
+	}
+}
+
+/* The layout the device uses: rows padded to 16 bytes, planes back to back. */
+static void cam_fill_pix(struct v4l2_pix_format_mplane *pix, u32 fourcc,
+			 u32 width, u32 height)
+{
+	u32 stride;
+	u64 size;
+
+	memset(pix, 0, sizeof(*pix));
+	pix->width = width;
+	pix->height = height;
+	pix->pixelformat = fourcc;
+	pix->field = V4L2_FIELD_NONE;
+	pix->num_planes = 1;
+
+	switch (fourcc) {
+	case V4L2_PIX_FMT_NV12:
+		stride = ALIGN(width, 16);
+		size = (u64)stride * (height + height / 2);
+		pix->colorspace = V4L2_COLORSPACE_REC709;
+		pix->xfer_func = V4L2_XFER_FUNC_709;
+		pix->ycbcr_enc = V4L2_YCBCR_ENC_709;
+		pix->quantization = V4L2_QUANTIZATION_FULL_RANGE;
+		break;
+	case V4L2_PIX_FMT_JPEG:
+		stride = 0;
+		size = (u64)width * height * 3 / 2 +
+		       VIRTIO_VIDEO_CAMERA_EXIF_GAP;
+		pix->colorspace = V4L2_COLORSPACE_JPEG;
+		pix->xfer_func = V4L2_XFER_FUNC_SRGB;
+		pix->ycbcr_enc = V4L2_YCBCR_ENC_601;
+		pix->quantization = V4L2_QUANTIZATION_FULL_RANGE;
+		break;
+	default:
+		stride = ALIGN(2 * width, 16);
+		size = (u64)stride * height;
+		pix->colorspace = V4L2_COLORSPACE_RAW;
+		break;
+	}
+
+	pix->plane_fmt[0].bytesperline = stride;
+	pix->plane_fmt[0].sizeimage = min_t(u64, size, U32_MAX);
+}
+
+/* The format TRY_FMT settles on; it never fails for an unknown one. */
+static void cam_try_pix(struct virtio_video_camera *cam,
+			struct v4l2_pix_format_mplane *pix)
+{
+	struct video_format *fmt = virtio_video_cam_find_format(cam,
+								pix->pixelformat);
+	u32 width = pix->width, height = pix->height;
+
+	if (!fmt)
+		fmt = virtio_video_cam_find_format(cam, V4L2_PIX_FMT_NV12) ?:
+		      cam_nth_format(cam, 0);
+	if (!fmt)
+		return;
+
+	if (!width || !height)
+		cam_default_size(fmt, &width, &height);
+	else
+		cam_pick_size(fmt, &width, &height);
+
+	cam_fill_pix(pix, fmt->desc.format, width, height);
+}
+
+/* ------------------------------------------------------------------------ */
+/* The host stream of a file                                                */
+/* ------------------------------------------------------------------------ */
+
+static struct virtio_video_device *cam_vvd(struct virtio_video_cam_file *file)
+{
+	return file->cam->vvd;
+}
+
+/*
+ * Reserves one of the buffers the device may hold in all
+ * (VIRTIO_VIDEO_CAMERA_MAX_QUEUED); a buffer over the budget is refused.
+ */
+static bool cam_buffer_reserve(struct virtio_video_device *vvd)
+{
+	if (atomic_inc_return(&vvd->cam_queued) <= VIRTIO_VIDEO_CAMERA_MAX_QUEUED)
+		return true;
+	atomic_dec(&vvd->cam_queued);
+
+	return false;
+}
+
+/* A buffer left the device: its answer came, or it was taken back. */
+static void cam_inflight_dec(struct virtio_video_cam_file *file)
+{
+	atomic_dec(&cam_vvd(file)->cam_queued);
+	atomic_dec(&file->inflight);
+}
+
+/* Notes a sequence handed to the client, so a reset can carry on after it. */
+static void cam_note_sequence(struct virtio_video_camera *cam, u32 sequence)
+{
+	int next = sequence + 1, seen = atomic_read(&cam->seq_next);
+
+	while (next - seen > 0 &&
+	       !atomic_try_cmpxchg(&cam->seq_next, &seen, next))
+		;
+}
+
+static void cam_stream_destroy(struct virtio_video_cam_file *file)
+{
+	struct virtio_video_device *vvd = cam_vvd(file);
+
+	if (!file->stream_id)
+		return;
+
+	virtio_video_cmd_stream_destroy(vvd, file->stream_id);
+	virtio_video_stream_id_put(vvd, file->stream_id);
+	file->stream_id = 0;
+}
+
+static int cam_stream_create(struct virtio_video_cam_file *file)
+{
+	struct virtio_video_device *vvd = cam_vvd(file);
+	char name[TASK_COMM_LEN];
+	uint32_t id;
+	int ret;
+
+	get_task_comm(name, current);
+	virtio_video_stream_id_get(vvd, file, &id);
+	if ((int)id <= 0)
+		return -ENOMEM;
+
+	ret = virtio_video_cam_cmd_stream_create(vvd, id, file->cam->index,
+						 file->kind, name);
+	if (ret) {
+		virtio_video_stream_id_put(vvd, id);
+		return ret;
+	}
+
+	file->stream_id = id;
+
+	return 0;
+}
+
+/*
+ * Tells the device the stream's format and learns the layout it picked and, for
+ * video, the frame interval it runs at.
+ */
+static int cam_stream_configure(struct virtio_video_cam_file *file)
+{
+	struct virtio_video_device *vvd = cam_vvd(file);
+	struct virtio_video_params params = {}, got = {};
+	bool capture = file->node->type == CAM_NODE_CAPTURE;
+	u32 plane_size, stride, minimum;
+	int ret;
+
+	params.queue_type = cpu_to_le32(VIRTIO_VIDEO_QUEUE_TYPE_OUTPUT);
+	params.format = cpu_to_le32(file->wire_format);
+	params.min_buffers = cpu_to_le32(1);
+	params.max_buffers = cpu_to_le32(VB2_MAX_FRAME);
+	params.num_planes = cpu_to_le32(1);
+	if (capture) {
+		params.frame_width = cpu_to_le32(file->pix.width);
+		params.frame_height = cpu_to_le32(file->pix.height);
+		params.crop.width = params.frame_width;
+		params.crop.height = params.frame_height;
+		params.frame_rate = cpu_to_le32(file->interval_denominator /
+						max(file->interval_numerator, 1u));
+		params.plane_formats[0].plane_size =
+			cpu_to_le32(file->pix.plane_fmt[0].sizeimage);
+		params.plane_formats[0].stride =
+			cpu_to_le32(file->pix.plane_fmt[0].bytesperline);
+	} else {
+		params.plane_formats[0].plane_size =
+			cpu_to_le32(sizeof(struct virtio_video_camera_meta));
+	}
+
+	ret = virtio_video_cam_cmd_set_params(vvd, file->stream_id, &params);
+	if (ret)
+		return ret;
+
+	ret = virtio_video_cam_cmd_get_params(vvd, file->stream_id, &got);
+	if (ret)
+		return ret;
+
+	if (le32_to_cpu(got.num_planes) < 1)
+		return -EIO;
+	plane_size = le32_to_cpu(got.plane_formats[0].plane_size);
+	stride = le32_to_cpu(got.plane_formats[0].stride);
+	/*
+	 * Nothing under what the driver itself works out for the format, and
+	 * nothing over what the device takes as a resource: vb2 would
+	 * allocate whatever it was told.
+	 */
+	minimum = capture ? file->pix.plane_fmt[0].sizeimage :
+			    sizeof(struct virtio_video_camera_meta);
+	if (plane_size < minimum ||
+	    plane_size > VIRTIO_VIDEO_CAMERA_MAX_PLANE_SIZE)
+		return -EIO;
+
+	file->plane_size = plane_size;
+	if (capture) {
+		file->pix.plane_fmt[0].sizeimage = plane_size;
+		file->pix.plane_fmt[0].bytesperline = stride;
+	} else {
+		file->meta_fmt.buffersize = plane_size;
+	}
+
+	if (file->kind == VIRTIO_VIDEO_CAMERA_STREAM_VIDEO) {
+		/* Whatever the guest asked for, the device runs at a rate it has. */
+		if (file->interval_numerator && file->interval_denominator)
+			virtio_video_cam_cmd_set_interval(vvd, file->stream_id,
+							  file->interval_numerator,
+							  file->interval_denominator);
+		virtio_video_cam_cmd_get_interval(vvd, file->stream_id,
+						  &file->interval_numerator,
+						  &file->interval_denominator);
+	}
+
+	return 0;
+}
+
+/* Creates the file's host stream and configures it. */
+static int cam_stream_setup(struct virtio_video_cam_file *file)
+{
+	int ret;
+
+	ret = cam_stream_create(file);
+	if (ret)
+		return ret;
+
+	ret = cam_stream_configure(file);
+	if (ret)
+		cam_stream_destroy(file);
+
+	return ret;
+}
+
+static int cam_stream_ensure(struct virtio_video_cam_file *file)
+{
+	return file->stream_id ? 0 : cam_stream_setup(file);
+}
+
+/* ------------------------------------------------------------------------ */
+/* vb2                                                                      */
+/* ------------------------------------------------------------------------ */
+
+static int cam_queue_setup(struct vb2_queue *vq, unsigned int *nbuffers,
+			   unsigned int *nplanes, unsigned int sizes[],
+			   struct device *alloc_devs[])
+{
+	struct virtio_video_cam_file *file = vb2_get_drv_priv(vq);
+
+	if (!file->stream_id)
+		return -EIO;
+
+	if (*nplanes)
+		return *nplanes == 1 && sizes[0] >= file->plane_size ?
+		       0 : -EINVAL;
+
+	*nplanes = 1;
+	sizes[0] = file->plane_size;
+
+	return 0;
+}
+
+static int cam_buf_init(struct vb2_buffer *vb)
+{
+	struct virtio_video_cam_file *file = vb2_get_drv_priv(vb->vb2_queue);
+	struct virtio_video_cam_buffer *buf = to_cam_buffer(vb);
+	u32 id = 0;
+	int ret;
+
+	INIT_LIST_HEAD(&buf->parked);
+	buf->cmd = NULL;
+	buf->attached = false;
+
+	ret = virtio_video_attach_buffer(cam_vvd(file), file->stream_id, vb,
+					 &id);
+	/* A buffer the device cannot map is not one the client may queue. */
+	if (ret == -ENOTTY)
+		ret = -EINVAL;
+	if (ret)
+		return ret;
+
+	buf->resource_id = id;
+	buf->attached = true;
+
+	return 0;
+}
+
+static void cam_buf_cleanup(struct vb2_buffer *vb)
+{
+	struct virtio_video_cam_file *file = vb2_get_drv_priv(vb->vb2_queue);
+	struct virtio_video_cam_buffer *buf = to_cam_buffer(vb);
+
+	if (buf->resource_id)
+		virtio_video_resource_id_put(cam_vvd(file), buf->resource_id);
+	buf->resource_id = 0;
+	buf->attached = false;
+}
+
+static int cam_buf_prepare(struct vb2_buffer *vb)
+{
+	struct virtio_video_cam_file *file = vb2_get_drv_priv(vb->vb2_queue);
+	struct virtio_video_cam_buffer *buf = to_cam_buffer(vb);
+	u32 id = buf->resource_id;
+	int ret;
+
+	if (vb2_plane_size(vb, 0) < file->plane_size)
+		return -EINVAL;
+
+	/*
+	 * The device forgot the buffer when it was reset, or the stream it was
+	 * attached to was destroyed: attach it again.
+	 */
+	if (!buf->attached && id) {
+		ret = cam_stream_ensure(file);
+		if (ret)
+			return ret;
+		ret = virtio_video_attach_buffer(cam_vvd(file), file->stream_id,
+						 vb, &id);
+		if (ret == -ENOTTY)
+			ret = -EINVAL;
+		if (ret)
+			return ret;
+		buf->attached = true;
+	}
+
+	return 0;
+}
+
+/* Hands a buffer to the device. */
+static int cam_send_buffer(struct virtio_video_cam_file *file,
+			   struct virtio_video_cam_buffer *buf)
+{
+	int ret;
+
+	/* A cookie and a group mean something to a still stream only. */
+	if (file->kind != VIRTIO_VIDEO_CAMERA_STREAM_STILL) {
+		buf->cookie = 0;
+		buf->group_more = false;
+	}
+
+	if (!cam_buffer_reserve(cam_vvd(file)))
+		return -EBUSY;
+	atomic_inc(&file->inflight);
+	ret = virtio_video_cam_cmd_queue(cam_vvd(file), file->stream_id, buf);
+	if (ret) {
+		cam_inflight_dec(file);
+		wake_up(&file->idle);
+	}
+
+	return ret;
+}
+
+static void cam_buf_queue(struct vb2_buffer *vb)
+{
+	struct virtio_video_cam_file *file = vb2_get_drv_priv(vb->vb2_queue);
+	struct virtio_video_cam_buffer *buf = to_cam_buffer(vb);
+
+	if (cam_send_buffer(file, buf)) {
+		vb2_set_plane_payload(vb, 0, 0);
+		vb2_buffer_done(vb, VB2_BUF_STATE_ERROR);
+	}
+}
+
+/*
+ * The metadata record of a buffer, in the pages the device wrote it to. Not
+ * through vb2_plane_vaddr(): that is a second mapping of the same pages, and
+ * this host's does not show the device's writes. A metadata buffer is always
+ * the node's own memory (see cam_init_queue), a page or more from its start.
+ */
+static struct virtio_video_camera_meta *cam_meta_record(struct vb2_buffer *vb)
+{
+	struct sg_table *sgt = vb2_dma_sg_plane_desc(vb, 0);
+
+	if (!sgt || !sgt->sgl ||
+	    sgt->sgl->length < sizeof(struct virtio_video_camera_meta))
+		return NULL;
+	return sg_virt(sgt->sgl);
+}
+
+/*
+ * The device's answer to a queued buffer, under the command queue's lock with
+ * interrupts off. The frame's timestamp is its age: the driver stamps it with
+ * its own clock minus that, as the monotonic clock the HAL converts. A still
+ * carries only the guest's cookie back, and its metadata record has the
+ * exposure's duration and no time, so a still is stamped when it completes. A
+ * failed buffer carries no payload; while a suspend stops the stream, the
+ * buffers the device returns as failed (video and metadata) are kept to be
+ * queued again instead of going back to the client.
+ */
+void virtio_video_cam_complete(struct virtio_video_cam_buffer *buf,
+			       const struct virtio_video_camera_queue_resp *resp)
+{
+	struct vb2_buffer *vb = &buf->vb.vb2_buf;
+	struct virtio_video_cam_file *file = vb2_get_drv_priv(vb->vb2_queue);
+	enum vb2_buffer_state state = VB2_BUF_STATE_DONE;
+	u32 flags = VIRTIO_VIDEO_DEQUEUE_FLAG_ERR;
+	u64 age = 0, now = ktime_get_ns();
+	u32 size = 0, wire_sequence = 0;
+	unsigned long irq;
+
+	if (resp) {
+		flags = le32_to_cpu(resp->base.flags);
+		age = le64_to_cpu(resp->base.timestamp);
+		size = le32_to_cpu(resp->base.data_sizes[0]);
+		wire_sequence = (u32)le64_to_cpu(resp->sequence);
+	}
+	buf->cmd = NULL;
+
+	if (flags & VIRTIO_VIDEO_DEQUEUE_FLAG_ERR) {
+		if (READ_ONCE(file->parking) &&
+		    file->kind != VIRTIO_VIDEO_CAMERA_STREAM_STILL) {
+			spin_lock_irqsave(&file->park_lock, irq);
+			list_add_tail(&buf->parked, &file->parked);
+			spin_unlock_irqrestore(&file->park_lock, irq);
+			goto out;
+		}
+		state = VB2_BUF_STATE_ERROR;
+		size = 0;
+		/* A failed buffer has no sequence of the device's: the stream's. */
+		buf->vb.sequence = file->sequence;
+	} else {
+		/*
+		 * The device counts from zero after a reset; the camera's
+		 * sequences, the metadata's too, go on from the highest
+		 * delivered.
+		 */
+		buf->vb.sequence = wire_sequence +
+				   atomic_read(&file->cam->seq_offset);
+		file->sequence = buf->vb.sequence + 1;
+		switch (file->kind) {
+		case VIRTIO_VIDEO_CAMERA_STREAM_VIDEO:
+			/* A frame fills the plane. */
+			size = file->plane_size;
+			break;
+		case VIRTIO_VIDEO_CAMERA_STREAM_META:
+			size = size ?: sizeof(struct virtio_video_camera_meta);
+			break;
+		default:
+			/* A JPEG says how long it is; a Bayer still fills the plane. */
+			size = size ?: file->plane_size;
+			break;
+		}
+		/* A buffer that claims more than it holds failed. */
+		if (size > vb2_plane_size(vb, 0)) {
+			state = VB2_BUF_STATE_ERROR;
+			size = 0;
+		}
+		/*
+		 * The record names its exposure by the device's sequence, which
+		 * is what the client matches to a frame by: it is carried on
+		 * the same way.
+		 */
+		if (state == VB2_BUF_STATE_DONE &&
+		    file->kind == VIRTIO_VIDEO_CAMERA_STREAM_META) {
+			struct virtio_video_camera_meta *meta = cam_meta_record(vb);
+			u32 offset = atomic_read(&file->cam->seq_offset);
+
+			if (meta && offset && size >= sizeof(*meta))
+				meta->sequence = cpu_to_le64(
+					le64_to_cpu(meta->sequence) + offset);
+		}
+	}
+	cam_note_sequence(file->cam, buf->vb.sequence);
+
+	vb->timestamp = file->kind == VIRTIO_VIDEO_CAMERA_STREAM_STILL ?
+			now : now - min(age, now);
+	buf->vb.field = V4L2_FIELD_NONE;
+	vb2_set_plane_payload(vb, 0, size);
+	vb2_buffer_done(vb, state);
+out:
+	cam_inflight_dec(file);
+	wake_up(&file->idle);
+}
+
+/*
+ * Takes back what the device holds of a file's buffers when it cannot say so
+ * itself. A buffer whose command the device still has is orphaned, so its
+ * answer finds no buffer. With `park`, the buffers a suspend stopped wait for
+ * the resume (stills do not: a capture that was never taken is a failed one);
+ * otherwise every buffer the driver owns goes back to the client as failed.
+ */
+static void cam_take_back(struct virtio_video_cam_file *file, bool park)
+{
+	struct vb2_queue *q = &file->vq;
+	unsigned long irq;
+	unsigned int i;
+
+	for (i = 0; i < q->max_num_buffers; i++) {
+		struct vb2_buffer *vb = vb2_get_buffer(q, i);
+		struct virtio_video_cam_buffer *buf;
+
+		if (!vb || vb->state != VB2_BUF_STATE_ACTIVE)
+			continue;
+		buf = to_cam_buffer(vb);
+
+		if (virtio_video_cmd_orphan(cam_vvd(file), &buf->cmd)) {
+			cam_inflight_dec(file);
+			if (park &&
+			    file->kind != VIRTIO_VIDEO_CAMERA_STREAM_STILL) {
+				spin_lock_irqsave(&file->park_lock, irq);
+				list_add_tail(&buf->parked, &file->parked);
+				spin_unlock_irqrestore(&file->park_lock, irq);
+				continue;
+			}
+		} else if (park || vb->state != VB2_BUF_STATE_ACTIVE) {
+			/*
+			 * Parked already, or answered while this looked: the
+			 * orphan above ordered us after its callback.
+			 */
+			continue;
+		}
+
+		spin_lock_irqsave(&file->park_lock, irq);
+		list_del_init(&buf->parked);
+		spin_unlock_irqrestore(&file->park_lock, irq);
+		vb2_set_plane_payload(vb, 0, 0);
+		vb2_buffer_done(vb, VB2_BUF_STATE_ERROR);
+	}
+
+	/*
+	 * A response callback that was running on another CPU holds the command
+	 * queue's lock until it is done with the file.
+	 */
+	spin_lock_irqsave(&cam_vvd(file)->commandq.qlock, irq);
+	spin_unlock_irqrestore(&cam_vvd(file)->commandq.qlock, irq);
+	wake_up(&file->idle);
+}
+
+static int cam_start_streaming(struct vb2_queue *q, unsigned int count)
+{
+	return 0;
+}
+
+/*
+ * Stops the device's work on a file's buffers, and does not return until it
+ * cannot write one any more. The device completes what it holds as failed,
+ * after it answers the clear, so the answer and then every buffer are waited
+ * for. A device that does not say so in time may still write a buffer, and the
+ * pages of one the client gets back are the client's to reuse: the stream is
+ * destroyed instead. The destroy is only queued here, so the wait for the
+ * buffers goes on after it, without a limit, in steps that say so: the device
+ * takes the ring in order and completes every buffer it holds when it
+ * processes either command, so the wait ends when the device does its work,
+ * and a removal ends it whatever the device does, because it clears the
+ * queue's ready flag and virtio_video_cancel_cmds() then returns every
+ * command, a buffer's among them. The buffers of a destroyed stream must be
+ * attached to a new one before they are queued again.
+ */
+static void cam_halt_stream(struct virtio_video_cam_file *file)
+{
+	struct virtio_video_device *vvd = cam_vvd(file);
+	struct vb2_queue *q = &file->vq;
+	unsigned int i;
+
+	if (!file->stream_id)
+		return;
+
+	if (!virtio_video_cam_cmd_clear(vvd, file->stream_id, false) &&
+	    wait_event_timeout(file->idle, !atomic_read(&file->inflight), HZ) > 0)
+		return;
+
+	v4l2_warn(&vvd->v4l2_dev,
+		  "camera %u: the device did not stop a stream in time: destroying it\n",
+		  file->cam->index);
+	cam_stream_destroy(file);
+	for (i = 0; i < q->max_num_buffers; i++) {
+		struct vb2_buffer *vb = vb2_get_buffer(q, i);
+
+		if (vb)
+			to_cam_buffer(vb)->attached = false;
+	}
+
+	while (!wait_event_timeout(file->idle,
+				   !atomic_read(&file->inflight) ||
+				   !READ_ONCE(vvd->commandq.ready), 5 * HZ))
+		v4l2_warn(&vvd->v4l2_dev,
+			  "camera %u: still waiting for the device to give back a stream's buffers\n",
+			  file->cam->index);
+}
+
+/*
+ * Stops the stream; the buffers go back to the client as failed only after
+ * the device has stopped writing them.
+ */
+static void cam_stop_streaming(struct vb2_queue *q)
+{
+	struct virtio_video_cam_file *file = vb2_get_drv_priv(q);
+
+	cam_halt_stream(file);
+	cam_take_back(file, false);
+}
+
+static const struct vb2_ops cam_vb2_ops = {
+	.queue_setup = cam_queue_setup,
+	.buf_init = cam_buf_init,
+	.buf_prepare = cam_buf_prepare,
+	.buf_cleanup = cam_buf_cleanup,
+	.buf_queue = cam_buf_queue,
+	.start_streaming = cam_start_streaming,
+	.stop_streaming = cam_stop_streaming,
+	.wait_prepare = vb2_ops_wait_prepare,
+	.wait_finish = vb2_ops_wait_finish,
+};
+
+static int cam_init_queue(struct virtio_video_cam_file *file)
+{
+	struct virtio_video_device *vvd = cam_vvd(file);
+	struct vb2_queue *q = &file->vq;
+
+	q->type = file->node->type == CAM_NODE_CAPTURE ?
+		  V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE :
+		  V4L2_BUF_TYPE_META_CAPTURE;
+	/* A metadata record is read from the node's own memory. */
+	q->io_modes = file->node->type == CAM_NODE_CAPTURE ?
+		      VB2_MMAP | VB2_DMABUF : VB2_MMAP;
+	q->ops = &cam_vb2_ops;
+	q->mem_ops = &vb2_dma_sg_memops;
+	q->buf_struct_size = sizeof(struct virtio_video_cam_buffer);
+	q->timestamp_flags = V4L2_BUF_FLAG_TIMESTAMP_MONOTONIC;
+	q->lock = &file->lock;
+	q->dev = vvd->v4l2_dev.dev;
+	q->drv_priv = file;
+	q->gfp_flags = virtio_video_gfp_flags(vvd);
+	q->min_queued_buffers = 0;
+
+	return vb2_queue_init(q);
+}
+
+/* ------------------------------------------------------------------------ */
+/* ioctls                                                                   */
+/* ------------------------------------------------------------------------ */
+
+static int cam_querycap(struct file *file, void *fh,
+			struct v4l2_capability *cap)
+{
+	struct virtio_video_cam_file *f = to_cam_file(file);
+
+	strscpy(cap->driver, DRIVER_NAME, sizeof(cap->driver));
+	snprintf(cap->card, sizeof(cap->card), "Virtio camera %u",
+		 f->cam->index);
+	snprintf(cap->bus_info, sizeof(cap->bus_info), "virtio-camera:%u",
+		 f->cam->index);
+
+	return 0;
+}
+
+static int cam_enum_fmt(struct file *file, void *fh, struct v4l2_fmtdesc *fmtdesc)
+{
+	struct virtio_video_cam_file *f = to_cam_file(file);
+	struct video_format *fmt;
+
+	if (fmtdesc->type != V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE)
+		return -EINVAL;
+
+	fmt = cam_nth_format(f->cam, fmtdesc->index);
+	if (!fmt)
+		return -EINVAL;
+
+	fmtdesc->pixelformat = fmt->desc.format;
+	fmtdesc->flags = 0;
+
+	return 0;
+}
+
+static int cam_g_fmt(struct file *file, void *fh, struct v4l2_format *format)
+{
+	struct virtio_video_cam_file *f = to_cam_file(file);
+	int ret;
+
+	ret = mutex_lock_interruptible(&f->lock);
+	if (ret)
+		return ret;
+	format->fmt.pix_mp = f->pix;
+	mutex_unlock(&f->lock);
+
+	return 0;
+}
+
+static int cam_try_fmt(struct file *file, void *fh, struct v4l2_format *format)
+{
+	struct virtio_video_cam_file *f = to_cam_file(file);
+
+	cam_try_pix(f->cam, &format->fmt.pix_mp);
+
+	return 0;
+}
+
+static int cam_s_fmt(struct file *file, void *fh, struct v4l2_format *format)
+{
+	struct virtio_video_cam_file *f = to_cam_file(file);
+	struct v4l2_pix_format_mplane pix = format->fmt.pix_mp;
+	struct v4l2_pix_format_mplane old_pix;
+	u32 old_kind, old_wire;
+	int ret;
+
+	ret = mutex_lock_interruptible(&f->lock);
+	if (ret)
+		return ret;
+	old_pix = f->pix;
+	old_kind = f->kind;
+	old_wire = f->wire_format;
+	if (vb2_is_busy(&f->vq)) {
+		ret = -EBUSY;
+		goto out;
+	}
+
+	cam_try_pix(f->cam, &pix);
+
+	/* The kind of stream is the format's, and a stream cannot change it. */
+	f->pix = pix;
+	f->kind = cam_kind_of(pix.pixelformat);
+	f->wire_format = cam_v4l2_to_wire(pix.pixelformat);
+	if (f->stream_id && f->kind != old_kind)
+		cam_stream_destroy(f);
+
+	if (f->stream_id)
+		ret = cam_stream_configure(f);
+	else
+		ret = cam_stream_setup(f);
+	if (ret) {
+		/* The device keeps the stream it had. */
+		f->pix = old_pix;
+		f->kind = old_kind;
+		f->wire_format = old_wire;
+		goto out;
+	}
+
+	format->fmt.pix_mp = f->pix;
+out:
+	mutex_unlock(&f->lock);
+
+	return ret;
+}
+
+static int cam_enum_framesizes(struct file *file, void *fh,
+			       struct v4l2_frmsizeenum *fsize)
+{
+	struct virtio_video_cam_file *f = to_cam_file(file);
+	const struct virtio_video_format_frame *frame;
+	struct video_format *fmt;
+
+	fmt = virtio_video_cam_find_format(f->cam, fsize->pixel_format);
+	if (!fmt || fsize->index >= fmt->desc.num_frames)
+		return -EINVAL;
+
+	frame = &fmt->frames[fsize->index].frame;
+	if (frame->width.min == frame->width.max &&
+	    frame->height.min == frame->height.max) {
+		fsize->type = V4L2_FRMSIZE_TYPE_DISCRETE;
+		fsize->discrete.width = frame->width.min;
+		fsize->discrete.height = frame->height.min;
+		return 0;
+	}
+
+	/* A range is one record. */
+	if (fsize->index)
+		return -EINVAL;
+	fsize->type = V4L2_FRMSIZE_TYPE_STEPWISE;
+	fsize->stepwise.min_width = frame->width.min;
+	fsize->stepwise.max_width = frame->width.max;
+	fsize->stepwise.step_width = max(frame->width.step, 1u);
+	fsize->stepwise.min_height = frame->height.min;
+	fsize->stepwise.max_height = frame->height.max;
+	fsize->stepwise.step_height = max(frame->height.step, 1u);
+
+	return 0;
+}
+
+/*
+ * The frame rates a video size runs at, as the lowest and highest rate of the
+ * ranges the device lists for it. Whatever is asked in between, the device runs
+ * at a rate it has.
+ */
+static bool cam_rate_envelope(struct virtio_video_camera *cam, u32 width,
+			      u32 height, u32 *low, u32 *high)
+{
+	struct video_format *fmt = virtio_video_cam_find_format(cam,
+								V4L2_PIX_FMT_NV12);
+	unsigned int i, j;
+
+	*low = U32_MAX;
+	*high = 0;
+	if (!fmt)
+		return false;
+
+	for (i = 0; i < fmt->desc.num_frames; i++) {
+		const struct video_format_frame *vf = &fmt->frames[i];
+
+		if (width < vf->frame.width.min || width > vf->frame.width.max ||
+		    height < vf->frame.height.min ||
+		    height > vf->frame.height.max)
+			continue;
+		for (j = 0; j < vf->frame.num_rates; j++) {
+			*low = min(*low, vf->frame_rates[j].min);
+			*high = max(*high, vf->frame_rates[j].max);
+		}
+	}
+
+	return *high != 0 && *low != 0 && *low <= *high;
+}
+
+static int cam_enum_frameintervals(struct file *file, void *fh,
+				   struct v4l2_frmivalenum *fival)
+{
+	struct virtio_video_cam_file *f = to_cam_file(file);
+	u32 low, high;
+
+	if (fival->index || fival->pixel_format != V4L2_PIX_FMT_NV12 ||
+	    !cam_rate_envelope(f->cam, fival->width, fival->height, &low,
+			       &high))
+		return -EINVAL;
+
+	if (low == high) {
+		fival->type = V4L2_FRMIVAL_TYPE_DISCRETE;
+		fival->discrete.numerator = 1;
+		fival->discrete.denominator = low;
+		return 0;
+	}
+
+	fival->type = V4L2_FRMIVAL_TYPE_CONTINUOUS;
+	fival->stepwise.min.numerator = 1;
+	fival->stepwise.min.denominator = high;
+	fival->stepwise.max.numerator = 1;
+	fival->stepwise.max.denominator = low;
+	fival->stepwise.step.numerator = 1;
+	fival->stepwise.step.denominator = 1;
+
+	return 0;
+}
+
+static int cam_g_parm(struct file *file, void *fh, struct v4l2_streamparm *parm)
+{
+	struct virtio_video_cam_file *f = to_cam_file(file);
+	int ret;
+
+	ret = mutex_lock_interruptible(&f->lock);
+	if (ret)
+		return ret;
+	memset(&parm->parm, 0, sizeof(parm->parm));
+	parm->parm.capture.capability = V4L2_CAP_TIMEPERFRAME;
+	parm->parm.capture.timeperframe.numerator = f->interval_numerator;
+	parm->parm.capture.timeperframe.denominator = f->interval_denominator;
+	mutex_unlock(&f->lock);
+
+	return 0;
+}
+
+static int cam_s_parm(struct file *file, void *fh, struct v4l2_streamparm *parm)
+{
+	struct virtio_video_cam_file *f = to_cam_file(file);
+	struct v4l2_fract wanted = parm->parm.capture.timeperframe;
+	int ret;
+
+	ret = mutex_lock_interruptible(&f->lock);
+	if (ret)
+		return ret;
+
+	/* Only a video stream has a rate. */
+	if (f->kind == VIRTIO_VIDEO_CAMERA_STREAM_VIDEO && wanted.numerator &&
+	    wanted.denominator) {
+		u32 low, high, rate;
+
+		/* The device runs at a rate it has and says which. */
+		if (cam_rate_envelope(f->cam, f->pix.width, f->pix.height, &low,
+				      &high)) {
+			rate = clamp(DIV_ROUND_CLOSEST(wanted.denominator,
+						       wanted.numerator),
+				     low, high);
+			wanted.numerator = 1;
+			wanted.denominator = rate;
+		}
+		if (f->stream_id) {
+			u32 numerator, denominator;
+
+			/* What the stream keeps is what the device answers. */
+			ret = virtio_video_cam_cmd_set_interval(cam_vvd(f),
+								f->stream_id,
+								wanted.numerator,
+								wanted.denominator);
+			if (!ret)
+				ret = virtio_video_cam_cmd_get_interval(cam_vvd(f),
+									f->stream_id,
+									&numerator,
+									&denominator);
+			if (!ret) {
+				f->interval_numerator = numerator;
+				f->interval_denominator = denominator;
+			}
+		} else {
+			/* The stream's creation settles it with the device. */
+			f->interval_numerator = wanted.numerator;
+			f->interval_denominator = wanted.denominator;
+		}
+	}
+
+	memset(&parm->parm, 0, sizeof(parm->parm));
+	parm->parm.capture.capability = V4L2_CAP_TIMEPERFRAME;
+	parm->parm.capture.timeperframe.numerator = f->interval_numerator;
+	parm->parm.capture.timeperframe.denominator = f->interval_denominator;
+	mutex_unlock(&f->lock);
+
+	return ret;
+}
+
+/*
+ * The buffers a client asks for need the stream, and the buffers it gives back
+ * are forgotten by the device in the same call (the device holds 128 per
+ * stream, and a client that reallocates would run out).
+ */
+static int cam_free_buffers(struct virtio_video_cam_file *file, u32 memory)
+{
+	struct v4l2_requestbuffers none = {
+		.type = file->vq.type,
+		.memory = memory,
+	};
+	int ret;
+
+	if (!vb2_get_num_buffers(&file->vq))
+		return 0;
+
+	ret = vb2_reqbufs(&file->vq, &none);
+	if (ret)
+		return ret;
+	if (file->stream_id)
+		virtio_video_cam_cmd_clear(cam_vvd(file), file->stream_id,
+					   true);
+
+	return 0;
+}
+
+static int cam_reqbufs(struct file *file, void *fh,
+		       struct v4l2_requestbuffers *rb)
+{
+	struct virtio_video_cam_file *f = to_cam_file(file);
+	int ret;
+
+	ret = mutex_lock_interruptible(&f->lock);
+	if (ret)
+		return ret;
+
+	ret = cam_free_buffers(f, rb->memory);
+	if (ret)
+		goto out;
+	if (rb->count) {
+		ret = cam_stream_ensure(f);
+		if (ret)
+			goto out;
+	}
+	ret = vb2_reqbufs(&f->vq, rb);
+out:
+	mutex_unlock(&f->lock);
+
+	return ret;
+}
+
+static int cam_create_bufs(struct file *file, void *fh,
+			   struct v4l2_create_buffers *create)
+{
+	struct virtio_video_cam_file *f = to_cam_file(file);
+	int ret;
+
+	ret = mutex_lock_interruptible(&f->lock);
+	if (ret)
+		return ret;
+	ret = cam_stream_ensure(f);
+	if (!ret)
+		ret = vb2_create_bufs(&f->vq, create);
+	mutex_unlock(&f->lock);
+
+	return ret;
+}
+
+static int cam_querybuf(struct file *file, void *fh, struct v4l2_buffer *b)
+{
+	struct virtio_video_cam_file *f = to_cam_file(file);
+	int ret;
+
+	ret = mutex_lock_interruptible(&f->lock);
+	if (ret)
+		return ret;
+	ret = vb2_querybuf(&f->vq, b);
+	mutex_unlock(&f->lock);
+
+	return ret;
+}
+
+static int cam_prepare_buf(struct file *file, void *fh, struct v4l2_buffer *b)
+{
+	struct virtio_video_cam_file *f = to_cam_file(file);
+	int ret;
+
+	ret = mutex_lock_interruptible(&f->lock);
+	if (ret)
+		return ret;
+	ret = vb2_prepare_buf(&f->vq, NULL, b);
+	mutex_unlock(&f->lock);
+
+	return ret;
+}
+
+/*
+ * A still's group is in the buffer the client queues: a non-zero cookie in the
+ * timestamp's seconds, and V4L2_BUF_FLAG_LAST on the group's last buffer. vb2
+ * keeps neither on a capture queue, so they are read here, into the buffer, for
+ * the command that queues it.
+ */
+static int cam_qbuf(struct file *file, void *fh, struct v4l2_buffer *b)
+{
+	struct virtio_video_cam_file *f = to_cam_file(file);
+	struct vb2_buffer *vb;
+	int ret;
+
+	ret = mutex_lock_interruptible(&f->lock);
+	if (ret)
+		return ret;
+
+	vb = b->type == f->vq.type ? vb2_get_buffer(&f->vq, b->index) : NULL;
+	if (vb && vb->state == VB2_BUF_STATE_DEQUEUED) {
+		struct virtio_video_cam_buffer *buf = to_cam_buffer(vb);
+
+		buf->cookie = (u64)b->timestamp.tv_sec;
+		buf->group_more = buf->cookie && !(b->flags & V4L2_BUF_FLAG_LAST);
+	}
+	ret = vb2_qbuf(&f->vq, NULL, b);
+	mutex_unlock(&f->lock);
+
+	return ret;
+}
+
+static int cam_dqbuf(struct file *file, void *fh, struct v4l2_buffer *b)
+{
+	struct virtio_video_cam_file *f = to_cam_file(file);
+	int ret;
+
+	ret = mutex_lock_interruptible(&f->lock);
+	if (ret)
+		return ret;
+	/* vb2 releases the lock while it waits for a buffer. */
+	ret = vb2_dqbuf(&f->vq, b, file->f_flags & O_NONBLOCK);
+	mutex_unlock(&f->lock);
+
+	return ret;
+}
+
+static int cam_expbuf(struct file *file, void *fh, struct v4l2_exportbuffer *e)
+{
+	struct virtio_video_cam_file *f = to_cam_file(file);
+	int ret;
+
+	ret = mutex_lock_interruptible(&f->lock);
+	if (ret)
+		return ret;
+	ret = vb2_expbuf(&f->vq, e);
+	mutex_unlock(&f->lock);
+
+	return ret;
+}
+
+static int cam_streamon(struct file *file, void *fh, enum v4l2_buf_type type)
+{
+	struct virtio_video_cam_file *f = to_cam_file(file);
+	int ret;
+
+	ret = mutex_lock_interruptible(&f->lock);
+	if (ret)
+		return ret;
+	ret = vb2_streamon(&f->vq, type);
+	mutex_unlock(&f->lock);
+
+	return ret;
+}
+
+static int cam_streamoff(struct file *file, void *fh, enum v4l2_buf_type type)
+{
+	struct virtio_video_cam_file *f = to_cam_file(file);
+	int ret;
+
+	ret = mutex_lock_interruptible(&f->lock);
+	if (ret)
+		return ret;
+	ret = vb2_streamoff(&f->vq, type);
+	mutex_unlock(&f->lock);
+
+	return ret;
+}
+
+static const struct v4l2_ioctl_ops cam_capture_ioctl_ops = {
+	.vidioc_querycap = cam_querycap,
+	.vidioc_enum_fmt_vid_cap = cam_enum_fmt,
+	.vidioc_g_fmt_vid_cap_mplane = cam_g_fmt,
+	.vidioc_s_fmt_vid_cap_mplane = cam_s_fmt,
+	.vidioc_try_fmt_vid_cap_mplane = cam_try_fmt,
+	.vidioc_enum_framesizes = cam_enum_framesizes,
+	.vidioc_enum_frameintervals = cam_enum_frameintervals,
+	.vidioc_g_parm = cam_g_parm,
+	.vidioc_s_parm = cam_s_parm,
+	.vidioc_reqbufs = cam_reqbufs,
+	.vidioc_create_bufs = cam_create_bufs,
+	.vidioc_querybuf = cam_querybuf,
+	.vidioc_prepare_buf = cam_prepare_buf,
+	.vidioc_qbuf = cam_qbuf,
