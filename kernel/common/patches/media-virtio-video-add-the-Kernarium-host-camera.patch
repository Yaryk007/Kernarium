+static const struct v4l2_ioctl_ops cam_meta_ioctl_ops = {
+	.vidioc_querycap = cam_querycap,
+	.vidioc_enum_fmt_meta_cap = cam_meta_enum_fmt,
+	.vidioc_g_fmt_meta_cap = cam_meta_g_fmt,
+	.vidioc_s_fmt_meta_cap = cam_meta_try_fmt,
+	.vidioc_try_fmt_meta_cap = cam_meta_try_fmt,
+	.vidioc_reqbufs = cam_reqbufs,
+	.vidioc_create_bufs = cam_create_bufs,
+	.vidioc_querybuf = cam_querybuf,
+	.vidioc_prepare_buf = cam_prepare_buf,
+	.vidioc_qbuf = cam_qbuf,
+	.vidioc_dqbuf = cam_dqbuf,
+	.vidioc_expbuf = cam_expbuf,
+	.vidioc_streamon = cam_streamon,
+	.vidioc_streamoff = cam_streamoff,
+	.vidioc_subscribe_event = v4l2_ctrl_subscribe_event,
+	.vidioc_unsubscribe_event = v4l2_event_unsubscribe,
+};
