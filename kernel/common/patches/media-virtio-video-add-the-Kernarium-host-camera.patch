+/*
+ * Sends one command and waits for its answer, which is copied to `resp` for
+ * `resp_size` bytes; `resp_len` says how many of them the device wrote. The
+ * camera's commands use it, because each of them depends on the device's word
+ * that it took effect.
+ */
+int virtio_video_cmd_sync(struct virtio_video_device *vvd, const void *req,
+			  size_t req_size, void *resp, size_t resp_size,
+			  size_t *resp_len)
+{
+	struct virtio_video_vbuffer *vbuf;
+	struct virtio_video_answer answer = {};
+	void *buf;
+	int ret;
+
+	if (req_size > MAX_INLINE_CMD_SIZE)
+		return -EINVAL;
+
+	buf = virtio_video_alloc_req_resp(vvd, virtio_video_answer_cb, &vbuf,
+					  req_size, resp_size, resp);
+	if (IS_ERR(buf))
+		return PTR_ERR(buf);
+
+	memcpy(buf, req, req_size);
+	vbuf->priv = &answer;
+
+	ret = virtio_video_queue_cmd_buffer_sync(vvd, vbuf);
+	if (ret)
+		return ret;
+
+	if (resp_len)
+		*resp_len = answer.len;
+
+	return 0;
+}
