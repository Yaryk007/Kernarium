+/* ------------------------------------------------------------------------ */
+/* Files                                                                    */
+/* ------------------------------------------------------------------------ */
+
+static int cam_open(struct file *filp)
+{
+	struct video_device *vdev = video_devdata(filp);
+	struct virtio_video_cam_node *node =
+		container_of(vdev, struct virtio_video_cam_node, vdev);
+	struct virtio_video_camera *cam = node->cam;
+	struct virtio_video_cam_file *file;
+	int ret;
+
+	file = kzalloc(sizeof(*file), GFP_KERNEL);
+	if (!file)
+		return -ENOMEM;
+
+	file->cam = cam;
+	file->node = node;
+	mutex_init(&file->lock);
+	init_waitqueue_head(&file->idle);
+	atomic_set(&file->inflight, 0);
+	spin_lock_init(&file->park_lock);
+	INIT_LIST_HEAD(&file->parked);
+	INIT_LIST_HEAD(&file->entry);
+	file->interval_numerator = 1;
+	file->interval_denominator = 30;
+
+	if (node->type == CAM_NODE_CAPTURE) {
+		struct video_format *fmt =
+			virtio_video_cam_find_format(cam, V4L2_PIX_FMT_NV12) ?:
+			cam_nth_format(cam, 0);
+		u32 width = 0, height = 0;
+
+		if (!fmt) {
+			ret = -EIO;
+			goto err_free;
+		}
+		cam_default_size(fmt, &width, &height);
+		cam_fill_pix(&file->pix, fmt->desc.format, width, height);
+		file->kind = cam_kind_of(fmt->desc.format);
+		file->wire_format = cam_v4l2_to_wire(fmt->desc.format);
+		file->plane_size = file->pix.plane_fmt[0].sizeimage;
+	} else {
+		file->kind = VIRTIO_VIDEO_CAMERA_STREAM_META;
+		file->wire_format = VIRTIO_VIDEO_FORMAT_CAMERA_META;
+		file->meta_fmt.dataformat = V4L2_META_FMT_VIRTIO_CAMERA;
+		file->meta_fmt.buffersize = sizeof(struct virtio_video_camera_meta);
+		file->plane_size = sizeof(struct virtio_video_camera_meta);
+	}
+
+	ret = cam_init_queue(file);
+	if (ret)
+		goto err_free;
+
+	v4l2_fh_init(&file->fh, vdev);
+	file->fh.ctrl_handler = &cam->hdl;
+	filp->private_data = &file->fh;
+
+	mutex_lock(&cam->lock);
+	list_add_tail(&file->entry, &cam->files);
+	mutex_unlock(&cam->lock);
+	v4l2_fh_add(&file->fh, filp);
+
+	return 0;
+
+err_free:
+	mutex_destroy(&file->lock);
+	kfree(file);
+
+	return ret;
+}
+
+static int cam_release(struct file *filp)
+{
+	struct virtio_video_cam_file *file = to_cam_file(filp);
+	struct virtio_video_camera *cam = file->cam;
+
+	mutex_lock(&cam->lock);
+	list_del_init(&file->entry);
+	mutex_unlock(&cam->lock);
+
+	mutex_lock(&file->lock);
+	vb2_queue_release(&file->vq);
+	cam_stream_destroy(file);
+	mutex_unlock(&file->lock);
+
+	v4l2_fh_del(&file->fh, filp);
+	v4l2_fh_exit(&file->fh);
+	mutex_destroy(&file->lock);
+	kfree(file);
+
+	return 0;
+}
+
+static __poll_t cam_poll(struct file *filp, struct poll_table_struct *wait)
+{
+	struct virtio_video_cam_file *file = to_cam_file(filp);
+	__poll_t ret;
+
+	if (mutex_lock_interruptible(&file->lock))
+		return EPOLLERR;
+	ret = vb2_poll(&file->vq, filp, wait);
+	mutex_unlock(&file->lock);
+
+	return ret;
+}
+
+static int cam_mmap(struct file *filp, struct vm_area_struct *vma)
+{
+	struct virtio_video_cam_file *file = to_cam_file(filp);
+
+	return vb2_mmap(&file->vq, vma);
+}
+
+static const struct v4l2_file_operations cam_fops = {
+	.owner = THIS_MODULE,
+	.open = cam_open,
+	.release = cam_release,
+	.poll = cam_poll,
+	.unlocked_ioctl = video_ioctl2,
+	.mmap = cam_mmap,
+};
