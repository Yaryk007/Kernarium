+/* ------------------------------------------------------------------------ */
+/* Suspend, reset                                                           */
+/* ------------------------------------------------------------------------ */
+
+/*
+ * Stops a file's stream for a system suspend. The device then holds none of its
+ * buffers, and keeps the stream through the suspend; the video and metadata
+ * buffers it returned as failed wait for the resume.
+ */
+int virtio_video_cam_suspend_file(struct virtio_video_cam_file *file)
+{
+	int ret = 0;
+
+	if (!file->stream_id || !atomic_read(&file->inflight))
+		return 0;
+
+	WRITE_ONCE(file->parking, true);
+	cam_halt_stream(file);
+	cam_take_back(file, true);
+	WRITE_ONCE(file->parking, false);
+
+	return ret;
+}
+
+/*
+ * The device was reset and forgot the file's stream: make it again under the
+ * same ID, with the same format and buffers.
+ */
+void virtio_video_cam_restore_file(struct virtio_video_cam_file *file,
+				   bool reset)
+{
+	struct virtio_video_device *vvd = cam_vvd(file);
+	struct vb2_queue *q = &file->vq;
+	unsigned int i;
+	int ret;
+
+	if (!reset || !file->stream_id)
+		return;
+
+	ret = virtio_video_cam_cmd_stream_create(vvd, file->stream_id,
+						 file->cam->index, file->kind,
+						 "resume");
+	if (!ret)
+		ret = cam_stream_configure(file);
+
+	for (i = 0; !ret && i < q->max_num_buffers; i++) {
+		struct vb2_buffer *vb = vb2_get_buffer(q, i);
+		struct virtio_video_cam_buffer *buf;
+		u32 id;
+
+		if (!vb)
+			continue;
+		buf = to_cam_buffer(vb);
+		if (!buf->attached)
+			continue;
+		/* An imported buffer that is not queued has no mapping. */
+		if (vb->memory == VB2_MEMORY_DMABUF &&
+		    vb->state != VB2_BUF_STATE_ACTIVE) {
+			buf->attached = false;
+			continue;
+		}
+		id = buf->resource_id;
+		ret = virtio_video_attach_buffer(vvd, file->stream_id, vb, &id);
+	}
+
+	if (ret) {
+		v4l2_err(&vvd->v4l2_dev,
+			 "camera %u: cannot restore a stream after the reset (%d)\n",
+			 file->cam->index, ret);
+		vb2_queue_error(q);
+	}
+}
+
+/* Queues the buffers a suspend kept, in the order the client queued them. */
+void virtio_video_cam_requeue_file(struct virtio_video_cam_file *file)
+{
+	struct virtio_video_cam_buffer *buf;
+	unsigned long irq;
+
+	for (;;) {
+		spin_lock_irqsave(&file->park_lock, irq);
+		buf = list_first_entry_or_null(&file->parked,
+					       struct virtio_video_cam_buffer,
+					       parked);
+		if (buf)
+			list_del_init(&buf->parked);
+		spin_unlock_irqrestore(&file->park_lock, irq);
+		if (!buf)
+			return;
+
+		/* The suspend destroyed the stream these were attached to. */
+		if (!buf->attached && buf->resource_id) {
+			u32 id = buf->resource_id;
+
+			if (!cam_stream_ensure(file) &&
+			    !virtio_video_attach_buffer(cam_vvd(file),
+							file->stream_id,
+							&buf->vb.vb2_buf, &id))
+				buf->attached = true;
+		}
+		if (!buf->attached || cam_send_buffer(file, buf)) {
+			vb2_set_plane_payload(&buf->vb.vb2_buf, 0, 0);
+			vb2_buffer_done(&buf->vb.vb2_buf, VB2_BUF_STATE_ERROR);
+		}
+	}
+}
+
+/* ------------------------------------------------------------------------ */
+/* Nodes                                                                    */
+/* ------------------------------------------------------------------------ */
+
+static void cam_node_release(struct video_device *vdev)
+{
+	struct virtio_video_cam_node *node =
+		container_of(vdev, struct virtio_video_cam_node, vdev);
+
+	virtio_video_camera_put(node->cam->vvd);
+}
+
+static int cam_register_node(struct virtio_video_camera *cam,
+			     struct virtio_video_cam_node *node,
+			     enum virtio_video_cam_node_type type)
+{
+	struct video_device *vdev = &node->vdev;
+	struct virtio_video_device *vvd = cam->vvd;
+	int ret;
+
+	node->cam = cam;
+	node->type = type;
+	vdev->v4l2_dev = &vvd->v4l2_dev;
+	vdev->fops = &cam_fops;
+	vdev->release = cam_node_release;
+	vdev->vfl_dir = VFL_DIR_RX;
+	vdev->ctrl_handler = &cam->hdl;
+	/* The files lock themselves: each has its own queue. */
+	vdev->lock = NULL;
+	if (type == CAM_NODE_CAPTURE) {
+		vdev->ioctl_ops = &cam_capture_ioctl_ops;
+		vdev->device_caps = V4L2_CAP_VIDEO_CAPTURE_MPLANE |
+				    V4L2_CAP_STREAMING;
+	} else {
+		vdev->ioctl_ops = &cam_meta_ioctl_ops;
+		vdev->device_caps = V4L2_CAP_META_CAPTURE | V4L2_CAP_STREAMING;
+	}
+	snprintf(vdev->name, sizeof(vdev->name), "virtio-camera%u-%s",
+		 cam->index, type == CAM_NODE_CAPTURE ? "capture" : "meta");
+	video_set_drvdata(vdev, node);
+
+	/*
+	 * The node's release drops this reference, so it is taken before the
+	 * node exists. A registration that fails never calls the release.
+	 */
+	kref_get(&vvd->ref);
+	ret = video_register_device(vdev, VFL_TYPE_VIDEO,
+				    VIRTIO_VIDEO_CAMERA_FIRST_NODE);
+	if (ret) {
+		virtio_video_camera_put(vvd);
+		return ret;
+	}
+
+	/*
+	 * A free number is looked for upward from the first, and below it only
+	 * when none above is free; the codecs' nodes must never share the
+	 * range they are scanned in with a camera. Unregistering the node
+	 * releases it, which drops the reference.
+	 */
+	if (vdev->num < VIRTIO_VIDEO_CAMERA_FIRST_NODE) {
+		video_unregister_device(vdev);
+		return -ENODEV;
+	}
+
+	node->registered = true;
+
+	v4l2_info(&vvd->v4l2_dev, "camera %u: /dev/video%d (%s)\n", cam->index,
+		  vdev->num, type == CAM_NODE_CAPTURE ? "capture" : "metadata");
+
+	return 0;
+}
+
+int virtio_video_cam_register_nodes(struct virtio_video_camera *cam)
+{
+	int ret;
+
+	ret = cam_register_node(cam, &cam->capture, CAM_NODE_CAPTURE);
+	if (ret)
+		return ret;
+
+	ret = cam_register_node(cam, &cam->meta, CAM_NODE_META);
+	if (ret)
+		virtio_video_cam_unregister_nodes(cam);
+
+	return ret;
+}
+
+void virtio_video_cam_unregister_nodes(struct virtio_video_camera *cam)
+{
+	if (cam->meta.registered) {
+		cam->meta.registered = false;
+		video_unregister_device(&cam->meta.vdev);
+	}
+	if (cam->capture.registered) {
+		cam->capture.registered = false;
+		video_unregister_device(&cam->capture.vdev);
+	}
+}
diff --git a/drivers/media/virtio/virtio_video_camera.h b/drivers/media/virtio/virtio_video_camera.h
new file mode 100644
index 0000000000000000000000000000000000000000..e1547651ce3cfc9228ad503ca3cfa460dcf806fa
--- /dev/null
+++ b/drivers/media/virtio/virtio_video_camera.h
@@ -0,0 +1,233 @@
+/* SPDX-License-Identifier: GPL-2.0+ */
+/*
+ * The Virtio camera: a capture node and a metadata node for each camera of the
+ * host, both on the stream and buffer machinery of the codecs.
+ *
+ * Locking, outermost first:
+ *   file->lock       one open file's ioctls and its vb2 queue (q->lock).
+ *   camera->lock     the camera's list of open files; suspend and resume.
+ *   camera->hdl      the control handler's lock, shared by the camera's files.
+ *   camera->carrier_lock   the control carrier stream.
+ * The command queue's lock is innermost: a response callback runs under it
+ * with interrupts off, so it only completes vb2 buffers and never sends a
+ * command.
+ */
+#ifndef _VIRTIO_VIDEO_CAMERA_H
+#define _VIRTIO_VIDEO_CAMERA_H
+
+#include <linux/kref.h>
+#include <linux/mutex.h>
+#include <linux/spinlock.h>
+#include <linux/wait.h>
+#include <media/v4l2-ctrls.h>
+#include <media/v4l2-fh.h>
+#include <media/videobuf2-v4l2.h>
+
+#include "virtio_video.h"
+
+/*
+ * The first V4L2 minor of a camera node. The codec nodes stay below it: the
+ * Android codec2 V4L2 device scans only /dev/video0 to 9, and ten camera nodes
+ * must not push the decoder and the encoder out of that window.
+ */
+#define VIRTIO_VIDEO_CAMERA_FIRST_NODE 10
+
+/* The metadata format: the device's struct virtio_video_camera_meta. */
+#define V4L2_META_FMT_VIRTIO_CAMERA v4l2_fourcc('V', 'C', 'A', 'M')
+
+/* The bytes the device reserves in a JPEG still for the Exif segment. */
+#define VIRTIO_VIDEO_CAMERA_EXIF_GAP 65000
+
+/*
+ * The most a plane may hold: the device refuses a resource larger than this
+ * (darwin/device/video/guest_buffers.cpp), so a stream that reports more is
+ * one it cannot serve.
+ */
+#define VIRTIO_VIDEO_CAMERA_MAX_PLANE_SIZE (128U << 20)
+
+/*
+ * The buffers of every kind (frames, stills and metadata) and of every camera
+ * that the device may hold at once. Each takes two descriptors of the command
+ * queue's 256, and a client that queues without end, as several metadata
+ * files can, would leave no room for a command, whose wait for room has no
+ * end: 64 descriptors stay for commands. The HAL queues at most 16 metadata
+ * buffers and two for each of the five streams Android allows (a camera in use
+ * holds 26), so three cameras at once hold 78.
+ */
+#define VIRTIO_VIDEO_CAMERA_MAX_QUEUED 96
+
+enum virtio_video_cam_node_type {
+	CAM_NODE_CAPTURE,
+	CAM_NODE_META,
+};
+
+struct virtio_video_camera;
+
+struct virtio_video_cam_node {
+	struct video_device vdev;
+	struct virtio_video_camera *cam;
+	enum virtio_video_cam_node_type type;
+	bool registered;
+};
+
+/* A control the device lists, and the order in which the guest wrote it. */
+struct virtio_video_cam_ctrl {
+	struct v4l2_ctrl *ctrl;
+	struct video_v4l2_control desc;
+	u64 written;
+};
+
+struct virtio_video_camera {
+	struct virtio_video_device *vvd;
+	u32 index;
+	/* The device's struct virtio_video_camera_desc, as it came. */
+	u8 desc_raw[sizeof(struct virtio_video_camera_desc)];
+	bool blocked;
+
+	struct virtio_video_cam_node capture;
+	struct virtio_video_cam_node meta;
+
+	struct mutex lock;
+	struct list_head files;
+
+	/* The formats of video streams and of still streams. */
+	struct list_head video_formats;
+	struct list_head still_formats;
+
+	/*
+	 * The sequence the next frame, still or record may carry at the least,
+	 * and what a reset of the device adds to the sequences it counts again
+	 * from zero, so that the sequences of a camera never go back.
+	 */
+	atomic_t seq_next;
+	atomic_t seq_offset;
+
+	struct v4l2_ctrl_handler hdl;
+	struct virtio_video_cam_ctrl *ctrls;
+	unsigned int num_ctrls;
+	/* Under the handler's lock: how many writes the guest has made. */
+	u64 writes;
+
+	/*
+	 * The control carrier: a metadata stream that carries the controls'
+	 * commands, because the device takes them through a stream of the camera
+	 * and a file may have none (a torch needs no stream). Created on first
+	 * use and never given a buffer. 0 until then.
+	 */
+	struct mutex carrier_lock;
+	u32 carrier_id;
+};
+
+/* One open file of a node. */
+struct virtio_video_cam_file {
+	struct v4l2_fh fh;
+	struct virtio_video_camera *cam;
+	struct virtio_video_cam_node *node;
+	struct vb2_queue vq;
+	struct mutex lock;
+	/* In camera->files, under camera->lock. */
+	struct list_head entry;
+
+	/* The host stream, 0 while the file has none. */
+	u32 stream_id;
+	u32 kind;
+	u32 wire_format;
+
+	/* The format, with the layout the device reported once it has one. */
+	struct v4l2_pix_format_mplane pix;
+	struct v4l2_meta_format meta_fmt;
+	u32 plane_size;
+	u32 interval_numerator;
+	u32 interval_denominator;
+
+	/* The sequence after the last buffer the device answered. */
+	u32 sequence;
+
+	/* Buffers handed to the device whose answer has not come. */
+	atomic_t inflight;
+	wait_queue_head_t idle;
+	/* Set while a suspend stops the stream: failed buffers are kept. */
+	bool parking;
+	spinlock_t park_lock;
+	struct list_head parked;
+};
+
+struct virtio_video_cam_buffer {
+	struct vb2_v4l2_buffer vb;
+	/* The pending RESOURCE_QUEUE, for virtio_video_cmd_orphan(). */
+	struct virtio_video_vbuffer *cmd;
+	struct list_head parked;
+	u32 resource_id;
+	bool attached;
+	/* A still's group: the guest's cookie and whether more members follow. */
+	u64 cookie;
+	bool group_more;
+};
+
+static inline struct virtio_video_cam_file *to_cam_file(struct file *file)
+{
+	return container_of(file->private_data, struct virtio_video_cam_file,
+			    fh);
+}
+
+static inline struct virtio_video_cam_buffer *
+to_cam_buffer(struct vb2_buffer *vb)
+{
+	return container_of(to_vb2_v4l2_buffer(vb),
+			    struct virtio_video_cam_buffer, vb);
+}
+
+/* virtio_video_camera_dev.c */
+struct virtio_video_camera *
+virtio_video_cam_find(struct virtio_video_device *vvd, u32 index);
+
+/* virtio_video_camera.c */
+int virtio_video_cam_register_nodes(struct virtio_video_camera *cam);
+void virtio_video_cam_unregister_nodes(struct virtio_video_camera *cam);
+void virtio_video_cam_restore_file(struct virtio_video_cam_file *file,
+				   bool reset);
+int virtio_video_cam_suspend_file(struct virtio_video_cam_file *file);
+void virtio_video_cam_requeue_file(struct virtio_video_cam_file *file);
+struct video_format *virtio_video_cam_find_format(struct virtio_video_camera *cam,
+						  u32 pixelformat);
+
+/* virtio_video_camera_ctrl.c */
+int virtio_video_cam_ctrls_init(struct virtio_video_camera *cam);
+void virtio_video_cam_ctrls_free(struct virtio_video_camera *cam);
+int virtio_video_cam_carrier(struct virtio_video_camera *cam, u32 *stream_id);
+int virtio_video_cam_ctrls_reapply(struct virtio_video_camera *cam);
+
+/* virtio_video_camera_cmd.c: the camera's own commands. */
+int virtio_video_cam_cmd_query(struct virtio_video_device *vvd, u32 start,
+			       void *resp, size_t resp_size, size_t *len);
+int virtio_video_cam_cmd_query_formats(struct virtio_video_device *vvd,
+				       u32 camera, u32 kind, void *resp,
+				       size_t resp_size);
+int virtio_video_cam_cmd_query_controls(struct virtio_video_device *vvd,
+					u32 camera, u32 start, void *resp,
+					size_t resp_size, size_t *len);
+int virtio_video_cam_cmd_stream_create(struct virtio_video_device *vvd,
+				       u32 stream_id, u32 camera, u32 kind,
+				       const char *tag);
+int virtio_video_cam_cmd_set_params(struct virtio_video_device *vvd,
+				    u32 stream_id,
+				    const struct virtio_video_params *params);
+int virtio_video_cam_cmd_get_params(struct virtio_video_device *vvd,
+				    u32 stream_id,
+				    struct virtio_video_params *params);
+int virtio_video_cam_cmd_clear(struct virtio_video_device *vvd, u32 stream_id,
+			       bool detach);
+int virtio_video_cam_cmd_set_interval(struct virtio_video_device *vvd,
+				      u32 stream_id, u32 numerator,
+				      u32 denominator);
+int virtio_video_cam_cmd_get_interval(struct virtio_video_device *vvd,
+				      u32 stream_id, u32 *numerator,
+				      u32 *denominator);
+int virtio_video_cam_cmd_queue(struct virtio_video_device *vvd, u32 stream_id,
+			       struct virtio_video_cam_buffer *buf);
+
+/* The completion of a RESOURCE_QUEUE, run under the command queue's lock. */
+void virtio_video_cam_complete(struct virtio_video_cam_buffer *buf,
+			       const struct virtio_video_camera_queue_resp *resp);
+
+#endif /* _VIRTIO_VIDEO_CAMERA_H */
diff --git a/drivers/media/virtio/virtio_video_camera_cmd.c b/drivers/media/virtio/virtio_video_camera_cmd.c
new file mode 100644
index 0000000000000000000000000000000000000000..c5d7f6225770347ee09d8bbda04f9724fbc94483
--- /dev/null
+++ b/drivers/media/virtio/virtio_video_camera_cmd.c
@@ -0,0 +1,290 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * The Virtio camera's commands.
+ *
+ * The camera takes the codecs' stream commands for everything but its queries
+ * and the creation of a stream, and it answers each of them, so the driver
+ * waits for the answer wherever it depends on the device's word that the
+ * command took effect. The one command that does not wait is the one that
+ * hands the device a buffer: its answer is the frame.
+ */
+#include "virtio_video_camera.h"
+
+static int cam_cmd_status(const void *resp, size_t len, size_t want,
+			  u32 type_ok)
+{
+	const struct virtio_video_cmd_hdr *hdr = resp;
+	u32 type;
+
+	if (len < sizeof(*hdr))
+		return -EIO;
+
+	type = le32_to_cpu(hdr->type);
+	if (type != type_ok)
+		return virtio_video_resp_errno(type) ?: -EIO;
+	if (len < want)
+		return -EIO;
+
+	return 0;
+}
+
+/* Sends a command that is answered with a bare header. */
+static int cam_cmd_nodata(struct virtio_video_device *vvd, const void *req,
+			  size_t size)
+{
+	struct virtio_video_cmd_hdr resp = {};
+	size_t len = 0;
+	int ret;
+
+	ret = virtio_video_cmd_sync(vvd, req, size, &resp, sizeof(resp), &len);
+	if (ret)
+		return ret;
+
+	return cam_cmd_status(&resp, len, sizeof(resp),
+			      VIRTIO_VIDEO_RESP_OK_NODATA);
+}
+
+int virtio_video_cam_cmd_query(struct virtio_video_device *vvd, u32 start,
+			       void *resp, size_t resp_size, size_t *len)
+{
+	struct virtio_video_camera_query req = {
+		.hdr.type = cpu_to_le32(VIRTIO_VIDEO_CMD_CAMERA_QUERY),
+		.start_index = cpu_to_le32(start),
+	};
+	int ret;
+
+	ret = virtio_video_cmd_sync(vvd, &req, sizeof(req), resp, resp_size,
+				    len);
+	if (ret)
+		return ret;
+
+	return cam_cmd_status(resp, *len,
+			      sizeof(struct virtio_video_camera_query_resp),
+			      VIRTIO_VIDEO_RESP_OK_CAMERA_QUERY);
+}
+
+int virtio_video_cam_cmd_query_formats(struct virtio_video_device *vvd,
+				       u32 camera, u32 kind, void *resp,
+				       size_t resp_size)
+{
+	struct virtio_video_camera_query_formats req = {
+		.hdr.type = cpu_to_le32(VIRTIO_VIDEO_CMD_CAMERA_QUERY_FORMATS),
+		.camera_index = cpu_to_le32(camera),
+		.kind = cpu_to_le32(kind),
+	};
+	size_t len = 0;
+	int ret;
+
+	ret = virtio_video_cmd_sync(vvd, &req, sizeof(req), resp, resp_size,
+				    &len);
+	if (ret)
+		return ret;
+
+	return cam_cmd_status(resp, len,
+			      sizeof(struct virtio_video_query_capability_resp),
+			      VIRTIO_VIDEO_RESP_OK_QUERY_CAPABILITY);
+}
+
+int virtio_video_cam_cmd_query_controls(struct virtio_video_device *vvd,
+					u32 camera, u32 start, void *resp,
+					size_t resp_size, size_t *len)
+{
+	struct virtio_video_camera_query_controls req = {
+		.hdr.type = cpu_to_le32(VIRTIO_VIDEO_CMD_CAMERA_QUERY_CONTROLS),
+		.camera_index = cpu_to_le32(camera),
+		.start_index = cpu_to_le32(start),
+	};
+	int ret;
+
+	ret = virtio_video_cmd_sync(vvd, &req, sizeof(req), resp, resp_size,
+				    len);
+	if (ret)
+		return ret;
+
+	return cam_cmd_status(resp, *len,
+			      sizeof(struct virtio_video_query_v4l2_controls_resp),
+			      VIRTIO_VIDEO_RESP_OK_QUERY_V4L2_CONTROLS);
+}
+
+int virtio_video_cam_cmd_stream_create(struct virtio_video_device *vvd,
+				       u32 stream_id, u32 camera, u32 kind,
+				       const char *tag)
+{
+	struct virtio_video_camera_stream_create req = {
+		.hdr.type = cpu_to_le32(VIRTIO_VIDEO_CMD_CAMERA_STREAM_CREATE),
+		.hdr.stream_id = cpu_to_le32(stream_id),
+		.camera_index = cpu_to_le32(camera),
+		.kind = cpu_to_le32(kind),
+	};
+
+	strscpy((char *)req.tag, tag, sizeof(req.tag));
+
+	return cam_cmd_nodata(vvd, &req, sizeof(req));
+}
+
+int virtio_video_cam_cmd_set_params(struct virtio_video_device *vvd,
+				    u32 stream_id,
+				    const struct virtio_video_params *params)
+{
+	struct virtio_video_set_params req = {
+		.hdr.type = cpu_to_le32(VIRTIO_VIDEO_CMD_SET_PARAMS),
+		.hdr.stream_id = cpu_to_le32(stream_id),
+		.params = *params,
+	};
+
+	return cam_cmd_nodata(vvd, &req, sizeof(req));
+}
+
+/*
+ * Reads a stream's parameters. -ENOENT says the device has no such stream,
+ * which is how a driver finds that the device was reset.
+ */
+int virtio_video_cam_cmd_get_params(struct virtio_video_device *vvd,
+				    u32 stream_id,
+				    struct virtio_video_params *params)
+{
+	struct virtio_video_get_params req = {
+		.hdr.type = cpu_to_le32(VIRTIO_VIDEO_CMD_GET_PARAMS),
+		.hdr.stream_id = cpu_to_le32(stream_id),
+		.queue_type = cpu_to_le32(VIRTIO_VIDEO_QUEUE_TYPE_OUTPUT),
+	};
+	struct virtio_video_get_params_resp resp = {};
+	size_t len = 0;
+	int ret;
+
+	ret = virtio_video_cmd_sync(vvd, &req, sizeof(req), &resp,
+				    sizeof(resp), &len);
+	if (ret)
+		return ret;
+
+	ret = cam_cmd_status(&resp, len, sizeof(resp),
+			     VIRTIO_VIDEO_RESP_OK_GET_PARAMS);
+	if (ret)
+		return ret;
+
+	*params = resp.params;
+
+	return 0;
+}
+
+/*
+ * Stops a stream's capture and completes what it holds as failed
+ * (QUEUE_CLEAR); the completions follow the answer. With `detach` the stream
+ * also forgets the buffers it was given.
+ */
+int virtio_video_cam_cmd_clear(struct virtio_video_device *vvd, u32 stream_id,
+			       bool detach)
+{
+	if (detach) {
+		struct virtio_video_queue_detach_resources req = {
+			.cmd_type = cpu_to_le32(VIRTIO_VIDEO_CMD_QUEUE_DETACH_RESOURCES),
+			.stream_id = cpu_to_le32(stream_id),
+			.queue_type = cpu_to_le32(VIRTIO_VIDEO_QUEUE_TYPE_OUTPUT),
+		};
+
+		return cam_cmd_nodata(vvd, &req, sizeof(req));
+	} else {
+		struct virtio_video_queue_clear req = {
+			.hdr.type = cpu_to_le32(VIRTIO_VIDEO_CMD_QUEUE_CLEAR),
+			.hdr.stream_id = cpu_to_le32(stream_id),
+			.queue_type = cpu_to_le32(VIRTIO_VIDEO_QUEUE_TYPE_OUTPUT),
+		};
+
+		return cam_cmd_nodata(vvd, &req, sizeof(req));
+	}
+}
+
+int virtio_video_cam_cmd_set_interval(struct virtio_video_device *vvd,
+				      u32 stream_id, u32 numerator,
+				      u32 denominator)
+{
+	struct virtio_video_set_stream_info req = {
+		.hdr.type = cpu_to_le32(VIRTIO_VIDEO_CMD_SET_STREAM_INFO),
+		.hdr.stream_id = cpu_to_le32(stream_id),
+		.info.queue_type = cpu_to_le32(VIRTIO_VIDEO_QUEUE_TYPE_OUTPUT),
+		.info.frame_interval_numerator = cpu_to_le32(numerator),
+		.info.frame_interval_denominator = cpu_to_le32(denominator),
+	};
+
+	return cam_cmd_nodata(vvd, &req, sizeof(req));
+}
+
+int virtio_video_cam_cmd_get_interval(struct virtio_video_device *vvd,
+				      u32 stream_id, u32 *numerator,
+				      u32 *denominator)
+{
+	struct virtio_video_get_stream_info req = {
+		.hdr.type = cpu_to_le32(VIRTIO_VIDEO_CMD_GET_STREAM_INFO),
+		.hdr.stream_id = cpu_to_le32(stream_id),
+		.queue_type = cpu_to_le32(VIRTIO_VIDEO_QUEUE_TYPE_OUTPUT),
+	};
+	struct virtio_video_get_stream_info_resp resp = {};
+	size_t len = 0;
+	int ret;
+
+	ret = virtio_video_cmd_sync(vvd, &req, sizeof(req), &resp,
+				    sizeof(resp), &len);
+	if (ret)
+		return ret;
+
+	ret = cam_cmd_status(&resp, len, sizeof(resp),
+			     VIRTIO_VIDEO_RESP_OK_STREAM_INFO);
+	if (ret)
+		return ret;
+
+	*numerator = le32_to_cpu(resp.info.frame_interval_numerator);
+	*denominator = le32_to_cpu(resp.info.frame_interval_denominator);
+
+	return 0;
+}
+
+/*
+ * The answer to a RESOURCE_QUEUE is the buffer's frame, so the driver does not
+ * wait for it; the callback hands the buffer back to vb2. The command points
+ * the buffer at itself while it is pending, which lets the buffer's owner take
+ * it back and stop the callback reaching a buffer that is gone.
+ */
+static void cam_queue_cb(struct virtio_video_device *vvd,
+			 struct virtio_video_vbuffer *vbuf)
+{
+	const struct virtio_video_camera_queue_resp *resp = (void *)vbuf->resp_buf;
+	struct virtio_video_cam_buffer *buf = vbuf->priv;
+
+	/* The buffer was taken back: nothing waits for the answer. */
+	if (!buf)
+		return;
+
+	if (vbuf->resp_len < sizeof(*resp) ||
+	    le32_to_cpu(resp->base.hdr.type) !=
+	    VIRTIO_VIDEO_RESP_OK_RESOURCE_QUEUE)
+		resp = NULL;
+
+	virtio_video_cam_complete(buf, resp);
+}
+
+int virtio_video_cam_cmd_queue(struct virtio_video_device *vvd, u32 stream_id,
+			       struct virtio_video_cam_buffer *buf)
+{
+	struct virtio_video_resource_queue *req;
+	struct virtio_video_vbuffer *vbuf;
+
+	req = virtio_video_alloc_req_resp(vvd, cam_queue_cb, &vbuf,
+					  sizeof(*req),
+					  sizeof(struct virtio_video_camera_queue_resp),
+					  NULL);
+	if (IS_ERR(req))
+		return PTR_ERR(req);
+
+	req->cmd_type = cpu_to_le32(VIRTIO_VIDEO_CMD_RESOURCE_QUEUE);
+	req->stream_id = cpu_to_le32(stream_id);
+	req->queue_type = cpu_to_le32(VIRTIO_VIDEO_QUEUE_TYPE_OUTPUT);
+	req->resource_id = cpu_to_le32(buf->resource_id);
+	if (buf->group_more)
+		req->flags = cpu_to_le32(VIRTIO_VIDEO_CAMERA_QUEUE_F_GROUP_MORE);
+	req->timestamp = cpu_to_le64(buf->cookie);
+
+	vbuf->priv = buf;
+	vbuf->owner = &buf->cmd;
+
+	return virtio_video_queue_cmd_buffer(vvd, vbuf);
+}
diff --git a/drivers/media/virtio/virtio_video_camera_ctrl.c b/drivers/media/virtio/virtio_video_camera_ctrl.c
new file mode 100644
index 0000000000000000000000000000000000000000..ba252c4ade1471f6a6da357fbbc383fcef2d01cf
--- /dev/null
+++ b/drivers/media/virtio/virtio_video_camera_ctrl.c
@@ -0,0 +1,568 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * The Virtio camera's V4L2 controls.
+ *
+ * The device lists the controls of each camera with their type, range, step,
+ * default, menu skip mask and flags, and the driver registers that list as the
+ * device describes it, for every file of the camera's two nodes: one control
+ * handler per camera. A control this kernel has no name or menu for is left
+ * out, so a newer device never makes an older driver refuse to probe. A menu's
+ * skipped values fail with EINVAL and an integer is clamped to its range by the
+ * framework, as the device would have it.
+ *
+ * The device takes a camera's controls through a stream of the camera, and
+ * applies them asynchronously, not per request. A file need not have a stream
+ * (a torch needs none), so the controls travel on a stream of their own, the
+ * control carrier, which the driver creates on first use. Two controls come
+ * from the driver and not from the device: the read-only privacy control, set
+ * when the session starts blocked, and the camera's description.
+ *
+ * A device reset takes the values the device held. The driver remembers in
+ * which order the guest wrote each control and writes them again, in that
+ * order, after a reset; it does not write the controls the guest never did
+ * (focus, for one, moves the lens only once it was written).
+ */
+#include "virtio_video_camera.h"
+
+/* More controls than this are not a camera's. */
+#define VIRTIO_VIDEO_CAM_MAX_CTRLS 256
+/* The most a compound control carries, in bytes. */
+#define VIRTIO_VIDEO_CAM_MAX_COMPOUND 64
+
+static const char * const cam_still_flash_menu[] = {
+	"Off", "Automatic", "On", NULL,
+};
+
+static const char * const cam_rotate_menu[] = {
+	"None", "90 Degrees", "180 Degrees", "270 Degrees", "Automatic", NULL,
+};
+
+static const char * const cam_test_pattern_menu[] = {
+	"Disabled", "Test Pattern", NULL,
+};
+
+struct cam_private_ctrl {
+	u32 id;
+	const char *name;
+	const char * const *menu;
+};
+
+static const struct cam_private_ctrl cam_private_ctrls[] = {
+	{ VIRTIO_VIDEO_CAMERA_CID_EXPOSURE_NS, "Exposure Time, Nanoseconds" },
+	{ VIRTIO_VIDEO_CAMERA_CID_ISO, "ISO Sensitivity, Device" },
+	{ VIRTIO_VIDEO_CAMERA_CID_WB_GAIN_RED, "White Balance Gain, Red" },
+	{ VIRTIO_VIDEO_CAMERA_CID_WB_GAIN_GREEN, "White Balance Gain, Green" },
+	{ VIRTIO_VIDEO_CAMERA_CID_WB_GAIN_BLUE, "White Balance Gain, Blue" },
+	{ VIRTIO_VIDEO_CAMERA_CID_ZOOM_Q16, "Zoom Ratio, Q16" },
+	{ VIRTIO_VIDEO_CAMERA_CID_AE_REGION, "Auto Exposure Region" },
+	{ VIRTIO_VIDEO_CAMERA_CID_AF_REGION, "Auto Focus Region" },
+	{ VIRTIO_VIDEO_CAMERA_CID_STILL_FLASH, "Still Flash",
+	  cam_still_flash_menu },
+	{ VIRTIO_VIDEO_CAMERA_CID_ROTATE_AND_CROP, "Rotate and Crop",
+	  cam_rotate_menu },
+	{ VIRTIO_VIDEO_CAMERA_CID_DESCRIPTION, "Camera Description" },
+};
+
+static const struct cam_private_ctrl *cam_private(u32 id)
+{
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(cam_private_ctrls); i++)
+		if (cam_private_ctrls[i].id == id)
+			return &cam_private_ctrls[i];
+
+	return NULL;
+}
+
+static const char *cam_ctrl_name(u32 id)
+{
+	const struct cam_private_ctrl *p = cam_private(id);
+
+	return p ? p->name : v4l2_ctrl_get_name(id);
+}
+
+/* The menu's names, or NULL if this kernel has none for the control. */
+static const char * const *cam_ctrl_menu(u32 id, unsigned int *items)
+{
+	const struct cam_private_ctrl *p = cam_private(id);
+	const char * const *menu;
+
+	if (p)
+		menu = p->menu;
+	else if (id == V4L2_CID_TEST_PATTERN)
+		menu = cam_test_pattern_menu;
+	else
+		menu = v4l2_ctrl_get_menu(id);
+	if (!menu)
+		return NULL;
+
+	for (*items = 0; menu[*items]; (*items)++)
+		;
+
+	return menu;
+}
+
+/* Whether the device's description of a control can be registered. */
+static bool cam_ctrl_usable(const struct video_v4l2_control *c)
+{
+	unsigned int items;
+
+	if (!cam_ctrl_name(c->id))
+		return false;
+
+	/* The driver reads a volatile control as a number, never a compound. */
+	if (c->type == V4L2_CTRL_TYPE_U32 &&
+	    (c->flags & VIRTIO_VIDEO_V4L2_CTRL_F_VOLATILE))
+		return false;
+
+	switch (c->type) {
+	case V4L2_CTRL_TYPE_INTEGER:
+		/* The framework keeps an integer control in 32 bits. */
+		return c->minimum <= c->maximum && c->maximum >= S32_MIN &&
+		       c->minimum <= S32_MAX &&
+		       c->default_value >= c->minimum &&
+		       c->default_value <= c->maximum;
+	case V4L2_CTRL_TYPE_INTEGER64:
+		return c->minimum <= c->maximum &&
+		       c->default_value >= c->minimum &&
+		       c->default_value <= c->maximum;
+	case V4L2_CTRL_TYPE_BOOLEAN:
+		return c->default_value == 0 || c->default_value == 1;
+	case V4L2_CTRL_TYPE_BUTTON:
+		return true;
+	case V4L2_CTRL_TYPE_BITMASK:
+		return !c->step && !c->minimum && c->maximum > 0 &&
+		       c->maximum <= U32_MAX &&
+		       !(c->default_value & ~c->maximum);
+	case V4L2_CTRL_TYPE_MENU:
+		if (!cam_ctrl_menu(c->id, &items) || c->minimum != 0 ||
+		    c->maximum < 0 || c->maximum >= items ||
+		    c->maximum >= BITS_PER_LONG_LONG ||
+		    c->default_value < 0 || c->default_value > c->maximum ||
+		    (c->menu_skip_mask & BIT_ULL(c->default_value)))
+			return false;
+		return true;
+	case V4L2_CTRL_TYPE_U32:
+		return c->elem_size && !(c->elem_size % 4) &&
+		       c->elem_size <= VIRTIO_VIDEO_CAM_MAX_COMPOUND;
+	default:
+		return false;
+	}
+}
+
+/* ------------------------------------------------------------------------ */
+/* The control carrier                                                      */
+/* ------------------------------------------------------------------------ */
+
+static int cam_carrier_create(struct virtio_video_camera *cam, u32 id)
+{
+	return virtio_video_cam_cmd_stream_create(cam->vvd, id, cam->index,
+						  VIRTIO_VIDEO_CAMERA_STREAM_META,
+						  "controls");
+}
+
+/* The stream the camera's control commands travel on. */
+int virtio_video_cam_carrier(struct virtio_video_camera *cam, u32 *stream_id)
+{
+	struct virtio_video_device *vvd = cam->vvd;
+	uint32_t id;
+	int ret = 0;
+
+	mutex_lock(&cam->carrier_lock);
+	if (!cam->carrier_id) {
+		virtio_video_stream_id_get(vvd, cam, &id);
+		if ((int)id <= 0) {
+			ret = -ENOMEM;
+		} else {
+			ret = cam_carrier_create(cam, id);
+			if (ret)
+				virtio_video_stream_id_put(vvd, id);
+			else
+				cam->carrier_id = id;
+		}
+	}
+	*stream_id = cam->carrier_id;
+	mutex_unlock(&cam->carrier_lock);
+
+	return ret;
+}
+
+/* The device was reset and forgot the carrier: make it again. */
+static int cam_carrier_restore(struct virtio_video_camera *cam)
+{
+	int ret = 0;
+
+	mutex_lock(&cam->carrier_lock);
+	if (cam->carrier_id)
+		ret = cam_carrier_create(cam, cam->carrier_id);
+	mutex_unlock(&cam->carrier_lock);
+
+	return ret;
+}
+
+/* ------------------------------------------------------------------------ */
+/* Values                                                                   */
+/* ------------------------------------------------------------------------ */
+
+/* Writes one control to the device, from the handler's new value. */
+static int cam_write_ctrl(struct virtio_video_camera *cam,
+			  struct v4l2_ctrl *ctrl, bool current_value)
+{
+	union v4l2_ctrl_ptr ptr = current_value ? ctrl->p_cur : ctrl->p_new;
+	__le32 words[VIRTIO_VIDEO_CAM_MAX_COMPOUND / 4];
+	u32 stream_id;
+	int64_t value;
+	int ret;
+
+	ret = virtio_video_cam_carrier(cam, &stream_id);
+	if (ret)
+		return ret;
+
+	if (ctrl->type == V4L2_CTRL_TYPE_U32) {
+		unsigned int i, n = ctrl->elems;
+
+		if (n > ARRAY_SIZE(words))
+			return -EINVAL;
+		for (i = 0; i < n; i++)
+			words[i] = cpu_to_le32(ptr.p_u32[i]);
+		return virtio_video_cmd_set_v4l2_control(cam->vvd, stream_id,
+							 ctrl->id, 0, words,
+							 n * sizeof(__le32));
+	}
+
+	if (ctrl->type == V4L2_CTRL_TYPE_BUTTON)
+		value = 1;
+	else if (ctrl->type == V4L2_CTRL_TYPE_INTEGER64)
+		value = *ptr.p_s64;
+	else
+		value = *ptr.p_s32;
+
+	return virtio_video_cmd_set_v4l2_control(cam->vvd, stream_id, ctrl->id,
+						 value, NULL, 0);
+}
+
+static int cam_s_ctrl(struct v4l2_ctrl *ctrl)
+{
+	struct virtio_video_camera *cam =
+		container_of(ctrl->handler, struct virtio_video_camera, hdl);
+	struct virtio_video_cam_ctrl *cc = ctrl->priv;
+	int ret;
+
+	ret = cam_write_ctrl(cam, ctrl, false);
+	if (ret)
+		return ret;
+
+	/* A button has no value to put back after a reset. */
+	if (ctrl->type != V4L2_CTRL_TYPE_BUTTON)
+		cc->written = ++cam->writes;
+
+	return 0;
+}
+
+static int cam_g_volatile_ctrl(struct v4l2_ctrl *ctrl)
+{
+	struct virtio_video_camera *cam =
+		container_of(ctrl->handler, struct virtio_video_camera, hdl);
+	u32 stream_id;
+	int64_t value = 0;
+	int ret;
+
+	ret = virtio_video_cam_carrier(cam, &stream_id);
+	if (ret)
+		return ret;
+
+	ret = virtio_video_cmd_get_v4l2_control(cam->vvd, stream_id, ctrl->id,
+						&value, NULL, 0);
+	if (ret)
+		return ret;
+
+	value = clamp_t(s64, value, ctrl->minimum, ctrl->maximum);
+	/* A 64-bit control keeps its value in the data area, not in val. */
+	if (ctrl->type == V4L2_CTRL_TYPE_INTEGER64)
+		*ctrl->p_new.p_s64 = value;
+	else
+		*ctrl->p_new.p_s32 = value;
+
+	return 0;
+}
+
+static const struct v4l2_ctrl_ops cam_ctrl_ops = {
+	.s_ctrl = cam_s_ctrl,
+	.g_volatile_ctrl = cam_g_volatile_ctrl,
+};
+
+/*
+ * Writes the controls the guest wrote to a device that was reset, in the order
+ * it wrote them. Under the handler's lock, so no write passes it.
+ */
+int virtio_video_cam_ctrls_reapply(struct virtio_video_camera *cam)
+{
+	u64 done = 0;
+	int ret = 0;
+
+	ret = cam_carrier_restore(cam);
+	if (ret)
+		return ret;
+
+	mutex_lock(cam->hdl.lock);
+	for (;;) {
+		struct virtio_video_cam_ctrl *next = NULL;
+		unsigned int i;
+
+		for (i = 0; i < cam->num_ctrls; i++) {
+			struct virtio_video_cam_ctrl *cc = &cam->ctrls[i];
+
+			if (cc->written > done &&
+			    (!next || cc->written < next->written))
+				next = cc;
+		}
+		if (!next)
+			break;
+		done = next->written;
+		ret = cam_write_ctrl(cam, next->ctrl, true);
+		if (ret)
+			break;
+	}
+	mutex_unlock(cam->hdl.lock);
+
+	return ret;
+}
+
+/* ------------------------------------------------------------------------ */
+/* Registration                                                             */
+/* ------------------------------------------------------------------------ */
+
+static void cam_register_ctrl(struct virtio_video_camera *cam,
+			      struct virtio_video_cam_ctrl *cc)
+{
+	const struct video_v4l2_control *c = &cc->desc;
+	struct v4l2_ctrl_config cfg = {
+		.ops = &cam_ctrl_ops,
+		.id = c->id,
+		.name = cam_ctrl_name(c->id),
+		.type = c->type,
+		.min = c->minimum,
+		.max = c->maximum,
+		.step = c->step ? c->step : 1,
+		.def = c->default_value,
+	};
+	enum v4l2_ctrl_type fill_type;
+	unsigned int items;
+	const char *name;
+	s64 min, max, def;
+	u64 step;
+	u32 flags;
+
+	v4l2_ctrl_fill(c->id, &name, &fill_type, &min, &max, &step, &def,
+		       &flags);
+	cfg.flags = flags;
+	if (c->flags & VIRTIO_VIDEO_V4L2_CTRL_F_READ_ONLY)
+		cfg.flags |= V4L2_CTRL_FLAG_READ_ONLY;
+	if (c->flags & VIRTIO_VIDEO_V4L2_CTRL_F_VOLATILE)
+		cfg.flags |= V4L2_CTRL_FLAG_VOLATILE;
+
+	switch (c->type) {
+	case V4L2_CTRL_TYPE_INTEGER:
+		cfg.min = max_t(s64, c->minimum, S32_MIN);
+		cfg.max = min_t(s64, c->maximum, S32_MAX);
+		cfg.def = clamp_t(s64, c->default_value, cfg.min, cfg.max);
+		break;
+	case V4L2_CTRL_TYPE_BOOLEAN:
+		cfg.min = 0;
+		cfg.max = 1;
+		cfg.step = 1;
+		break;
+	case V4L2_CTRL_TYPE_BUTTON:
+		cfg.min = cfg.max = cfg.def = 0;
+		cfg.step = 0;
+		break;
+	case V4L2_CTRL_TYPE_BITMASK:
+		cfg.min = 0;
+		cfg.step = 0;
+		break;
+	case V4L2_CTRL_TYPE_MENU:
+		cfg.qmenu = cam_ctrl_menu(c->id, &items);
+		cfg.step = 0;
+		cfg.menu_skip_mask = c->menu_skip_mask;
+		break;
+	case V4L2_CTRL_TYPE_U32:
+		cfg.dims[0] = c->elem_size / 4;
+		cfg.min = 0;
+		cfg.max = U32_MAX;
+		cfg.step = 1;
+		cfg.def = 0;
+		break;
+	default:
+		break;
+	}
+
+	cc->ctrl = v4l2_ctrl_new_custom(&cam->hdl, &cfg, cc);
+}
+
+/* The two controls the driver answers itself. */
+static void cam_register_own_ctrls(struct virtio_video_camera *cam)
+{
+	struct v4l2_ctrl_config privacy = {
+		.id = V4L2_CID_PRIVACY,
+		.name = "Privacy",
+		.type = V4L2_CTRL_TYPE_BOOLEAN,
+		.min = 0,
+		.max = 1,
+		.step = 1,
+		.def = cam->blocked,
+		.flags = V4L2_CTRL_FLAG_READ_ONLY,
+	};
+	struct v4l2_ctrl_config description = {
+		.id = VIRTIO_VIDEO_CAMERA_CID_DESCRIPTION,
+		.name = cam_ctrl_name(VIRTIO_VIDEO_CAMERA_CID_DESCRIPTION),
+		.type = V4L2_CTRL_TYPE_U8,
+		.min = 0,
+		.max = 255,
+		.step = 1,
+		.dims = { sizeof(cam->desc_raw) },
+		.flags = V4L2_CTRL_FLAG_READ_ONLY,
+	};
+	struct v4l2_ctrl *ctrl;
+
+	v4l2_ctrl_new_custom(&cam->hdl, &privacy, NULL);
+
+	ctrl = v4l2_ctrl_new_custom(&cam->hdl, &description, NULL);
+	if (ctrl) {
+		memcpy(ctrl->p_cur.p_u8, cam->desc_raw, sizeof(cam->desc_raw));
+		memcpy(ctrl->p_new.p_u8, cam->desc_raw, sizeof(cam->desc_raw));
+	}
+}
+
+/*
+ * Fetches the camera's control list, a page of descriptors at a time, and
+ * keeps the ones this kernel can register.
+ */
+static int cam_query_ctrls(struct virtio_video_camera *cam)
+{
+	struct virtio_video_device *vvd = cam->vvd;
+	struct virtio_video_query_v4l2_controls_resp *resp;
+	size_t size = vvd->max_resp_len;
+	u32 start = 0, total = 0;
+	int ret = 0;
+
+	if (size < sizeof(*resp) + sizeof(struct virtio_video_v4l2_control_desc))
+		return -EINVAL;
+
+	resp = kzalloc(size, GFP_KERNEL);
+	if (!resp)
+		return -ENOMEM;
+
+	for (;;) {
+		const struct virtio_video_v4l2_control_desc *descs = (void *)(resp + 1);
+		u32 num, next, i;
+		size_t len;
+
+		ret = virtio_video_cam_cmd_query_controls(vvd, cam->index,
+							  start, resp, size,
+							  &len);
+		if (ret)
+			break;
+
+		num = le32_to_cpu(resp->num_descs);
+		if (num > (len - sizeof(*resp)) / sizeof(*descs)) {
+			ret = -EIO;
+			break;
+		}
+		total += num;
+		if (total > VIRTIO_VIDEO_CAM_MAX_CTRLS) {
+			ret = -EIO;
+			break;
+		}
+
+		for (i = 0; i < num; i++) {
+			struct virtio_video_cam_ctrl *ctrls, *cc;
+			struct video_v4l2_control c = {};
+
+			c.id = le32_to_cpu(descs[i].id);
+			c.type = le32_to_cpu(descs[i].type);
+			c.minimum = le64_to_cpu(descs[i].minimum);
+			c.maximum = le64_to_cpu(descs[i].maximum);
+			c.step = le64_to_cpu(descs[i].step);
+			c.default_value = le64_to_cpu(descs[i].default_value);
+			c.menu_skip_mask = le64_to_cpu(descs[i].menu_skip_mask);
+			c.flags = le32_to_cpu(descs[i].flags);
+			c.elem_size = le32_to_cpu(descs[i].elem_size);
+
+			/* The driver answers these two, whatever the device says. */
+			if (c.id == V4L2_CID_PRIVACY ||
+			    c.id == VIRTIO_VIDEO_CAMERA_CID_DESCRIPTION)
+				continue;
+			if (!cam_ctrl_usable(&c)) {
+				v4l2_dbg(1, vvd->debug, &vvd->v4l2_dev,
+					 "camera %u: control %#x (type %u) is not one this kernel can register\n",
+					 cam->index, c.id, c.type);
+				continue;
+			}
+
+			ctrls = krealloc_array(cam->ctrls, cam->num_ctrls + 1,
+					       sizeof(*ctrls), GFP_KERNEL);
+			if (!ctrls) {
+				ret = -ENOMEM;
+				goto out;
+			}
+			cam->ctrls = ctrls;
+			cc = &ctrls[cam->num_ctrls++];
+			memset(cc, 0, sizeof(*cc));
+			cc->desc = c;
+		}
+
+		next = le32_to_cpu(resp->next_index);
+		if (!next)
+			break;
+		/* Every page moves forward, or the list never ends. */
+		if (!num || next <= start) {
+			ret = -EIO;
+			break;
+		}
+		start = next;
+	}
+out:
+	kfree(resp);
+
+	return ret;
+}
+
+int virtio_video_cam_ctrls_init(struct virtio_video_camera *cam)
+{
+	unsigned int i;
+	int ret;
+
+	ret = cam_query_ctrls(cam);
+	if (ret)
+		goto err;
+
+	ret = v4l2_ctrl_handler_init(&cam->hdl, cam->num_ctrls + 2);
+	if (ret)
+		goto err;
+
+	cam_register_own_ctrls(cam);
+	for (i = 0; i < cam->num_ctrls && !cam->hdl.error; i++)
+		cam_register_ctrl(cam, &cam->ctrls[i]);
+
+	ret = cam->hdl.error;
+	if (ret) {
+		v4l2_ctrl_handler_free(&cam->hdl);
+		goto err;
+	}
+
+	return 0;
+err:
+	kfree(cam->ctrls);
+	cam->ctrls = NULL;
+	cam->num_ctrls = 0;
+
+	return ret;
+}
+
+void virtio_video_cam_ctrls_free(struct virtio_video_camera *cam)
+{
+	v4l2_ctrl_handler_free(&cam->hdl);
+	kfree(cam->ctrls);
+	cam->ctrls = NULL;
+	cam->num_ctrls = 0;
+}
diff --git a/drivers/media/virtio/virtio_video_camera_dev.c b/drivers/media/virtio/virtio_video_camera_dev.c
new file mode 100644
index 0000000000000000000000000000000000000000..a174706a1628b94b375e0b9d11685ce5bc109acf
--- /dev/null
+++ b/drivers/media/virtio/virtio_video_camera_dev.c
@@ -0,0 +1,434 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * The Virtio camera device.
+ *
+ * One device carries every camera of the host. The driver asks which there are
+ * (VIRTIO_VIDEO_CMD_CAMERA_QUERY), what each offers, and which controls it has,
+ * and registers a capture node and a metadata node for each, from /dev/video10
+ * up (see virtio_video_camera.h). The camera is a device of its own kind, not a
+ * video_device of the codecs': the nodes outlive its removal for as long as a
+ * file is open, so what they use is freed by the last of them, through the
+ * reference the driver and every registered node hold on the device.
+ *
+ * A system suspend stops the streams that hold buffers, so the device holds no
+ * request while the rings are off. The transport keeps a request the device
+ * holds across a ring disable all the same; a change of the guest's memory or
+ * of a ring, or a teardown, is what resets the device. If it was reset, the
+ * resume finds the streams gone and makes them again, with their controls and
+ * buffers.
+ */
+#include "virtio_video_camera.h"
+
+struct virtio_video_camera *
+virtio_video_cam_find(struct virtio_video_device *vvd, u32 index)
+{
+	unsigned int i;
+
+	for (i = 0; i < vvd->num_cameras; i++)
+		if (vvd->cameras[i].index == index)
+			return &vvd->cameras[i];
+
+	return NULL;
+}
+
+/* Reads the formats a camera's video or still streams offer. */
+static int cam_query_formats(struct virtio_video_camera *cam, u32 kind,
+			     struct list_head *list)
+{
+	struct virtio_video_device *vvd = cam->vvd;
+	struct virtio_video_query_capability_resp *resp;
+	u32 count = 0;
+	int ret;
+
+	resp = kzalloc(vvd->max_caps_len, GFP_KERNEL);
+	if (!resp)
+		return -ENOMEM;
+
+	ret = virtio_video_cam_cmd_query_formats(vvd, cam->index, kind, resp,
+						 vvd->max_caps_len);
+	/* A camera with no video, or no stills, has an empty list. */
+	if (!ret && le32_to_cpu(resp->num_descs))
+		ret = virtio_video_parse_virtio_capability(vvd, resp, list,
+							   &count);
+	if (ret)
+		virtio_video_free_format_list(list);
+	kfree(resp);
+
+	return ret;
+}
+
+static int cam_setup(struct virtio_video_camera *cam)
+{
+	struct virtio_video_device *vvd = cam->vvd;
+	int ret;
+
+	cam->blocked = vvd->camera_session_flags &
+		       VIRTIO_VIDEO_CAMERA_SESSION_F_BLOCKED;
+
+	ret = cam_query_formats(cam, VIRTIO_VIDEO_CAMERA_STREAM_VIDEO,
+				&cam->video_formats);
+	if (ret)
+		return ret;
+
+	ret = cam_query_formats(cam, VIRTIO_VIDEO_CAMERA_STREAM_STILL,
+				&cam->still_formats);
+	if (ret)
+		return ret;
+
+	if (list_empty(&cam->video_formats) && list_empty(&cam->still_formats))
+		return -ENODEV;
+
+	ret = virtio_video_cam_ctrls_init(cam);
+	if (ret)
+		return ret;
+
+	return virtio_video_cam_register_nodes(cam);
+}
+
+/* Asks the device which cameras it has. */
+static int cam_query_cameras(struct virtio_video_device *vvd)
+{
+	struct virtio_video_camera_query_resp *resp;
+	size_t size = vvd->max_resp_len;
+	u32 start = 0, expected = 0;
+	bool first = true;
+	int ret;
+
+	if (size < sizeof(*resp) + sizeof(struct virtio_video_camera_desc))
+		return -EINVAL;
+
+	resp = kzalloc(size, GFP_KERNEL);
+	if (!resp)
+		return -ENOMEM;
+
+	for (;;) {
+		const struct virtio_video_camera_desc *descs = (void *)(resp + 1);
+		u32 num, next, i, total;
+		size_t len;
+
+		ret = virtio_video_cam_cmd_query(vvd, start, resp, size, &len);
+		if (ret)
+			break;
+
+		if (le32_to_cpu(resp->desc_size) != sizeof(*descs)) {
+			v4l2_err(&vvd->v4l2_dev,
+				 "camera descriptions of %u bytes, not %zu\n",
+				 le32_to_cpu(resp->desc_size), sizeof(*descs));
+			ret = -EIO;
+			break;
+		}
+
+		total = le32_to_cpu(resp->num_cameras);
+		num = le32_to_cpu(resp->num_descs);
+		if (total > VIRTIO_VIDEO_CAMERA_MAX_CAMERAS ||
+		    num > (len - sizeof(*resp)) / sizeof(*descs)) {
+			ret = -EIO;
+			break;
+		}
+		/*
+		 * The array is sized by the first page's total, and every page
+		 * after it must say the same: the device could otherwise
+		 * have the driver write past the array.
+		 */
+		if (first) {
+			expected = total;
+			first = false;
+		} else if (total != expected) {
+			ret = -EIO;
+			break;
+		}
+		vvd->camera_session_flags = le32_to_cpu(resp->session_flags);
+
+		if (!vvd->cameras && expected) {
+			vvd->cameras = kcalloc(expected, sizeof(*vvd->cameras),
+					       GFP_KERNEL);
+			if (!vvd->cameras) {
+				ret = -ENOMEM;
+				break;
+			}
+		}
+		if (vvd->num_cameras + num > expected) {
+			ret = -EIO;
+			break;
+		}
+
+		for (i = 0; i < num; i++) {
+			struct virtio_video_camera *cam =
+				&vvd->cameras[vvd->num_cameras];
+			u32 index = le32_to_cpu(descs[i].index);
+
+			/* Every other command names a camera by this. */
+			if (index >= VIRTIO_VIDEO_CAMERA_MAX_CAMERAS ||
+			    virtio_video_cam_find(vvd, index)) {
+				ret = -EIO;
+				goto out;
+			}
+			cam->vvd = vvd;
+			cam->index = index;
+			memcpy(cam->desc_raw, &descs[i], sizeof(cam->desc_raw));
+			mutex_init(&cam->lock);
+			mutex_init(&cam->carrier_lock);
+			INIT_LIST_HEAD(&cam->files);
+			INIT_LIST_HEAD(&cam->video_formats);
+			INIT_LIST_HEAD(&cam->still_formats);
+			vvd->num_cameras++;
+		}
+
+		next = le32_to_cpu(resp->next_index);
+		if (!next)
+			break;
+		/* Every page moves forward, or the list never ends. */
+		if (!num || next <= start) {
+			ret = -EIO;
+			break;
+		}
+		start = next;
+	}
+out:
+	kfree(resp);
+
+	return ret;
+}
+
+/*
+ * The sizes of the wire structures the driver reads and writes in place: a
+ * layout change of the shared header shows here, at build time, rather than as
+ * a device the driver misreads.
+ */
+static void cam_check_wire_sizes(void)
+{
+	BUILD_BUG_ON(sizeof(struct virtio_video_cmd_hdr) != 8);
+	BUILD_BUG_ON(sizeof(struct virtio_video_params) != 112);
+	BUILD_BUG_ON(sizeof(struct virtio_video_get_params) != 16);
+	BUILD_BUG_ON(sizeof(struct virtio_video_get_params_resp) != 120);
+	BUILD_BUG_ON(sizeof(struct virtio_video_set_params) != 120);
+	BUILD_BUG_ON(sizeof(struct virtio_video_stream_create) != 88);
+	BUILD_BUG_ON(sizeof(struct virtio_video_resource_queue) != 64);
+	BUILD_BUG_ON(sizeof(struct virtio_video_resource_queue_resp) != 56);
+	BUILD_BUG_ON(sizeof(struct virtio_video_queue_clear) != 16);
+	BUILD_BUG_ON(sizeof(struct virtio_video_query_capability) != 16);
+	BUILD_BUG_ON(sizeof(struct virtio_video_query_capability_resp) != 16);
+	BUILD_BUG_ON(sizeof(struct virtio_video_v4l2_control_desc) != 64);
+	BUILD_BUG_ON(sizeof(struct virtio_video_v4l2_control_value) != 16);
+	BUILD_BUG_ON(sizeof(struct virtio_video_v4l2_controls) != 16);
+	BUILD_BUG_ON(sizeof(struct virtio_video_v4l2_controls_resp) != 16);
+	BUILD_BUG_ON(sizeof(struct virtio_video_camera_query) != 16);
+	BUILD_BUG_ON(sizeof(struct virtio_video_camera_desc) != 328);
+	BUILD_BUG_ON(sizeof(struct virtio_video_camera_query_resp) != 32);
+	BUILD_BUG_ON(sizeof(struct virtio_video_camera_query_formats) != 16);
+	BUILD_BUG_ON(sizeof(struct virtio_video_camera_query_controls) != 16);
+	BUILD_BUG_ON(sizeof(struct virtio_video_camera_stream_create) != 88);
+	BUILD_BUG_ON(sizeof(struct virtio_video_camera_queue_resp) != 64);
+	BUILD_BUG_ON(sizeof(struct virtio_video_camera_meta) != 168);
+	/* The rest the camera's commands and answers carry or parse. */
+	BUILD_BUG_ON(sizeof(struct virtio_video_stream_destroy) != 8);
+	BUILD_BUG_ON(sizeof(struct virtio_video_resource_attach) != 16);
+	BUILD_BUG_ON(sizeof(struct virtio_video_resource_sg_list) != 8);
+	BUILD_BUG_ON(sizeof(struct virtio_video_resource_sg_entry) != 16);
+	BUILD_BUG_ON(sizeof(struct virtio_video_queue_detach_resources) != 16);
+	BUILD_BUG_ON(sizeof(struct virtio_video_get_stream_info) != 16);
+	BUILD_BUG_ON(sizeof(struct virtio_video_get_stream_info_resp) != 40);
+	BUILD_BUG_ON(sizeof(struct virtio_video_set_stream_info) != 40);
+	BUILD_BUG_ON(sizeof(struct virtio_video_stream_info) != 32);
+	BUILD_BUG_ON(sizeof(struct virtio_video_query_v4l2_controls) != 16);
+	BUILD_BUG_ON(sizeof(struct virtio_video_query_v4l2_controls_resp) != 16);
+	BUILD_BUG_ON(sizeof(struct virtio_video_format_desc) != 24);
+	BUILD_BUG_ON(sizeof(struct virtio_video_format_frame) != 40);
+	BUILD_BUG_ON(sizeof(struct virtio_video_format_range) != 16);
+	BUILD_BUG_ON(sizeof(struct virtio_video_event) != 8);
+}
+
+int virtio_video_camera_init(struct virtio_video_device *vvd)
+{
+	unsigned int i, registered = 0;
+	int ret;
+
+	cam_check_wire_sizes();
+
+	/*
+	 * The format parser frees what it parsed from these on a failure, and a
+	 * camera never fills them: only the codecs' init makes them empty.
+	 */
+	INIT_LIST_HEAD(&vvd->input_fmt_list);
+	INIT_LIST_HEAD(&vvd->output_fmt_list);
+
+	ret = cam_query_cameras(vvd);
+	if (ret)
+		return ret;
+
+	/* A device with no camera is a device with nothing to register. */
+	if (!vvd->num_cameras)
+		return 0;
+
+	for (i = 0; i < vvd->num_cameras; i++) {
+		struct virtio_video_camera *cam = &vvd->cameras[i];
+
+		ret = cam_setup(cam);
+		if (ret) {
+			/* The others stay: one camera failing is not the device. */
+			v4l2_err(&vvd->v4l2_dev,
+				 "camera %u cannot be registered (%d)\n",
+				 cam->index, ret);
+			continue;
+		}
+		registered++;
+	}
+
+	return registered ? 0 : -ENODEV;
+}
+
+/* The device is going away: no node opens or answers an ioctl any more. */
+void virtio_video_camera_deinit(struct virtio_video_device *vvd)
+{
+	unsigned int i;
+
+	for (i = 0; i < vvd->num_cameras; i++)
+		virtio_video_cam_unregister_nodes(&vvd->cameras[i]);
+}
+
+static void virtio_video_camera_free(struct kref *ref)
+{
+	struct virtio_video_device *vvd =
+		container_of(ref, struct virtio_video_device, ref);
+	unsigned int i;
+
+	for (i = 0; i < vvd->num_cameras; i++) {
+		struct virtio_video_camera *cam = &vvd->cameras[i];
+
+		virtio_video_free_format_list(&cam->video_formats);
+		virtio_video_free_format_list(&cam->still_formats);
+		virtio_video_cam_ctrls_free(cam);
+		mutex_destroy(&cam->lock);
+		mutex_destroy(&cam->carrier_lock);
+	}
+	kfree(vvd->cameras);
+
+	virtio_video_free_vbufs(vvd);
+	v4l2_device_unregister(&vvd->v4l2_dev);
+	idr_destroy(&vvd->resource_idr);
+	idr_destroy(&vvd->stream_idr);
+	mutex_destroy(&vvd->eventq.lock);
+	mutex_destroy(&vvd->video_dev_mutex);
+	kfree(vvd);
+}
+
+void virtio_video_camera_put(struct virtio_video_device *vvd)
+{
+	kref_put(&vvd->ref, virtio_video_camera_free);
+}
+
+/*
+ * The camera events say what the host did to a camera: it became unavailable or
+ * available, or its capture was interrupted or resumed. Nothing in the guest
+ * depends on them: the frames carry the same news in their flags and metadata,
+ * and the buffers keep arriving.
+ */
+void virtio_video_camera_event(struct virtio_video_device *vvd, u32 type,
+			       u32 camera)
+{
+	switch (type) {
+	case VIRTIO_VIDEO_EVENT_CAMERA_AVAILABLE:
+	case VIRTIO_VIDEO_EVENT_CAMERA_UNAVAILABLE:
+	case VIRTIO_VIDEO_EVENT_CAMERA_INTERRUPTED:
+	case VIRTIO_VIDEO_EVENT_CAMERA_RESUMED:
+		v4l2_dbg(1, vvd->debug, &vvd->v4l2_dev,
+			 "camera %u: event %#x\n", camera, type);
+		break;
+	default:
+		v4l2_warn(&vvd->v4l2_dev, "camera %u: unknown event %#x\n",
+			  camera, type);
+		break;
+	}
+}
+
+/*
+ * The userspace is frozen here, so no ioctl runs and the files' locks are not
+ * needed; the camera's lock keeps its list of files still.
+ */
+int virtio_video_camera_suspend(struct virtio_video_device *vvd)
+{
+	unsigned int i;
+
+	for (i = 0; i < vvd->num_cameras; i++) {
+		struct virtio_video_camera *cam = &vvd->cameras[i];
+		struct virtio_video_cam_file *file;
+
+		mutex_lock(&cam->lock);
+		list_for_each_entry(file, &cam->files, entry)
+			virtio_video_cam_suspend_file(file);
+		mutex_unlock(&cam->lock);
+	}
+
+	return 0;
+}
+
+/* The stream the resume asks the device about, to learn whether it was reset. */
+static u32 cam_probe_stream(struct virtio_video_camera *cam)
+{
+	struct virtio_video_cam_file *file;
+	u32 id = 0;
+
+	mutex_lock(&cam->lock);
+	if (cam->carrier_id)
+		id = cam->carrier_id;
+	else
+		list_for_each_entry(file, &cam->files, entry)
+			if (file->stream_id) {
+				id = file->stream_id;
+				break;
+			}
+	mutex_unlock(&cam->lock);
+
+	return id;
+}
+
+int virtio_video_camera_resume(struct virtio_video_device *vvd)
+{
+	bool probed = false, reset = false;
+	unsigned int i;
+
+	for (i = 0; i < vvd->num_cameras; i++) {
+		struct virtio_video_camera *cam = &vvd->cameras[i];
+		struct virtio_video_cam_file *file;
+
+		/*
+		 * A reset takes every stream at once, so asking about one says
+		 * it for all.
+		 */
+		if (!probed) {
+			u32 id = cam_probe_stream(cam);
+
+			if (id) {
+				struct virtio_video_params params;
+
+				probed = true;
+				reset = virtio_video_cam_cmd_get_params(vvd, id,
+									&params) ==
+					-ENOENT;
+				if (reset)
+					v4l2_info(&vvd->v4l2_dev,
+						  "the device was reset: restoring the streams\n");
+			}
+		}
+
+		mutex_lock(&cam->lock);
+		if (reset) {
+			/*
+			 * The device counts from zero again; the camera's
+			 * sequences go on from the highest delivered.
+			 */
+			atomic_set(&cam->seq_offset, atomic_read(&cam->seq_next));
+			list_for_each_entry(file, &cam->files, entry)
+				virtio_video_cam_restore_file(file, true);
+			if (virtio_video_cam_ctrls_reapply(cam))
+				v4l2_err(&vvd->v4l2_dev,
+					 "camera %u: cannot write the controls again\n",
+					 cam->index);
+		}
+		list_for_each_entry(file, &cam->files, entry)
+			virtio_video_cam_requeue_file(file);
+		mutex_unlock(&cam->lock);
+	}
+
+	return 0;
+}
