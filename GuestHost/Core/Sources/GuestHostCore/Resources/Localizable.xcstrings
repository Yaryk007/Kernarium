        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如何更新"
          }
        }
      }
    },
    "Install it with the same Apple ID and the same app as before, so it replaces this version and keeps your virtual machine." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以前と同じApple IDと同じアプリでインストールすると、このバージョンが置き換えられ、仮想マシンも残ります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请使用与之前相同的Apple ID和相同的App安装，这样新版本会替换此版本，并保留你的虚拟机。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請使用與之前相同的Apple ID和相同的App來安裝，這樣新版本會取代此版本，並保留你的虛擬機器。"
          }
        }
      }
    },
    "Install it with the same app or computer and the same Apple ID as before." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以前と同じアプリまたはコンピュータと、同じApple IDでインストールします。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用与之前相同的App或电脑，以及相同的Apple ID进行安装。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用與之前相同的App或電腦，以及相同的Apple ID來安裝。"
