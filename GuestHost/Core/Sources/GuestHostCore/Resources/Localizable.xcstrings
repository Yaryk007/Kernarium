{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ %@ is out. You have %@." : {
      "comment" : "The application's name, the offered version as \"1.1 (16)\", the installed version as \"1.0 (15)\".",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ %@が公開されました。現在のバージョンは%@です。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ %@已推出。你当前的版本为%@。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ %@已推出。你目前的版本為%@。"
          }
        }
      }
    },
    "Check for Updates" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アップデートを確認"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "检查更新"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "檢查更新"
          }
        }
      }
    },
    "Checks once a day for a newer version. Sends no account, identifier or usage data." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1日に1回、新しいバージョンがあるか確認します。アカウント、識別子、使用状況のデータは送信しません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每天检查一次是否有新版本。不会发送任何账户、标识符或使用数据。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每天檢查一次是否有較新的版本。不會傳送任何帳號、識別碼或使用狀況資料。"
          }
        }
      }
    },
    "Done" : {
      "localizations" : {
