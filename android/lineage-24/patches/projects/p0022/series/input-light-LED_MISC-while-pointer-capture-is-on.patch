+/**
+ * A device that advertises LED_MISC has it lit while pointer capture is on and put out when it ends.
+ */
+TEST_F(CursorInputMapperUnitTest, PointerCaptureLightsTheMiscLed) {
+    EXPECT_CALL(mMockEventHub, hasLed(EVENTHUB_ID, ALED_MISC)).WillRepeatedly(Return(true));
+    EXPECT_CALL(mMockEventHub, setLedState(EVENTHUB_ID, ALED_MISC, true)).Times(1);
+    EXPECT_CALL(mMockEventHub, setLedState(EVENTHUB_ID, ALED_MISC, false)).Times(1);
+    createMapper();
+
+    setPointerCapture(true);
+    setPointerCapture(false);
+}
+
+/**
+ * A device without LED_MISC sees no change.
+ */
+TEST_F(CursorInputMapperUnitTest, PointerCaptureLeavesADeviceWithoutTheMiscLedAlone) {
+    EXPECT_CALL(mMockEventHub, hasLed(EVENTHUB_ID, ALED_MISC)).WillRepeatedly(Return(false));
+    EXPECT_CALL(mMockEventHub, setLedState).Times(0);
+    createMapper();
+
+    setPointerCapture(true);
+    setPointerCapture(false);
+}
