+void StreamAlsaMonoPipe::restartInputClock() {
+    mInputClockRunning = false;
+    mInputStalled = false;
+}
+
+// The frames that the client takes from the input keep to real time. The device paces the input,
+// but what it delivers can stall (the worker of the sound device blocked, a host that is busy), and
+// a recorder stamps what it reads with the time of the read: a stall that the input answers with
+// fewer frames than the time that passed leaves a recording with less audio than its timestamps
+// span, and a player that follows the audio clock skips ahead at every gap. So the frames are due
+// one after the other from a clock that starts with the first transfer after the stream started,
+// paused, went to standby or changed its device (each of them restarts it), and:
+//  - a read waits for its frames until a slack after the last of them is due. The slack covers the
+//    buffers that the device delivers late in the normal course, so that nothing is made up unless
+//    the device stalls;
+//  - the frames that are still missing then are made up (silence) and the clock goes on, so the
+//    count of the client's frames follows the time through the stall, wherever the stall falls:
+//    inside a read or between two reads, since the elapsed time between reads is no sign of a
+//    pause (the whole process can stand still there while the recording goes on);
+//  - the count may lead the clock by the slack at most: frames that would put it further ahead are
+//    dropped, oldest first. They are the buffers that the device delivered before the clock started
+//    (the I/O thread runs from the start of the stream), for time that was made up already after a
+//    stall, or because the device is faster than the clock.
+// A count that is more than 'kLongestMakeUpNs' behind the clock when a read starts, or when it
+// ends, starts the clock again: the whole process stood still, inside a read or between two, and a
+// recording has the same gap in its video, so the standstill is not caught up and stays a gap in
+// the timeline (a read that it stopped holds one buffer of silence for it at most). A stall of the
+// device leaves the count behind by the slack and the delay of the reader, which the limit has room
+// for: a stall of any length is made up without a restart, as long as the reader comes back within
+// the slack. A reader that is later than that during a stall restarts the clock once, and the stall
+// leaves a gap of its own. The I/O thread wakes the wait each time it has written to the pipe, and
+// when it is stopped, which ends the wait as well. The position of the input stays its client's
+// count and the time of the reply.
+void StreamAlsaMonoPipe::readInput(void* buffer, size_t frameCount) {
+    constexpr int64_t kSlackNs = 100'000'000;
+    constexpr int64_t kDropLogIntervalNs = 10'000'000'000;
+    // The clock follows the device's own rate slowly (see below).
+    constexpr int64_t kTargetLatenessNs = 10'000'000;
+    constexpr int64_t kMaxStepNs = 1'000'000;
+    constexpr int64_t kStepDivisor = 64;
+    const size_t i = 0;  // For the input case, only support a single device.
+    const int64_t sampleRate = getContext().getSampleRate();
+    char* const bytes = static_cast<char*>(buffer);
+    int64_t nowNs = steadyNanos();
+    if (!mInputClockRunning ||
+        nowNs - (mInputClockStartNs + framesToNanos(mInputFramesTaken, sampleRate)) >
+                kLongestMakeUpNs) {
+        mInputClockRunning = true;
+        mInputClockStartNs = nowNs;
+        mInputFramesTaken = 0;
+        mInputStalled = false;
+    }
+    const int64_t deadlineNs = mInputClockStartNs +
+                               framesToNanos(mInputFramesTaken + frameCount, sampleRate) + kSlackNs;
+    size_t framesRead = 0;
+    size_t framesDropped = 0;
+    while (framesRead < frameCount) {
+        if (const ssize_t available = mSources[i]->availableToRead(); available > 0) {
+            // The count may be ahead of the frames that are due by the slack at most.
+            const int64_t dueFrames =
+                    nanosToFrames(steadyNanos() + kSlackNs - mInputClockStartNs, sampleRate);
+            const int64_t surplus = mInputFramesTaken + framesRead + available - dueFrames;
+            for (int64_t toDrop = std::min<int64_t>(surplus, available); toDrop > 0;) {
+                // The buffer of the client has room for the frames to drop: they are read and
+                // forgotten.
+                const ssize_t dropped = mSources[i]->read(
+                        bytes + framesRead * mFrameSizeBytes,
+                        std::min<size_t>(static_cast<size_t>(toDrop), frameCount - framesRead));
+                LOG_IF(FATAL, dropped < 0) << "Error reading from the pipe: " << dropped;
+                if (dropped == 0) break;
+                toDrop -= dropped;
+                framesDropped += dropped;
+            }
+        }
+        const ssize_t chunk = mSources[i]->read(bytes + framesRead * mFrameSizeBytes,
+                                                frameCount - framesRead);
+        LOG_IF(FATAL, chunk < 0) << "Error reading from the pipe: " << chunk;
+        framesRead += chunk;
+        nowNs = steadyNanos();
+        if (framesRead >= frameCount || !mIoThreadIsRunning || nowNs >= deadlineNs) {
+            break;
+        }
+        if (chunk == 0) {
+            std::unique_lock lock(mInputMutex);
+            mInputCv.wait_until(lock,
+                                std::chrono::steady_clock::time_point(
+                                        std::chrono::nanoseconds(deadlineNs)),
+                                [&] {
+                                    return !mIoThreadIsRunning ||
+                                           mSources[i]->availableToRead() > 0;
+                                });
+        }
+    }
+    if (framesDropped > 0) {
+        mInputFramesDropped += framesDropped;
+        // A device that is faster than the clock drops a few frames about once a second, so the
+        // message is rate limited like the stall's.
+        if (nowNs - mInputDropLoggedNs >= kDropLogIntervalNs) {
+            LOG(WARNING) << __func__ << ": dropped " << mInputFramesDropped
+                         << " frames since the last message, which would have put the count ahead"
+                         << " of the clock by more than the slack";
+            mInputFramesDropped = 0;
+            mInputDropLoggedNs = nowNs;
+        }
+    }
+    if (const size_t framesMissing = frameCount - framesRead; framesMissing > 0) {
+        memset(bytes + framesRead * mFrameSizeBytes, 0, framesMissing * mFrameSizeBytes);
+        if (mIoThreadIsRunning) {
+            // A stop of the stream ends a wait too, and is no stall. A stall that goes on is
+            // logged once.
+            if (!mInputStalled) {
+                LOG(WARNING) << __func__ << ": the device delivers no frames in time, making"
+                             << " silence up to keep to real time";
+                mInputStalled = true;
+                mInputFramesMadeUp = 0;
+            }
+            mInputFramesMadeUp += framesMissing;
+        }
+    } else if (mInputStalled) {
+        LOG(WARNING) << __func__ << ": the device delivers again, after " << mInputFramesMadeUp
+                     << " frames of silence made up";
+        mInputStalled = false;
+    }
+    if (framesRead == frameCount && framesDropped == 0) {
+        // The clock of the device and the steady clock of the guest differ a little. A read that
+        // got all its frames from the device moves the start of the clock by a small step towards
+        // the lateness that the delivery has in the normal course, so that over a long recording
+        // the stream neither drifts to the edge of the slack, where a read ends with a gap, nor
+        // out of it, where frames are dropped. The reads of a stall or of a drop do not move it.
+        const int64_t lateNs = nowNs - (mInputClockStartNs +
+                                        framesToNanos(mInputFramesTaken + frameCount, sampleRate));
+        mInputClockStartNs +=
+                std::clamp((lateNs - kTargetLatenessNs) / kStepDivisor, -kMaxStepNs, kMaxStepNs);
+    }
+    mInputFramesTaken += frameCount;
+    if (nowNs - (mInputClockStartNs + framesToNanos(mInputFramesTaken, sampleRate)) >
+        kLongestMakeUpNs) {
+        // The read itself was stopped (the process stood still inside it): the standstill is not
+        // caught up, and the next read starts the clock again.
+        mInputClockRunning = false;
+    }
+}
+
