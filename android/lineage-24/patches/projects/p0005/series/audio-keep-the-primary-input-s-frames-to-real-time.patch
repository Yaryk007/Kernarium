 namespace aidl::android::hardware::audio::core {
 
+namespace {
+
+constexpr int64_t kNanosPerSecond = 1'000'000'000;
+
+// How far behind its clock the input's count may be when a read starts or ends, or when a reply
+// reports the position: a stall of the device leaves room for the slack of a read and the delay of
+// the reader. A count further behind is a standstill of the whole process, which is not caught up
+// (the clock starts again), and the limit bounds how long before a reply a frame was due.
+constexpr int64_t kLongestMakeUpNs = 200'000'000;
+
+int64_t steadyNanos() {
+    return std::chrono::duration_cast<std::chrono::nanoseconds>(
+                   std::chrono::steady_clock::now().time_since_epoch())
+            .count();
+}
+
+// The time that a number of frames take at a sample rate, and the frames of a time. Neither
+// overflows for a count of frames or a time of years.
+int64_t framesToNanos(int64_t frames, int64_t sampleRate) {
+    return frames / sampleRate * kNanosPerSecond +
+           frames % sampleRate * kNanosPerSecond / sampleRate;
+}
+
+int64_t nanosToFrames(int64_t nanos, int64_t sampleRate) {
+    return nanos / kNanosPerSecond * sampleRate +
+           nanos % kNanosPerSecond * sampleRate / kNanosPerSecond;
+}
+
