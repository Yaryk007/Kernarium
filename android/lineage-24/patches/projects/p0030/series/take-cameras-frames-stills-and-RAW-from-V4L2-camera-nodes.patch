+ * limitations under the License.
+ */
+
+#ifndef HW_EMULATOR_CAMERA_V4L2_STREAM_H
+#define HW_EMULATOR_CAMERA_V4L2_STREAM_H
+
+#include <atomic>
+#include <condition_variable>
+#include <map>
+#include <memory>
+#include <mutex>
+#include <string>
+#include <thread>
+#include <vector>
+
+#include "V4l2Utils.h"
+
+namespace android {
+namespace v4l2cam {
+
+// One open file of a camera's capture node: a stream of the camera device. The
+// device writes each frame (or still) into a buffer that the guest queued, so a
+// request queues the framework's buffer, as a dma-buf where the node can import
+// it and as a mapped buffer of the stream's own (copied by the caller) where not,
+// and waits for it.
+class V4l2Stream {
+ public:
+  enum class Kind { kVideo, kStill };
+
+  struct Params {
+    std::string path;
+    Kind kind = Kind::kVideo;
+    uint32_t pixel_format = 0;
+    uint32_t width = 0;
+    uint32_t height = 0;
+    // The frame interval a video stream is asked for; 0 leaves the node's own.
+    uint32_t fps = 0;
+    uint32_t buffers = 4;
+    bool try_dmabuf = true;
+  };
+
+  struct Completion {
+    uint64_t sequence = 0;
+    nsecs_t timestamp = 0;  // CLOCK_BOOTTIME
+    uint32_t bytes_used = 0;
+    bool error = false;
+  };
+
+  static std::unique_ptr<V4l2Stream> Create(const Params& params);
+  ~V4l2Stream();
+
+  V4l2Stream(const V4l2Stream&) = delete;
+  V4l2Stream& operator=(const V4l2Stream&) = delete;
+
+  bool uses_dmabuf() const {
+    return dmabuf_;
+  }
+  uint32_t bytes_per_line() const {
+    return bytes_per_line_;
+  }
+  uint32_t size_image() const {
+    return size_image_;
+  }
+  const Params& params() const {
+    return params_;
+  }
+  nsecs_t last_used() const {
+    return last_used_;
+  }
+
+  // Queues a buffer and returns its slot, or -1. `dma_fd` is the framework
+  // buffer's dma-buf when the stream uses them. A still that is not the last of
+  // a group (a JPEG that a Bayer still follows) passes `group_cookie`, which
+  // is not zero; the last of a group passes the cookie and `last_of_group`.
+  int Queue(int dma_fd, size_t dma_length, uint32_t group_cookie, bool last_of_group);
+
+  // Waits for the slot's buffer, in slices of at most a second, until
+  // `timeout_ns` has passed or `*cancel` (when given) is set. A wait that ends
+  // without the buffer takes every buffer of the stream back from the device
+  // (STREAMOFF, which the next Queue starts again), so that the device cannot
+  // write later into memory that the framework has reused. TIMED_OUT when the
+  // time ran out; DEAD_OBJECT when the wait was cancelled or the buffer was
+  // already taken back by another wait's reset.
+  status_t Wait(int slot, nsecs_t timeout_ns, const std::atomic<bool>* cancel,
+                Completion* completion);
+
+  // The mapped buffer of a slot when the stream does not use dma-bufs.
+  const uint8_t* Mapped(int slot) const;
+
+  // Gives up dma-bufs: the stream's own mapped buffers from now on.
+  status_t SwitchToMmap();
+
+  // The frame interval of a running video stream.
+  void SetFrameRate(uint32_t fps);
+
+ private:
+  struct Slot {
+    bool queued = false;
+    uint8_t* mapped = nullptr;
+    size_t mapped_length = 0;
+    bool done = false;
+    Completion completion;
+  };
+
+  explicit V4l2Stream(const Params& params) : params_(params) {
+  }
+  status_t Initialize();
+  status_t AllocateBuffers(bool dmabuf);
+  void FreeBuffers();
+  int TypeOf() const {
+    return V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE;
+  }
+  status_t DequeueLocked();
+  // STREAMOFF, and every slot free again: the device holds no buffer afterwards.
+  void ResetLocked();
+
+  Params params_;
+  UniqueFd fd_;
+  bool dmabuf_ = false;
+  bool streaming_ = false;
+  uint32_t bytes_per_line_ = 0;
+  uint32_t size_image_ = 0;
+  uint32_t num_planes_ = 1;
+  std::vector<Slot> slots_;
+  std::vector<uint32_t> cookies_;
+  nsecs_t last_used_ = 0;
+  mutable std::mutex mutex_;
+};
+
+// The metadata node of a camera: a record for each exposure, which a reader
+// thread keeps for the last few exposures so that a frame finds its record by
+// sequence.
+class V4l2MetaReader {
+ public:
+  static std::unique_ptr<V4l2MetaReader> Create(const std::string& path);
+  ~V4l2MetaReader();
+
+  V4l2MetaReader(const V4l2MetaReader&) = delete;
+  V4l2MetaReader& operator=(const V4l2MetaReader&) = delete;
+
+  // Waits up to `timeout_ns` for the record of `sequence`.
+  bool WaitFor(uint64_t sequence, nsecs_t timeout_ns,
+               andarium::camera::abi::Meta* meta);
+  // The newest record, if any.
+  bool Latest(andarium::camera::abi::Meta* meta);
+
+ private:
+  V4l2MetaReader() = default;
+  status_t Initialize(const std::string& path);
+  void Run();
+
+  UniqueFd fd_;
+  std::vector<uint8_t*> mapped_;
+  std::vector<size_t> mapped_length_;
+  size_t record_size_ = 0;
+  std::thread thread_;
+  bool stop_ = false;
+  std::mutex mutex_;
+  std::condition_variable arrived_;
+  std::map<uint64_t, andarium::camera::abi::Meta> records_;
+};
+
+}  // namespace v4l2cam
+}  // namespace android
+
+#endif  // HW_EMULATOR_CAMERA_V4L2_STREAM_H
