diff --git a/devices/EmulatedCamera/hwl/V4l2Utils.cpp b/devices/EmulatedCamera/hwl/V4l2Utils.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..a45fffff8d38d7a0b9268cd1feffba260ebe57d2
--- /dev/null
+++ b/devices/EmulatedCamera/hwl/V4l2Utils.cpp
@@ -0,0 +1,479 @@
+/*
+ * Copyright (C) 2026 The Android Open Source Project
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ *      http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+#define LOG_TAG "V4l2Utils"
+#include "V4l2Utils.h"
+
+#include <dirent.h>
+#include <fcntl.h>
+#include <log/log.h>
+#include <sys/ioctl.h>
+#include <unistd.h>
+
+#include <algorithm>
+#include <array>
+#include <cerrno>
+#include <cstdlib>
+#include <cstring>
+#include <ctime>
+#include <set>
+#include <span>
+
+#include "camera_ids.hpp"
+
+namespace android {
+namespace v4l2cam {
+
+using andarium::camera::ControlWrite;
+using andarium::camera::Formats;
+using andarium::camera::Size;
+using andarium::camera::VideoMode;
+namespace abi = andarium::camera::abi;
+
+void UniqueFd::reset(int fd) {
+  if (fd_ >= 0) {
+    close(fd_);
+  }
+  fd_ = fd;
+}
+
+int Ioctl(int fd, unsigned long request, void* arg) {
+  int ret;
+  do {
+    ret = ioctl(fd, request, arg);
+  } while (ret == -1 && errno == EINTR);
+  return ret;
+}
+
+nsecs_t BufferTimeAsBoottime(const struct timeval& timestamp) {
+  struct timespec monotonic;
+  struct timespec boottime;
+  clock_gettime(CLOCK_MONOTONIC, &monotonic);
+  clock_gettime(CLOCK_BOOTTIME, &boottime);
+  const nsecs_t offset = (static_cast<nsecs_t>(boottime.tv_sec) -
+                          static_cast<nsecs_t>(monotonic.tv_sec)) *
+                             1000000000LL +
+                         (static_cast<nsecs_t>(boottime.tv_nsec) -
+                          static_cast<nsecs_t>(monotonic.tv_nsec));
+  return static_cast<nsecs_t>(timestamp.tv_sec) * 1000000000LL +
+         static_cast<nsecs_t>(timestamp.tv_usec) * 1000LL + offset;
+}
+
+namespace {
+
+constexpr uint32_t kRawFormats[] = {V4L2_PIX_FMT_SRGGB16, V4L2_PIX_FMT_SGRBG16,
+                                    V4L2_PIX_FMT_SGBRG16, V4L2_PIX_FMT_SBGGR16};
+
+bool ParseCameraIndex(const std::string& bus_info, uint32_t* index) {
+  const std::string prefix = kBusInfoPrefix;
+  if (bus_info.compare(0, prefix.size(), prefix) != 0) {
+    return false;
+  }
+  char* end = nullptr;
+  errno = 0;
+  unsigned long value = strtoul(bus_info.c_str() + prefix.size(), &end, 10);
+  if (errno != 0 || end == bus_info.c_str() + prefix.size() || *end != '\0' ||
+      value >= abi::max_cameras) {
+    return false;
+  }
+  *index = static_cast<uint32_t>(value);
+  return true;
+}
+
+// The frame rates a size runs at, from ENUM_FRAMEINTERVALS.
+bool FrameRates(int fd, uint32_t pixel_format, uint32_t width, uint32_t height,
+                uint32_t* min_fps, uint32_t* max_fps) {
+  struct v4l2_frmivalenum interval = {};
+  interval.pixel_format = pixel_format;
+  interval.width = width;
+  interval.height = height;
+  uint32_t low = UINT32_MAX;
+  uint32_t high = 0;
+  for (interval.index = 0; Ioctl(fd, VIDIOC_ENUM_FRAMEINTERVALS, &interval) == 0;
+       ++interval.index) {
+    auto fps_of = [](const struct v4l2_fract& fraction) -> uint32_t {
+      return fraction.numerator == 0 ? 0 : fraction.denominator / fraction.numerator;
+    };
+    if (interval.type == V4L2_FRMIVAL_TYPE_DISCRETE) {
+      const uint32_t fps = fps_of(interval.discrete);
+      low = std::min(low, fps);
+      high = std::max(high, fps);
+    } else {
+      // The shortest interval is the highest rate.
+      high = std::max(high, fps_of(interval.stepwise.min));
+      low = std::min(low, fps_of(interval.stepwise.max));
+      break;
+    }
+  }
+  if (high == 0) {
+    return false;
+  }
+  *min_fps = low == UINT32_MAX ? high : std::max<uint32_t>(low, 1);
+  *max_fps = high;
+  return true;
+}
+
+// The discrete sizes of a pixel format, from ENUM_FRAMESIZES.
+std::vector<Size> FrameSizes(int fd, uint32_t pixel_format) {
+  std::vector<Size> sizes;
+  struct v4l2_frmsizeenum size = {};
+  size.pixel_format = pixel_format;
+  for (size.index = 0; Ioctl(fd, VIDIOC_ENUM_FRAMESIZES, &size) == 0; ++size.index) {
+    if (size.type == V4L2_FRMSIZE_TYPE_DISCRETE) {
+      sizes.push_back({size.discrete.width, size.discrete.height});
+    } else {
+      ALOGW("%s: format %08x offers a stepwise size range; ignored", __FUNCTION__,
+            pixel_format);
+      break;
+    }
+  }
+  return sizes;
+}
+
+bool EnumerateFormats(int fd, CameraNodes* nodes) {
+  std::vector<uint32_t> pixel_formats;
+  struct v4l2_fmtdesc description = {};
+  description.type = V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE;
+  for (description.index = 0; Ioctl(fd, VIDIOC_ENUM_FMT, &description) == 0;
+       ++description.index) {
+    pixel_formats.push_back(description.pixelformat);
+  }
+  auto has = [&](uint32_t format) {
+    return std::find(pixel_formats.begin(), pixel_formats.end(), format) !=
+           pixel_formats.end();
+  };
+
+  if (has(V4L2_PIX_FMT_NV12)) {
+    nodes->video_pixel_format = V4L2_PIX_FMT_NV12;
+  } else if (has(V4L2_PIX_FMT_NV12M)) {
+    nodes->video_pixel_format = V4L2_PIX_FMT_NV12M;
+  } else {
+    ALOGE("%s: camera %u offers no NV12 video", __FUNCTION__, nodes->camera_index);
+    return false;
+  }
+  for (const auto& size : FrameSizes(fd, nodes->video_pixel_format)) {
+    uint32_t low = 0;
+    uint32_t high = 0;
+    if (!FrameRates(fd, nodes->video_pixel_format, size.width, size.height, &low, &high)) {
+      // A size without intervals runs at the usual rate.
+      low = 1;
+      high = 30;
+    }
+    nodes->formats.video.push_back({size.width, size.height, low, high});
+  }
+  if (nodes->formats.video.empty()) {
+    ALOGE("%s: camera %u offers no video size", __FUNCTION__, nodes->camera_index);
+    return false;
+  }
+
+  if (has(V4L2_PIX_FMT_JPEG)) {
+    nodes->has_jpeg = true;
+    nodes->formats.jpeg = FrameSizes(fd, V4L2_PIX_FMT_JPEG);
+  }
+  for (uint32_t format : kRawFormats) {
+    if (has(format)) {
+      const auto sizes = FrameSizes(fd, format);
+      if (!sizes.empty()) {
+        nodes->raw_pixel_format = format;
+        nodes->formats.raw = andarium::camera::largest(sizes);
+      }
+      break;
+    }
+  }
+  return true;
+}
+
+// The pixel format a Bayer order is offered as.
+uint32_t RawFormatOf(uint32_t bayer_order) {
+  switch (bayer_order) {
+    case abi::bayer::rggb:
+      return V4L2_PIX_FMT_SRGGB16;
+    case abi::bayer::grbg:
+      return V4L2_PIX_FMT_SGRBG16;
+    case abi::bayer::gbrg:
+      return V4L2_PIX_FMT_SGBRG16;
+    case abi::bayer::bggr:
+      return V4L2_PIX_FMT_SBGGR16;
+    default:
+      return 0;
+  }
+}
+
+}  // namespace
+
+status_t ReadControl(int fd, uint32_t id, int64_t* value) {
+  // The kernel fills the 64-bit member for a 64-bit control and the 32-bit one
+  // for every other integer, so the control's type says which to read.
+  struct v4l2_query_ext_ctrl query = {};
+  query.id = id;
+  if (Ioctl(fd, VIDIOC_QUERY_EXT_CTRL, &query) != 0) {
+    return BAD_VALUE;
+  }
+  struct v4l2_ext_control control = {};
+  control.id = id;
+  struct v4l2_ext_controls controls = {};
+  controls.which = V4L2_CTRL_WHICH_CUR_VAL;
+  controls.count = 1;
+  controls.controls = &control;
+  if (Ioctl(fd, VIDIOC_G_EXT_CTRLS, &controls) != 0) {
+    return BAD_VALUE;
+  }
+  *value = query.type == V4L2_CTRL_TYPE_INTEGER64 ? control.value64
+                                                  : static_cast<int64_t>(control.value);
+  return OK;
+}
+
+static status_t ReadDescription(int fd, abi::Desc* desc) {
+  struct v4l2_ext_control control = {};
+  control.id = kDescriptionControl;
+  control.size = sizeof(*desc);
+  control.ptr = desc;
+  struct v4l2_ext_controls controls = {};
+  controls.which = V4L2_CTRL_WHICH_CUR_VAL;
+  controls.count = 1;
+  controls.controls = &control;
+  if (Ioctl(fd, VIDIOC_G_EXT_CTRLS, &controls) != 0) {
+    return BAD_VALUE;
+  }
+  return OK;
+}
+
+namespace {
+
+// Whether the node has the control. VIDIOC_S_EXT_CTRLS says EINVAL both for a
+// control the node lacks and for a value it refuses; this tells them apart.
+bool ControlExists(int fd, uint32_t id) {
+  struct v4l2_query_ext_ctrl query = {};
+  query.id = id;
+  if (Ioctl(fd, VIDIOC_QUERY_EXT_CTRL, &query) == 0) {
+    return (query.flags & V4L2_CTRL_FLAG_DISABLED) == 0;
+  }
+  return errno != EINVAL;
+}
+
+// Logs a refused value once for each control and value (a request writes the
+// same ones again and again).
+void LogRefused(uint32_t id, int64_t value, int error) {
+  static std::mutex mutex;
+  static std::set<std::pair<uint32_t, int64_t>> seen;
+  constexpr size_t kLimit = 256;
+  std::lock_guard<std::mutex> lock(mutex);
+  if (seen.size() >= kLimit) {
+    seen.clear();
+  }
+  if (seen.insert({id, value}).second) {
+    ALOGW("%s: the camera refused %lld for control %08x: %s", __FUNCTION__,
+          static_cast<long long>(value), id, strerror(error));
+  }
+}
+
+}  // namespace
+
+status_t WriteControls(int fd, const std::vector<ControlWrite>& writes,
+                       std::vector<uint32_t>* unsupported,
+                       const std::function<void(const ControlWrite&)>& written) {
+  status_t result = OK;
+  for (const auto& write : writes) {
+    if (unsupported != nullptr &&
+        std::find(unsupported->begin(), unsupported->end(), write.id) !=
+            unsupported->end()) {
+      continue;
+    }
+    struct v4l2_ext_control control = {};
+    control.id = write.id;
+    std::array<uint32_t, abi::region_words> words = write.region;
+    if (write.is_region) {
+      control.size = sizeof(uint32_t) * words.size();
+      control.ptr = words.data();
+    } else {
+      control.value64 = write.value;
+    }
+    struct v4l2_ext_controls controls = {};
+    controls.which = V4L2_CTRL_WHICH_CUR_VAL;
+    controls.count = 1;
+    controls.controls = &control;
+    if (Ioctl(fd, VIDIOC_S_EXT_CTRLS, &controls) == 0) {
+      if (written) {
+        written(write);
+      }
+      continue;
+    }
+    const int error = errno;
+    if (error == ENOTTY || (error == EINVAL && !ControlExists(fd, write.id))) {
+      if (unsupported != nullptr) {
+        unsupported->push_back(write.id);
+      }
+      ALOGV("%s: the camera has no control %08x", __FUNCTION__, write.id);
+    } else {
+      LogRefused(write.id, write.is_region ? static_cast<int64_t>(write.region[0]) : write.value, error);
+      result = UNKNOWN_ERROR;
+    }
+  }
+  return result;
+}
+
+std::vector<CameraNodes> DiscoverCameraNodes(const std::string& dev_dir) {
+  std::map<uint32_t, CameraNodes> by_index;
+  DIR* dir = opendir(dev_dir.c_str());
+  if (dir == nullptr) {
+    ALOGE("%s: cannot read %s: %s", __FUNCTION__, dev_dir.c_str(), strerror(errno));
+    return {};
+  }
+  std::vector<std::string> names;
+  while (struct dirent* entry = readdir(dir)) {
+    // Only the camera device's nodes (video10 and above) are opened: opening a codec node starts
+    // a session on the host.
+    if (abi::may_be_camera_node(entry->d_name)) {
+      names.push_back(entry->d_name);
+    }
+  }
+  closedir(dir);
+  std::sort(names.begin(), names.end());
+
+  for (const auto& name : names) {
+    const std::string path = dev_dir + "/" + name;
+    UniqueFd fd(open(path.c_str(), O_RDWR | O_NONBLOCK | O_CLOEXEC));
+    if (!fd.valid()) {
+      continue;
+    }
+    struct v4l2_capability capability = {};
+    if (Ioctl(fd.get(), VIDIOC_QUERYCAP, &capability) != 0) {
+      continue;
+    }
+    const uint32_t caps = (capability.capabilities & V4L2_CAP_DEVICE_CAPS) != 0
+                              ? capability.device_caps
+                              : capability.capabilities;
+    const std::string bus_info(reinterpret_cast<const char*>(capability.bus_info),
+                               strnlen(reinterpret_cast<const char*>(capability.bus_info),
+                                       sizeof(capability.bus_info)));
+    uint32_t index = 0;
+    if (!ParseCameraIndex(bus_info, &index)) {
+      continue;
+    }
+    auto& nodes = by_index[index];
+    nodes.camera_index = index;
+    if ((caps & V4L2_CAP_META_CAPTURE) != 0) {
+      nodes.meta_path = path;
+    } else if ((caps & V4L2_CAP_VIDEO_CAPTURE_MPLANE) != 0 &&
+               (caps & V4L2_CAP_STREAMING) != 0) {
+      nodes.capture_path = path;
+      if (ReadDescription(fd.get(), &nodes.desc) != OK ||
+          nodes.desc.index != index) {
+        ALOGE("%s: %s: no description for camera %u", __FUNCTION__, path.c_str(), index);
+        nodes.capture_path.clear();
+        continue;
+      }
+      if (!EnumerateFormats(fd.get(), &nodes)) {
+        nodes.capture_path.clear();
+        continue;
+      }
+      // The Bayer order the node offers must be the description's.
+      if (nodes.raw_pixel_format != 0 &&
+          nodes.raw_pixel_format != RawFormatOf(nodes.desc.bayer_order)) {
+        ALOGW("%s: camera %u: the Bayer still's format does not match the description",
+              __FUNCTION__, index);
+        nodes.raw_pixel_format = 0;
+        nodes.formats.raw = {};
+      }
+      int64_t privacy = 0;
+      nodes.blocked = ReadControl(fd.get(), abi::cid::privacy, &privacy) == OK && privacy != 0;
+    }
+  }
+
+  std::vector<CameraNodes> cameras;
+  for (auto& [index, nodes] : by_index) {
+    if (nodes.capture_path.empty() || nodes.meta_path.empty()) {
+      ALOGW("%s: camera %u lacks a capture or a metadata node", __FUNCTION__, index);
+      continue;
+    }
+    cameras.push_back(std::move(nodes));
+  }
+  return cameras;
+}
+
+status_t SetTorch(const CameraNodes& nodes, bool on) {
+  UniqueFd fd(open(nodes.capture_path.c_str(), O_RDWR | O_NONBLOCK | O_CLOEXEC));
+  if (!fd.valid()) {
+    ALOGE("%s: cannot open %s: %s", __FUNCTION__, nodes.capture_path.c_str(), strerror(errno));
+    return NO_INIT;
+  }
+  int64_t privacy = 0;
+  if (ReadControl(fd.get(), abi::cid::privacy, &privacy) == OK && privacy != 0) {
+    return INVALID_OPERATION;
+  }
+  ControlWrite write;
+  write.id = abi::cid::flash_led_mode;
+  write.value = on ? abi::v4l2_value::flash_led_torch : abi::v4l2_value::flash_led_off;
+  return WriteControls(fd.get(), {write}, nullptr);
+}
+
+CameraRegistry& CameraRegistry::Get() {
+  static CameraRegistry registry;
+  return registry;
+}
+
+void CameraRegistry::Replace(std::map<uint32_t, CameraNodes> cameras) {
+  std::lock_guard<std::mutex> lock(mutex_);
+  cameras_ = std::move(cameras);
+}
+
+bool CameraRegistry::Find(uint32_t camera_id, CameraNodes* nodes) const {
+  std::lock_guard<std::mutex> lock(mutex_);
+  auto found = cameras_.find(camera_id);
+  if (found == cameras_.end()) {
+    return false;
+  }
+  *nodes = found->second;
+  return true;
+}
+
+namespace {
+
+std::vector<andarium::camera::Concurrency> ConcurrencyOf(const std::map<uint32_t, CameraNodes>& cameras) {
+  std::vector<andarium::camera::Concurrency> result;
+  for (const auto& entry : cameras) {
+    const auto& desc = entry.second.desc;
+    result.push_back({entry.first, entry.second.camera_index, desc.concurrent_mask, desc.conflict_mask});
+  }
+  return result;
+}
+
+}  // namespace
+
+std::vector<std::vector<uint32_t>> CameraRegistry::ReportedConcurrentSets(
+    const std::function<bool(uint32_t)>& meets) const {
+  std::lock_guard<std::mutex> lock(mutex_);
+  const auto cameras = ConcurrencyOf(cameras_);
+  return andarium::camera::reported_concurrent_sets(
+      std::span<const andarium::camera::Concurrency>(cameras), meets);
+}
+
+std::vector<uint32_t> CameraRegistry::ConflictingIds(uint32_t camera_id) const {
+  std::lock_guard<std::mutex> lock(mutex_);
+  return andarium::camera::conflicting_ids(ConcurrencyOf(cameras_), camera_id);
+}
+
+std::vector<uint32_t> CameraRegistry::Ids() const {
+  std::lock_guard<std::mutex> lock(mutex_);
+  std::vector<uint32_t> ids;
+  for (const auto& entry : cameras_) {
+    ids.push_back(entry.first);
+  }
+  return ids;
+}
+
+}  // namespace v4l2cam
+}  // namespace android
