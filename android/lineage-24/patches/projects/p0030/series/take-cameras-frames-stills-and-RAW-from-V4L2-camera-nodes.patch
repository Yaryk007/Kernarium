+ * limitations under the License.
+ */
+
+#define LOG_TAG "V4l2Thumbnail"
+#include "V4l2Thumbnail.h"
+
+#include <log/log.h>
+
+#include <algorithm>
+#include <csetjmp>
+#include <cstdio>
+#include <cstdlib>
+
+extern "C" {
+#include <jpeglib.h>
+}
+
+namespace android {
+namespace v4l2cam {
+
+namespace {
+
+struct ErrorManager {
+  struct jpeg_error_mgr base;
+  jmp_buf jump;
+};
+
+void OnError(j_common_ptr info) {
+  longjmp(reinterpret_cast<ErrorManager*>(info->err)->jump, 1);
+}
+
+// Decodes `jpeg` to RGB at a scale of 1, 1/2, 1/4 or 1/8 that keeps both sides
+// at least as large as the thumbnail. The pixels are malloc'd; the caller frees
+// them.
+uint8_t* Decode(const uint8_t* jpeg, size_t size, uint32_t want_width,
+                uint32_t want_height, uint32_t* width, uint32_t* height) {
+  struct jpeg_decompress_struct decoder;
+  ErrorManager error;
+  // Assigned after setjmp and read after the longjmp, so it is volatile.
+  uint8_t* volatile pixels = nullptr;
+  decoder.err = jpeg_std_error(&error.base);
+  error.base.error_exit = OnError;
+  if (setjmp(error.jump) != 0) {
+    jpeg_destroy_decompress(&decoder);
+    free(pixels);
+    return nullptr;
+  }
+  jpeg_create_decompress(&decoder);
+  jpeg_mem_src(&decoder, jpeg, size);
+  if (jpeg_read_header(&decoder, TRUE) != JPEG_HEADER_OK) {
+    jpeg_destroy_decompress(&decoder);
+    return nullptr;
+  }
+  decoder.out_color_space = JCS_RGB;
+  unsigned int denominator = 1;
+  while (denominator < 8 && decoder.image_width / (denominator * 2) >= want_width &&
+         decoder.image_height / (denominator * 2) >= want_height) {
+    denominator *= 2;
+  }
+  decoder.scale_num = 1;
+  decoder.scale_denom = denominator;
+  jpeg_start_decompress(&decoder);
+  *width = decoder.output_width;
+  *height = decoder.output_height;
+  pixels = static_cast<uint8_t*>(malloc(static_cast<size_t>(*width) * *height * 3));
+  if (pixels == nullptr) {
+    jpeg_destroy_decompress(&decoder);
+    return nullptr;
+  }
+  while (decoder.output_scanline < decoder.output_height) {
+    JSAMPROW row = pixels + static_cast<size_t>(decoder.output_scanline) * *width * 3;
+    jpeg_read_scanlines(&decoder, &row, 1);
+  }
+  jpeg_finish_decompress(&decoder);
+  jpeg_destroy_decompress(&decoder);
+  return pixels;
+}
+
+// Encodes RGB pixels; the output is malloc'd by the encoder.
+bool Encode(const uint8_t* pixels, uint32_t width, uint32_t height, int quality,
+            std::vector<uint8_t>* out) {
+  struct jpeg_compress_struct encoder;
+  ErrorManager error;
+  unsigned char* buffer = nullptr;
+  unsigned long length = 0;
+  encoder.err = jpeg_std_error(&error.base);
+  error.base.error_exit = OnError;
+  if (setjmp(error.jump) != 0) {
+    jpeg_destroy_compress(&encoder);
+    free(buffer);
+    return false;
+  }
+  jpeg_create_compress(&encoder);
+  jpeg_mem_dest(&encoder, &buffer, &length);
+  encoder.image_width = width;
+  encoder.image_height = height;
+  encoder.input_components = 3;
+  encoder.in_color_space = JCS_RGB;
+  jpeg_set_defaults(&encoder);
+  jpeg_set_quality(&encoder, quality, TRUE);
+  jpeg_start_compress(&encoder, TRUE);
+  while (encoder.next_scanline < encoder.image_height) {
+    JSAMPROW row = const_cast<uint8_t*>(pixels) +
+                   static_cast<size_t>(encoder.next_scanline) * width * 3;
+    jpeg_write_scanlines(&encoder, &row, 1);
+  }
+  jpeg_finish_compress(&encoder);
+  out->assign(buffer, buffer + length);
+  jpeg_destroy_compress(&encoder);
+  free(buffer);
+  return true;
+}
+
+}  // namespace
+
+bool MakeThumbnail(const uint8_t* jpeg, size_t size, uint32_t width, uint32_t height,
+                   int quality, std::vector<uint8_t>* thumbnail) {
+  if (jpeg == nullptr || width == 0 || height == 0 || thumbnail == nullptr) {
+    return false;
+  }
+  uint32_t source_width = 0;
+  uint32_t source_height = 0;
+  uint8_t* source = Decode(jpeg, size, width, height, &source_width, &source_height);
+  if (source == nullptr) {
+    ALOGW("%s: cannot decode the picture", __FUNCTION__);
+    return false;
+  }
+  // The window of the source with the thumbnail's aspect ratio, centred.
+  uint64_t crop_width = source_width;
+  uint64_t crop_height = source_height;
+  if (crop_width * height > crop_height * width) {
+    crop_width = crop_height * width / height;
+  } else {
+    crop_height = crop_width * height / width;
+  }
+  const uint64_t left = (source_width - crop_width) / 2;
+  const uint64_t top = (source_height - crop_height) / 2;
+
+  std::vector<uint8_t> scaled(static_cast<size_t>(width) * height * 3);
+  for (uint32_t y = 0; y < height; ++y) {
+    const uint64_t y0 = top + crop_height * y / height;
+    const uint64_t y1 = std::max<uint64_t>(top + crop_height * (y + 1) / height, y0 + 1);
+    for (uint32_t x = 0; x < width; ++x) {
+      const uint64_t x0 = left + crop_width * x / width;
+      const uint64_t x1 = std::max<uint64_t>(left + crop_width * (x + 1) / width, x0 + 1);
+      uint64_t sum[3] = {0, 0, 0};
+      for (uint64_t sy = y0; sy < y1 && sy < source_height; ++sy) {
+        for (uint64_t sx = x0; sx < x1 && sx < source_width; ++sx) {
+          const uint8_t* pixel = source + (sy * source_width + sx) * 3;
+          sum[0] += pixel[0];
+          sum[1] += pixel[1];
+          sum[2] += pixel[2];
+        }
+      }
+      const uint64_t count = std::max<uint64_t>((y1 - y0) * (x1 - x0), 1);
+      uint8_t* out = scaled.data() + (static_cast<size_t>(y) * width + x) * 3;
+      out[0] = static_cast<uint8_t>(sum[0] / count);
+      out[1] = static_cast<uint8_t>(sum[1] / count);
+      out[2] = static_cast<uint8_t>(sum[2] / count);
+    }
+  }
+  free(source);
+  return Encode(scaled.data(), width, height, quality, thumbnail);
+}
+
+}  // namespace v4l2cam
+}  // namespace android
