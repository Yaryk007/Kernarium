+constexpr nsecs_t kMetaTimeout = 200000000LL;
+// Frames and stills are queued two at a time at most: one in flight and one
+// spare, since a request waits for its own buffers.
+constexpr uint32_t kStreamSlots = 2;
+
+template <typename T>
+void Replace(HalCameraMetadata* metadata, uint32_t tag, const T* data, uint32_t count) {
+  camera_metadata_ro_entry_t entry;
+  if (metadata->Get(tag, &entry) == OK) {
+    metadata->Set(tag, data, count);
+  }
+}
+
+// Where the chroma rows of an NV12 frame of the stream start: right after the
+// luma rows, which the node may pad (its image is then larger than 3/2 of the
+// luma rows it was asked for). The layout is luma, then chroma at one stride.
+size_t ChromaOffset(const V4l2Stream& stream) {
+  const size_t stride = stream.bytes_per_line();
+  const size_t height = stream.params().height;
+  const size_t luma = static_cast<size_t>(stream.size_image()) * 2 / 3;
+  return stride != 0 && luma >= stride * height && luma % stride == 0 ? luma : stride * height;
+}
+
+// NV12 rows, luma and chroma at one stride, into the planes of a framework buffer.
+void CopyNv12(const uint8_t* luma, const uint8_t* chroma, uint32_t stride, SensorBuffer* buffer) {
+  const YCbCrPlanes& planes = buffer->plane.img_y_crcb;
+  for (uint32_t y = 0; y < buffer->height; ++y) {
+    memcpy(planes.img_y + static_cast<size_t>(y) * planes.y_stride,
+           luma + static_cast<size_t>(y) * stride, buffer->width);
+  }
+  for (uint32_t y = 0; y < buffer->height / 2; ++y) {
+    const uint8_t* source = chroma + static_cast<size_t>(y) * stride;
+    uint8_t* cb = planes.img_cb + static_cast<size_t>(y) * planes.cbcr_stride;
+    uint8_t* cr = planes.img_cr + static_cast<size_t>(y) * planes.cbcr_stride;
+    if (planes.cbcr_step == 2 && cr == cb + 1) {
+      memcpy(cb, source, buffer->width);
+    } else {
+      for (uint32_t x = 0; x < buffer->width / 2; ++x) {
+        cb[x * planes.cbcr_step] = source[2 * x];
+        cr[x * planes.cbcr_step] = source[2 * x + 1];
+      }
+    }
+  }
+}
