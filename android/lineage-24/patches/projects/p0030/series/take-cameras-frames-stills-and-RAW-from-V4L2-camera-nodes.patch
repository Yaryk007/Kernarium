+Request V4l2FrameSource::RequestOf(const SensorSettings& settings) {
+  Request request;
+  const auto& host = settings.host;
+  request.ae_mode = host.ae_mode;
+  request.ae_lock = host.ae_lock;
+  request.ae_compensation_steps = host.ae_compensation;
+  request.exposure_ns = settings.exposure_time;
+  request.sensitivity = static_cast<int32_t>(settings.gain);
+  request.ae_precapture_trigger = host.ae_precapture_trigger;
+  request.af_mode = host.af_mode;
+  request.af_trigger = host.af_trigger;
+  request.focus_distance = host.focus_distance;
+  request.awb_mode = host.awb_mode;
+  request.awb_lock = host.awb_lock;
+  for (size_t i = 0; i < 4; ++i) {
+    request.wb_gains[i] = host.color_correction_gains[i];
+  }
+  request.zoom_ratio = settings.zoom_ratio;
+  request.flash_mode = host.flash_mode;
+  request.test_pattern = settings.test_pattern_mode;
+  request.rotate_and_crop = settings.rotate_and_crop;
+  request.jpeg_quality = host.jpeg_quality;
+  request.video_stabilization = settings.video_stab != ANDROID_CONTROL_VIDEO_STABILIZATION_MODE_OFF;
+  request.ae_region = {host.ae_regions[0], host.ae_regions[1], host.ae_regions[2],
+                       host.ae_regions[3], host.ae_regions[4]};
+  request.af_region = {host.af_regions[0], host.af_regions[1], host.af_regions[2],
+                       host.af_regions[3], host.af_regions[4]};
+  return request;
+}
+
+V4l2FrameSource::Route V4l2FrameSource::RouteOf(const Camera& camera, const SensorBuffer& buffer) {
+  namespace plan = andarium::camera;
+  Route route;
+  route.key = {V4l2Stream::Kind::kVideo, camera.nodes.video_pixel_format, buffer.width,
+               buffer.height};
+  // A size that the device does not serve is made from a frame of a native mode.
+  const auto made_here = [&](const std::vector<plan::SizeSource>& list) -> const plan::SizeSource* {
+    for (const auto& entry : list) {
+      if (entry.size.width == buffer.width && entry.size.height == buffer.height) {
+        return entry.host ? nullptr : &entry;
+      }
+    }
+    return nullptr;
+  };
+  const auto derive = [&](const plan::SizeSource& entry) {
+    route.key = {V4l2Stream::Kind::kVideo, camera.nodes.video_pixel_format, entry.source.width,
+                 entry.source.height, true};
+    route.window = entry.window;
+  };
+  if (buffer.format == PixelFormat::BLOB) {
+    if (const auto* entry = made_here(camera.sizes.jpeg)) {
+      derive(*entry);
+    } else if (camera.nodes.has_jpeg) {
+      route.key = {V4l2Stream::Kind::kStill, V4L2_PIX_FMT_JPEG, buffer.width, buffer.height};
+      route.group_still = true;
+    } else {
+      return route;
+    }
+  } else if (buffer.format == PixelFormat::RAW16) {
+    if (camera.nodes.raw_pixel_format == 0) {
+      return route;
+    }
+    route.key = {V4l2Stream::Kind::kStill, camera.nodes.raw_pixel_format, buffer.width,
+                 buffer.height};
+    route.group_still = true;
+  } else if (buffer.format == PixelFormat::YCBCR_420_888 ||
+             buffer.format == PixelFormat::YCRCB_420_SP) {
+    if (const auto* entry = made_here(camera.sizes.yuv)) {
+      derive(*entry);
+    }
+    route.key.output = static_cast<uint32_t>(buffer.stream_buffer.stream_id) + 1;
+  } else {
+    return route;
+  }
+  route.ok = true;
+  return route;
+}
+
+V4l2Stream* V4l2FrameSource::StreamFor(Camera* camera, const StreamKey& key) {
+  auto found = camera->streams.find(key);
+  if (found != camera->streams.end()) {
+    return found->second.get();
+  }
+  V4l2Stream::Params params;
+  params.path = camera->nodes.capture_path;
+  params.kind = key.kind;
+  params.pixel_format = key.pixel_format;
+  params.width = key.width;
+  params.height = key.height;
+  params.fps = camera->fps;
+  params.buffers = camera->buffers;
+  params.try_dmabuf = camera->use_dmabuf && !key.derived;
+  auto stream = V4l2Stream::Create(params);
+  if (stream == nullptr) {
+    return nullptr;
+  }
+  if (!key.derived && !stream->uses_dmabuf()) {
+    ALOGI("%s: the %ux%u stream copies its frames (%s)", __FUNCTION__, key.width, key.height,
+          camera->use_dmabuf ? "the node would not take dma-bufs"
+                             : "dma-bufs were given up for this camera");
+  }
+  auto* raw = stream.get();
+  camera->streams[key] = std::move(stream);
+  return raw;
+}
+
+// The characteristics that the Exif data of a picture is made from. The Exif
+// focal length in 35 mm film is the field of view's own, which the camera's
+// stated focal length and physical size give together. A description that
+// states no such pair gives the Exif writer zeros, and the tag is left out: the
+// static metadata keeps the template's default size for a camera that states
+// none (the platform requires a size), and that default is no stated size.
+SensorCharacteristics V4l2FrameSource::ExifCharacteristics(const Camera& camera,
+                                                           SensorCharacteristics chars) {
+  const auto optics = andarium::camera::stated_optics(camera.nodes.desc);
+  chars.focal_length = optics.focal_length_mm;
+  chars.physical_size[0] = optics.sensor_width_mm;
+  chars.physical_size[1] = optics.sensor_height_mm;
+  return chars;
+}
+
+// The platform runs at the largest size of the streams that are open, and a
+// change restarts it with black frames. The stream of a video output that stays
+// configured but leaves the requests (a recording that stopped) is closed soon,
+// so that the restart comes then and not in a recording started a few seconds
+// later; an output that leaves the configuration needs no rule, as the
+// framework's reconfiguration makes a new frame source. A stream that the
+// request about to begin uses is never closed, and a request that takes a still
+// does not count towards an absence, because a still holds the pipeline and the
+// preview's requests wait behind it, and the absences that a video output earned
+// before such a request start again from zero at it: the rule is in
+// camera_streams.hpp.
+void V4l2FrameSource::CloseIdleStreams(Camera* camera, const std::set<StreamKey>& used) {
+  const nsecs_t now = systemTime(SYSTEM_TIME_MONOTONIC);
+  for (auto it = camera->streams.begin(); it != camera->streams.end();) {
+    bool in_flight = false;
+    for (const auto& entry : pending_) {
+      if (entry.second.stream == it->second.get()) {
+        in_flight = true;
+      }
+    }
+    const auto last = camera->stream_last_request.find(it->first);
+    const uint64_t since_use = last == camera->stream_last_request.end()
+                                   ? still_free_requests_begun_
+                                   : still_free_requests_begun_ - last->second;
+    if (!in_flight && used.count(it->first) == 0 &&
+        andarium::camera::closes_when_idle(it->first.output != 0, since_use,
+                                           now - it->second->last_used())) {
+      camera->stream_last_request.erase(it->first);
+      it = camera->streams.erase(it);
+    } else {
+      ++it;
+    }
+  }
+}
