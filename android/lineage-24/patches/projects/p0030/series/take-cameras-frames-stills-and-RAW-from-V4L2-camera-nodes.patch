+namespace {
+
+// The dma-buf of a framework buffer that the stream can write in place, if it
+// has the layout the device writes.
+bool DmabufOf(const SensorBuffer& buffer, const V4l2Stream& stream, int* fd, size_t* length,
+              const char** why) {
+  const native_handle_t* handle = buffer.stream_buffer.buffer;
+  if (handle == nullptr || handle->numFds < 1) {
+    *why = "the buffer has no dma-buf";
+    return false;
+  }
+  if (buffer.format == PixelFormat::YCBCR_420_888) {
+    const YCbCrPlanes& planes = buffer.plane.img_y_crcb;
+    // The device writes luma and then chroma rows at one stride, and the chroma
+    // where the node's image puts it (ChromaOffset): a gralloc buffer whose
+    // height is padded is taken when the node pads it the same way.
+    if (planes.img_y == nullptr || planes.y_stride != stream.bytes_per_line()) {
+      *why = "the luma stride is not the node's";
+      return false;
+    }
+    if (planes.cbcr_stride != planes.y_stride || planes.cbcr_step != 2 ||
+        planes.img_cr != planes.img_cb + 1) {
+      *why = "the chroma is not interleaved at the luma stride";
+      return false;
+    }
+    if (planes.img_cb != planes.img_y + ChromaOffset(stream)) {
+      *why = "the chroma starts at another offset than the node's";
+      return false;
+    }
+  } else if (buffer.format == PixelFormat::RAW16) {
+    if (buffer.plane.img.stride_in_bytes != stream.bytes_per_line()) {
+      *why = "the stride is not the node's";
+      return false;
+    }
+  } else if (buffer.format != PixelFormat::BLOB) {
+    *why = "the format is not one the node writes in place";
+    return false;
+  }
+  const int dma_fd = handle->data[0];
+  const off_t size = lseek(dma_fd, 0, SEEK_END);
+  lseek(dma_fd, 0, SEEK_SET);
+  if (size < 0 || static_cast<size_t>(size) < stream.size_image()) {
+    *why = "the buffer is smaller than the node's image";
+    return false;
+  }
+  *fd = dma_fd;
+  *length = static_cast<size_t>(size);
+  return true;
+}
+
+}  // namespace
+
+bool V4l2FrameSource::QueueBuffer(Camera* camera, V4l2Stream* stream, SensorBuffer* buffer,
+                                  const Route& route, uint32_t cookie, bool last_of_group) {
+  int dma_fd = -1;
+  size_t dma_length = 0;
+  const char* why = "";
+  if (stream->uses_dmabuf() && !DmabufOf(*buffer, *stream, &dma_fd, &dma_length, &why)) {
+    ALOGI("%s: the %ux%u stream copies its frames from now on: %s", __FUNCTION__,
+          stream->params().width, stream->params().height, why);
+    camera->use_dmabuf = false;
+    if (stream->SwitchToMmap() != OK) {
+      return false;
+    }
+  }
+  int slot = stream->Queue(dma_fd, dma_length, cookie, last_of_group);
+  if (slot < 0 && stream->uses_dmabuf()) {
+    ALOGW("%s: the node refused the dma-buf; the %ux%u stream copies from now on", __FUNCTION__,
+          stream->params().width, stream->params().height);
+    camera->use_dmabuf = false;
+    if (stream->SwitchToMmap() != OK) {
+      return false;
+    }
+    slot = stream->Queue(-1, 0, cookie, last_of_group);
+  }
+  if (slot < 0) {
+    return false;
+  }
+  pending_[buffer] = {stream, slot, camera, route.key.derived, route.window};
+  return true;
+}
+
+status_t V4l2FrameSource::BeginRequest(const LogicalCameraSettings& settings, Buffers* buffers) {
+  if (buffers == nullptr) {
+    return BAD_VALUE;
+  }
+  // Every request collects the buffers it queued, so a buffer still pending
+  // here was never collected: a request that stopped on its way. Take it back
+  // now, or its slot stays with the device for good and every later request
+  // finds the stream full.
+  if (!pending_.empty()) {
+    ALOGW("%s: %zu buffers of earlier requests were never collected", __FUNCTION__,
+          pending_.size());
+    for (const auto& entry : pending_) {
+      V4l2Stream::Completion unused;
+      entry.second.stream->Wait(entry.second.slot, 0, nullptr, &unused);
+    }
+    pending_.clear();
+  }
+  // The stills the device takes in this request are one capture. A JPEG made
+  // here from a video frame is not one of them. The whole request has one
+  // deadline.
+  std::map<uint32_t, int> still_count;
+  // The streams that the request uses: none of them is idle.
+  std::map<uint32_t, std::set<StreamKey>> used;
+  bool any_still = false;
+  for (const auto& buffer : *buffers) {
+    if (buffer->is_input || buffer->stream_buffer.status == google_camera_hal::BufferStatus::kError) {
+      continue;
+    }
+    if (buffer->format == PixelFormat::BLOB || buffer->format == PixelFormat::RAW16) {
+      any_still = true;
+    }
+    auto camera_entry = cameras_.find(buffer->camera_id);
+    if (camera_entry != cameras_.end()) {
+      const Route route = RouteOf(camera_entry->second, *buffer);
+      if (route.ok) {
+        used[buffer->camera_id].insert(route.key);
+      }
+      if (route.group_still) {
+        ++still_count[buffer->camera_id];
+      }
+    }
+  }
+  request_clock_.begin(systemTime(SYSTEM_TIME_MONOTONIC), any_still);
+
+  for (auto& entry : cameras_) {
+    CloseIdleStreams(&entry.second, used[entry.first]);
+  }
+  if (!any_still) {
+    ++still_free_requests_begun_;
+  } else {
+    // The absences a video output earned before this request do not carry over
+    // it: the requests that wait behind a still wait behind all of it, so the
+    // count of the requests without a still starts again for every open video
+    // output (the idle time is left as it is).
+    for (auto& entry : cameras_) {
+      for (const auto& stream : entry.second.streams) {
+        if (stream.first.output != 0) {
+          entry.second.stream_last_request[stream.first] = still_free_requests_begun_;
+        }
+      }
+    }
+  }
+
+  std::map<uint32_t, bool> controls_written;
+  std::map<uint32_t, int> stills_queued;
+  status_t result = OK;
+  for (auto& buffer : *buffers) {
+    if (buffer->is_input || buffer->stream_buffer.status == google_camera_hal::BufferStatus::kError) {
+      continue;
+    }
+    auto camera_entry = cameras_.find(buffer->camera_id);
+    auto settings_entry = settings.find(buffer->camera_id);
+    if (camera_entry == cameras_.end() || settings_entry == settings.end()) {
+      buffer->stream_buffer.status = google_camera_hal::BufferStatus::kError;
+      result = BAD_VALUE;
+      continue;
+    }
+    Camera& camera = camera_entry->second;
+    const SensorSettings& sensor_settings = settings_entry->second;
+
+    if (!controls_written[buffer->camera_id]) {
+      controls_written[buffer->camera_id] = true;
+      camera.last_request = RequestOf(sensor_settings);
+      // The planner learns of a write only when the camera took it.
+      ControlPlanner* planner = camera.planner.get();
+      v4l2cam::WriteControls(camera.control_fd.get(), planner->plan(camera.last_request),
+                             &camera.unsupported_controls,
+                             [planner](const andarium::camera::ControlWrite& write) {
+                               planner->commit(write);
+                             });
+      camera.request_timestamp = 0;
+      // The camera cannot vary its rate: with AE on it runs at the top of the
+      // requested range (frame_duration holds the middle of it).
+      double wanted = 0;
+      if (sensor_settings.host.ae_mode != ANDROID_CONTROL_AE_MODE_OFF &&
+          sensor_settings.host.ae_max_fps > 0) {
+        wanted = sensor_settings.host.ae_max_fps;
+      } else if (sensor_settings.frame_duration > 0) {
+        wanted = 1e9 / static_cast<double>(sensor_settings.frame_duration);
+      }
+      if (wanted > 0) {
+        const uint32_t fps =
+            static_cast<uint32_t>(std::clamp<int64_t>(std::llround(wanted), 1, 240));
+        if (fps != camera.fps) {
+          camera.fps = fps;
+          for (auto& stream : camera.streams) {
+            if (stream.first.kind == V4l2Stream::Kind::kVideo) {
+              stream.second->SetFrameRate(fps);
+            }
+          }
+        }
+      }
+    }
+
+    const Route route = RouteOf(camera, *buffer);
+    if (!route.ok) {
+      ALOGE("%s: the camera cannot serve a %ux%u buffer of format %x", __FUNCTION__,
+            buffer->width, buffer->height, static_cast<int>(buffer->format));
+      buffer->stream_buffer.status = google_camera_hal::BufferStatus::kError;
+      result = BAD_VALUE;
+      continue;
+    }
+    camera.stream_last_request[route.key] = still_free_requests_begun_;
+    uint32_t cookie = 0;
+    bool last_of_group = false;
+    if (route.group_still && still_count[buffer->camera_id] > 1) {
+      cookie = buffer->frame_number + 1;
+      last_of_group = ++stills_queued[buffer->camera_id] == still_count[buffer->camera_id];
+    }
+
+    V4l2Stream* stream = StreamFor(&camera, route.key);
+    if (stream == nullptr ||
+        !QueueBuffer(&camera, stream, buffer.get(), route, cookie, last_of_group)) {
+      ALOGE("%s: cannot queue a %ux%u buffer of format %x", __FUNCTION__, buffer->width,
+            buffer->height, static_cast<int>(buffer->format));
+      buffer->stream_buffer.status = google_camera_hal::BufferStatus::kError;
+      result = UNKNOWN_ERROR;
+    }
+  }
+  return result;
+}
+
+bool V4l2FrameSource::FailsRequest(size_t outputs, size_t failed) const {
+  return andarium::camera::request_end(outputs, failed) ==
+         andarium::camera::RequestEnd::request_error;
+}
+
+bool V4l2FrameSource::MetaOf(Camera* camera, uint64_t sequence, abi::Meta* meta) {
+  if (camera->meta->WaitFor(sequence, kMetaTimeout, meta)) {
+    return true;
+  }
+  ALOGW("%s: no metadata for exposure %llu; using the latest", __FUNCTION__,
+        static_cast<unsigned long long>(sequence));
+  return camera->meta->Latest(meta);
+}
+
+bool V4l2FrameSource::WaitFor(const SensorBuffer* buffer, V4l2Stream::Completion* completion,
+                              const uint8_t** mapped, Pending* pending) {
+  auto found = pending_.find(buffer);
+  if (found == pending_.end()) {
+    ALOGE("%s: a buffer that was not queued", __FUNCTION__);
+    return false;
+  }
+  *pending = found->second;
+  pending_.erase(found);
+  // What is left of the request's deadline; a wait that ends without the buffer
+  // takes the stream's buffers back, so the rest of the request fails at once.
+  const nsecs_t remaining = request_clock_.remaining(systemTime(SYSTEM_TIME_MONOTONIC));
+  status_t status = pending->stream->Wait(pending->slot, remaining, &interrupted_, completion);
+  if (status != OK) {
+    ALOGE("%s: the camera did not deliver a buffer (%d)", __FUNCTION__, status);
+    return false;
+  }
+  *mapped = pending->stream->uses_dmabuf() ? nullptr : pending->stream->Mapped(pending->slot);
+  return true;
+}
+
+status_t V4l2FrameSource::ProduceFrame(uint32_t camera_id, nsecs_t /*timestamp*/,
+                                       const SensorSettings& /*settings*/,
+                                       SensorBuffer* buffer,
+                                       const SensorBuffer* /*input_buffer*/) {
+  if (buffer == nullptr) {
+    return BAD_VALUE;
+  }
+  Pending pending;
+  V4l2Stream::Completion completion;
+  const uint8_t* mapped = nullptr;
+  if (!WaitFor(buffer, &completion, &mapped, &pending)) {
+    return UNKNOWN_ERROR;
+  }
+  Camera* camera = pending.camera;
+  if (camera == nullptr || cameras_.find(camera_id) == cameras_.end()) {
+    return BAD_VALUE;
+  }
+  if (completion.error) {
+    return UNKNOWN_ERROR;
+  }
+  if (camera->request_timestamp == 0) {
+    camera->request_timestamp = completion.timestamp;
+  }
+  abi::Meta meta;
+  if (MetaOf(camera, completion.sequence, &meta)) {
+    camera->last_meta = meta;
+    camera->have_meta = true;
+    if ((meta.flags & abi::frame_flag::still) != 0) {
+      camera->last_still_meta = meta;
+      camera->have_still_meta = true;
+    }
+  }
+  if (mapped == nullptr) {
+    return OK;  // the device wrote the framework's buffer
+  }
+
+  if (pending.derived) {
+    return ScaleInto(pending, mapped, buffer);
+  }
+
+  const uint32_t stride = pending.stream->bytes_per_line();
+  if (buffer->format == PixelFormat::RAW16) {
+    const size_t row = static_cast<size_t>(buffer->width) * 2;
+    for (uint32_t y = 0; y < buffer->height; ++y) {
+      memcpy(buffer->plane.img.img + static_cast<size_t>(y) * buffer->plane.img.stride_in_bytes,
+             mapped + static_cast<size_t>(y) * stride, row);
+    }
+    return OK;
+  }
+
+  // NV12 rows, luma and then chroma at one stride, into the buffer's planes.
+  CopyNv12(mapped, mapped + ChromaOffset(*pending.stream), stride, buffer);
+  return OK;
+}
+
+// Scales the window of a native NV12 frame to `width` x `height` into the two
+// planes at `dst_y` and `dst_uv`.
+static int ScaleWindow(const V4l2Stream& stream, const andarium::camera::Window& window,
+                       const uint8_t* mapped,
+                       uint8_t* dst_y, int dst_stride_y, uint8_t* dst_uv, int dst_stride_uv,
+                       uint32_t width, uint32_t height) {
+  const size_t stride = stream.bytes_per_line();
+  const uint8_t* src_y = mapped + static_cast<size_t>(window.y) * stride + window.x;
+  const uint8_t* src_uv = mapped + ChromaOffset(stream) + static_cast<size_t>(window.y / 2) * stride + window.x;
+  return libyuv::NV12Scale(src_y, static_cast<int>(stride), src_uv, static_cast<int>(stride),
+                           static_cast<int>(window.width), static_cast<int>(window.height), dst_y,
+                           dst_stride_y, dst_uv, dst_stride_uv, static_cast<int>(width),
+                           static_cast<int>(height), libyuv::kFilterBox);
+}
+
+status_t V4l2FrameSource::ScaleInto(const Pending& pending, const uint8_t* mapped,
+                                    SensorBuffer* buffer) {
+  const YCbCrPlanes& planes = buffer->plane.img_y_crcb;
+  if (planes.img_y == nullptr || pending.window.width == 0 || pending.window.height == 0) {
+    return BAD_VALUE;
+  }
+  int result;
+  if (planes.cbcr_step == 2 && planes.img_cr == planes.img_cb + 1) {
+    // The buffer's chroma is NV12: scale straight into it.
+    result = ScaleWindow(*pending.stream, pending.window, mapped, planes.img_y,
+                         static_cast<int>(planes.y_stride), planes.img_cb,
+                         static_cast<int>(planes.cbcr_stride), buffer->width, buffer->height);
+  } else {
+    const size_t luma = static_cast<size_t>(buffer->width) * buffer->height;
+    std::vector<uint8_t> scaled(luma + luma / 2);
+    result = ScaleWindow(*pending.stream, pending.window, mapped, scaled.data(),
+                         static_cast<int>(buffer->width), scaled.data() + luma,
+                         static_cast<int>(buffer->width), buffer->width, buffer->height);
+    if (result == 0) {
+      CopyNv12(scaled.data(), scaled.data() + luma, buffer->width, buffer);
+    }
+  }
+  if (result != 0) {
+    ALOGE("%s: scaling to %ux%u failed (%d)", __FUNCTION__, buffer->width, buffer->height, result);
+    return UNKNOWN_ERROR;
+  }
+  return OK;
+}
+
+status_t V4l2FrameSource::ProduceBlob(uint32_t camera_id, const SensorSettings& /*settings*/,
+                                      SensorBuffer* buffer, HalCameraMetadata* result_metadata,
+                                      const SensorCharacteristics& chars) {
+  if (buffer == nullptr || result_metadata == nullptr) {
+    return BAD_VALUE;
+  }
+  Pending pending;
+  V4l2Stream::Completion completion;
+  const uint8_t* mapped = nullptr;
+  if (!WaitFor(buffer, &completion, &mapped, &pending)) {
+    return UNKNOWN_ERROR;
+  }
+  Camera* camera = pending.camera;
+  if (camera == nullptr || cameras_.find(camera_id) == cameras_.end() || completion.error) {
+    return UNKNOWN_ERROR;
+  }
+  if (camera->request_timestamp == 0) {
+    camera->request_timestamp = completion.timestamp;
+  }
+  abi::Meta meta;
+  if (!MetaOf(camera, completion.sequence, &meta)) {
+    return UNKNOWN_ERROR;
+  }
+  camera->last_meta = meta;
+  camera->have_meta = true;
+  if (pending.derived) {
+    // The device completes a frame it made black (blocked, interrupted, or
+    // starting after a restart) as a good frame; a picture of it is no picture,
+    // and a still of the device's own kind fails then too.
+    if ((meta.flags & (abi::frame_flag::interrupted | abi::frame_flag::blocked |
+                       abi::frame_flag::resuming)) != 0) {
+      ALOGW("%s: the frame for a %ux%u picture was black (flags %x)", __FUNCTION__, buffer->width,
+            buffer->height, meta.flags);
+      return UNKNOWN_ERROR;
+    }
+    // A picture made here from a video frame: the results first, as the Exif
+    // data says what the exposure did.
+    nsecs_t unused = 0;
+    FrameResult(camera_id, result_metadata, &unused);
+    return EncodeDerived(camera, pending, mapped, buffer, result_metadata, chars);
+  }
+  camera->last_still_meta = meta;
+  camera->have_still_meta = true;
+
+  uint8_t* image = buffer->plane.img.img;
+  const size_t capacity = buffer->plane.img.buffer_size;
+  const size_t jpeg_size = completion.bytes_used;
+  if (image == nullptr || jpeg_size == 0 || jpeg_size + sizeof(andarium::camera::JpegBlobHeader) > capacity) {
+    ALOGE("%s: a %zu byte picture does not fit a %zu byte buffer", __FUNCTION__, jpeg_size, capacity);
+    return UNKNOWN_ERROR;
+  }
+  if (mapped != nullptr) {
+    memcpy(image, mapped, jpeg_size);
+  }
+
+  // The results first, so that the Exif data says what the still did.
+  nsecs_t unused = 0;
+  FrameResult(camera_id, result_metadata, &unused);
+
+  if (meta.jpeg_gap_length != 0) {
+    std::unique_ptr<ExifUtils> exif(ExifUtils::Create(ExifCharacteristics(*camera, chars)));
+    bool placed = false;
+    if (exif != nullptr && exif->Initialize() &&
+        exif->SetFromMetadata(*result_metadata, buffer->width, buffer->height)) {
+      char value[PROPERTY_VALUE_MAX];
+      property_get("ro.product.manufacturer", value, "unknown");
+      exif->SetMake(value);
+      property_get("ro.product.model", value, "unknown");
+      exif->SetModel(value);
+      exif->SetColorSpace(COLOR_SPACE_SRGB);
+
+      std::vector<uint8_t> thumbnail;
+      camera_metadata_ro_entry_t entry;
+      if (result_metadata->Get(ANDROID_JPEG_THUMBNAIL_SIZE, &entry) == OK && entry.count == 2 &&
+          entry.data.i32[0] > 0 && entry.data.i32[1] > 0) {
+        if (!v4l2cam::MakeThumbnail(image, jpeg_size, entry.data.i32[0], entry.data.i32[1], 80,
+                                    &thumbnail)) {
+          thumbnail.clear();
+        }
+      }
+      for (int attempt = 0; attempt < 2 && !placed; ++attempt) {
+        const bool with_thumbnail = attempt == 0 && !thumbnail.empty();
+        if (exif->GenerateApp1(with_thumbnail ? thumbnail.data() : nullptr,
+                               with_thumbnail ? static_cast<uint32_t>(thumbnail.size()) : 0)) {
+          placed = andarium::camera::place_exif(
+              std::span<uint8_t>(image, jpeg_size), meta.jpeg_gap_offset, meta.jpeg_gap_length,
+              std::span<const uint8_t>(exif->GetApp1Buffer(), exif->GetApp1Length()));
+        }
+      }
+    }
+    if (!placed) {
+      ALOGW("%s: the Exif data was not placed", __FUNCTION__);
+    }
+  }
+  if (!andarium::camera::write_blob_header(std::span<uint8_t>(image, capacity),
+                                           static_cast<uint32_t>(jpeg_size))) {
+    return UNKNOWN_ERROR;
+  }
+  return OK;
+}
+
+status_t V4l2FrameSource::EncodeDerived(Camera* camera, const Pending& pending,
+                                        const uint8_t* mapped, SensorBuffer* buffer,
+                                        HalCameraMetadata* result_metadata,
+                                        const SensorCharacteristics& chars) {
+  uint8_t* image = buffer->plane.img.img;
+  const size_t capacity = buffer->plane.img.buffer_size;
+  const uint32_t width = buffer->width;
+  const uint32_t height = buffer->height;
+  if (mapped == nullptr || image == nullptr || capacity <= sizeof(andarium::camera::JpegBlobHeader) ||
+      width == 0 || height == 0 || ((width | height) & 1u) != 0) {
+    return BAD_VALUE;
+  }
+
+  // The window of the native frame, scaled to the picture's size, as I420.
+  const size_t luma = static_cast<size_t>(width) * height;
+  std::vector<uint8_t> scaled(luma + luma / 2);
+  std::vector<uint8_t> i420(luma + luma / 2);
+  uint8_t* y_plane = i420.data();
+  uint8_t* u_plane = y_plane + luma;
+  uint8_t* v_plane = u_plane + luma / 4;
+  if (ScaleWindow(*pending.stream, pending.window, mapped, scaled.data(),
+                  static_cast<int>(width), scaled.data() + luma, static_cast<int>(width), width,
+                  height) != 0 ||
+      libyuv::NV12ToI420(scaled.data(), static_cast<int>(width), scaled.data() + luma,
+                         static_cast<int>(width), y_plane, static_cast<int>(width), u_plane,
+                         static_cast<int>(width / 2), v_plane, static_cast<int>(width / 2),
+                         static_cast<int>(width), static_cast<int>(height)) != 0) {
+    ALOGE("%s: cannot scale the frame to %ux%u", __FUNCTION__, width, height);
+    return UNKNOWN_ERROR;
+  }
+  YCbCrPlanes planes;
+  planes.img_y = y_plane;
+  planes.img_cb = u_plane;
+  planes.img_cr = v_plane;
+  planes.y_stride = width;
+  planes.cbcr_stride = width / 2;
+  planes.cbcr_step = 1;
+
+  // The Exif thumbnail: the window of the same frame that has the thumbnail's aspect
+  // ratio, centred, scaled and encoded (the picture is cropped to the shape, not
+  // stretched to it).
+  std::vector<uint8_t> thumbnail;
+  camera_metadata_ro_entry_t entry;
+  if (result_metadata->Get(ANDROID_JPEG_THUMBNAIL_SIZE, &entry) == OK && entry.count == 2 &&
+      entry.data.i32[0] > 1 && entry.data.i32[1] > 1) {
+    const uint32_t thumb_width = static_cast<uint32_t>(entry.data.i32[0]) & ~1u;
+    const uint32_t thumb_height = static_cast<uint32_t>(entry.data.i32[1]) & ~1u;
+    const andarium::camera::Window crop = andarium::camera::centred_window(
+        {width, height}, {thumb_width, thumb_height});
+    const size_t thumb_luma = static_cast<size_t>(thumb_width) * thumb_height;
+    std::vector<uint8_t> small(thumb_luma + thumb_luma / 2);
+    YCbCrPlanes small_planes;
+    small_planes.img_y = small.data();
+    small_planes.img_cb = small.data() + thumb_luma;
+    small_planes.img_cr = small_planes.img_cb + thumb_luma / 4;
+    small_planes.y_stride = thumb_width;
+    small_planes.cbcr_stride = thumb_width / 2;
+    small_planes.cbcr_step = 1;
+    // The window starts on even pixels, so the chroma of its corner is half.
+    const size_t luma_offset = static_cast<size_t>(crop.y) * width + crop.x;
+    const size_t chroma_offset = static_cast<size_t>(crop.y / 2) * (width / 2) + crop.x / 2;
+    if (crop.width >= 2 && crop.height >= 2 &&
+        libyuv::I420Scale(y_plane + luma_offset, static_cast<int>(width),
+                          u_plane + chroma_offset, static_cast<int>(width / 2),
+                          v_plane + chroma_offset, static_cast<int>(width / 2),
+                          static_cast<int>(crop.width), static_cast<int>(crop.height),
+                          small_planes.img_y, static_cast<int>(small_planes.y_stride),
+                          small_planes.img_cb, static_cast<int>(small_planes.cbcr_stride),
+                          small_planes.img_cr, static_cast<int>(small_planes.cbcr_stride),
+                          static_cast<int>(thumb_width), static_cast<int>(thumb_height),
+                          libyuv::kFilterBox) == 0) {
+      thumbnail.resize(64 * 1024);  // an APP1 segment is limited to 64 KiB
+      JpegCompressor::YUV420Frame frame = {.output_buffer = thumbnail.data(),
+                                           .output_buffer_size = thumbnail.size(),
+                                           .yuv_planes = small_planes,
+                                           .width = thumb_width,
+                                           .height = thumb_height,
+                                           .app1_buffer = nullptr,
+                                           .app1_buffer_size = 0,
+                                           .color_space = buffer->color_space,
+                                           .quality = 80};
+      thumbnail.resize(JpegCompressor::EncodeYUV420(frame));
+    }
+  }
+
+  // The Exif data, as the stock sensor makes it.
+  std::unique_ptr<ExifUtils> exif(ExifUtils::Create(ExifCharacteristics(*camera, chars)));
+  const uint8_t* app1 = nullptr;
+  size_t app1_size = 0;
+  if (exif != nullptr && exif->Initialize() &&
+      exif->SetFromMetadata(*result_metadata, width, height)) {
+    char value[PROPERTY_VALUE_MAX];
+    property_get("ro.product.manufacturer", value, "unknown");
+    exif->SetMake(value);
+    property_get("ro.product.model", value, "unknown");
+    exif->SetModel(value);
+    exif->SetColorSpace(COLOR_SPACE_ICC_PROFILE);
+    if (exif->GenerateApp1(thumbnail.empty() ? nullptr : thumbnail.data(),
+                           static_cast<uint32_t>(thumbnail.size()))) {
+      app1 = exif->GetApp1Buffer();
+      app1_size = exif->GetApp1Length();
+    }
+  }
+  if (app1 == nullptr) {
+    ALOGW("%s: the Exif data was not made", __FUNCTION__);
+  }
+
+  const int quality = std::clamp<int>(camera->last_request.jpeg_quality, 1, 100);
+  JpegCompressor::YUV420Frame frame = {
+      .output_buffer = image,
+      .output_buffer_size = capacity - sizeof(andarium::camera::JpegBlobHeader),
+      .yuv_planes = planes,
+      .width = width,
+      .height = height,
+      .app1_buffer = app1,
+      .app1_buffer_size = app1_size,
+      .color_space = buffer->color_space,
+      .quality = quality};
+  const size_t jpeg_size = JpegCompressor::EncodeYUV420(frame);
+  if (jpeg_size == 0) {
+    ALOGE("%s: cannot encode a %ux%u picture", __FUNCTION__, width, height);
+    return UNKNOWN_ERROR;
+  }
+  if (!andarium::camera::write_blob_header(std::span<uint8_t>(image, capacity),
+                                           static_cast<uint32_t>(jpeg_size))) {
+    return UNKNOWN_ERROR;
+  }
+  return OK;
+}
+
+bool V4l2FrameSource::FrameResult(uint32_t camera_id, HalCameraMetadata* result,
+                                  nsecs_t* timestamp) {
+  auto found = cameras_.find(camera_id);
+  if (found == cameras_.end() || result == nullptr) {
+    return false;
+  }
+  Camera& camera = found->second;
+  if (timestamp != nullptr && camera.request_timestamp != 0) {
+    *timestamp = camera.request_timestamp;
+  }
+  if (!camera.have_meta) {
+    return false;
+  }
+  const bool flash = (camera.nodes.desc.flags & (abi::feature::flash | abi::feature::torch)) != 0;
+  const auto values = andarium::camera::result_of(camera.last_meta, camera.last_request, flash,
+                                                   camera.planner->af_engaged());
+
+  const uint8_t ae_state = static_cast<uint8_t>(values.ae_state);
+  const uint8_t af_state = static_cast<uint8_t>(values.af_state);
+  const uint8_t awb_state = static_cast<uint8_t>(values.awb_state);
+  const uint8_t flash_state = static_cast<uint8_t>(values.flash_state);
+  Replace(result, ANDROID_CONTROL_AE_STATE, &ae_state, 1);
+  Replace(result, ANDROID_CONTROL_AF_STATE, &af_state, 1);
+  Replace(result, ANDROID_CONTROL_AWB_STATE, &awb_state, 1);
+  Replace(result, ANDROID_FLASH_STATE, &flash_state, 1);
+  Replace(result, ANDROID_SENSOR_EXPOSURE_TIME, &values.exposure_ns, 1);
+  Replace(result, ANDROID_SENSOR_FRAME_DURATION, &values.frame_duration_ns, 1);
+  Replace(result, ANDROID_SENSOR_SENSITIVITY, &values.sensitivity, 1);
+  Replace(result, ANDROID_LENS_FOCUS_DISTANCE, &values.focus_distance, 1);
+  Replace(result, ANDROID_LENS_APERTURE, &values.aperture, 1);
+  Replace(result, ANDROID_LENS_FOCAL_LENGTH, &values.focal_length_mm, 1);
+  Replace(result, ANDROID_CONTROL_ZOOM_RATIO, &values.zoom_ratio, 1);
+  Replace(result, ANDROID_COLOR_CORRECTION_GAINS, values.wb_gains.data(), 4);
+  return true;
+}
+
+bool V4l2FrameSource::AppendNeutralColorPoint(uint32_t camera_id, HalCameraMetadata* result) {
+  auto found = cameras_.find(camera_id);
+  if (found == cameras_.end() || result == nullptr || !found->second.have_still_meta) {
+    return false;
+  }
+  const auto& meta = found->second.last_still_meta;
+  if (meta.neutral_point_q16[0] == 0 || meta.neutral_point_q16[1] == 0 ||
+      meta.neutral_point_q16[2] == 0) {
+    return false;
+  }
+  camera_metadata_rational_t neutral[3];
+  for (size_t i = 0; i < 3; ++i) {
+    neutral[i] = {static_cast<int32_t>(meta.neutral_point_q16[i]), 65536};
+  }
+  result->Set(ANDROID_SENSOR_NEUTRAL_COLOR_POINT, neutral, 3);
+  return true;
+}
+
+void V4l2FrameSource::CalculateAndAppendNoiseProfile(float gain /*in ISO*/,
+                                                     float /*max_raw_value*/,
+                                                     HalCameraMetadata* result /*out*/) {
+  if (result == nullptr) {
+    return;
+  }
+  double profile[8];
+  bool measured = false;
+  for (const auto& entry : cameras_) {
+    const Camera& camera = entry.second;
+    if (!camera.have_still_meta) {
+      continue;
+    }
+    // The still's own noise model, as pairs of binary32 values.
+    measured = true;
+    for (size_t i = 0; i < 8; ++i) {
+      float value;
+      memcpy(&value, &camera.last_still_meta.noise_profile_f32[i], sizeof(value));
+      profile[i] = value;
+      if (!(value > 0.0f)) {
+        measured = false;
+      }
+    }
+    break;
+  }
+  if (!measured) {
+    // Nominal until a still has measured the sensor: the shot noise grows with
+    // the gain and the read noise with its square.
+    const double scale = std::max(gain, 1.0f) / 100.0;
+    for (size_t i = 0; i < 8; i += 2) {
+      profile[i] = 2.0e-4 * scale;
+      profile[i + 1] = 1.0e-6 * scale * scale + 4.0e-7;
+    }
+  }
+  result->Set(ANDROID_SENSOR_NOISE_PROFILE, profile, 8);
+}
