+
+namespace android {
+namespace framesource {
+
+namespace abi = andarium::camera::abi;
+namespace av = andarium::camera::android_value;
+using andarium::camera::ControlPlanner;
+using andarium::camera::Request;
+using v4l2cam::V4l2Stream;
+
+// The platform's values that the planner's tables repeat.
+static_assert(av::ae_off == ANDROID_CONTROL_AE_MODE_OFF);
+static_assert(av::ae_on == ANDROID_CONTROL_AE_MODE_ON);
+static_assert(av::ae_on_auto_flash == ANDROID_CONTROL_AE_MODE_ON_AUTO_FLASH);
+static_assert(av::ae_on_always_flash == ANDROID_CONTROL_AE_MODE_ON_ALWAYS_FLASH);
+static_assert(av::af_off == ANDROID_CONTROL_AF_MODE_OFF);
+static_assert(av::af_auto == ANDROID_CONTROL_AF_MODE_AUTO);
+static_assert(av::af_macro == ANDROID_CONTROL_AF_MODE_MACRO);
+static_assert(av::af_continuous_video == ANDROID_CONTROL_AF_MODE_CONTINUOUS_VIDEO);
+static_assert(av::af_continuous_picture == ANDROID_CONTROL_AF_MODE_CONTINUOUS_PICTURE);
+static_assert(av::af_trigger_idle == ANDROID_CONTROL_AF_TRIGGER_IDLE);
+static_assert(av::af_trigger_start == ANDROID_CONTROL_AF_TRIGGER_START);
+static_assert(av::af_trigger_cancel == ANDROID_CONTROL_AF_TRIGGER_CANCEL);
