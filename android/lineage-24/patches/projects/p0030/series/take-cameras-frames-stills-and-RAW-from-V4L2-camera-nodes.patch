+
+namespace android {
+namespace framesource {
+
+// The frames, stills and metadata of a camera that the host drives, through
+// the camera device's V4L2 nodes. The sensor thread asks it to queue a request's
+// buffers (BeginRequest), then collects them one by one (ProduceFrame for video
+// and RAW, ProduceBlob for JPEG); the exposure's metadata then fills the
+// request's results (FrameResult).
+//
+// A size that the camera device does not serve itself (camera_plan.hpp,
+// derive_sizes) is made here from a frame of a native NV12 mode: the source
+// queues a mapped buffer of that mode, scales a window of the frame to the
+// stream's size with libyuv and, for a JPEG, encodes it with the HAL's own
+// compressor. The device's JPEG sizes keep the device's JPEG.
+class V4l2FrameSource : public IFrameSource {
+ public:
+  // Opens the camera's nodes; nullptr if it has none.
+  static std::unique_ptr<V4l2FrameSource> Create(const LogicalCharacteristics& chars,
+                                                 uint32_t camera_id);
+  ~V4l2FrameSource() override;
+
+  status_t ProduceFrame(uint32_t camera_id, nsecs_t timestamp,
+                        const SensorSettings& settings, SensorBuffer* buffer,
+                        const SensorBuffer* input_buffer) override;
+
+  void CalculateAndAppendNoiseProfile(float gain /*in ISO*/, float max_raw_value,
+                                      HalCameraMetadata* result /*out*/) override;
+
+  bool IsHostDriven() const override {
+    return true;
+  }
+  status_t BeginRequest(const LogicalCameraSettings& settings, Buffers* buffers) override;
+  bool FailsRequest(size_t outputs, size_t failed) const override;
+  status_t ProduceBlob(uint32_t camera_id, const SensorSettings& settings,
+                       SensorBuffer* buffer, HalCameraMetadata* result_metadata,
+                       const SensorCharacteristics& chars) override;
+  bool FrameResult(uint32_t camera_id, HalCameraMetadata* result,
+                   nsecs_t* timestamp) override;
+  bool AppendNeutralColorPoint(uint32_t camera_id, HalCameraMetadata* result) override;
+  void Interrupt() override {
+    interrupted_ = true;
+  }
+  void ClearInterrupt() override {
+    interrupted_ = false;
+  }
+
+ private:
+  struct StreamKey {
+    v4l2cam::V4l2Stream::Kind kind;
+    uint32_t pixel_format;
+    uint32_t width;
+    uint32_t height;
+    // The stream serves a size made here: its frames are mapped and copied,
+    // never imported.
+    bool derived = false;
+    // The framework stream of a video output, plus one; 0 for a still or a JPEG
+    // made here. Two outputs of one request that need the same frame size have
+    // a host stream each, so that one exposure fills both: on one stream they
+    // would take an exposure each, and halve the frame rate.
+    uint32_t output = 0;
+    bool operator<(const StreamKey& other) const {
+      return std::tie(kind, pixel_format, width, height, derived, output) <
+             std::tie(other.kind, other.pixel_format, other.width, other.height, other.derived,
+                      other.output);
+    }
+  };
+
+  // How one output buffer of a request is served.
+  struct Route {
+    bool ok = false;
+    StreamKey key{};
+    // A size made here: the part of the native frame it is scaled from.
+    andarium::camera::Window window;
+    // A device still that belongs to the request's capture group.
+    bool group_still = false;
+  };
+
+  struct Camera {
+    v4l2cam::CameraNodes nodes;
+    andarium::camera::Capabilities capabilities;
+    andarium::camera::Limits limits;
+    std::unique_ptr<andarium::camera::ControlPlanner> planner;
+    v4l2cam::UniqueFd control_fd;
+    std::vector<uint32_t> unsupported_controls;
+    std::unique_ptr<v4l2cam::V4l2MetaReader> meta;
+    std::map<StreamKey, std::unique_ptr<v4l2cam::V4l2Stream>> streams;
+    // What still_free_requests_begun_ was when a request last used each stream
+    // (or, for a video output, when a request that takes a still began), for the
+    // rule that closes an idle stream.
+    std::map<StreamKey, uint64_t> stream_last_request;
+    uint32_t buffers = 4;
+    uint32_t fps = 0;
+    andarium::camera::Request last_request;
+    andarium::camera::abi::Meta last_meta{};
+    bool have_meta = false;
+    andarium::camera::abi::Meta last_still_meta{};
+    bool have_still_meta = false;
+    // The CLOCK_BOOTTIME time of the first buffer of the request that completed.
+    nsecs_t request_timestamp = 0;
+    bool use_dmabuf = true;
+    // The sizes the camera serves, with how each is made.
+    andarium::camera::StreamSizes sizes;
+  };
+
+  struct Pending {
+    v4l2cam::V4l2Stream* stream = nullptr;
+    int slot = -1;
+    Camera* camera = nullptr;
+    bool derived = false;
+    andarium::camera::Window window;
+  };
+
+  V4l2FrameSource() = default;
+
+  static Route RouteOf(const Camera& camera, const SensorBuffer& buffer);
+  v4l2cam::V4l2Stream* StreamFor(Camera* camera, const StreamKey& key);
+  void CloseIdleStreams(Camera* camera, const std::set<StreamKey>& used);
+  static SensorCharacteristics ExifCharacteristics(const Camera& camera, SensorCharacteristics chars);
+  bool QueueBuffer(Camera* camera, v4l2cam::V4l2Stream* stream, SensorBuffer* buffer,
+                   const Route& route, uint32_t cookie, bool last_of_group);
+  bool WaitFor(const SensorBuffer* buffer, v4l2cam::V4l2Stream::Completion* completion,
+               const uint8_t** mapped, Pending* pending);
+  static status_t ScaleInto(const Pending& pending, const uint8_t* mapped, SensorBuffer* buffer);
+  status_t EncodeDerived(Camera* camera, const Pending& pending, const uint8_t* mapped,
+                         SensorBuffer* buffer, HalCameraMetadata* result_metadata,
+                         const SensorCharacteristics& chars);
+  bool MetaOf(Camera* camera, uint64_t sequence, andarium::camera::abi::Meta* meta);
+  static andarium::camera::Request RequestOf(const SensorSettings& settings);
+
+  std::map<uint32_t, Camera> cameras_;
+  std::map<const SensorBuffer*, Pending> pending_;
+  // The requests that took no still and have begun so far. A request that takes
+  // a still does not count: it holds the pipeline for as long as the host takes
+  // to make the picture, and the requests of the preview wait behind it, and it
+  // starts the count of absences again for every open video output.
+  uint64_t still_free_requests_begun_ = 0;
+  // A flush or a close is under way (Interrupt); the sensor clears it as it takes the next request.
+  std::atomic<bool> interrupted_{false};
+  // When the request being collected has to be complete, whatever its buffers
+  // wait for: one deadline for the whole request.
+  andarium::camera::RequestClock request_clock_;
+};
+
