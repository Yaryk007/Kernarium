+std::unique_ptr<V4l2FrameSource> V4l2FrameSource::Create(const LogicalCharacteristics& /*chars*/,
+                                                         uint32_t camera_id) {
+  v4l2cam::CameraNodes nodes;
+  if (!v4l2cam::CameraRegistry::Get().Find(camera_id, &nodes)) {
+    ALOGE("%s: no camera nodes for camera %u", __FUNCTION__, camera_id);
+    return nullptr;
+  }
+  std::unique_ptr<V4l2FrameSource> source(new V4l2FrameSource());
+  Camera& camera = source->cameras_[camera_id];
+  camera.nodes = nodes;
+  camera.capabilities = andarium::camera::capabilities_of(nodes.desc, nodes.formats);
+  camera.limits = andarium::camera::Limits::of(
+      nodes.desc, camera.capabilities,
+      andarium::camera::array_size(nodes.desc, camera.capabilities));
+  camera.limits.has_jpeg = nodes.has_jpeg;
+  camera.planner = std::make_unique<ControlPlanner>(camera.limits);
+  camera.sizes = andarium::camera::derive_sizes(nodes.formats);
+  camera.buffers = kStreamSlots;
+  camera.use_dmabuf = property_get_bool("vendor.camera.v4l2.dmabuf", true);
+
+  camera.control_fd.reset(open(nodes.capture_path.c_str(), O_RDWR | O_NONBLOCK | O_CLOEXEC));
+  if (!camera.control_fd.valid()) {
+    ALOGE("%s: cannot open %s: %s", __FUNCTION__, nodes.capture_path.c_str(), strerror(errno));
+    return nullptr;
+  }
+  camera.meta = v4l2cam::V4l2MetaReader::Create(nodes.meta_path);
+  if (camera.meta == nullptr) {
+    return nullptr;
+  }
+  return source;
+}
+
+V4l2FrameSource::~V4l2FrameSource() {
+  pending_.clear();
+  cameras_.clear();
+}
