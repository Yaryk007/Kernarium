+#ifndef HW_EMULATOR_CAMERA_V4L2_CHARACTERISTICS_H
+#define HW_EMULATOR_CAMERA_V4L2_CHARACTERISTICS_H
+
+#include <string>
+#include <vector>
+
+#include "ConfigUtils.h"
+
+namespace android {
+
+// The cameras of a device whose cameras are the V4L2 nodes of the camera
+// device (ro.vendor.camera.config=v4l2). Each camera that the nodes present
+// gets the characteristics its description and formats earn, on the template
+// emu_camera_v4l2.json in `config_dir`, and a frame source that reads the
+// nodes. A host without cameras gives an empty list.
+status_t GetV4l2CameraConfigurations(const std::string& config_dir,
+                                     std::vector<CameraConfiguration>* configs);
+
+}  // namespace android
