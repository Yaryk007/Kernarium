+template <typename T>
+status_t Put(HalCameraMetadata* metadata, uint32_t tag, const std::vector<T>& values) {
+  return metadata->Set(tag, values.data(), static_cast<uint32_t>(values.size()));
+}
+
+template <typename T>
+status_t PutOne(HalCameraMetadata* metadata, uint32_t tag, T value) {
+  return metadata->Set(tag, &value, 1);
+}
+
+// The int32 list `list_tag` (request, result or characteristics keys) without
+// `remove`, and with `add`.
+void EditKeyList(HalCameraMetadata* metadata, uint32_t list_tag,
+                 const std::set<int32_t>& remove, const std::set<int32_t>& add) {
+  camera_metadata_ro_entry_t entry;
+  if (metadata->Get(list_tag, &entry) != OK) {
+    return;
+  }
+  std::vector<int32_t> keys;
+  for (size_t i = 0; i < entry.count; ++i) {
+    if (remove.count(entry.data.i32[i]) == 0) {
+      keys.push_back(entry.data.i32[i]);
+    }
+  }
+  for (int32_t tag : add) {
+    if (std::find(keys.begin(), keys.end(), tag) == keys.end()) {
+      keys.push_back(tag);
+    }
+  }
+  Put(metadata, list_tag, keys);
+}
+
+void RemoveCharacteristic(HalCameraMetadata* metadata, uint32_t tag) {
+  metadata->Erase(tag);
+  EditKeyList(metadata, ANDROID_REQUEST_AVAILABLE_CHARACTERISTICS_KEYS,
+              {static_cast<int32_t>(tag)}, {});
+}
+
+void AddCharacteristic(HalCameraMetadata* metadata, uint32_t tag) {
+  EditKeyList(metadata, ANDROID_REQUEST_AVAILABLE_CHARACTERISTICS_KEYS, {},
+              {static_cast<int32_t>(tag)});
+}
+
+// Where camera_plan.hpp's state_raw_metadata writes: the camera's static metadata. The plan has no Android
+// headers and names the tags and values by number.
+class MetadataSink {
+ public:
+  explicit MetadataSink(HalCameraMetadata* metadata) : metadata_(metadata) {}
+
+  void put_bytes(int32_t tag, std::span<const uint8_t> values) {
+    Put(metadata_, static_cast<uint32_t>(tag), std::vector<uint8_t>(values.begin(), values.end()));
+  }
+  void list_characteristic(int32_t tag) { AddCharacteristic(metadata_, static_cast<uint32_t>(tag)); }
+  void list_result(int32_t tag) {
+    EditKeyList(metadata_, ANDROID_REQUEST_AVAILABLE_RESULT_KEYS, {}, {tag});
+  }
+
+ private:
+  HalCameraMetadata* metadata_;
+};
