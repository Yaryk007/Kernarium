+namespace android {
+namespace v4l2cam {
+
+// The control that returns a camera's static description (the record of
+// virtio_video_camera_desc) on its capture node. It is a read-only U8 compound
+// control of the camera device's private range.
+constexpr uint32_t kDescriptionControl = andarium::camera::abi::cid::private_base + 16;
+
+// The first bytes of a camera node's bus_info; the camera's index follows.
+constexpr const char kBusInfoPrefix[] = "virtio-camera:";
+
+// A file descriptor that closes itself.
+class UniqueFd {
+ public:
+  UniqueFd() = default;
+  explicit UniqueFd(int fd) : fd_(fd) {
+  }
+  UniqueFd(UniqueFd&& other) noexcept : fd_(other.release()) {
+  }
+  UniqueFd& operator=(UniqueFd&& other) noexcept {
+    if (this != &other) {
+      reset(other.release());
+    }
+    return *this;
+  }
+  UniqueFd(const UniqueFd&) = delete;
+  UniqueFd& operator=(const UniqueFd&) = delete;
+  ~UniqueFd() {
+    reset();
+  }
+
+  int get() const {
+    return fd_;
+  }
+  bool valid() const {
+    return fd_ >= 0;
+  }
+  int release() {
+    int fd = fd_;
+    fd_ = -1;
+    return fd;
+  }
+  void reset(int fd = -1);
+
+ private:
+  int fd_ = -1;
+};
+
+// ioctl() that retries when a signal interrupts it.
+int Ioctl(int fd, unsigned long request, void* arg);
+
+// The CLOCK_MONOTONIC time of a V4L2 buffer's timestamp as CLOCK_BOOTTIME.
+nsecs_t BufferTimeAsBoottime(const struct timeval& timestamp);
+
+// One camera as its nodes present it.
+struct CameraNodes {
+  uint32_t camera_index = 0;
+  std::string capture_path;
+  std::string meta_path;
+  andarium::camera::abi::Desc desc{};
+  andarium::camera::Formats formats;
+  // The pixel format of the video kind and of the Bayer still the node offers.
+  uint32_t video_pixel_format = 0;
+  uint32_t raw_pixel_format = 0;
+  bool has_jpeg = false;
+  // The camera's session is blocked: every frame is black.
+  bool blocked = false;
+};
+
+// Scans `dev_dir` for the camera device's capture and metadata nodes, reads
+// each camera's description and formats, and returns the cameras that have both
+// nodes, by ascending camera index. Only video10 and above are opened
+// (abi::may_be_camera_node): the codec nodes below are not.
+std::vector<CameraNodes> DiscoverCameraNodes(const std::string& dev_dir = "/dev");
+
+// Writes the controls, one at a time so that one the camera lacks does not stop
+// the rest. A control that the node does not have (VIDIOC_QUERY_EXT_CTRL says
+// EINVAL) is remembered in `unsupported` and not written again; a value the
+// camera refuses is logged once for the control and value and retires nothing.
+// `written`, when given, is called with each write the camera accepted.
+status_t WriteControls(int fd,
+                       const std::vector<andarium::camera::ControlWrite>& writes,
+                       std::vector<uint32_t>* unsupported,
+                       const std::function<void(const andarium::camera::ControlWrite&)>& written = nullptr);
+
+// Reads one integer control (a 64-bit one through its 64-bit member, the rest
+// through the 32-bit one); BAD_VALUE if the camera has none.
+status_t ReadControl(int fd, uint32_t id, int64_t* value);
+
+// Turns a camera's torch on or off through its capture node, without a stream.
+// INVALID_OPERATION when the camera's session is blocked: there is no torch then.
+status_t SetTorch(const CameraNodes& nodes, bool on);
+
+// What discovery found, by the camera ID Android uses. The characteristics, the
+// frame source and the torch read it.
+class CameraRegistry {
+ public:
+  static CameraRegistry& Get();
+
+  void Replace(std::map<uint32_t, CameraNodes> cameras);
+  bool Find(uint32_t camera_id, CameraNodes* nodes) const;
+  std::vector<uint32_t> Ids() const;
+
+  // The sets of cameras, by Android's IDs, that Android is told can stream at
+  // once: each set the host streams together, reduced to the cameras for which
+  // `meets` holds (the guaranteed concurrent stream sizes), when two remain.
+  // Also the cameras that cannot be open while `camera_id` is.
+  std::vector<std::vector<uint32_t>> ReportedConcurrentSets(
+      const std::function<bool(uint32_t)>& meets) const;
+  std::vector<uint32_t> ConflictingIds(uint32_t camera_id) const;
+
+ private:
+  mutable std::mutex mutex_;
+  std::map<uint32_t, CameraNodes> cameras_;
+};
+
+}  // namespace v4l2cam
+}  // namespace android
+
+#endif  // HW_EMULATOR_CAMERA_V4L2_UTILS_H
