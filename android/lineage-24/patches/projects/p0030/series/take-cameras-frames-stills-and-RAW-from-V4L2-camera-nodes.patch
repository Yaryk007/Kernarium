+#ifndef HW_EMULATOR_CAMERA_V4L2_FRAME_SOURCE_H
+#define HW_EMULATOR_CAMERA_V4L2_FRAME_SOURCE_H
+
+#include <atomic>
+#include <map>
+#include <memory>
+#include <set>
+#include <string>
