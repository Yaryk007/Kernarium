+std::unique_ptr<V4l2Stream> V4l2Stream::Create(const Params& params) {
+  std::unique_ptr<V4l2Stream> stream(new V4l2Stream(params));
+  if (stream->Initialize() != OK) {
+    return nullptr;
+  }
+  return stream;
+}
+
+V4l2Stream::~V4l2Stream() {
+  FreeBuffers();
+}
+
+status_t V4l2Stream::Initialize() {
+  fd_.reset(open(params_.path.c_str(), O_RDWR | O_NONBLOCK | O_CLOEXEC));
+  if (!fd_.valid()) {
+    ALOGE("%s: cannot open %s: %s", __FUNCTION__, params_.path.c_str(), strerror(errno));
+    return NO_INIT;
+  }
+
+  struct v4l2_format format = {};
+  format.type = TypeOf();
+  format.fmt.pix_mp.width = params_.width;
+  format.fmt.pix_mp.height = params_.height;
+  format.fmt.pix_mp.pixelformat = params_.pixel_format;
+  format.fmt.pix_mp.field = V4L2_FIELD_NONE;
+  format.fmt.pix_mp.num_planes = 1;
+  if (Ioctl(fd_.get(), VIDIOC_S_FMT, &format) != 0) {
+    ALOGE("%s: S_FMT %ux%u %08x: %s", __FUNCTION__, params_.width, params_.height,
+          params_.pixel_format, strerror(errno));
+    return BAD_VALUE;
+  }
+  if (format.fmt.pix_mp.width != params_.width ||
+      format.fmt.pix_mp.height != params_.height ||
+      format.fmt.pix_mp.pixelformat != params_.pixel_format ||
+      format.fmt.pix_mp.num_planes != 1) {
+    ALOGE("%s: the node would not give %ux%u %08x in one plane (got %ux%u %08x, %u planes)",
+          __FUNCTION__, params_.width, params_.height, params_.pixel_format,
+          format.fmt.pix_mp.width, format.fmt.pix_mp.height,
+          format.fmt.pix_mp.pixelformat, format.fmt.pix_mp.num_planes);
+    return BAD_VALUE;
+  }
+  num_planes_ = format.fmt.pix_mp.num_planes;
+  bytes_per_line_ = format.fmt.pix_mp.plane_fmt[0].bytesperline;
+  size_image_ = format.fmt.pix_mp.plane_fmt[0].sizeimage;
+
+  if (params_.kind == Kind::kVideo && params_.fps != 0) {
+    SetFrameRate(params_.fps);
+  }
+
+  status_t result = params_.try_dmabuf ? AllocateBuffers(true) : BAD_VALUE;
+  if (result != OK) {
+    result = AllocateBuffers(false);
+  }
+  return result;
+}
+
+status_t V4l2Stream::AllocateBuffers(bool dmabuf) {
+  struct v4l2_requestbuffers request = {};
+  request.type = TypeOf();
+  request.memory = dmabuf ? V4L2_MEMORY_DMABUF : V4L2_MEMORY_MMAP;
+  request.count = params_.buffers;
+  if (Ioctl(fd_.get(), VIDIOC_REQBUFS, &request) != 0 || request.count == 0) {
+    ALOGW("%s: REQBUFS (%s): %s", __FUNCTION__, dmabuf ? "dma-buf" : "mmap",
+          strerror(errno));
+    return BAD_VALUE;
+  }
+  slots_.assign(request.count, Slot());
+  cookies_.assign(request.count, 0);
+  dmabuf_ = dmabuf;
+  if (dmabuf) {
+    return OK;
+  }
+  for (uint32_t index = 0; index < request.count; ++index) {
+    struct v4l2_plane planes[VIDEO_MAX_PLANES] = {};
+    struct v4l2_buffer buffer = {};
+    buffer.type = TypeOf();
+    buffer.memory = V4L2_MEMORY_MMAP;
+    buffer.index = index;
+    buffer.m.planes = planes;
+    buffer.length = num_planes_;
+    if (Ioctl(fd_.get(), VIDIOC_QUERYBUF, &buffer) != 0) {
+      ALOGE("%s: QUERYBUF: %s", __FUNCTION__, strerror(errno));
+      FreeBuffers();
+      return BAD_VALUE;
+    }
+    void* mapped = mmap(nullptr, planes[0].length, PROT_READ | PROT_WRITE, MAP_SHARED,
+                        fd_.get(), planes[0].m.mem_offset);
+    if (mapped == MAP_FAILED) {
+      ALOGE("%s: mmap: %s", __FUNCTION__, strerror(errno));
+      FreeBuffers();
+      return NO_MEMORY;
+    }
+    slots_[index].mapped = static_cast<uint8_t*>(mapped);
+    slots_[index].mapped_length = planes[0].length;
+  }
+  return OK;
+}
+
+void V4l2Stream::FreeBuffers() {
+  if (fd_.valid()) {
+    if (streaming_) {
+      int type = TypeOf();
+      Ioctl(fd_.get(), VIDIOC_STREAMOFF, &type);
+      streaming_ = false;
+    }
+    for (auto& slot : slots_) {
+      if (slot.mapped != nullptr) {
+        munmap(slot.mapped, slot.mapped_length);
+        slot.mapped = nullptr;
+      }
+    }
+    if (!slots_.empty()) {
+      struct v4l2_requestbuffers request = {};
+      request.type = TypeOf();
+      request.memory = dmabuf_ ? V4L2_MEMORY_DMABUF : V4L2_MEMORY_MMAP;
+      request.count = 0;
+      Ioctl(fd_.get(), VIDIOC_REQBUFS, &request);
+    }
+  }
+  slots_.clear();
+  cookies_.clear();
+}
+
+status_t V4l2Stream::SwitchToMmap() {
+  std::lock_guard<std::mutex> lock(mutex_);
+  if (!dmabuf_) {
+    return OK;
+  }
+  FreeBuffers();
+  return AllocateBuffers(false);
+}
+
+void V4l2Stream::SetFrameRate(uint32_t fps) {
+  if (fps == 0 || !fd_.valid()) {
+    return;
+  }
+  struct v4l2_streamparm parameters = {};
+  parameters.type = TypeOf();
+  parameters.parm.capture.timeperframe.numerator = 1;
+  parameters.parm.capture.timeperframe.denominator = fps;
+  if (Ioctl(fd_.get(), VIDIOC_S_PARM, &parameters) != 0) {
+    ALOGV("%s: S_PARM %u: %s", __FUNCTION__, fps, strerror(errno));
+  }
+}
+
+int V4l2Stream::Queue(int dma_fd, size_t dma_length, uint32_t group_cookie,
+                      bool last_of_group) {
+  std::lock_guard<std::mutex> lock(mutex_);
+  int slot = -1;
+  for (size_t index = 0; index < slots_.size(); ++index) {
+    if (!slots_[index].queued && !slots_[index].done) {
+      slot = static_cast<int>(index);
+      break;
+    }
+  }
+  if (slot < 0) {
+    ALOGE("%s: every buffer of the stream is in flight", __FUNCTION__);
+    return -1;
+  }
+  if (dmabuf_ && (dma_fd < 0 || dma_length < size_image_)) {
+    return -1;
+  }
+
+  struct v4l2_plane planes[VIDEO_MAX_PLANES] = {};
+  struct v4l2_buffer buffer = {};
+  buffer.type = TypeOf();
+  buffer.memory = dmabuf_ ? V4L2_MEMORY_DMABUF : V4L2_MEMORY_MMAP;
+  buffer.index = slot;
+  buffer.m.planes = planes;
+  buffer.length = num_planes_;
+  if (dmabuf_) {
+    planes[0].m.fd = dma_fd;
+    planes[0].length = dma_length;
+  }
+  if (group_cookie != 0) {
+    buffer.timestamp.tv_sec = group_cookie;
+    if (last_of_group) {
+      buffer.flags |= V4L2_BUF_FLAG_LAST;
+    }
+  }
+  if (Ioctl(fd_.get(), VIDIOC_QBUF, &buffer) != 0) {
+    ALOGE("%s: QBUF: %s", __FUNCTION__, strerror(errno));
+    return -1;
+  }
+  slots_[slot].queued = true;
+  slots_[slot].done = false;
+  if (!streaming_) {
+    int type = TypeOf();
+    if (Ioctl(fd_.get(), VIDIOC_STREAMON, &type) != 0) {
+      ALOGE("%s: STREAMON: %s", __FUNCTION__, strerror(errno));
+      // The buffer just queued is not going to be filled: take it back, so that
+      // no slot stays with a device that is not running.
+      ResetLocked();
+      return -1;
+    }
+    streaming_ = true;
+  }
+  last_used_ = systemTime(SYSTEM_TIME_MONOTONIC);
+  return slot;
+}
+
+status_t V4l2Stream::DequeueLocked() {
+  struct v4l2_plane planes[VIDEO_MAX_PLANES] = {};
+  struct v4l2_buffer buffer = {};
+  buffer.type = TypeOf();
+  buffer.memory = dmabuf_ ? V4L2_MEMORY_DMABUF : V4L2_MEMORY_MMAP;
+  buffer.m.planes = planes;
+  buffer.length = num_planes_;
+  if (Ioctl(fd_.get(), VIDIOC_DQBUF, &buffer) != 0) {
+    return errno == EAGAIN ? WOULD_BLOCK : UNKNOWN_ERROR;
+  }
+  if (buffer.index >= slots_.size()) {
+    return UNKNOWN_ERROR;
+  }
+  auto& slot = slots_[buffer.index];
+  slot.queued = false;
+  slot.done = true;
+  slot.completion.sequence = buffer.sequence;
+  slot.completion.timestamp = BufferTimeAsBoottime(buffer.timestamp);
+  slot.completion.bytes_used = planes[0].bytesused;
+  slot.completion.error = (buffer.flags & V4L2_BUF_FLAG_ERROR) != 0;
+  return OK;
+}
+
+void V4l2Stream::ResetLocked() {
+  if (fd_.valid()) {
+    int type = TypeOf();
+    Ioctl(fd_.get(), VIDIOC_STREAMOFF, &type);
+  }
+  streaming_ = false;
+  for (auto& slot : slots_) {
+    slot.queued = false;
+    slot.done = false;
+  }
+}
+
+status_t V4l2Stream::Wait(int slot, nsecs_t timeout_ns, const std::atomic<bool>* cancel,
+                          Completion* completion) {
+  const nsecs_t deadline = systemTime(SYSTEM_TIME_MONOTONIC) + timeout_ns;
+  for (;;) {
+    {
+      std::lock_guard<std::mutex> lock(mutex_);
+      if (slot < 0 || static_cast<size_t>(slot) >= slots_.size()) {
+        return BAD_VALUE;
+      }
+      while (DequeueLocked() == OK) {
+      }
+      if (slots_[slot].done) {
+        *completion = slots_[slot].completion;
+        slots_[slot].done = false;
+        last_used_ = systemTime(SYSTEM_TIME_MONOTONIC);
+        return OK;
+      }
+      if (!slots_[slot].queued) {
+        // Another wait's reset took the buffer back.
+        return DEAD_OBJECT;
+      }
+      if (cancel != nullptr && cancel->load()) {
+        ResetLocked();
+        return DEAD_OBJECT;
+      }
+      if (deadline - systemTime(SYSTEM_TIME_MONOTONIC) <= 0) {
+        ALOGW("%s: the camera did not deliver the buffer of slot %d; the stream starts over",
+              __FUNCTION__, slot);
+        ResetLocked();
+        return TIMED_OUT;
+      }
+    }
+    const nsecs_t remaining = deadline - systemTime(SYSTEM_TIME_MONOTONIC);
+    struct pollfd wait = {fd_.get(), POLLIN | POLLRDNORM, 0};
+    int ready = poll(&wait, 1, static_cast<int>(std::clamp<nsecs_t>(remaining / 1000000 + 1, 1, 1000)));
+    if (ready < 0 && errno != EINTR) {
+      return UNKNOWN_ERROR;
+    }
+  }
+}
+
+const uint8_t* V4l2Stream::Mapped(int slot) const {
+  std::lock_guard<std::mutex> lock(mutex_);
+  if (slot < 0 || static_cast<size_t>(slot) >= slots_.size()) {
+    return nullptr;
+  }
+  return slots_[slot].mapped;
+}
+
+std::unique_ptr<V4l2MetaReader> V4l2MetaReader::Create(const std::string& path) {
+  std::unique_ptr<V4l2MetaReader> reader(new V4l2MetaReader());
+  if (reader->Initialize(path) != OK) {
+    return nullptr;
+  }
+  return reader;
+}
+
+status_t V4l2MetaReader::Initialize(const std::string& path) {
+  fd_.reset(open(path.c_str(), O_RDWR | O_NONBLOCK | O_CLOEXEC));
+  if (!fd_.valid()) {
+    ALOGE("%s: cannot open %s: %s", __FUNCTION__, path.c_str(), strerror(errno));
+    return NO_INIT;
+  }
+  struct v4l2_format format = {};
+  format.type = V4L2_BUF_TYPE_META_CAPTURE;
+  if (Ioctl(fd_.get(), VIDIOC_G_FMT, &format) != 0) {
+    ALOGE("%s: G_FMT on %s: %s", __FUNCTION__, path.c_str(), strerror(errno));
+    return BAD_VALUE;
+  }
+  record_size_ = format.fmt.meta.buffersize;
+  if (record_size_ < sizeof(abi::Meta)) {
+    ALOGE("%s: the metadata buffer of %s is %zu bytes, a record is %zu", __FUNCTION__,
+          path.c_str(), record_size_, sizeof(abi::Meta));
+    return BAD_VALUE;
+  }
+
+  struct v4l2_requestbuffers request = {};
+  request.type = V4L2_BUF_TYPE_META_CAPTURE;
+  request.memory = V4L2_MEMORY_MMAP;
+  request.count = kMetaBuffers;
+  if (Ioctl(fd_.get(), VIDIOC_REQBUFS, &request) != 0 || request.count == 0) {
+    ALOGE("%s: REQBUFS on %s: %s", __FUNCTION__, path.c_str(), strerror(errno));
+    return BAD_VALUE;
+  }
+  for (uint32_t index = 0; index < request.count; ++index) {
+    struct v4l2_buffer buffer = {};
+    buffer.type = V4L2_BUF_TYPE_META_CAPTURE;
+    buffer.memory = V4L2_MEMORY_MMAP;
+    buffer.index = index;
+    if (Ioctl(fd_.get(), VIDIOC_QUERYBUF, &buffer) != 0) {
+      ALOGE("%s: QUERYBUF: %s", __FUNCTION__, strerror(errno));
+      return BAD_VALUE;
+    }
+    void* mapped = mmap(nullptr, buffer.length, PROT_READ | PROT_WRITE, MAP_SHARED,
+                        fd_.get(), buffer.m.offset);
+    if (mapped == MAP_FAILED) {
+      ALOGE("%s: mmap: %s", __FUNCTION__, strerror(errno));
+      return NO_MEMORY;
+    }
+    mapped_.push_back(static_cast<uint8_t*>(mapped));
+    mapped_length_.push_back(buffer.length);
+    if (Ioctl(fd_.get(), VIDIOC_QBUF, &buffer) != 0) {
+      ALOGE("%s: QBUF: %s", __FUNCTION__, strerror(errno));
+      return BAD_VALUE;
+    }
+  }
+  int type = V4L2_BUF_TYPE_META_CAPTURE;
+  if (Ioctl(fd_.get(), VIDIOC_STREAMON, &type) != 0) {
+    ALOGE("%s: STREAMON: %s", __FUNCTION__, strerror(errno));
+    return BAD_VALUE;
+  }
+  thread_ = std::thread([this] { Run(); });
+  return OK;
+}
+
+V4l2MetaReader::~V4l2MetaReader() {
+  {
+    std::lock_guard<std::mutex> lock(mutex_);
+    stop_ = true;
+  }
+  if (thread_.joinable()) {
+    thread_.join();
+  }
+  if (fd_.valid()) {
+    int type = V4L2_BUF_TYPE_META_CAPTURE;
+    Ioctl(fd_.get(), VIDIOC_STREAMOFF, &type);
+  }
+  for (size_t index = 0; index < mapped_.size(); ++index) {
+    munmap(mapped_[index], mapped_length_[index]);
+  }
+}
+
+void V4l2MetaReader::Run() {
+  for (;;) {
+    {
+      std::lock_guard<std::mutex> lock(mutex_);
+      if (stop_) {
+        return;
+      }
+    }
+    struct pollfd wait = {fd_.get(), POLLIN | POLLRDNORM, 0};
+    int ready = poll(&wait, 1, 100);
+    if (ready <= 0) {
+      continue;
+    }
+    for (;;) {
+      struct v4l2_buffer buffer = {};
+      buffer.type = V4L2_BUF_TYPE_META_CAPTURE;
+      buffer.memory = V4L2_MEMORY_MMAP;
+      if (Ioctl(fd_.get(), VIDIOC_DQBUF, &buffer) != 0) {
+        break;
+      }
+      if (buffer.index < mapped_.size() && buffer.bytesused >= sizeof(abi::Meta)) {
+        abi::Meta meta;
+        memcpy(&meta, mapped_[buffer.index], sizeof(meta));
+        {
+          std::lock_guard<std::mutex> lock(mutex_);
+          records_[meta.sequence] = meta;
+          while (records_.size() > kMetaRecordsKept) {
+            records_.erase(records_.begin());
+          }
+        }
+        arrived_.notify_all();
+      }
+      buffer.bytesused = 0;
+      Ioctl(fd_.get(), VIDIOC_QBUF, &buffer);
+    }
+  }
+}
+
+bool V4l2MetaReader::WaitFor(uint64_t sequence, nsecs_t timeout_ns, abi::Meta* meta) {
+  std::unique_lock<std::mutex> lock(mutex_);
+  auto found = [&] { return records_.find(sequence) != records_.end(); };
+  if (!arrived_.wait_for(lock, std::chrono::nanoseconds(timeout_ns), found)) {
+    return false;
+  }
+  *meta = records_.at(sequence);
+  return true;
+}
+
+bool V4l2MetaReader::Latest(abi::Meta* meta) {
+  std::lock_guard<std::mutex> lock(mutex_);
+  if (records_.empty()) {
+    return false;
+  }
+  *meta = records_.rbegin()->second;
+  return true;
+}
+
+}  // namespace v4l2cam
+}  // namespace android
