+
+// Whether a stream of the configuration has a video encoder as its consumer (camera_session.hpp).
+bool HasEncoderStream(const google_camera_hal::StreamConfiguration& config) {
+  std::vector<andarium::camera::StreamUse> uses;
+  uses.reserve(config.streams.size());
+  for (const auto& stream : config.streams) {
+    uses.push_back({stream.stream_type == google_camera_hal::StreamType::kInput, stream.usage});
+  }
+  return andarium::camera::has_encoder_stream(uses.data(), uses.size());
+}
