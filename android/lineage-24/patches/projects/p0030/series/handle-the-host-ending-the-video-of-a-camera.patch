@@ -565,6 +574,49 @@ bool V4l2FrameSource::MetaOf(Camera* camera, uint64_t sequence, abi::Meta* meta)
   return camera->meta->Latest(meta);
 }
 
+// A video buffer that failed under a black, interrupted record is the host's end of the camera's video (the host fails the
+// buffers of a video it ended, and records them so); any other failed buffer is a failed buffer. What follows depends on the
+// session (camera_session.hpp): one with an encoder stream is over (the sensor tells the framework), any other goes on: the
+// camera's video streams are closed at the start of the next request, which ends the host's loss, and the requests after it
+// open them again.
+void V4l2FrameSource::NoteFailedBuffer(Camera* camera, const V4l2Stream& stream) {
+  abi::Meta latest{};
+  const bool has_record = camera->meta != nullptr && camera->meta->Latest(&latest);
+  if (!andarium::camera::camera_lost(stream.params().kind == V4l2Stream::Kind::kVideo, true,
+                                     has_record, has_record ? latest.flags : 0)) {
+    return;
+  }
+  if (health_ == nullptr || health_->response() == andarium::camera::LossResponse::device_error) {
+    if (!device_lost_.exchange(true)) {
+      ALOGW("%s: the host ended the camera: its video buffers fail under an interrupted record (flags %x)",
+            __FUNCTION__, static_cast<unsigned>(latest.flags));
+    }
+    return;
+  }
+  if (!camera->reopen.pending()) {
+    ALOGW("%s: the host ended the camera's video: its video streams are closed and opened again (flags %x)",
+          __FUNCTION__, static_cast<unsigned>(latest.flags));
+  }
+  camera->reopen.note_loss();
+}
+
+// Closes the camera's video streams: the host's loss ends with the last of them, and the next request that needs one opens
+// it again. Between requests only, when no buffer is in flight. A close is a stop of the stream and a close of the node; the
+// source waits for nothing.
+void V4l2FrameSource::CloseVideoStreams(Camera* camera) {
+  size_t closed = 0;
+  for (auto it = camera->streams.begin(); it != camera->streams.end();) {
+    if (it->first.kind == V4l2Stream::Kind::kVideo) {
+      camera->stream_last_request.erase(it->first);
+      it = camera->streams.erase(it);
+      ++closed;
+    } else {
+      ++it;
+    }
+  }
+  ALOGI("%s: closed %zu video streams of the camera the host ended", __FUNCTION__, closed);
+}
