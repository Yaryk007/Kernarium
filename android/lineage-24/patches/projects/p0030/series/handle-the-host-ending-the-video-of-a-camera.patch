+  // Returns the request as failed, as a whole: every output buffer goes back with an error
+  // status, whatever it did before (one output may have completed when another met the loss),
+  // the buffers are marked so that none of them sends a buffer error of its own, and the
+  // framework is told by one error for the request, with no shutter and no results. The request
+  // that also tells the framework that the device is gone (the first of a lost session) is
+  // reported as a failed request all the same, after the device error: the framework returns the
+  // buffers of a request only when it was told that the request failed, so a request that only
+  // the device error named would keep its buffers, and the references to their streams, until
+  // the camera service itself ends, and the application's own reopening would fail.
+  auto fail_request = [&](bool device_error) {
+    for (auto& buffer : *buffers) {
+      if (!buffer->is_input) {
+        buffer->stream_buffer.status = BufferStatus::kError;
+      }
+      buffer->is_failed_request = true;
+    }
+    next_capture_time_ = getSystemTimeWithSource(timestamp_source);
+    next_readout_time_ = next_capture_time_ + exposure_time;
+    if (callback.notify != nullptr) {
+      if (device_error) {
+        NotifyMessage device = ErrorMessage{.frame_number = frame_number,
+                                            .error_stream_id = -1,
+                                            .error_code = ErrorCode::kErrorDevice};
+        callback.notify(pipeline_id, device);
+      }
+      NotifyMessage request = ErrorMessage{.frame_number = frame_number,
+                                           .error_stream_id = -1,
+                                           .error_code = ErrorCode::kErrorRequest};
+      callback.notify(pipeline_id, request);
+    }
+    if (result != nullptr) {
+      result->result_metadata.reset();
+    }
+    buffers->clear();
+  };
+
+  // A session whose device is gone (the host ended the camera's video in a session with an
+  // encoder stream) never restarts production, whatever configuration it is in: each request
+  // it still holds drains here, in order, as a failed request, without a word to the frame
+  // source. The one that tells the framework that the device is gone is the first of them.
+  if (session_health_->lost()) {
+    ALOGW("%s: frame %u failed: the session's device is gone", __FUNCTION__, frame_number);
+    fail_request(session_health_->claim_device_error());
+    return;
+  }
+
   // The request processor hands every buffer over marked as failed, and the
   // stock sensor flips the mark as it produces the buffer. Here the source's
   // BeginRequest marks only the buffers it could not queue, so the others start
@@ -134,24 +180,22 @@ void EmulatedSensor::CaptureFromHost(
       ++failed;
     }
   }
-  if (frame_source_->FailsRequest(outputs, failed)) {
-    ALOGW("%s: frame %u failed: none of its %zu outputs was produced",
-          __FUNCTION__, frame_number, outputs);
-    for (auto& buffer : *buffers) {
-      buffer->is_failed_request = true;
-    }
-    next_capture_time_ = getSystemTimeWithSource(timestamp_source);
-    next_readout_time_ = next_capture_time_ + exposure_time;
-    if (callback.notify != nullptr) {
-      NotifyMessage msg = ErrorMessage{.frame_number = frame_number,
-                                       .error_stream_id = -1,
-                                       .error_code = ErrorCode::kErrorRequest};
-      callback.notify(pipeline_id, msg);
-    }
-    if (result != nullptr) {
-      result->result_metadata.reset();
+  // A camera whose video the host ended in a session with an encoder stream fails the request
+  // whatever else was produced, and the session is over: the loss is latched at the session's
+  // scope, and the framework is told that the device is gone (ERROR_DEVICE), once, besides the
+  // failed request.
+  if (frame_source_->DeviceLost()) {
+    session_health_->latch_lost();
+  }
+  const bool device_lost = session_health_->lost();
+  if (device_lost || frame_source_->FailsRequest(outputs, failed)) {
+    if (device_lost) {
+      ALOGW("%s: frame %u failed: the host ended the camera", __FUNCTION__, frame_number);
+    } else {
+      ALOGW("%s: frame %u failed: none of its %zu outputs was produced",
+            __FUNCTION__, frame_number, outputs);
     }
-    buffers->clear();
+    fail_request(device_lost && session_health_->claim_device_error());
     return;
   }
 
