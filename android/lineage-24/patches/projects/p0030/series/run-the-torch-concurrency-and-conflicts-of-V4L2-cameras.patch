+        (nodes.desc.flags & (andarium::camera::abi::feature::flash |
+                             andarium::camera::abi::feature::torch)) != 0) {
+      torch_cb_(one_map.first, google_camera_hal::TorchModeStatus::kNotAvailable);
+    }
+  }
