 void EmulatedCameraProviderHwlImpl::NotifyPhysicalCameraUnavailable() {
+  // The framework starts a torch as available; one whose camera's session is
+  // blocked is not, from the start.
+  for (const auto& one_map : camera_id_map_) {
+    v4l2cam::CameraNodes nodes;
+    if (torch_cb_ != nullptr && v4l2cam::CameraRegistry::Get().Find(one_map.first, &nodes) &&
