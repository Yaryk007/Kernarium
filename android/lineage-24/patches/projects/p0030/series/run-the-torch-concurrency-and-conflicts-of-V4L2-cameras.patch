diff --git a/devices/EmulatedCamera/hwl/EmulatedTorchState.cpp b/devices/EmulatedCamera/hwl/EmulatedTorchState.cpp
index edb6311bfc62f7efa7391908f246bba9f16ca418..a98116fbed46eff39eb8eb8786948108dc6be4f3 100644
--- a/devices/EmulatedCamera/hwl/EmulatedTorchState.cpp
+++ b/devices/EmulatedCamera/hwl/EmulatedTorchState.cpp
@@ -20,10 +20,22 @@
 
 #include <log/log.h>
 
+#include "V4l2Utils.h"
+
 namespace android {
 
 using android::google_camera_hal::TorchModeStatus;
 
+// The status of a torch nobody is using: off, or not available when the
+// camera's session is blocked (privacy), as the camera device reports it.
+TorchModeStatus EmulatedTorchState::IdleStatus() const {
+  v4l2cam::CameraNodes nodes;
+  if (v4l2cam::CameraRegistry::Get().Find(camera_id_, &nodes) && nodes.blocked) {
+    return TorchModeStatus::kNotAvailable;
+  }
+  return TorchModeStatus::kAvailableOff;
+}
+
 status_t EmulatedTorchState::SetTorchMode(TorchMode mode) {
   std::lock_guard<std::mutex> lock(mutex_);
   if (camera_open_) {
@@ -32,16 +44,26 @@ status_t EmulatedTorchState::SetTorchMode(TorchMode mode) {
     return UNKNOWN_ERROR;
   }
 
-  torch_status_ = (mode == TorchMode::kOn) ? TorchModeStatus::kAvailableOn : TorchModeStatus::kAvailableOff;
+  // The torch of a camera the host drives is the camera device's flash control.
+  v4l2cam::CameraNodes nodes;
+  if (v4l2cam::CameraRegistry::Get().Find(camera_id_, &nodes)) {
+    const status_t res = v4l2cam::SetTorch(nodes, mode == TorchMode::kOn);
+    if (res != OK) {
+      ALOGE("%s: the camera device did not set the torch: %d", __FUNCTION__, res);
+      torch_status_ = TorchModeStatus::kNotAvailable;
+      torch_cb_(camera_id_, TorchModeStatus::kNotAvailable);
+      return res;
+    }
+  }
+
+  torch_status_ = (mode == TorchMode::kOn) ? TorchModeStatus::kAvailableOn : IdleStatus();
   if (mode == TorchMode::kOff && support_torch_strength_control_) {
     new_torch_strength_level_ = default_level_;
     ALOGV("%s: Turning torch OFF so reset the torch strength to default level:%d",
           __FUNCTION__, default_level_);
   }
 
-  torch_cb_(camera_id_, (mode == TorchMode::kOn)
-                            ? TorchModeStatus::kAvailableOn
-                            : TorchModeStatus::kAvailableOff);
+  torch_cb_(camera_id_, torch_status_);
   return OK;
 }
 
@@ -75,7 +97,8 @@ void EmulatedTorchState::AcquireFlashHw() {
 void EmulatedTorchState::ReleaseFlashHw() {
   std::lock_guard<std::mutex> lock(mutex_);
   camera_open_ = false;
-  torch_cb_(camera_id_, TorchModeStatus::kAvailableOff);
+  torch_status_ = IdleStatus();
+  torch_cb_(camera_id_, torch_status_);
 }
 
 int32_t EmulatedTorchState::GetTorchStrengthLevel() {
