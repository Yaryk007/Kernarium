index 0000000000000000000000000000000000000000..d2105c09f0f31cfa7a0c73f1c423c0756df17431
--- /dev/null
+++ b/devices/EmulatedCamera/hwl/EmulatedSensorHost.cpp
@@ -0,0 +1,189 @@
