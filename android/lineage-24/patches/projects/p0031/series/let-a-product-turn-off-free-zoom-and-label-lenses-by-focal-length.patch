+++ b/app/src/main/java/org/lineageos/aperture/utils/LensZoomRatioUtils.kt
@@ -0,0 +1,79 @@
+/*
+ * SPDX-FileCopyrightText: The LineageOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package org.lineageos.aperture.utils
+
+import kotlin.math.abs
+
+/**
+ * Zoom ratios of lenses, as their lens buttons show them.
+ */
+object LensZoomRatioUtils {
+    /**
+     * The ratios a phone's lens buttons usually carry.
+     */
+    private val LABEL_RATIOS = floatArrayOf(0.5f, 1f, 2f, 2.5f, 3f, 4f, 5f)
+
+    /**
+     * How far a ratio may lie from a label ratio and still take it, relative to the label ratio.
+     */
+    private const val LABEL_TOLERANCE = 0.2f
+
+    /**
+     * Get the zoom ratio of a lens to the main lens, for its lens button.
+     *
+     * The focal length over the diagonal of the sensor is the 35 mm-equivalent focal length up
+     * to a factor that is the same for every camera, so the quotient of two of them is the
+     * ratio of the equivalent focal lengths. The result is snapped to the nearest label ratio
+     * when it lies within the tolerance of it.
+     *
+     * @param focalLengthPerDiagonal The focal length of the lens over the diagonal of its sensor
+     * @param mainFocalLengthPerDiagonal The same for the main lens
+     * @return The ratio, or null if either value is unknown
+     */
+    fun getZoomRatio(
+        focalLengthPerDiagonal: Float?,
+        mainFocalLengthPerDiagonal: Float?,
+    ): Float? {
+        if (
+            focalLengthPerDiagonal == null || mainFocalLengthPerDiagonal == null
+            || !focalLengthPerDiagonal.isFinite() || !mainFocalLengthPerDiagonal.isFinite()
+            || focalLengthPerDiagonal <= 0f || mainFocalLengthPerDiagonal <= 0f
+        ) {
+            return null
+        }
+
+        return snapToLabelRatio(focalLengthPerDiagonal / mainFocalLengthPerDiagonal)
+    }
+
+    /**
+     * Get the main camera of each side: of the cameras that face the same way, the one with the
+     * lowest ID. The external cameras all face the same side, so they share one main camera.
+     *
+     * @param cameras The cameras
+     * @param side The side a camera faces
+     * @param cameraId The ID of a camera
+     * @return The main camera of each side
+     */
+    fun <T, S> getMainCameras(
+        cameras: Collection<T>,
+        side: (T) -> S,
+        cameraId: (T) -> String,
+    ): Map<S, T> = cameras.groupBy(side).mapValues { (_, sameSideCameras) ->
+        sameSideCameras.minBy(cameraId)
+    }
+
+    /**
+     * Snap a zoom ratio to the nearest label ratio if it lies within the tolerance of it.
+     */
+    fun snapToLabelRatio(zoomRatio: Float): Float {
+        val labelRatio = LABEL_RATIOS.minBy { abs(it - zoomRatio) }
+
+        return when (abs(labelRatio - zoomRatio) <= LABEL_TOLERANCE * labelRatio) {
+            true -> labelRatio
+            false -> zoomRatio
+        }
+    }
+}
