+package com.android.server.display.config
+
+import com.google.common.truth.Truth.assertThat
+import org.junit.Test
+import org.junit.runner.RunWith
+import org.junit.runners.JUnit4
+
+@RunWith(JUnit4::class)
+class ThermalThrottlingDataTest {
+    private val severe = ThermalStatusEnum.SEVERE.toPowerManagerConstant()
+
+    @Test
+    fun loadRefreshRateThrottlingMapIfAbsent_noMap_takesTheMapOfTheConfiguration() {
+        val config = createDisplayConfiguration {
+            thermalThrottling {
+                refreshRateThrottlingMap {
+                    refreshRateThrottlingPoint(ThermalStatusEnum.SEVERE, "0", "30")
+                }
+            }
+        }
+        val data = ThermalThrottlingData()
+
+        data.loadRefreshRateThrottlingMapIfAbsent(config)
+
+        assertThat(data.refreshRateThrottlingMap.keys).containsExactly("default")
+        val points = data.refreshRateThrottlingMap.getValue("default")
+        assertThat(points.size()).isEqualTo(1)
+        assertThat(points.get(severe).min).isEqualTo(0f)
+        assertThat(points.get(severe).max).isEqualTo(30f)
+    }
+
+    @Test
+    fun loadRefreshRateThrottlingMapIfAbsent_ownMap_keepsIt() {
+        val own = createDisplayConfiguration {
+            thermalThrottling {
+                refreshRateThrottlingMap {
+                    refreshRateThrottlingPoint(ThermalStatusEnum.SEVERE, "30", "60")
+                }
+            }
+        }
+        val default = createDisplayConfiguration {
+            thermalThrottling {
+                refreshRateThrottlingMap {
+                    refreshRateThrottlingPoint(ThermalStatusEnum.SEVERE, "0", "30")
+                }
+            }
+        }
+        val data = ThermalThrottlingData()
+        data.loadThermalThrottlingConfig(own)
+
+        data.loadRefreshRateThrottlingMapIfAbsent(default)
+
+        val points = data.refreshRateThrottlingMap.getValue("default")
+        assertThat(points.size()).isEqualTo(1)
+        assertThat(points.get(severe).min).isEqualTo(30f)
+        assertThat(points.get(severe).max).isEqualTo(60f)
+    }
+
+    @Test
+    fun loadRefreshRateThrottlingMapIfAbsent_noThermalThrottling_leavesNoMap() {
+        val data = ThermalThrottlingData()
+
+        data.loadRefreshRateThrottlingMapIfAbsent(createDisplayConfiguration())
+
+        assertThat(data.refreshRateThrottlingMap).isEmpty()
+    }
+
+    @Test
+    fun loadRefreshRateThrottlingMapIfAbsent_noRefreshRateMap_leavesNoMap() {
+        val config = createDisplayConfiguration {
+            thermalThrottling {
+                brightnessThrottlingMap {
+                    brightnessThrottlingPoint(ThermalStatusEnum.SEVERE, "0.4")
+                }
+            }
+        }
+        val data = ThermalThrottlingData()
+
+        data.loadRefreshRateThrottlingMapIfAbsent(config)
+
+        assertThat(data.refreshRateThrottlingMap).isEmpty()
+    }
+
+    @Test
+    fun loadRefreshRateThrottlingMapIfAbsent_takesNothingButTheRefreshRateMap() {
+        val config = createDisplayConfiguration {
+            thermalThrottling {
+                brightnessThrottlingMap {
+                    brightnessThrottlingPoint(ThermalStatusEnum.SEVERE, "0.4")
+                }
+                refreshRateThrottlingMap {
+                    refreshRateThrottlingPoint(ThermalStatusEnum.SEVERE, "0", "30")
+                }
+            }
+        }
+        val data = ThermalThrottlingData()
+
+        data.loadRefreshRateThrottlingMapIfAbsent(config)
+
+        assertThat(data.refreshRateThrottlingMap.keys).containsExactly("default")
+        assertThat(data.thermalBrightnessThrottlingDataMapByThrottlingId).isEmpty()
+        assertThat(data.thermalThrottlingWorkDurations).isEmpty()
+    }
+}
