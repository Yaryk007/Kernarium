# Exact pinned sources of the accessibility applications the image builds
# (TalkBack, and eSpeak NG with its libsonic) and where each is materialized in
# the Android source tree. A series under dependencies/patches carries the
# maintained changes of its source, its Soong build among them; the tree the
# series records is the identity of the replayed source.
ACCESSIBILITY_SOURCE_SCHEMA=1
TALKBACK_UPSTREAM_REPOSITORY='https://github.com/google/talkback.git'
