# The Magisk release the Android release's root/ files are made from: the
# official APK, which the release carries unmodified, and the init_boot that
# Magisk's own patcher makes from it. The producer takes the APK as a local
# file and refuses one whose size or SHA-256 is not the one recorded here.
# Name, version and digest only.
LINEAGE24_MAGISK_SCHEMA=1
LINEAGE24_MAGISK_NAME='Magisk'
LINEAGE24_MAGISK_VERSION='v31.1'
LINEAGE24_MAGISK_VERSION_CODE=31100
LINEAGE24_MAGISK_APK_SHA256='89cefac0a318afa39fb3880c45c87b036c05bc1ebf02a7a715b7f8d7c26ac6e7'
LINEAGE24_MAGISK_APK_SIZE=10679283
