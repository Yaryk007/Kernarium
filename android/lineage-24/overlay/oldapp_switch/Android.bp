package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

// The shell-user command of Old app compatibility. It lists the applications
// the compatibility layer can apply to (with their labels in the system's
// language, which only the package manager and the applications' resources
// give) and turns the layer on or off for one by writing
// persist.sys.kernarium.oldapp.<package>. The command is a Java tool started
// through app_process, as the platform's own `content` is, so it is installed
// on system_ext with its wrapper script, beside the policy that types the
// property (overlay/sepolicy/system_ext/private/kernarium_oldapp_prop.te).
java_binary {
    name: "kernarium_oldapp",
    wrapper: "kernarium_oldapp",
    srcs: ["src/**/*.java"],
    platform_apis: true,
    system_ext_specific: true,
}
