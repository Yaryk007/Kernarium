// SPDX-License-Identifier: Apache-2.0
package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

// The vibrator HAL of a device with haptics. The ODM manifest of the "haptics"
// SKU (manifest_haptics.xml, named by ODM_MANIFEST_HAPTICS_FILES in
// BoardConfig.mk) declares it, so the module carries no vintf_fragments.
cc_binary {
    name: "android.hardware.vibrator-service.andarium",
    relative_install_path: "hw",
    init_rc: ["android.hardware.vibrator-service.andarium.rc"],
    vendor: true,
    cpp_std: "c++20",
    srcs: [
        "HostLink.cpp",
        "Vibrator.cpp",
        "main.cpp",
    ],
    shared_libs: [
        "libbase",
        "libbinder_ndk",
        "libcutils",
        "libfmq",
        "liblog",
        "libutils",
        "android.hardware.vibrator-V4-ndk",
        "android.hardware.common-V2-ndk",
        "android.hardware.common.fmq-V1-ndk",
        "android.media.audio.common.types-V5-ndk",
    ],
    cflags: ["-Wall", "-Wextra", "-Werror"],
}
