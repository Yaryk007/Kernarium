<resources>
    <!-- The virtual Wi-Fi device has no way to change its MAC address, and a
         second MAC would need a second DHCP lease on the host's network, so the
         station keeps the MAC it has. Cuttlefish's overlay turns both on. -->
    <bool name="config_wifi_connected_mac_randomization_supported">false</bool>
    <bool name="config_wifiAllowNonPersistentMacRandomizationOnOpenSsids">false</bool>

    <!-- The virtual Wi-Fi interface is a station: no peer-to-peer or access
         point to randomize. -->
    <bool name="config_wifi_p2p_mac_randomization_supported">false</bool>
    <bool name="config_wifi_ap_mac_randomization_supported">false</bool>

    <!-- The one virtual network is on 5 GHz channel 48 as well as 2.4 GHz. -->
    <bool name="config_wifi5ghzSupport">true</bool>

    <!-- A failed internet check never disables the one network, because a
         disabled network is never joined again and the guest has no other:
         the platform disables it when its failure count (at least one) reaches
         the threshold, so only the largest value is never reached. -->
    <integer name="config_wifiDisableReasonNoInternetPermanentThreshold">2147483647</integer>
    <integer name="config_wifiDisableReasonNoInternetTemporaryThreshold">2147483647</integer>
</resources>
