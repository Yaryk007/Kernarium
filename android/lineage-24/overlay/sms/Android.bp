// SPDX-License-Identifier: Apache-2.0
package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

// Hands Android a text message the host application sends, as an SMS-DELIVER
// broadcast the way the radio stack makes one (Delivery). It runs as the system
// user, which alone may send the protected SMS broadcasts, in a domain of its
// own (sepolicy/system_ext/private/kernarium_sms.te), and takes messages only
// from the host over vsock, on a listening socket that the holder of the port
// (listener/) passes to it while messages are in flight (HostService).
android_app {
    name: "KernariumSms",
    manifest: "AndroidManifest.xml",
    srcs: ["src/**/*.java"],
    platform_apis: true,
    certificate: "platform",
    system_ext_specific: true,
    optimize: { enabled: false },
}
