#
# Input device configuration of "Kernarium Mouse" (1af4:0004), the host's
# relative mouse (wheels, and motion while an app captures the pointer). The
# device is virtual, but it is what a USB mouse would be: external, so that a
# button, a wheel step or motion wakes the screen.

device.internal = 0
