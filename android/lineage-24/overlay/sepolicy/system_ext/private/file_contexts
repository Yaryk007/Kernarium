# Saves the virtual Wi-Fi network once the system is up.
/(system_ext|system/system_ext)/bin/kernarium_wifi_network\.sh  u:object_r:kernarium_wifi_network_exec:s0

# Gives back the memory of the cached boot-started apps once boot has settled.
/(system_ext|system/system_ext)/bin/kernarium_reclaim_boot_apps\.sh  u:object_r:kernarium_reclaim_boot_apps_exec:s0

# Applies the host's time zone once the system is up.
/(system_ext|system/system_ext)/bin/kernarium_time_zone\.sh  u:object_r:kernarium_time_zone_exec:s0

# Moves a guest that started with an older release to the on-screen keyboard default, once.
/(system_ext|system/system_ext)/bin/kernarium_keyboard_default\.sh  u:object_r:kernarium_keyboard_default_exec:s0

# The holder of the text message service's vsock port, the script that starts the service, and the socket the
# service takes the listening socket through.
/(system_ext|system/system_ext)/bin/kernarium_sms_listener  u:object_r:kernarium_sms_listener_exec:s0
/(system_ext|system/system_ext)/bin/kernarium_sms_wake\.sh  u:object_r:kernarium_sms_wake_exec:s0
/dev/socket/kernarium_sms  u:object_r:kernarium_sms_socket:s0
