#
# The adb public key the host application authorizes for a boot reaches the
# guest as androidboot.kernarium.adb_key, which init turns into
# ro.boot.kernarium.adb_key. A ro.boot.* property is a bootloader_prop unless
# a context says otherwise, and every application may read that. The key is
# the host's own for this installation, an identifier that no other property
# shows, so no application may read it. adbd reads it itself (route p0011).
# init sets it from the kernel command line, which the policy allows as it
# does for any property type (init may set every property_type). dumpstate
# can read it too, so a bug report that the user shares can carry the key; the
# policy leaves that as it is.
system_internal_prop(kernarium_adb_key_prop)
get_prop(adbd, kernarium_adb_key_prop)
