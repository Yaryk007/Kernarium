# SPDX-License-Identifier: Apache-2.0
#
# After boot completes the product moves a guest that started with an older
# release to its on-screen keyboard default, once
# (tools/kernarium_keyboard_default.sh): `cmd settings get secure` reads the
# "Show on-screen keyboard" setting and `cmd settings put secure` writes it. A
# vendor domain may neither execute /system/bin/cmd nor be the framework's
# client, so the script runs in a core domain defined here, as the time zone
# script does.
type kernarium_keyboard_default, domain;
typeattribute kernarium_keyboard_default coredomain;
type kernarium_keyboard_default_exec, exec_type, system_file_type, file_type;

init_daemon_domain(kernarium_keyboard_default)
binder_use(kernarium_keyboard_default)

# The shell script, and getprop, setprop, log and sleep from the toolbox.
allow kernarium_keyboard_default shell_exec:file rx_file_perms;
allow kernarium_keyboard_default toolbox_exec:file rx_file_perms;
# cmd runs in the script's domain.
allow kernarium_keyboard_default system_file:file execute_no_trans;

# cmd finds the settings service and hands it the descriptors it writes the
# output to and the binder it receives the result on: the descriptors are the
# script's own. Without the binder transfer the service never gets the command,
# and without the call back to that binder cmd never learns the command is done.
allow kernarium_keyboard_default settings_service:service_manager find;
allow kernarium_keyboard_default system_server:binder transfer;
allow system_server kernarium_keyboard_default:binder call;
allow system_server kernarium_keyboard_default:fd use;
allow system_server kernarium_keyboard_default:fifo_file { getattr read write };

# The marker that the script has looked at the setting.
system_internal_prop(kernarium_keyboard_default_prop)
set_prop(kernarium_keyboard_default, kernarium_keyboard_default_prop)
get_prop(kernarium_keyboard_default, kernarium_keyboard_default_prop)
