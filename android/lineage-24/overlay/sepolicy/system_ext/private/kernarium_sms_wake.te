# SPDX-License-Identifier: Apache-2.0
#
# The holder of the text message service's vsock port starts this script through init when a connection waits
# and no session runs (tools: overlay/sms/listener/kernarium_sms_wake.sh): `cmd activity start-service` starts
# the service as the system user. A domain that owns a vsock socket may not be the framework's client, so the
# script runs in a core domain defined here, as the Wi-Fi network script does, and holds nothing but what
# `cmd` needs to reach the activity manager.
type kernarium_sms_wake, domain;
typeattribute kernarium_sms_wake coredomain;
type kernarium_sms_wake_exec, exec_type, system_file_type, file_type;

init_daemon_domain(kernarium_sms_wake)
binder_use(kernarium_sms_wake)

# The shell script; cmd runs in the script's domain.
allow kernarium_sms_wake shell_exec:file rx_file_perms;
allow kernarium_sms_wake system_file:file execute_no_trans;

# cmd finds the activity manager and hands it the descriptors it writes the command's output to and the binder
# it receives the result on: the descriptors are the script's own. Without the binder transfer the activity
# manager never gets the command, and without the call back to that binder cmd never learns the command is done.
allow kernarium_sms_wake activity_service:service_manager find;
allow kernarium_sms_wake system_server:binder transfer;
allow system_server kernarium_sms_wake:binder call;
allow system_server kernarium_sms_wake:fd use;
