# SPDX-License-Identifier: Apache-2.0
# The thermal HAL (overlay/thermal) reads the host's thermal state from the host
# application over vsock, like the vibrator and motion HALs. The platform
# requires this explicit domain classification for direct vsock access. The
# service accepts only host CID 2 and never connects out.
typeattribute hal_thermal_default unconstrained_vsock_violators;
allow hal_thermal_default self:vsock_socket { create bind listen accept read write shutdown getattr getopt };

# Debug dump output goes to dumpsys's pipes.
allow hal_thermal_default shell:fd use;
allow hal_thermal_default shell:fifo_file write;
allow hal_thermal_default dumpstate:fd use;
allow hal_thermal_default dumpstate:fifo_file write;
