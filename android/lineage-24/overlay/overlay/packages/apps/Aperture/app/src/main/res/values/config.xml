<resources>
    <!-- The camera has one button per lens of the host and no free zoom. Each back lens of the host
         is a camera device of its own with a lens button (0 is the main lens, 3 the ultra wide, 4
         the telephoto), labelled by its focal length against the main lens. There is no pinch to
         zoom, no zoom slider and no Zoom action for the hardware keys, and tapping the active
         lens button does nothing. -->
    <bool name="config_enableZoom">false</bool>
    <bool name="config_enableAuxCameras">true</bool>
    <!-- ID 2 never gets a button: a host that publishes the wide lens a second time, as 2 beside
         its camera 0, would show it twice. A host that publishes no ID 2 is not affected. -->
    <string-array name="config_ignoredAuxCameraIds">
        <item>2</item>
    </string-array>
</resources>
