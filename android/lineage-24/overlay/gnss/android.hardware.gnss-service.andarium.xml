<!--
     The vendor manifest fragment of the GNSS HAL (vintf_fragments of
     android.hardware.gnss-service.andarium). Every device declares it, so there
     is no ODM SKU for GNSS.
-->
<manifest version="1.0" type="device">
    <hal format="aidl">
        <name>android.hardware.gnss</name>
        <version>7</version>
        <fqname>IGnss/default</fqname>
    </hal>
</manifest>
