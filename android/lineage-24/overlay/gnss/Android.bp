// SPDX-License-Identifier: Apache-2.0
package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

// The GNSS HAL of the guest: the host's position, read from the receiver the
// kernel registers as /dev/gnss0. Its fragment declares IGnss/default on every
// device, since the receiver exists on every device. gnss_engine.hpp holds why
// a session keeps a wakelock (libpower).
cc_binary {
    name: "android.hardware.gnss-service.andarium",
    relative_install_path: "hw",
    init_rc: ["android.hardware.gnss-service.andarium.rc"],
    vintf_fragments: ["android.hardware.gnss-service.andarium.xml"],
    vendor: true,
    cpp_std: "c++20",
    defaults: ["gnss_use_latest_hal_aidl_ndk_shared"],
    srcs: [
        "Gnss.cpp",
        "main.cpp",
    ],
    shared_libs: [
        "libbinder_ndk",
        "liblog",
        "libpower",
    ],
    cflags: ["-Wall", "-Wextra", "-Werror"],
}
