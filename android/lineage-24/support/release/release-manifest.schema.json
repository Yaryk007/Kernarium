{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linux-um-darwin.invalid/android/lineage-24/release-manifest.schema.json",
  "title": "LineageOS 24 mainline 6.18 4 KiB UML release manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "release_id",
    "directory_name",
    "product_family",
    "acceptance",
    "published_at_utc",
    "android",
    "source",
    "kernel",
    "outer",
    "producer",
    "inventory"
  ],
  "properties": {
    "schema_version": { "enum": [6, 7, 8] },
    "release_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
    "directory_name": { "type": "string" },
    "product_family": { "const": "lineage-24-mainline-6.18-4k" },
    "acceptance": { "const": "accepted" },
    "published_at_utc": { "type": "string" },
    "android": { "type": "object" },
    "source": { "type": "object" },
    "kernel": { "type": "object" },
    "outer": {
      "type": "object",
      "required": ["revision", "dirty"],
      "properties": {
        "revision": { "type": "string" },
        "dirty": { "const": false },
        "input_trees": {
          "description": "Git object ID of each path in support/release/input-paths.tsv marked input, as of the commit the release was built from; schema 7 and later.",
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
        }
      },
      "additionalProperties": false
    },
    "producer": { "type": "object" },
    "inventory": { "type": "array" },
    "root": {
      "description": "The Magisk root files of the release, under root/: the official APK, unmodified, and a copy of the release's own init_boot that Magisk's patcher made; schema 8, optional. Both files are in the inventory.",
      "type": "object",
      "additionalProperties": false,
      "required": ["magisk", "apk", "boot_image"],
      "properties": {
        "magisk": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version_name", "version_code"],
          "properties": {
            "name": { "const": "Magisk" },
            "version_name": { "type": "string", "pattern": "^v[0-9]+\\.[0-9]+(\\.[0-9]+)?$" },
            "version_code": { "type": "integer", "minimum": 1 }
          }
        },
        "apk": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256", "size"],
          "properties": {
            "path": { "type": "string", "pattern": "^root/Magisk-v[0-9]+\\.[0-9]+(\\.[0-9]+)?\\.apk$" },
            "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "size": { "type": "integer", "minimum": 1 }
          }
        },
        "boot_image": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256", "size", "stock_init_boot_sha256", "stock_init_boot_sha1"],
          "properties": {
            "path": { "const": "root/init_boot-magisk.img" },
            "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "size": { "type": "integer", "minimum": 1 },
            "stock_init_boot_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "stock_init_boot_sha1": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "schema_version": { "enum": [7, 8] } } },
      "then": { "properties": { "outer": { "required": ["input_trees"] } } }
    },
    {
      "if": { "required": ["root"] },
      "then": { "properties": { "schema_version": { "const": 8 } } }
    }
  ]
}
