<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.example.andarium.smsprobe">
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.MANAGE_VIRTUAL_MACHINE" />
    <application android:label="SMS Probe" android:debuggable="true">
        <receiver android:name=".ReceivedReceiver" android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter android:priority="1000">
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>
        <receiver android:name=".CommandReceiver" android:exported="true" />
    </application>
</manifest>
