// SPDX-License-Identifier: Apache-2.0
package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

// Foreground location client for the candidate image's GNSS checks.
android_app {
    name: "AndariumLocationProbe",
    manifest: "app/AndroidManifest.xml",
    srcs: ["app/src/**/*.java"],
    sdk_version: "current",
    optimize: { enabled: false },
}
