diff --git a/android/soong/espeak-data.sh b/android/soong/espeak-data.sh
new file mode 100755
index 0000000000000000000000000000000000000000..fda30719a92b73f293cd696ef522a06a4bed1244
--- /dev/null
+++ b/android/soong/espeak-data.sh
@@ -0,0 +1,68 @@
+#!/bin/bash
+# SPDX-License-Identifier: GPL-3.0-or-later
+#
+# Compiles the voice data of eSpeak NG as cmake/data.cmake does (intonations, phonemes, and the
+# dictionary of every language of its list) and writes the app's raw resources as a resource zip:
+#   raw/espeakdata.zip       the data below espeak-ng-data/ (what android/build.gradle's createDataArchive zips)
+#   raw/espeakdata_version   the SHA-256 of that archive (createDataVersion)
+#
+#   espeak-data.sh ESPEAK_NG SOONG_ZIP SOURCE_DIR WORK_DIR OUT_ZIP
+#
+# Everything is written below WORK_DIR; SOURCE_DIR is only read.
+set -eu
+
+absolute() { case $1 in /*) printf '%s' "$1" ;; *) printf '%s/%s' "$PWD" "$1" ;; esac; }
+tool=$(absolute "$1")
+zip=$(absolute "$2")
+src=$3
+gen=$(absolute "$4")
+out=$(absolute "$5")
+
+data=$gen/data
+log=$gen/espeak-data.log
+rm -rf "$data" "$gen/res" "$gen/espeakdata.zip"
+mkdir -p "$data/espeak-ng-data/voices" "$data/dictsource" "$gen/res/raw"
+
+# the data directory's layout: lang and voices/!v are copied, the rest is compiled
+cp -R "$src/espeak-ng-data/lang" "$data/espeak-ng-data/"
+cp -R "$src/espeak-ng-data/voices/!v" "$data/espeak-ng-data/voices/"
+cp -R "$src/phsource" "$data/"
+chmod -R u+w "$data"
+export ESPEAK_DATA_PATH=$data
+
+run() { # DIRECTORY ARGUMENT...: the tool, in that directory, with its output in the log
+	local dir=$1
+	shift
+	(cd "$dir" && "$tool" "$@") >> "$log" 2>&1 || { echo "espeak-data: $* failed in $dir; the end of the log:" >&2; tail -n 30 "$log" >&2; exit 1; }
+}
+: > "$log"
+run "$data/phsource" --compile-intonations
+run "$data/phsource" --compile-phonemes
+
+# the languages: the first list of cmake/data.cmake, the one the data build loops over
+langs=$(awk 'NR == 1 { next } /^\)/ { exit } { print }' "$src/cmake/data.cmake" | tr '\n' ' ')
+count=0
+for lang in $langs; do
+	files=("$src/dictsource/${lang}_rules" "$src/dictsource/${lang}_list")
+	if [ -e "$src/dictsource/extra/${lang}_listx" ]; then
+		files+=("$src/dictsource/extra/${lang}_listx")
+	elif [ -e "$src/dictsource/${lang}_listx" ]; then
+		files+=("$src/dictsource/${lang}_listx")
+	fi
+	[ ! -e "$src/dictsource/${lang}_emoji" ] || files+=("$src/dictsource/${lang}_emoji")
+	cp "${files[@]}" "$data/dictsource/"
+	chmod u+w "$data/dictsource"/*
+	run "$data/dictsource" "--compile=$lang"
+	[ -s "$data/espeak-ng-data/${lang}_dict" ] || { echo "espeak-data: no dictionary for $lang" >&2; exit 1; }
+	count=$((count + 1))
+done
+# a list that parsed to far fewer names than cmake/data.cmake holds (it has more than a hundred) means the file's layout changed
+[ "$count" -ge 100 ] || { echo "espeak-data: only $count languages read from cmake/data.cmake" >&2; exit 1; }
+for f in intonations phondata phondata-manifest phonindex phontab; do
+	[ -s "$data/espeak-ng-data/$f" ] || { echo "espeak-data: $f was not compiled" >&2; exit 1; }
+done
+
+"$zip" -o "$gen/espeakdata.zip" -P espeak-ng-data -C "$data/espeak-ng-data" -D "$data/espeak-ng-data"
+cp "$gen/espeakdata.zip" "$gen/res/raw/espeakdata.zip"
+printf '%s' "$(sha256sum "$gen/espeakdata.zip" | cut -d' ' -f1)" > "$gen/res/raw/espeakdata_version"
+"$zip" -o "$out" -C "$gen/res" -D "$gen/res"
