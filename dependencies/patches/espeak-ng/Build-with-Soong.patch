diff --git a/Android.bp b/Android.bp
new file mode 100644
index 0000000000000000000000000000000000000000..c19d7b3b64026ff250431aaaf522ddd5e3e4eaa4
--- /dev/null
+++ b/Android.bp
@@ -0,0 +1,272 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+// eSpeak NG, built from source by the Android image build. The Gradle and CMake
+// files of android/ are not used by it. This file lists what they build: the speech
+// engine and its parts as static libraries for the device and the host, the host
+// tool that compiles the voice data (cmake/data.cmake), libttsespeak, and the app.
+// The pinned libsonic tree is placed in sonic/ beside these sources.
+
+package {
+    default_applicable_licenses: ["external_espeak_ng_license"],
+    default_visibility: ["//external/espeak-ng:__subpackages__"],
+}
+
+license {
+    name: "external_espeak_ng_license",
+    visibility: [":__subpackages__"],
+    license_kinds: [
+        "SPDX-license-identifier-GPL-3.0-or-later",
+    ],
+    license_text: [
+        "COPYING",
+    ],
+}
+
+// The Android parts of the project: the app and the JNI library.
+license {
+    name: "external_espeak_ng_app_license",
+    visibility: [":__subpackages__"],
+    license_kinds: [
+        "SPDX-license-identifier-Apache-2.0",
+    ],
+    license_text: [
+        "COPYING.APACHE",
+    ],
+}
+
+license {
+    name: "external_espeak_ng_sonic_license",
+    visibility: [":__subpackages__"],
+    license_kinds: [
+        "SPDX-license-identifier-Apache-2.0",
+    ],
+    license_text: [
+        "sonic/LICENSE",
+    ],
+}
+
+// What the engine sources are built with. The values are those of the Gradle build
+// (async speech, MBROLA and PCAudio off; libsonic and speechPlayer on), in
+// android/soong/config/<device|host>/config.h.
+cc_defaults {
+    name: "espeak_ng_flags",
+    local_include_dirs: [
+        "src/libespeak-ng",
+        "src/include",
+        "src/include/compat",
+        "src/ucd-tools/src/include",
+        "src/speechPlayer/include",
+        "sonic",
+    ],
+    cflags: [
+        "-Wno-error",
+        "-fvisibility=hidden",
+        "-fno-exceptions",
+        "-fwrapv",
+        "-DLIBESPEAK_NG_EXPORT=1",
+        "-DPATH_ESPEAK_DATA=\"/usr/share/espeak-ng-data\"",
+    ],
+}
+
+// The device libraries are NDK libraries of the app's minSdk; the host ones are
+// for the data tool.
+cc_defaults {
+    name: "espeak_ng_device",
+    defaults: ["espeak_ng_flags"],
+    sdk_version: "21",
+    stl: "none",
+    local_include_dirs: ["android/soong/config/device"],
+}
+
+// The tool runs as a genrule tool: it carries its C++ library.
+cc_defaults {
+    name: "espeak_ng_host",
+    defaults: ["espeak_ng_flags"],
+    stl: "libc++_static",
+    local_include_dirs: ["android/soong/config/host"],
+}
+
+cc_defaults {
+    name: "espeak_ng_ucd_sources",
+    srcs: [
+        "src/ucd-tools/src/case.c",
+        "src/ucd-tools/src/categories.c",
+        "src/ucd-tools/src/ctype.c",
+        "src/ucd-tools/src/proplist.c",
+        "src/ucd-tools/src/scripts.c",
+        "src/ucd-tools/src/tostring.c",
+    ],
+    export_include_dirs: ["src/ucd-tools/src/include"],
+}
+
+// The platform makes -Wnon-virtual-dtor an error for C++; speechPlayer's WaveGenerator is an
+// interface without a virtual destructor, and its one implementation has one.
+cc_defaults {
+    name: "espeak_ng_speechplayer_sources",
+    srcs: [
+        "src/speechPlayer/src/frame.cpp",
+        "src/speechPlayer/src/speechPlayer.cpp",
+        "src/speechPlayer/src/speechWaveGenerator.cpp",
+    ],
+    cflags: ["-Wno-error=non-virtual-dtor"],
+    export_include_dirs: ["src/speechPlayer/include"],
+}
+
+cc_defaults {
+    name: "espeak_ng_sonic_sources",
+    srcs: ["sonic/sonic.c"],
+    export_include_dirs: ["sonic"],
+    licenses: ["external_espeak_ng_sonic_license"],
+}
+
+cc_defaults {
+    name: "espeak_ng_core_sources",
+    srcs: [
+        "src/libespeak-ng/common.c",
+        "src/libespeak-ng/mnemonics.c",
+        "src/libespeak-ng/error.c",
+        "src/libespeak-ng/ieee80.c",
+        "src/libespeak-ng/compiledata.c",
+        "src/libespeak-ng/compiledict.c",
+        "src/libespeak-ng/dictionary.c",
+        "src/libespeak-ng/encoding.c",
+        "src/libespeak-ng/intonation.c",
+        "src/libespeak-ng/langopts.c",
+        "src/libespeak-ng/numbers.c",
+        "src/libespeak-ng/phoneme.c",
+        "src/libespeak-ng/phonemelist.c",
+        "src/libespeak-ng/readclause.c",
+        "src/libespeak-ng/setlengths.c",
+        "src/libespeak-ng/soundicon.c",
+        "src/libespeak-ng/spect.c",
+        "src/libespeak-ng/ssml.c",
+        "src/libespeak-ng/synthdata.c",
+        "src/libespeak-ng/synthesize.c",
+        "src/libespeak-ng/tr_languages.c",
+        "src/libespeak-ng/translate.c",
+        "src/libespeak-ng/translateword.c",
+        "src/libespeak-ng/voices.c",
+        "src/libespeak-ng/wavegen.c",
+        "src/libespeak-ng/speech.c",
+        "src/libespeak-ng/espeak_api.c",
+        "src/libespeak-ng/klatt.c",
+        "src/libespeak-ng/sPlayer.c",
+    ],
+}
+
+cc_library_static {
+    name: "espeak_ng_ucd",
+    defaults: ["espeak_ng_device", "espeak_ng_ucd_sources"],
+}
+
+cc_library_static {
+    name: "espeak_ng_speechplayer",
+    defaults: ["espeak_ng_device", "espeak_ng_speechplayer_sources"],
+    stl: "c++_static",
+}
+
+cc_library_static {
+    name: "espeak_ng_sonic",
+    defaults: ["espeak_ng_device", "espeak_ng_sonic_sources"],
+}
+
+cc_library_static {
+    name: "espeak_ng_core",
+    defaults: ["espeak_ng_device", "espeak_ng_core_sources"],
+}
+
+cc_library_host_static {
+    name: "espeak_ng_ucd_host",
+    defaults: ["espeak_ng_host", "espeak_ng_ucd_sources"],
+}
+
+cc_library_host_static {
+    name: "espeak_ng_speechplayer_host",
+    defaults: ["espeak_ng_host", "espeak_ng_speechplayer_sources"],
+}
+
+cc_library_host_static {
+    name: "espeak_ng_sonic_host",
+    defaults: ["espeak_ng_host", "espeak_ng_sonic_sources"],
+}
+
+cc_library_host_static {
+    name: "espeak_ng_core_host",
+    defaults: ["espeak_ng_host", "espeak_ng_core_sources"],
+}
+
+// The command line program: the data is compiled with it, as cmake/data.cmake does.
+cc_binary_host {
+    name: "espeak_ng_tool",
+    defaults: ["espeak_ng_host"],
+    srcs: ["src/espeak-ng.c"],
+    static_libs: [
+        "espeak_ng_core_host",
+        "espeak_ng_speechplayer_host",
+        "espeak_ng_sonic_host",
+        "espeak_ng_ucd_host",
+    ],
+}
+
+// The JNI library of the app.
+cc_library_shared {
+    name: "espeak_ng_ttsespeak",
+    stem: "libttsespeak",
+    defaults: ["espeak_ng_device"],
+    licenses: ["external_espeak_ng_app_license"],
+    stl: "c++_static",
+    header_libs: ["jni_headers"],
+    srcs: ["android/jni/jni/eSpeakService.c"],
+    local_include_dirs: ["android/jni/include"],
+    static_libs: [
+        "espeak_ng_core",
+        "espeak_ng_speechplayer",
+        "espeak_ng_sonic",
+        "espeak_ng_ucd",
+    ],
+    shared_libs: ["liblog"],
+}
+
+// res/raw/espeakdata.zip and res/raw/espeakdata_version: the compiled voice data and
+// the SHA-256 of its archive, as the createDataArchive and createDataVersion tasks of
+// android/build.gradle make them.
+genrule {
+    name: "espeak_ng_data_res",
+    srcs: [
+        "cmake/data.cmake",
+        "espeak-ng-data/lang/**/*",
+        "espeak-ng-data/voices/!v/**/*",
+        "phsource/**/*",
+        "dictsource/**/*",
+    ],
+    out: ["espeakdata.res.zip"],
+    tools: [
+        "espeak_ng_tool",
+        "soong_zip",
+    ],
+    tool_files: ["android/soong/espeak-data.sh"],
+    cmd: "/bin/bash $(location android/soong/espeak-data.sh) $(location espeak_ng_tool) $(location soong_zip) " +
+        "external/espeak-ng $(genDir) $(out)",
+}
+
+android_app {
+    name: "eSpeakNG",
+    licenses: ["external_espeak_ng_app_license"],
+    sdk_version: "36",
+    min_sdk_version: "21",
+    target_sdk_version: "36",
+    java_version: "17",
+    product_specific: true,
+    manifest: "android/soong/AndroidManifest.xml",
+    srcs: [
+        "android/src/**/*.java",
+        // BuildConfig, as the Gradle build generates it for a release build.
+        "android/soong/java/**/*.java",
+    ],
+    resource_dirs: ["android/res"],
+    resource_zips: [":espeak_ng_data_res"],
+    jni_libs: ["espeak_ng_ttsespeak"],
+    optimize: {
+        enabled: false,
+    },
+}
