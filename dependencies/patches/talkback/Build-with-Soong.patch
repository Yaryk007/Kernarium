diff --git a/Android.bp b/Android.bp
new file mode 100644
index 0000000000000000000000000000000000000000..65288439af7a19973613ab1a94ccb376a99b37d0
--- /dev/null
+++ b/Android.bp
@@ -0,0 +1,134 @@
+// SPDX-License-Identifier: Apache-2.0
+
+//
+// TalkBack, built from source by the Android image build. The Gradle files
+// beside these modules are not used by it; each module's Android.bp lists the
+// sources its Gradle module compiles (the phone variant: src/main and
+// src/phone).
+
+package {
+    default_applicable_licenses: ["external_talkback_license"],
+    default_visibility: ["//external/talkback:__subpackages__"],
+}
+
+license {
+    name: "external_talkback_license",
+    visibility: [":__subpackages__"],
+    license_kinds: [
+        "SPDX-license-identifier-Apache-2.0",
+    ],
+    license_text: [
+        "LICENSE",
+    ],
+}
+
+// liblouis and BRLTTY, which the braille libraries build from the sources
+// they carry. The texts of the copyleft licences are those of licenses/.
+license {
+    name: "external_talkback_liblouis_license",
+    visibility: [":__subpackages__"],
+    license_kinds: [
+        "SPDX-license-identifier-LGPL-2.1-or-later",
+    ],
+    license_text: [
+        "licenses/LGPL-2.1.txt",
+    ],
+}
+
+license {
+    name: "external_talkback_brltty_license",
+    visibility: [":__subpackages__"],
+    license_kinds: [
+        "SPDX-license-identifier-LGPL-2.1-or-later",
+    ],
+    license_text: [
+        "licenses/LGPL-2.1.txt",
+    ],
+}
+
+// The BRLTTY wrapper is GPL-2.0-or-later.
+license {
+    name: "external_talkback_brltty_wrapper_license",
+    visibility: [":__subpackages__"],
+    license_kinds: [
+        "SPDX-license-identifier-GPL-2.0-or-later",
+    ],
+    license_text: [
+        "licenses/GPL-2.0.txt",
+    ],
+}
+
+// What every Android library of the phone build shares: the platform's own
+// copies of the libraries the Gradle build declares in shared.gradle, at the
+// versions the tree carries. R classes are transitive, as the Gradle build
+// leaves them (nonTransitiveRClass=false). The minimum SDK is the app's: a
+// library without one takes its compile SDK (36), which the manifest merger
+// refuses for an app of minSdk 26.
+java_defaults {
+    name: "TalkBack-defaults",
+    sdk_version: "36",
+    min_sdk_version: "26",
+    java_version: "17",
+    kotlin_lang_version: "1.9",
+    use_resource_processor: false,
+    plugins: ["auto_value_plugin"],
+    libs: [
+        "auto_value_annotations",
+        "checker-qual",
+        "error_prone_annotations",
+        "jsr305",
+    ],
+    static_libs: [
+        "androidx.annotation_annotation",
+        "androidx.appcompat_appcompat",
+        "androidx.collection_collection",
+        "androidx.core_core",
+        "androidx.fragment_fragment",
+        "androidx.lifecycle_lifecycle-runtime",
+        "androidx.lifecycle_lifecycle-service",
+        "androidx.localbroadcastmanager_localbroadcastmanager",
+        "androidx.preference_preference",
+        "androidx.recyclerview_recyclerview",
+        "androidx.savedstate_savedstate",
+        "com.google.android.material_material",
+        "gson",
+        "guava",
+        "kotlin-stdlib",
+        "libprotobuf-java-lite",
+    ],
+}
+
+// The JNI libraries of the app: built against the NDK API level of its
+// minSdk, with the code they ship (liblouis, BRLTTY) carrying its own
+// warnings.
+cc_defaults {
+    name: "TalkBack-native-defaults",
+    sdk_version: "26",
+    stl: "none",
+    header_libs: ["jni_headers"],
+    cflags: ["-Wno-error"],
+}
+
+// The app, as the Gradle build's root project builds its phone flavor: the
+// service and settings (TalkBack-talkback) with the two JNI libraries, and the
+// manifest that names the application class and the package. The app does not
+// shrink its code (the Gradle build sets no minification), and the release
+// signing step signs it, so it carries the default certificate.
+android_app {
+    name: "TalkBack",
+    defaults: ["TalkBack-defaults"],
+    manifest: "src/soong/AndroidManifest.xml",
+    target_sdk_version: "30",
+    product_specific: true,
+    optimize: {
+        enabled: false,
+    },
+    static_libs: [
+        "TalkBack-talkback",
+    ],
+    jni_libs: [
+        "talkback_louiswrap",
+        "talkback_brlttywrap",
+    ],
+    use_embedded_native_libs: true,
+}
