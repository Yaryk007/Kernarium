+    cflags: [
+        "-DDRIVER_NAME=Baum",
+        "-DDRIVER_CODE=bm",
+        "-DDRIVER_COMMENT=\"\"",
+        "-DDRIVER_VERSION=\"\"",
+        "-DDRIVER_DEVELOPERS=\"Dave Mielke\"",
