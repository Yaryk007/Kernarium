+/*
+ * Hand in-order data from the guest to the host socket's buffer. A socket
+ * that can no longer send never writes so_rcv again, so the data is only
+ * acknowledged, which the caller has done by advancing rcv_nxt, and freed:
+ * appended, it would fill so_rcv and close the window for ever.
+ * tcp_emu() is not run for what is dropped.
+ */
+static void tcp_append(struct socket *so, struct mbuf *m)
+{
+    if (so->so_state & SS_FCANTSENDMORE) {
+        m_free(m);
+    } else if (so->so_emu) {
+        if (tcp_emu(so, m))
+            sbappend(so, m);
+    } else {
+        sbappend(so, m);
+    }
+}
