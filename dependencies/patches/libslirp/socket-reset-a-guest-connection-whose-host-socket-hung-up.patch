@@ -1068,6 +1072,22 @@ void slirp_pollfds_poll(Slirp *slirp, int select_error,
                 continue;
             }
 
+            /*
+             * A socket is polled for reading only while so_snd is under half
+             * full and its end of file is unread, but poll() reports a
+             * hang-up or an error unasked, and a socket polled to write the
+             * guest's data shows it. When the end of file was read, or so_snd
+             * is full, that belongs to the write side: soread() would only
+             * meet the end of file it already handled, or have nowhere to put
+             * what it reads, and leave the socket ready on every pass. (Short
+             * of full, soread() still reads the room there is.)
+             */
+            if ((revents & (SLIRP_POLL_HUP | SLIRP_POLL_ERR)) &&
+                ((so->so_state & SS_FCANTRCVMORE) || CONN_NOROOM(so))) {
+                sohangup(so);
+                continue;
+            }
