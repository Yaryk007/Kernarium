+/*
+ * Whether the host socket is a Unix-domain one (slirp_add_unix forwards).
+ * so_ffamily is the guest-visible address, not the host socket's, so ask the
+ * socket itself.
+ */
+static bool sohost_is_unix(struct socket *so)
+{
+    struct sockaddr_storage addr;
+    socklen_t alen = sizeof(addr);
+
+    return getsockname(so->s, (struct sockaddr *)&addr, &alen) == 0 &&
+           addr.ss_family == AF_UNIX;
+}
+
+/*
+ * The error that says the peer of a host socket, at end of file or hung up
+ * with no error pending, is gone rather than having closed in order; 0 when
+ * it is still there. A stream socket that is shut down in both directions
+ * hangs up and reads end of file just as a closed peer does, but loses its
+ * peer's address. XNU reports that as EINVAL, where ENOTCONN is meant.
+ *
+ * A Unix-domain socket whose peer closed in order loses the address the same
+ * way, so it is never asked: its peer's close is a plain end of file. An
+ * error, if there is one, is the socket's own.
+ */
+static int sopeer_gone(struct socket *so)
+{
+    struct sockaddr_storage addr;
+    socklen_t alen = sizeof(addr);
+    int err;
+
+    if (sohost_is_unix(so)) {
+        return 0;
+    }
+    if (getpeername(so->s, (struct sockaddr *)&addr, &alen) >= 0) {
+        return 0;
+    }
+    err = errno;
+    return err == EINVAL ? ENOTCONN : err;
+}
+
+/*
+ * Whether a host socket error ends the guest's connection with a reset.
+ * soread() and sohangup() decide alike: these errors mean the peer is gone,
+ * any other ends the connection in order.
+ */
+static bool soerror_resets(int err)
+{
+    return err == ECONNABORTED || err == ECONNRESET || err == ECONNREFUSED ||
+           err == ENOTCONN || err == EPIPE;
+}
