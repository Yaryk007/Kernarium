@@ -978,6 +1027,72 @@ void sofwdrain(struct socket *so)
         sofcantsendmore(so);
 }
 
+/*
+ * A hang-up or an error on a socket that is not polled for reading: its end
+ * of file was read, or the guest has not taken what so_snd holds and there is
+ * no room to read (see slirp_pollfds_poll()). The guest's data in so_rcv can
+ * no longer reach a peer that is gone.
+ *
+ * The decision is soread()'s: a pending error that soerror_resets() lists, or
+ * a peer that sopeer_gone() reports, resets the guest's connection. Otherwise
+ * the close is orderly and the guest keeps what it is owed:
+ *   - sofcantsendmore() shuts the host socket's write side down. What is
+ *     still in so_rcv is never written and goes with the connection. Data
+ *     the guest sends from now on is acknowledged and freed (tcp_append()),
+ *     so a writer with an open window is not held on it; one whose window
+ *     was already shut when the peer went keeps probing it, as it did for
+ *     the live peer;
+ *   - the descriptor leaves the poll set, as it is polled for reading only
+ *     below half full. The guest reads what the socket and so_snd hold, and
+ *     when sbdrop() makes room soread() reads the end of file: that marks
+ *     the socket as without a user (sofcantrcvmore() sets SS_NOFDREF, as
+ *     SS_FCANTSENDMORE is already set) and sends the FIN. From then on the
+ *     guest's next data segment resets the connection (tcp_input()) and
+ *     discards what so_snd still holds, the FIN with it, as a closed TCP
+ *     peer does to data sent to it. The guest keeps everything it is owed
+ *     only if it sends nothing between that read of the end of file and its
+ *     own read of the FIN.
+ * Only the guest holds that up. A guest that never reads keeps the connection
+ * for as long as it did while the peer was alive, and after the FIN one that
+ * sends nothing but window probes keeps it while they come more often than
+ * TCP_LINGERTIME.
+ */
+void sohangup(struct socket *so)
+{
+    int err = 0;
+    socklen_t elen = sizeof(err);
+    bool eof = so->so_state & SS_FCANTRCVMORE;
+
+    if (getsockopt(so->s, SOL_SOCKET, SO_ERROR, &err, &elen) < 0) {
+        err = errno;
+    }
+    if (err == 0 && !eof && !(so->so_state & SS_FCANTSENDMORE)) {
+        /*
+         * No error is pending, yet a stream socket that was shut down in
+         * both directions, or made defunct, hangs up this way with nothing
+         * to report. soread() asks the same question of its end of file; it
+         * cannot read here, as there is no room.
+         */
+        err = sopeer_gone(so);
+    }
+    if (soerror_resets(err)) {
+        tcp_drop(sototcpcb(so), err);
+        return;
+    }
+
+    sofcantsendmore(so);
+    if (eof) {
+        /*
+         * The guest's side was closed when soread() read the end of file.
+         * This only re-arms the linger timer, as sowrite() does when its
+         * write fails: sofcantsendmore() has just taken the socket out of
+         * the poll set, and the connection ends when the guest sends its own
+         * FIN or has been idle for TCP_LINGERTIME.
+         */
+        tcp_sockclosed(sototcpcb(so));
+    }
+}
