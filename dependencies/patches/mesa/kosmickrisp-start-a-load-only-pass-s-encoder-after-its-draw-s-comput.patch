+
    kk_stop_encoder(cmd, &cmd->gfx);
    cs_end_main(cmd);
    cs_start_render(cmd);
+   cmd->heap_in_segment = heap_in_segment;
+   cmd->heap_demand_B = heap_demand_B;
    /* A draw being recorded flushed its state into the closed encoder and
