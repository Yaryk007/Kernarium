    bool valid =
-      poly_u32_checked_mul(draw[0], draw[1], &vs_records) &&
-      poly_u32_checked_mul(vs_records, popcount(vertex_outputs), &vs_slots) &&
+      libkk_u32_mul_fits(draw[0], draw[1], &vs_records) &&
+      libkk_u32_mul_fits(vs_records, popcount(vertex_outputs), &vs_slots) &&
       poly_u32_checked_mul(vs_slots, 16, &vs_size) &&
       poly_heap_size_can_align(vs_size);
    if (p->output_vertex_stride) {
       uint32_t primitive_count =
          poly_decomposed_prims_for_vertices_u32(prim, draw[0]);
-      uint32_t total_primitives;
+      uint32_t total_primitives, records;
       valid = valid &&
-         poly_u32_checked_mul(primitive_count, draw[1], &total_primitives) &&
-         poly_gs_output_buffer_size(total_primitives, p->output_vertices,
-                                     p->output_vertex_stride, &output_size);
+         libkk_u32_mul_fits(primitive_count, draw[1], &total_primitives) &&
+         libkk_u32_mul_fits(total_primitives, p->output_vertices, &records) &&
+         libkk_u32_mul_fits(records, p->output_vertex_stride, &output_size) &&
+         poly_heap_size_can_align(output_size);
    }
    /* The setup below sets the grids before it reserves the buffers they
     * write, so a refused reservation has to clear them again. */
