@@ -493,9 +501,18 @@ kk_start_compute_encoder(struct kk_cmd_buffer *cmd,
 static void
 cs_split_render(struct kk_cmd_buffer *cmd)
 {
+   /* The heap segment goes on across the split. The reset it queued waits in
+    * the post-render encoder, which runs after both parts of the pass, so the
+    * next draw to reserve from the heap counts its demand beside what the
+    * segment has reserved, not from zero on a heap that is not empty. */
+   const bool heap_in_segment = cmd->heap_in_segment;
