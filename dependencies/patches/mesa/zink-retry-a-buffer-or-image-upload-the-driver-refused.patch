From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Fri, 13 Nov 2026 07:29:03 +0900
Subject: [PATCH] zink: retry a buffer or image upload the driver refused

zink_buffer_subdata() and the staged path of zink_image_subdata() map a
staging buffer, copy into it and unmap it. When the driver refused the
buffer the map failed and the upload was dropped without an error, so
the application kept a buffer or texture with its older contents.

Each now gives back what the driver can, through u_reclaim, and maps
once more. A call the threaded context made without synchronizing with
the driver thread does not finish the context's work, which it does not
own: it only releases what the screen caches.

The screen counts the device memory it frees and reports it through
get_freed_memory, so that the retry can tell whether waiting for the
budget to show the room is worth it.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 src/gallium/drivers/zink/zink_bo.c       |  1 +
 src/gallium/drivers/zink/zink_resource.c | 29 +++++++++++++++++++++++-
 src/gallium/drivers/zink/zink_screen.c   |  7 ++++++
 src/gallium/drivers/zink/zink_types.h    |  1 +
 4 files changed, 37 insertions(+), 1 deletion(-)

diff --git a/src/gallium/drivers/zink/zink_bo.c b/src/gallium/drivers/zink/zink_bo.c
index 42c394eee1363db75cb78e48ffc072d7f2bae17a..cee44a35ddab841062320a42f691d84a65558455 100644
--- a/src/gallium/drivers/zink/zink_bo.c
+++ b/src/gallium/drivers/zink/zink_bo.c
@@ -134,6 +134,7 @@ bo_destroy(struct zink_screen *screen, struct zink_bo *bo)
    }
 
    VKSCR(FreeMemory)(screen->dev, bo->mem, NULL);
+   p_atomic_add(&screen->freed_mem, bo->base.size);
 
    simple_mtx_destroy(&bo->lock);
    FREE(bo);
diff --git a/src/gallium/drivers/zink/zink_resource.c b/src/gallium/drivers/zink/zink_resource.c
index 5821a7321b0d87600ea9ab8c59effe2fa40e9605..49fc93bf604ae9ca16c62f68f141dd0b08c2ad76 100644
--- a/src/gallium/drivers/zink/zink_resource.c
+++ b/src/gallium/drivers/zink/zink_resource.c
@@ -42,6 +42,8 @@
 #include "util/u_blitter.h"
 #include "util/u_debug.h"
 #include "util/format/u_format.h"
+#include "util/u_reclaim.h"
+#include "util/u_transfer.h"
 #include "util/u_transfer_helper.h"
 #include "util/u_inlines.h"
 #include "util/u_memory.h"
@@ -3173,7 +3175,21 @@ zink_image_subdata(struct pipe_context *pctx,
       return;
    }
    /* fallback case for per-resource unsupported or device-level unsupported */
-   u_default_texture_subdata(pctx, pres, level, usage, box, data, stride, layer_stride);
+   if (!u_texture_subdata_try(pctx, pres, level, usage, box, data, stride, layer_stride)) {
+      /* The driver had no memory for the staging buffer. The upload would be
+       * dropped, and nothing tells the application, so give back what can be
+       * and try once more. An unsynchronized call is made from the thread
+       * that records commands, so the context's work cannot be finished from
+       * it.
+       */
+      struct u_reclaim reclaim;
+      if (u_reclaim_begin(pctx, !(usage & TC_TRANSFER_MAP_THREADED_UNSYNC), &reclaim)) {
+         u_reclaim_settle(&reclaim);
+         u_reclaim_end(&reclaim,
+                       u_texture_subdata_try(pctx, pres, level, usage, box,
+                                             data, stride, layer_stride));
+      }
+   }
    res->subdata = false;
    if (res->fb_bind_count)
       ctx->rp_tc_info_updated = true;
@@ -3535,6 +3551,17 @@ zink_buffer_subdata(struct pipe_context *ctx, struct pipe_resource *buffer,
 
    u_box_1d(offset, size, &box);
    map = zink_buffer_map(ctx, buffer, 0, usage, &box, &transfer);
+   if (!map) {
+      /* The driver had no memory for the staging buffer, and the upload would
+       * be dropped without a word: give back what can be, and try once more.
+       */
+      struct u_reclaim reclaim;
+      if (u_reclaim_begin(ctx, !(usage & TC_TRANSFER_MAP_THREADED_UNSYNC), &reclaim)) {
+         u_reclaim_settle(&reclaim);
+         map = zink_buffer_map(ctx, buffer, 0, usage, &box, &transfer);
+         u_reclaim_end(&reclaim, map != NULL);
+      }
+   }
    if (map) {
       memcpy(map, data, size);
       zink_buffer_unmap(ctx, transfer);
diff --git a/src/gallium/drivers/zink/zink_screen.c b/src/gallium/drivers/zink/zink_screen.c
index 66207c5f30b79169e795c5a134b806c84e6413af..6f69474284f45bdc13a2bafb9768e0d30f0371e6 100644
--- a/src/gallium/drivers/zink/zink_screen.c
+++ b/src/gallium/drivers/zink/zink_screen.c
@@ -1530,6 +1530,12 @@ zink_release_cached_memory(struct pipe_screen *pscreen)
    return zink_bo_release_cached(screen);
 }
 
+static uint64_t
+zink_get_freed_memory(struct pipe_screen *pscreen)
+{
+   return p_atomic_read(&zink_screen(pscreen)->freed_mem);
+}
+
 static void
 zink_set_damage_region(struct pipe_screen *pscreen, struct pipe_resource *pres, unsigned int nrects, const struct pipe_box *rects)
 {
@@ -3739,6 +3745,7 @@ zink_internal_create_screen(const struct pipe_screen_config *config, int64_t dev
    screen->base.get_driver_query_info = zink_get_driver_query_info;
    screen->base.set_damage_region = zink_set_damage_region;
    screen->base.release_cached_memory = zink_release_cached_memory;
+   screen->base.get_freed_memory = zink_get_freed_memory;
    screen->base.get_cl_cts_version = zink_cl_cts_version;
 
    screen->total_video_mem = get_video_mem(screen);
diff --git a/src/gallium/drivers/zink/zink_types.h b/src/gallium/drivers/zink/zink_types.h
index 30150fbf20e8214ebe6ff31fbdd76d1a2b8344e5..ac37eb49595f72d64bf81d96da9d25a4e8a7ebba 100644
--- a/src/gallium/drivers/zink/zink_types.h
+++ b/src/gallium/drivers/zink/zink_types.h
@@ -1481,6 +1481,7 @@ struct zink_screen {
    uint64_t clamp_video_mem;
    uint64_t total_mem;
    uint64_t mapped_vram;
+   uint64_t freed_mem; /* bytes of device memory freed so far; atomic */
 
    VkInstance instance;
    const struct zink_instance_info *instance_info;
