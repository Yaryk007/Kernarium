+   case KK_VARIANT_BAD_FORMAT:
+      return "format";
+   case KK_VARIANT_BAD_BUILD:
+      return "build";
+   case KK_VARIANT_BAD_KEY:
+      return "key";
+   case KK_VARIANT_BAD_COUNT:
+      return "count";
+   case KK_VARIANT_BAD_SIZE:
+      return "size";
+   case KK_VARIANT_BAD_HASH:
+      return "hash";
+   case KK_VARIANT_BAD_STAGE:
+      return "stage";
+   case KK_VARIANT_BAD_TEXT:
+      return "text";
+   case KK_VARIANT_BAD_INFO:
