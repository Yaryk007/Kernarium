@@ -0,0 +1,19 @@
+// SPDX-License-Identifier: MIT
+#version 450
+layout(triangles, invocations = 32) in;
+layout(triangle_strip, max_vertices = 64) out;
+
+/* How many vertices this emits depends on the primitive, so the output keeps
+ * its dynamic index buffer.  The 32 invocations are flattened into the output
+ * vertices (64 for each of them: 2048), and a restart index for every third
+ * vertex comes with them: the index count is 2730. */
+void main()
+{
+   for (int i = 0; i < 64; ++i) {
+      if (i >= 3 + gl_PrimitiveIDIn % 5)
+         break;
+      gl_Position = gl_in[i % 3].gl_Position;
+      EmitVertex();
+   }
+   EndPrimitive();
+}
