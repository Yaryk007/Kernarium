+ */
+
+#include "descriptor_layout_hash_state.h"
+
+#include <string.h>
+
+#include "kosmickrisp/vulkan/kk_descriptor_set_layout.h"
+
+void
+kk_test_set_layout_hash(VkDescriptorSetLayout layout, uint8_t hash[32])
+{
+   const struct kk_descriptor_set_layout *set_layout =
+      kk_descriptor_set_layout_from_handle(layout);
+   memcpy(hash, set_layout->vk.blake3, 32);
+}
diff --git a/src/kosmickrisp/vulkan/tests/descriptor_layout_hash_state.h b/src/kosmickrisp/vulkan/tests/descriptor_layout_hash_state.h
