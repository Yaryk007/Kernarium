index 0000000000000000000000000000000000000000..70e1d396cc0059ba21e58697db46b34ef5905681
--- /dev/null
+++ b/src/kosmickrisp/vulkan/tests/variant_disk_cache_state.c
@@ -0,0 +1,149 @@
+/*
+ * Copyright 2026 Google LLC
+ * SPDX-License-Identifier: MIT
+ */
+
+#include "variant_disk_cache_state.h"
+
+#include <stdint.h>
+#include <string.h>
+
+#include "kosmickrisp/bridge/mtl_format.h"
+#include "kosmickrisp/bridge/mtl_types.h"
+#include "kosmickrisp/vulkan/kk_device.h"
+#include "kosmickrisp/vulkan/kk_physical_device.h"
+#include "kosmickrisp/vulkan/kk_shader.h"
+#include "util/blob.h"
+#include "vk_shader.h"
+
+struct disk_cache *
+kk_test_variant_disk_cache(VkPhysicalDevice physical)
+{
+   struct kk_physical_device *pdev = kk_physical_device_from_handle(physical);
+   return pdev->variant_cache != NULL ? pdev->variant_cache->disk : NULL;
+}
+
+size_t
+kk_test_driver_value(const char *name)
+{
+   static const struct {
+      const char *name;
+      size_t value;
+   } values[] = {
+#define FIELD(label, member) {label, offsetof(struct kk_shader_info, member)}
+#define VALUE(label, value) {label, (size_t)(value)}
+      VALUE("sizeof info", sizeof(struct kk_shader_info)),
+      VALUE("sizeof robustness", sizeof(struct vk_pipeline_robustness_state)),
+      FIELD("info.stage", stage),
+      FIELD("info.deferred", deferred),
+      FIELD("vs.additional_stages_bits", vs.additional_stages_bits),
+      FIELD("vs.raster_variant_mask", vs.raster_variant_mask),
+      FIELD("vs.raster_variant_stages", vs.raster_variant_stages),
+      FIELD("vs.raster_variant_class", vs.raster_variant_class),
+      FIELD("vs.geometry.shape", vs.geometry.shape),
+      FIELD("vs.geometry.max_indices", vs.geometry.max_indices),
+      FIELD("vs.geometry.mode", vs.geometry.mode),
+      FIELD("vs.geometry.count_words", vs.geometry.count_words),
+      FIELD("vs.transform_feedback.mode", vs.transform_feedback.mode),
+      FIELD("vs.transform_feedback.count_words",
+            vs.transform_feedback.count_words),
+      FIELD("vs.tess_local_thread_size", vs.tess_local_thread_size),
+      FIELD("vs.sample_count", vs.sample_count),
+      FIELD("vs.has_ms", vs.has_ms),
+      FIELD("vs.raster_primitive", vs.raster_primitive),
+      FIELD("vs.line_raster_prim", vs.line_raster_prim),
+      FIELD("vs.transform_feedback.shape", vs.transform_feedback.shape),
+      FIELD("vs.transform_feedback.max_indices",
+            vs.transform_feedback.max_indices),
+      FIELD("vs.topology", vs.topology),
+      FIELD("vs.rt_formats", vs.rt_formats),
+      FIELD("vs.view_mask", vs.view_mask),
+      FIELD("vs.depth_compare_op", vs.depth_compare_op),
+      FIELD("vs.stencil_front.fail", vs.stencil_front.fail),
+      FIELD("vs.stencil_back.compare", vs.stencil_back.compare),
+      FIELD("vs.metal_vertex_fetch", vs.metal_vertex_fetch),
+      FIELD("vs.vertex_buffers_used", vs.vertex_buffers_used),
+      FIELD("vs.vertex_attributes", vs.vertex_attributes),
+      VALUE("sizeof vertex_attribute",
+            sizeof(((struct kk_shader_info *)0)->vs.vertex_attributes[0])),
+      FIELD("vs.vertex_layouts", vs.vertex_layouts),
+      VALUE("sizeof vertex_layout",
+            sizeof(((struct kk_shader_info *)0)->vs.vertex_layouts[0])),
+      VALUE("vertex_layout.step",
+            offsetof(struct kk_shader_info, vs.vertex_layouts[0].step) -
+               offsetof(struct kk_shader_info, vs.vertex_layouts)),
+      FIELD("vs.blend", vs.blend),
+      FIELD("vs.metal_blend", vs.metal_blend),
+      VALUE("blend.destination_rgb",
+            offsetof(struct kk_shader_info, vs.blend[0].destination_rgb) -
+               offsetof(struct kk_shader_info, vs.blend)),
+      VALUE("blend.alpha_operation",
+            offsetof(struct kk_shader_info, vs.blend[0].alpha_operation) -
+               offsetof(struct kk_shader_info, vs.blend)),
+      VALUE("blend.write_mask",
+            offsetof(struct kk_shader_info, vs.blend[0].write_mask) -
+               offsetof(struct kk_shader_info, vs.blend)),
+      VALUE("sizeof blend",
+            sizeof(((struct kk_shader_info *)0)->vs.blend[0])),
+      VALUE("MESA_SHADER_VERTEX", MESA_SHADER_VERTEX),
+      VALUE("MESA_SHADER_TESS_CTRL", MESA_SHADER_TESS_CTRL),
+      VALUE("MESA_SHADER_TESS_EVAL", MESA_SHADER_TESS_EVAL),
+      VALUE("MESA_SHADER_GEOMETRY", MESA_SHADER_GEOMETRY),
+      VALUE("MESA_SHADER_FRAGMENT", MESA_SHADER_FRAGMENT),
+      VALUE("MESA_SHADER_COMPUTE", MESA_SHADER_COMPUTE),
+      VALUE("MESA_SHADER_STAGES", MESA_SHADER_STAGES),
+      VALUE("POLY_GS_SHAPE_STATIC_INDEXED", POLY_GS_SHAPE_STATIC_INDEXED),
+      VALUE("POLY_GS_SHAPE_DYNAMIC_INDEXED", POLY_GS_SHAPE_DYNAMIC_INDEXED),
+      VALUE("KK_MAX_GEOMETRY_OUTPUT_INDICES", KK_MAX_GEOMETRY_OUTPUT_INDICES),
+      VALUE("KK_RASTER_BASE", KK_RASTER_BASE),
+      VALUE("KK_RASTER_POINT", KK_RASTER_POINT),
+      VALUE("KK_RASTER_LINE", KK_RASTER_LINE),
+      VALUE("KK_RASTER_VARIANT_COUNT", KK_RASTER_VARIANT_COUNT),
+      VALUE("vertex_attribute.buffer",
+            offsetof(struct kk_shader_info, vs.vertex_attributes[0].buffer) -
+               offsetof(struct kk_shader_info, vs.vertex_attributes)),
+      VALUE("vertex_layout.step_rate",
+            offsetof(struct kk_shader_info, vs.vertex_layouts[0].step_rate) -
+               offsetof(struct kk_shader_info, vs.vertex_layouts)),
+      VALUE("KK_MAX_NATIVE_VBUFS", KK_MAX_NATIVE_VBUFS),
+      VALUE("MESA_PRIM_POINTS", MESA_PRIM_POINTS),
+      VALUE("MESA_PRIM_LINES", MESA_PRIM_LINES),
+      VALUE("MESA_PRIM_LINE_LOOP", MESA_PRIM_LINE_LOOP),
+      VALUE("MESA_PRIM_LINE_STRIP", MESA_PRIM_LINE_STRIP),
+      VALUE("MESA_PRIM_TRIANGLES", MESA_PRIM_TRIANGLES),
+      VALUE("MESA_PRIM_TRIANGLE_STRIP", MESA_PRIM_TRIANGLE_STRIP),
+      VALUE("MESA_PRIM_TRIANGLE_FAN", MESA_PRIM_TRIANGLE_FAN),
+      VALUE("MESA_PRIM_QUADS", MESA_PRIM_QUADS),
+      VALUE("MESA_PRIM_COUNT", MESA_PRIM_COUNT),
+      VALUE("MESA_PRIM_PATCHES", MESA_PRIM_PATCHES),
+      VALUE("MTL_VERTEX_FORMAT_FLOAT4", MTL_VERTEX_FORMAT_FLOAT4),
+      VALUE("MTL_VERTEX_STEP_FUNCTION_CONSTANT",
+            MTL_VERTEX_STEP_FUNCTION_CONSTANT),
+      VALUE("MTL_VERTEX_STEP_FUNCTION_PER_VERTEX",
+            MTL_VERTEX_STEP_FUNCTION_PER_VERTEX),
+#undef FIELD
+#undef VALUE
+   };
+   for (unsigned i = 0; i < sizeof(values) / sizeof(values[0]); i++) {
+      if (strcmp(values[i].name, name) == 0)
+         return values[i].value;
+   }
+   return SIZE_MAX;
+}
+
+VkResult
+kk_test_deserialize_shader(VkDevice device, const void *data, size_t size)
+{
+   struct kk_device *dev = kk_device_from_handle(device);
+   struct vk_device *vk_dev = &dev->vk;
+
+   struct blob_reader reader;
+   blob_reader_init(&reader, data, size);
+   struct vk_shader *shader = NULL;
+   const VkResult result = vk_dev->shader_ops->deserialize(
+      vk_dev, &reader, vk_dev->physical->properties.shaderBinaryVersion,
+      &vk_dev->alloc, &shader);
+   if (result == VK_SUCCESS)
+      vk_shader_destroy(vk_dev, shader, &vk_dev->alloc);
+   return result;
+}
