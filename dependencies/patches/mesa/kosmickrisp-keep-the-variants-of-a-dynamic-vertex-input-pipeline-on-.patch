index 0000000000000000000000000000000000000000..97f40239795575380294e664ca90116dd69a7703
--- /dev/null
+++ b/src/kosmickrisp/vulkan/tests/variant_disk_cache_state.h
@@ -0,0 +1,36 @@
+/* SPDX-License-Identifier: MIT */
+#pragma once
+
+#include <stddef.h>
+
+#include <vulkan/vulkan.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+struct disk_cache;
+
+/* The disk cache the driver keeps the variants of dynamic vertex-input
+ * pipelines in, or NULL when the driver keeps none.  An entry in the
+ * cache can only be read through a cache with the same identity, which only
+ * the driver knows. */
+struct disk_cache *
+kk_test_variant_disk_cache(VkPhysicalDevice physical);
+
+/* Where the driver keeps a field of the serialized shader info
+ * (struct kk_shader_info, the first bytes of every stored shader), the size of
+ * a record's parts, and the value of an enumerator the rows forge, by name:
+ * "info.stage", "vs.view_mask", "sizeof info", "MESA_SHADER_FRAGMENT" and so
+ * on.  SIZE_MAX for a name the driver does not have. */
+size_t kk_test_driver_value(const char *name);
+
+/* Offers `size` bytes to the driver's shader deserializer, the one a pipeline
+ * cache and a pipeline binary are read back by, as a shader of the device, and
+ * returns what it answered.  A shader it takes is released again. */
+VkResult kk_test_deserialize_shader(VkDevice device, const void *data,
+                                    size_t size);
+
+#ifdef __cplusplus
+}
+#endif
