+void
+kk_variant_cache_create(struct kk_physical_device *pdev)
+{
+#ifdef ENABLE_SHADER_CACHE
+   if (!debug_get_bool_option("MESA_KK_VARIANT_CACHE", true))
+      return;
+
+   /* Entries of another build are never looked at: the cache of a build is
+    * its own. */
+   struct kk_instance *instance = kk_physical_device_instance(pdev);
+   struct mesa_blake3 hash;
+   _mesa_blake3_init(&hash);
+   const uint32_t format = KK_VARIANT_FORMAT;
+   _mesa_blake3_update(&hash, &format, sizeof(format));
+   _mesa_blake3_update(&hash, instance->driver_build_sha,
+                       sizeof(instance->driver_build_sha));
+   blake3_hash id;
+   _mesa_blake3_final(&hash, id);
+   char cache_id[BLAKE3_HEX_LEN];
+   mesa_bytes_to_hex(cache_id, id, BLAKE3_KEY_LEN);
+
+   struct disk_cache *disk = disk_cache_create("kosmickrisp-variants", cache_id, 0);
+   if (disk == NULL)
+      return;
+
+   struct kk_variant_cache *cache = calloc(1, sizeof(*cache));
+   if (cache != NULL) {
+      cache->disk = disk;
+      simple_mtx_init(&cache->lock, mtx_plain);
+      cache->known =
+         _mesa_set_create(NULL, kk_blake3_key_hash, kk_blake3_key_equal);
+   }
+   if (cache == NULL || cache->known == NULL) {
+      if (cache != NULL)
+         simple_mtx_destroy(&cache->lock);
+      free(cache);
+      disk_cache_destroy(disk);
+      return;
+   }
+   pdev->variant_cache = cache;
+#endif
+}
+
+void
+kk_variant_cache_destroy(struct kk_physical_device *pdev)
+{
+#ifdef ENABLE_SHADER_CACHE
+   struct kk_variant_cache *cache = pdev->variant_cache;
+   if (cache == NULL)
+      return;
+
+   /* Destroying the disk cache waits for the writes still queued. */
+   disk_cache_destroy(cache->disk);
+   _mesa_set_destroy(cache->known, kk_variant_free_known);
+   simple_mtx_destroy(&cache->lock);
+   free(cache);
+   pdev->variant_cache = NULL;
+#endif
+}
