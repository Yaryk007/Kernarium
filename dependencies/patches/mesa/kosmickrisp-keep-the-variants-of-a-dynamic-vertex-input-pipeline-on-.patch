+/* The primitive a geometry or tessellation evaluation shader outputs: the one
+ * a pipeline with such a stage rasterizes, whatever its input assembly says. */
+static enum mesa_prim
+kk_nir_output_primitive(const nir_shader *nir)
+{
+   if (nir->info.stage == MESA_SHADER_GEOMETRY)
+      return nir->info.gs.output_primitive;
+
+   assert(nir->info.stage == MESA_SHADER_TESS_EVAL);
+   return nir->info.tess.point_mode ? MESA_PRIM_POINTS
+          : nir->info.tess._primitive_mode == TESS_PRIMITIVE_ISOLINES
+             ? MESA_PRIM_LINES
+             : MESA_PRIM_TRIANGLES;
+}
+
+static bool
+kk_stage_outputs_a_fixed_primitive(mesa_shader_stage stage)
+{
+   return stage == MESA_SHADER_GEOMETRY || stage == MESA_SHADER_TESS_EVAL;
+}
