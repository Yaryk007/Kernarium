+void
+kk_msl_pool_init(struct kk_msl_pool *pool,
+                 const struct kk_variant_store_ops *ops, void *ctx)
+{
+   memset(pool, 0, sizeof(*pool));
+   pool->ops = ops;
+   pool->ctx = ctx;
+}
+
+void
+kk_msl_pool_finish(struct kk_msl_pool *pool)
+{
+   for (uint32_t i = 0; i < pool->held_count; i++)
+      free(pool->held[i]);
+   free(pool->held);
+   pool->held = NULL;
+   pool->held_count = pool->held_capacity = 0;
+   pool->held_bytes = 0;
+}
+
+void
+kk_msl_text_name(uint8_t codec, uint32_t code_size, const void *bytes,
+                 uint32_t stored_size, blake3_hash name)
+{
+   const uint32_t fields[3] = {codec, code_size, stored_size};
+   struct mesa_blake3 hash;
+   _mesa_blake3_init(&hash);
+   _mesa_blake3_update(&hash, fields, sizeof(fields));
+   _mesa_blake3_update(&hash, bytes, stored_size);
+   _mesa_blake3_final(&hash, name);
+}
+
+static enum kk_variant_status
+check_text_entry(const uint8_t *entry, size_t size, const blake3_hash name,
+                 struct kk_variant_text_header *header)
+{
+   if (size < sizeof(*header))
+      return KK_VARIANT_TRUNCATED;
+   memcpy(header, entry, sizeof(*header));
+   if (header->magic != KK_VARIANT_TEXT_MAGIC)
+      return KK_VARIANT_BAD_MAGIC;
+   if (header->format != KK_VARIANT_FORMAT || header->reserved != 0)
+      return KK_VARIANT_BAD_FORMAT;
+   if (memcmp(header->name, name, sizeof(blake3_hash)) != 0)
+      return KK_VARIANT_BAD_KEY;
+   if (header->codec >= KK_MSL_CODEC_COUNT || header->code_size < 1 ||
+       header->code_size > KK_MSL_MAX_CODE_SIZE)
+      return KK_VARIANT_BAD_COUNT;
+   if (header->stored_size < 1 || header->stored_size > header->code_size ||
+       header->stored_size != size - sizeof(*header))
+      return KK_VARIANT_BAD_SIZE;
+
+   blake3_hash actual;
+   kk_msl_text_name(header->codec, header->code_size,
+                    entry + sizeof(*header), header->stored_size, actual);
+   if (memcmp(actual, name, sizeof(blake3_hash)) != 0)
+      return KK_VARIANT_BAD_HASH;
+   return KK_VARIANT_OK;
+}
+
+bool
+kk_msl_pool_put(struct kk_msl_pool *pool, uint8_t codec, uint32_t code_size,
+                const void *bytes, uint32_t stored_size, blake3_hash name)
+{
+   kk_msl_text_name(codec, code_size, bytes, stored_size, name);
+   if (pool->ops->has(pool->ctx, name))
+      return true;
+
+   /* A text the store holds counts only if it is a text a reader would take:
+    * a file the store accepted can still be damaged, and one a reader
+    * refuses would otherwise stay until a reader removed it. */
+   size_t existing_size = 0;
+   uint8_t *existing = pool->ops->get(pool->ctx, name, &existing_size);
+   if (existing != NULL) {
+      struct kk_variant_text_header existing_header;
+      const bool usable =
+         check_text_entry(existing, existing_size, name, &existing_header) ==
+         KK_VARIANT_OK;
+      free(existing);
+      if (usable)
+         return true;
+   }
+   pool->ops->remove(pool->ctx, name);
+
+   const size_t size = sizeof(struct kk_variant_text_header) + stored_size;
+   uint8_t *entry = malloc(size);
+   if (entry == NULL) {
+      pool->failed = true;
+      return false;
+   }
+   const struct kk_variant_text_header header = {
+      .magic = KK_VARIANT_TEXT_MAGIC,
+      .format = KK_VARIANT_FORMAT,
+      .codec = codec,
+      .code_size = code_size,
+      .stored_size = stored_size,
+   };
+   memcpy(entry, &header, sizeof(header));
+   memcpy(((struct kk_variant_text_header *)entry)->name, name,
+          sizeof(blake3_hash));
+   memcpy(entry + sizeof(header), bytes, stored_size);
+   pool->ops->put(pool->ctx, name, entry, size);
+   return true;
+}
+
+enum kk_variant_status
+kk_msl_pool_get(struct kk_msl_pool *pool, const blake3_hash name,
+                uint8_t *codec, uint32_t *code_size, const void **bytes,
+                uint32_t *stored_size)
+{
+   size_t size = 0;
+   uint8_t *entry = pool->ops->get(pool->ctx, name, &size);
+   if (entry == NULL) {
+      /* Missing, or a file the store itself refused: either way nothing good
+       * is under this name, and a bad file there would keep the next writer
+       * from putting the text back. */
+      pool->ops->remove(pool->ctx, name);
+      return KK_VARIANT_BAD_TEXT;
+   }
+
+   struct kk_variant_text_header header;
+   enum kk_variant_status status = check_text_entry(entry, size, name, &header);
+   if (status != KK_VARIANT_OK) {
+      free(entry);
+      pool->ops->remove(pool->ctx, name);
+      return status;
+   }
+
+   if (header.stored_size > KK_VARIANT_MAX_LOAD_TEXT_BYTES - pool->held_bytes) {
+      free(entry);
+      return KK_VARIANT_BAD_SIZE;
+   }
+
+   if (pool->held_count == pool->held_capacity) {
+      const uint32_t capacity = pool->held_capacity ? pool->held_capacity * 2 : 16;
+      void **held = realloc(pool->held, capacity * sizeof(*held));
+      if (held == NULL) {
+         free(entry);
+         return KK_VARIANT_NO_MEMORY;
+      }
+      pool->held = held;
+      pool->held_capacity = capacity;
+   }
+   pool->held[pool->held_count++] = entry;
+   pool->held_bytes += header.stored_size;
+
+   *codec = header.codec;
+   *code_size = header.code_size;
+   *stored_size = header.stored_size;
+   *bytes = entry + sizeof(header);
+   return KK_VARIANT_OK;
+}
+
+void
+kk_msl_record_write(struct blob *blob, const struct msl_compile_data *data,
+                    struct kk_msl_pool *pool)
+{
+   const uint32_t entrypoint_length = strlen(data->entrypoint_name) + 1;
+   const void *bytes = data->packed != NULL ? (const void *)data->packed
+                                            : (const void *)data->code;
+   const uint32_t stored_length = kk_msl_resident_bytes(data);
+   const uint32_t code_length = kk_msl_text_bytes(data);
+   const uint8_t codec =
+      data->packed != NULL ? data->codec : KK_MSL_CODEC_STORED;
+   blob_write_uint32(blob, entrypoint_length);
+   blob_write_uint32(blob, code_length);
+   blob_write_uint32(blob, stored_length);
+   blob_write_uint8(blob, codec);
+   blob_write_bytes(blob, data->entrypoint_name, entrypoint_length);
+   if (pool == NULL) {
+      blob_write_bytes(blob, bytes, stored_length);
+      return;
+   }
+
+   blake3_hash name = {0};
+   kk_msl_pool_put(pool, codec, code_length, bytes, stored_length, name);
+   blob_write_bytes(blob, name, sizeof(name));
+}
+
+enum kk_msl_record_status
+kk_msl_record_read(struct blob_reader *blob, struct msl_compile_data *data,
+                   struct kk_msl_pool *pool)
+{
+   const uint32_t entrypoint_length = blob_read_uint32(blob);
+   const uint32_t code_length = blob_read_uint32(blob);
+   const uint32_t stored_length = blob_read_uint32(blob);
+   const uint8_t codec = blob_read_uint8(blob);
+   /* Lengths a blob cannot hold are corrupt, and are refused before anything
+    * is allocated for them. */
+   const size_t tail = pool != NULL ? sizeof(blake3_hash) : stored_length;
+   if (blob->overrun || entrypoint_length == 0 ||
+       entrypoint_length > blob->end - blob->current ||
+       tail > blob->end - blob->current - entrypoint_length)
+      return KK_MSL_RECORD_CORRUPT;
+
+   data->entrypoint_name = ralloc_array(NULL, char, entrypoint_length);
+   if (data->entrypoint_name == NULL)
+      return KK_MSL_RECORD_NO_MEMORY;
+   blob_copy_bytes(blob, (void *)data->entrypoint_name, entrypoint_length);
+   if (data->entrypoint_name[entrypoint_length - 1] != '\0')
+      return KK_MSL_RECORD_CORRUPT;
+
+   const void *bytes;
+   if (pool == NULL) {
+      /* The compressed text stays compressed: it is decompressed only to
+       * build a pipeline from it. */
+      bytes = blob_read_bytes(blob, stored_length);
+      if (blob->overrun)
+         return KK_MSL_RECORD_CORRUPT;
+   } else {
+      blake3_hash name;
+      blob_copy_bytes(blob, name, sizeof(name));
+      if (blob->overrun)
+         return KK_MSL_RECORD_CORRUPT;
+
+      uint8_t held_codec;
+      uint32_t held_code_size, held_stored_size;
+      const enum kk_variant_status status =
+         kk_msl_pool_get(pool, name, &held_codec, &held_code_size, &bytes,
+                         &held_stored_size);
+      if (status == KK_VARIANT_NO_MEMORY)
+         return KK_MSL_RECORD_NO_MEMORY;
+      /* The text is what its name says; the record must say the same of it. */
+      if (status != KK_VARIANT_OK || held_codec != codec ||
+          held_code_size != code_length || held_stored_size != stored_length)
+         return KK_MSL_RECORD_CORRUPT;
+   }
+
+   if (!kk_msl_adopt(data, codec, bytes, stored_length, code_length))
+      return KK_MSL_RECORD_CORRUPT;
+   return KK_MSL_RECORD_OK;
+}
+
+void
+kk_variant_descriptor_begin(struct blob *blob)
+{
+   const struct kk_variant_descriptor_header header = {0};
+   blob_write_bytes(blob, &header, sizeof(header));
+}
+
+void
+kk_variant_descriptor_add_stage(struct blob *blob, uint32_t stage,
+                                const struct blob *shader)
+{
+   blob_write_uint32(blob, stage);
+   blob_write_uint32(blob, shader->size);
+   blob_write_bytes(blob, shader->data, shader->size);
+}
+
+bool
+kk_variant_descriptor_end(struct blob *blob,
+                          const uint8_t build_id[KK_VARIANT_BUILD_ID_SIZE],
+                          const blake3_hash key, uint32_t stage_count)
+{
+   if (blob->out_of_memory || blob->size < sizeof(struct kk_variant_descriptor_header) ||
+       blob->size > KK_VARIANT_MAX_DESCRIPTOR_SIZE)
+      return false;
+
+   struct kk_variant_descriptor_header header = {
+      .magic = KK_VARIANT_DESCRIPTOR_MAGIC,
+      .format = KK_VARIANT_FORMAT,
+      .stage_count = stage_count,
+      .payload_size = blob->size - sizeof(header),
+   };
+   memcpy(header.build_id, build_id, sizeof(header.build_id));
+   memcpy(header.key, key, sizeof(header.key));
+   _mesa_blake3_compute((const uint8_t *)blob->data + sizeof(header),
+                        header.payload_size, header.payload_hash);
+   return blob_overwrite_bytes(blob, 0, &header, sizeof(header));
+}
+
+enum kk_variant_status
+kk_variant_descriptor_open(const void *data, size_t size,
+                           const uint8_t build_id[KK_VARIANT_BUILD_ID_SIZE],
+                           const blake3_hash key, uint32_t stage_limit,
+                           struct blob_reader *payload, uint32_t *stage_count)
+{
+   struct kk_variant_descriptor_header header;
+   if (size < sizeof(header))
+      return KK_VARIANT_TRUNCATED;
+   memcpy(&header, data, sizeof(header));
+
+   if (header.magic != KK_VARIANT_DESCRIPTOR_MAGIC)
+      return KK_VARIANT_BAD_MAGIC;
+   if (header.format != KK_VARIANT_FORMAT)
+      return KK_VARIANT_BAD_FORMAT;
+   if (memcmp(header.build_id, build_id, sizeof(header.build_id)) != 0)
+      return KK_VARIANT_BAD_BUILD;
+   if (memcmp(header.key, key, sizeof(blake3_hash)) != 0)
+      return KK_VARIANT_BAD_KEY;
+   if (header.stage_count < 1 || header.stage_count > stage_limit)
+      return KK_VARIANT_BAD_COUNT;
+   if (size > KK_VARIANT_MAX_DESCRIPTOR_SIZE ||
+       header.payload_size != size - sizeof(header))
+      return KK_VARIANT_BAD_SIZE;
+
+   blake3_hash hash;
+   _mesa_blake3_compute((const uint8_t *)data + sizeof(header),
+                        header.payload_size, hash);
+   if (memcmp(hash, header.payload_hash, sizeof(hash)) != 0)
+      return KK_VARIANT_BAD_HASH;
+
+   blob_reader_init(payload, (const uint8_t *)data + sizeof(header),
+                    header.payload_size);
+   *stage_count = header.stage_count;
+   return KK_VARIANT_OK;
+}
+
+enum kk_variant_status
+kk_variant_descriptor_next_stage(struct blob_reader *payload,
+                                 uint32_t stage_limit, uint32_t *stage,
+                                 struct blob_reader *shader)
+{
+   const uint32_t number = blob_read_uint32(payload);
+   const uint32_t length = blob_read_uint32(payload);
+   if (payload->overrun || number >= stage_limit ||
+       length > payload->end - payload->current)
+      return KK_VARIANT_BAD_STAGE;
+
+   blob_reader_init(shader, blob_read_bytes(payload, length), length);
+   *stage = number;
+   return KK_VARIANT_OK;
+}
+
+enum kk_variant_status
+kk_variant_descriptor_close(const struct blob_reader *payload)
+{
+   return payload->overrun || payload->current != payload->end
+             ? KK_VARIANT_BAD_SIZE
+             : KK_VARIANT_OK;
+}
diff --git a/src/kosmickrisp/vulkan/kk_variant_entry.h b/src/kosmickrisp/vulkan/kk_variant_entry.h
new file mode 100644
index 0000000000000000000000000000000000000000..16eb8f6ab8c36c1ae882db5752042e2a17413aa8
--- /dev/null
+++ b/src/kosmickrisp/vulkan/kk_variant_entry.h
@@ -0,0 +1,191 @@
+/*
+ * Copyright 2026 Google LLC
+ * SPDX-License-Identifier: MIT
+ */
+
+#ifndef KK_VARIANT_ENTRY_H
+#define KK_VARIANT_ENTRY_H 1
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+#include "kk_msl_pack.h"
+#include "util/blob.h"
+#include "util/mesa-blake3.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* The entries the driver keeps on disk for the variants of a dynamic
+ * vertex-input pipeline (kk_shader.c).  A variant is the MSL of its shaders
+ * and the Metal pipelines built from it; only the MSL and what describes it
+ * is stored, so a variant read back is built again by Metal and is never code
+ * the host loads as it is.  Two kinds of entry exist:
+ *
+ *  - a descriptor, under the variant's key: a header, then for each stage the
+ *    stage's serialized shader with every text replaced by the name of the
+ *    text;
+ *  - a text, under its name: the compressed MSL of one Metal function.  Its
+ *    name is the hash of what it holds, so equal texts, which most of a
+ *    pipeline's variants share, are stored once.
+ *
+ * Everything read back is untrusted: the file may be damaged, or written by
+ * another build, or hold counts and lengths made up to run past it.  Reading
+ * checks each field against the bytes it has before it uses the field, and an
+ * entry that fails any check is reported as such and never half used: the
+ * caller translates the variant again and stores it over the bad entry.
+ */
+
+#define KK_VARIANT_FORMAT 1u
+#define KK_VARIANT_BUILD_ID_SIZE 16
+
+/* The most a descriptor may hold; the real ones are a few KiB. */
+#define KK_VARIANT_MAX_DESCRIPTOR_SIZE (16u << 20)
+
+/* The most stored text one load may hold at once.  A descriptor names a text
+ * once for each reference, and a reference holds its own copy, so without a
+ * bound a descriptor of 16 MiB could make a load read many gigabytes.  The real
+ * variants hold well under a tenth of this. */
+#define KK_VARIANT_MAX_LOAD_TEXT_BYTES (64u << 20)
+
+enum kk_variant_status {
+   KK_VARIANT_OK = 0,
+   /* Shorter than its header. */
+   KK_VARIANT_TRUNCATED,
+   KK_VARIANT_BAD_MAGIC,
+   /* Written by another version of this layout. */
+   KK_VARIANT_BAD_FORMAT,
+   /* Written by another build of the driver. */
+   KK_VARIANT_BAD_BUILD,
+   /* Not the entry its key names. */
+   KK_VARIANT_BAD_KEY,
+   /* A count or a length no entry of this size can hold. */
+   KK_VARIANT_BAD_COUNT,
+   KK_VARIANT_BAD_SIZE,
+   /* The bytes are not the bytes whose hash the header holds. */
+   KK_VARIANT_BAD_HASH,
+   /* A stage's frame is not one a descriptor holds. */
+   KK_VARIANT_BAD_STAGE,
+   /* A text the descriptor names is missing or is not that text. */
+   KK_VARIANT_BAD_TEXT,
+   /* A shader's own description holds a value no writer wrote. */
+   KK_VARIANT_BAD_INFO,
+   KK_VARIANT_NO_MEMORY,
+};
+
+const char *kk_variant_status_name(enum kk_variant_status status);
+
+/* What the entries are kept in: Mesa's disk cache in the driver, a table in
+ * the tests.  Entries are found by a 32-byte name; `data` given to put is
+ * malloc'd and the store owns it from then on; get returns a malloc'd copy.
+ * `has` is true only for a text the store already knows is good, because this
+ * process put it or read it and found it so; it never reads a file. */
+struct kk_variant_store_ops {
+   bool (*has)(void *ctx, const blake3_hash name);
+   void (*put)(void *ctx, const blake3_hash name, void *data, size_t size);
+   void *(*get)(void *ctx, const blake3_hash name, size_t *size);
+   void (*remove)(void *ctx, const blake3_hash name);
+};
+
+/* The texts of the shaders of one variant that are being written or read. */
+struct kk_msl_pool {
+   const struct kk_variant_store_ops *ops;
+   void *ctx;
+   /* The texts read, kept until the pool is finished: a text adopted from
+    * them is copied, so the pool may go once the shaders are built. */
+   void **held;
+   uint32_t held_count;
+   uint32_t held_capacity;
+   /* The stored bytes of the texts held (KK_VARIANT_MAX_LOAD_TEXT_BYTES). */
+   uint64_t held_bytes;
+   /* A text could not be stored for lack of memory. */
+   bool failed;
+};
+
+void kk_msl_pool_init(struct kk_msl_pool *pool,
+                      const struct kk_variant_store_ops *ops, void *ctx);
+void kk_msl_pool_finish(struct kk_msl_pool *pool);
+
+/* The name of a text: the hash of its codec, both lengths and its bytes. */
+void kk_msl_text_name(uint8_t codec, uint32_t code_size, const void *bytes,
+                      uint32_t stored_size, blake3_hash name);
+
+/* Stores the text under its name unless the store has it, and returns the
+ * name.  Returns false when memory ran out. */
+bool kk_msl_pool_put(struct kk_msl_pool *pool, uint8_t codec,
+                     uint32_t code_size, const void *bytes,
+                     uint32_t stored_size, blake3_hash name);
+
+/* Finds the text of the name.  The bytes stay valid until the pool is
+ * finished.  A text that is there but is not what its name says, or whose
+ * header cannot be what any writer wrote, is removed from the store so that
+ * the next writer puts it back, and reported.  A text that would take the
+ * pool past its byte bound is reported as a bad size and left in the store: it
+ * is the descriptor that names too many. */
+enum kk_variant_status
+kk_msl_pool_get(struct kk_msl_pool *pool, const blake3_hash name,
+                uint8_t *codec, uint32_t *code_size, const void **bytes,
+                uint32_t *stored_size);
+
+/* One MSL text as a shader writes it:
+ *
+ *    u32 entrypoint length, u32 text length, u32 stored length, u8 codec,
+ *    the entrypoint, then
+ *       the stored bytes (the text itself for KK_MSL_CODEC_STORED), or, with
+ *       a pool, the 32-byte name of the text, which the pool holds.
+ */
+void kk_msl_record_write(struct blob *blob, const struct msl_compile_data *data,
+                         struct kk_msl_pool *pool);
+
+enum kk_msl_record_status {
+   KK_MSL_RECORD_OK = 0,
+   /* Lengths or bytes a record cannot hold, or a text the pool cannot give. */
+   KK_MSL_RECORD_CORRUPT,
+   KK_MSL_RECORD_NO_MEMORY,
+};
+
+enum kk_msl_record_status
+kk_msl_record_read(struct blob_reader *blob, struct msl_compile_data *data,
+                   struct kk_msl_pool *pool);
+
+/* A descriptor: a header, then `stage count` frames of
+ *
+ *    u32 stage, u32 length, the stage's serialized shader.
+ *
+ * The header holds the build of the driver and the key the entry was written
+ * for, the number of frames and the length and hash of everything after it.
+ */
+void kk_variant_descriptor_begin(struct blob *blob);
+void kk_variant_descriptor_add_stage(struct blob *blob, uint32_t stage,
+                                     const struct blob *shader);
+bool kk_variant_descriptor_end(struct blob *blob,
+                               const uint8_t build_id[KK_VARIANT_BUILD_ID_SIZE],
+                               const blake3_hash key, uint32_t stage_count);
+
+/* Checks the header against the entry's size, the build and the key it is
+ * wanted for, and its hash; on success `payload` reads the frames.
+ * `stage_limit` is one past the highest stage a frame may name. */
+enum kk_variant_status
+kk_variant_descriptor_open(const void *data, size_t size,
+                           const uint8_t build_id[KK_VARIANT_BUILD_ID_SIZE],
+                           const blake3_hash key, uint32_t stage_limit,
+                           struct blob_reader *payload,
+                           uint32_t *stage_count);
+
+/* Reads the next frame into `shader`, a reader of exactly its bytes. */
+enum kk_variant_status
+kk_variant_descriptor_next_stage(struct blob_reader *payload,
+                                 uint32_t stage_limit, uint32_t *stage,
+                                 struct blob_reader *shader);
+
+/* Nothing may follow the last frame. */
+enum kk_variant_status
+kk_variant_descriptor_close(const struct blob_reader *payload);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* KK_VARIANT_ENTRY_H */
