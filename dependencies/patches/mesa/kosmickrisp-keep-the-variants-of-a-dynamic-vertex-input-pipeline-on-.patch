+/* The variants of dynamic vertex-input pipelines, kept on disk.
+ *
+ * Compiling a variant is most of what the first draw of a screen costs, and
+ * the same variants are compiled again by every process and every run: the
+ * in-memory table of a parent dies with it, and a new guest context makes a
+ * new parent.  So the MSL of a compiled variant and what describes it are
+ * stored in Mesa's disk cache, in an instance of its own beside the cache of
+ * the OpenGL driver above (the application sets the location and the size
+ * limit of both), and a later variant with the same key is built from them
+ * again instead of translated.  The entries are described in
+ * kk_variant_entry.h.
+ *
+ * The key of a variant is everything its translation depends on: the device
+ * (kk_variant_identity_init), the pipeline (kk_dynamic_vertex_input_disk_base)
+ * and the vertex input.  An entry is read only under the key it was written
+ * for by the same build of the driver, is checked in full before any of it is
+ * used, and when it fails a check, or Metal cannot build its pipelines, the
+ * variant is translated as it would be without the cache and stored over it.
+ * No behaviour depends on an entry surviving.
+ *
+ * MESA_KK_VARIANT_CACHE=0 turns the cache off.  MESA_KK_VARIANT_LOG=1 writes
+ * a line to stderr for each event: a variant loaded or missed, an entry found
+ * invalid, a variant translated or stored.
+ */
+#define KK_VARIANT_MAX_KNOWN_TEXTS 8192
+
+static bool
+kk_variant_log_enabled(void)
+{
+   static int enabled = -1;
+   int value = p_atomic_read(&enabled);
+   if (value < 0) {
+      const char *env = getenv("MESA_KK_VARIANT_LOG");
+      value = env != NULL && env[0] != '\0' && env[0] != '0';
+      p_atomic_set(&enabled, value);
+   }
+   return value;
+}
+
+static void
+kk_variant_log(const char *event, const blake3_hash key, uint64_t us,
+               size_t bytes, uint32_t stages, const char *reason)
+{
+   if (!kk_variant_log_enabled())
+      return;
+
+   struct timeval tv;
+   gettimeofday(&tv, NULL);
+   uint64_t tid = 0;
+   pthread_threadid_np(NULL, &tid);
+   fprintf(stderr,
+           "kkvar %s t=%ld.%06d key=%02x%02x%02x%02x us=%llu bytes=%zu "
+           "stages=%u tid=%llu%s%s\n",
+           event, (long)tv.tv_sec, (int)tv.tv_usec, key[0], key[1], key[2],
+           key[3], (unsigned long long)us, bytes, stages,
+           (unsigned long long)tid, reason != NULL ? " reason=" : "",
+           reason != NULL ? reason : "");
+}
+
+static void
+kk_variant_text_know(struct kk_variant_cache *cache, const blake3_hash name)
+{
+   simple_mtx_lock(&cache->lock);
+   if (cache->known->entries < KK_VARIANT_MAX_KNOWN_TEXTS &&
+       _mesa_set_search(cache->known, name) == NULL) {
+      uint8_t *copy = malloc(sizeof(blake3_hash));
+      if (copy != NULL) {
+         memcpy(copy, name, sizeof(blake3_hash));
+         _mesa_set_add(cache->known, copy);
+      }
+   }
+   simple_mtx_unlock(&cache->lock);
+}
+
+static void
+kk_variant_text_forget(struct kk_variant_cache *cache, const blake3_hash name)
+{
+   simple_mtx_lock(&cache->lock);
+   struct set_entry *entry = _mesa_set_search(cache->known, name);
+   if (entry != NULL) {
+      free((void *)entry->key);
+      _mesa_set_remove(cache->known, entry);
+   }
+   simple_mtx_unlock(&cache->lock);
+}
+
+static void
+kk_variant_cache_key(const struct kk_variant_cache *cache,
+                     const blake3_hash name, cache_key key)
+{
+   disk_cache_compute_key(cache->disk, name, sizeof(blake3_hash), key);
+}
+
+/* The store the texts of a variant are kept in: Mesa's disk cache. */
+static bool
+kk_variant_store_has(void *ctx, const blake3_hash name)
+{
+   struct kk_variant_cache *cache = ctx;
+   simple_mtx_lock(&cache->lock);
+   const bool known = _mesa_set_search(cache->known, name) != NULL;
+   simple_mtx_unlock(&cache->lock);
+   return known;
+}
+
+static void
+kk_variant_store_put(void *ctx, const blake3_hash name, void *data, size_t size)
+{
+   struct kk_variant_cache *cache = ctx;
+   cache_key key;
+   kk_variant_cache_key(cache, name, key);
+   kk_variant_text_know(cache, name);
+   disk_cache_put_nocopy(cache->disk, key, data, size, NULL);
+}
+
+static void *
+kk_variant_store_get(void *ctx, const blake3_hash name, size_t *size)
+{
+   struct kk_variant_cache *cache = ctx;
+   cache_key key;
+   kk_variant_cache_key(cache, name, key);
+   void *data = disk_cache_get(cache->disk, key, size);
+   if (data != NULL)
+      kk_variant_text_know(cache, name);
+   return data;
+}
+
+static void
+kk_variant_store_remove(void *ctx, const blake3_hash name)
+{
+   struct kk_variant_cache *cache = ctx;
+   cache_key key;
+   kk_variant_cache_key(cache, name, key);
+   kk_variant_text_forget(cache, name);
+   disk_cache_remove(cache->disk, key);
+}
+
+static const struct kk_variant_store_ops kk_variant_disk_ops = {
+   .has = kk_variant_store_has,
+   .put = kk_variant_store_put,
+   .get = kk_variant_store_get,
+   .remove = kk_variant_store_remove,
+};
+
+static void
+kk_variant_free_known(struct set_entry *entry)
+{
+   free((void *)entry->key);
+}
