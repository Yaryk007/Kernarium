+   size_t os_build_size = sizeof(os_build) - 1;
+   sysctlbyname("kern.osversion", os_build, &os_build_size, NULL, 0);
+   _mesa_blake3_update(&hash, os_build, sizeof(os_build));
+   _mesa_blake3_update(&hash, &dev->disabled_workarounds,
+                       sizeof(dev->disabled_workarounds));
+   const uint64_t debug_flags = kk_mesa_debug_flags;
+   _mesa_blake3_update(&hash, &debug_flags, sizeof(debug_flags));
+   _mesa_blake3_update(&hash, &dev->vk.enabled_features,
+                       sizeof(dev->vk.enabled_features));
+   blake3_hash identity;
+   _mesa_blake3_final(&hash, identity);
+   STATIC_ASSERT(sizeof(identity) == sizeof(dev->variant_identity));
+   memcpy(dev->variant_identity, identity, sizeof(identity));
+}
+
+static bool
+kk_variant_disk_key(const struct kk_device *dev,
+                    const struct kk_linked_graphics_pipeline *linked,
+                    const blake3_hash vi_key, blake3_hash key)
+{
+   if (kk_device_physical(dev)->variant_cache == NULL ||
+       !linked->dynamic.has_disk_base)
+      return false;
+
+   struct mesa_blake3 hash;
+   _mesa_blake3_init(&hash);
+   _mesa_blake3_update(&hash, dev->variant_identity,
+                       sizeof(dev->variant_identity));
+   _mesa_blake3_update(&hash, linked->dynamic.disk_base,
+                       sizeof(linked->dynamic.disk_base));
+   _mesa_blake3_update(&hash, vi_key, sizeof(blake3_hash));
+   _mesa_blake3_final(&hash, key);
+   return true;
+}
+
+/* The MSL of a variant leaves for the disk compressed, as it is in a pipeline
+ * cache. */
+static void
+kk_pack_variant_msl(struct kk_linked_graphics_pipeline *variant)
+{
+   struct kk_shader *group[MESA_SHADER_STAGES];
+   uint32_t count = 0;
+   for (uint32_t stage = 0; stage < MESA_SHADER_STAGES; stage++) {
+      if (variant->shaders[stage] != NULL)
+         group[count++] = variant->shaders[stage];
+   }
+   if (count > 0)
+      kk_pack_shaders_msl(group, count);
+
+   const struct kk_shader *vs = variant->shaders[MESA_SHADER_VERTEX];
+   if (vs == NULL)
+      return;
+   u_foreach_bit(raster, vs->info.vs.raster_variant_mask &
+                            ~BITFIELD_BIT(vs->info.vs.raster_variant_class)) {
+      count = 0;
+      for (uint32_t stage = 0; stage < MESA_SHADER_STAGES; stage++) {
+         struct kk_shader *child = vs->raster_variant_shaders[raster][stage];
+         if (child != NULL)
+            group[count++] = child;
+      }
+      if (count > 0)
+         kk_pack_shaders_msl(group, count);
+   }
+}
+
+/* What a variant loaded for `parent` must agree with the parent on: the stages
+ * of the pipeline, and the raster classes its vertex shader owns, which the
+ * parent's own state decides (kk_compile_shaders_impl).  A shader that owns
+ * classes the draw would not look for, or that lacks one it would, is not a
+ * variant of this parent whatever its key says. */
+static bool
+kk_loaded_variant_matches_parent(
+   const struct kk_linked_graphics_pipeline *parent,
+   const struct kk_shader *vertex, uint32_t parent_stages)
+{
+   const struct vk_graphics_pipeline_state *parent_state =
+      &parent->dynamic.state;
+   struct vk_input_assembly_state ia = *parent_state->ia;
+   if (BITSET_TEST(parent_state->dynamic, MESA_VK_DYNAMIC_IA_PRIMITIVE_TOPOLOGY))
+      ia.primitive_topology = kk_vk_topology_class(ia.primitive_topology);
+   struct vk_graphics_pipeline_state canonical = *parent_state;
+   canonical.ia = &ia;
+
+   const bool fixed_primitive =
+      (parent_stages & (BITFIELD_BIT(MESA_SHADER_TESS_EVAL) |
+                        BITFIELD_BIT(MESA_SHADER_GEOMETRY))) != 0;
+   /* The final primitive of a pipeline with a tessellation or geometry shader
+    * is the shader's own (kk_graphics_raster_primitive), which the parent took
+    * from its NIR (kk_dynamic_vertex_input_disk_base): never from the record,
+    * which is what is being checked. */
+   enum mesa_prim primitive = vk_topology_to_mesa(ia.primitive_topology);
+   for (uint32_t i = 0; i < parent->dynamic.shader_count; i++) {
+      const struct kk_deferred_graphics_shader *source =
+         &parent->dynamic.sources[i];
+      assert(source->content_valid);
+      if (source->stage == MESA_SHADER_GEOMETRY) {
+         primitive = source->primitive;
+         break;
+      }
+      if (source->stage == MESA_SHADER_TESS_EVAL)
+         primitive = source->primitive;
+   }
+   if (vertex->info.vs.raster_primitive != primitive)
+      return false;
+
+   const uint32_t mask =
+      kk_raster_variant_mask(&canonical, primitive, fixed_primitive);
+   if (mask == 0 || vertex->info.vs.raster_variant_class != ffs(mask) - 1)
+      return false;
+
+   /* The writer stores the set of classes only when there is more than one. */
+   if (util_bitcount(mask) == 1) {
+      return vertex->info.vs.raster_variant_mask == 0 &&
+             vertex->info.vs.raster_variant_stages == 0;
+   }
+   return vertex->info.vs.raster_variant_mask == mask &&
+          vertex->info.vs.raster_variant_stages == parent_stages;
+}
+
+/* Whether a variant's shaders are ones the loader takes back: each shader's
+ * description is one the deserializer accepts and the variant agrees with its
+ * parent.  A variant that fails is not stored; its entry would only be read,
+ * refused and removed by every run after it. */
+static bool
+kk_variant_is_loadable(struct kk_device *dev,
+                       const struct kk_linked_graphics_pipeline *parent,
+                       const struct kk_linked_graphics_pipeline *variant)
+{
+   uint32_t parent_stages = 0;
+   for (uint32_t i = 0; i < parent->dynamic.shader_count; i++)
+      parent_stages |= BITFIELD_BIT(parent->dynamic.sources[i].stage);
+
+   uint32_t stages = 0;
+   for (uint32_t stage = 0; stage < MESA_SHADER_STAGES; stage++) {
+      const struct kk_shader *shader = variant->shaders[stage];
+      if (shader == NULL)
+         continue;
+      stages |= BITFIELD_BIT(stage);
+      if (shader->info.stage != stage || shader->info.deferred ||
+          !kk_shader_info_is_valid(dev, &shader->info, true))
+         return false;
+
+      for (uint32_t raster = 0; raster < KK_RASTER_VARIANT_COUNT; raster++) {
+         for (uint32_t child_stage = 0; child_stage < MESA_SHADER_STAGES;
+              child_stage++) {
+            const struct kk_shader *child =
+               shader->raster_variant_shaders[raster][child_stage];
+            if (child != NULL &&
+                !kk_shader_info_is_valid(dev, &child->info, false))
+               return false;
+         }
+      }
+   }
+
+   const struct kk_shader *vertex = variant->shaders[MESA_SHADER_VERTEX];
+   return stages == parent_stages && vertex != NULL &&
+          !vertex->info.vs.metal_vertex_fetch &&
+          kk_loaded_variant_matches_parent(parent, vertex, parent_stages);
+}
+
+/* Stores a variant that was just translated.  The texts go first, so that the
+ * descriptor never names a text that was not queued before it. */
+static void
+kk_variant_cache_store(struct kk_device *dev,
+                       const struct kk_linked_graphics_pipeline *parent,
+                       struct kk_linked_graphics_pipeline *variant,
+                       const blake3_hash key)
+{
+   struct kk_physical_device *pdev = kk_device_physical(dev);
+   struct kk_variant_cache *cache = pdev->variant_cache;
+   struct kk_instance *instance = kk_physical_device_instance(pdev);
+   const uint64_t start = os_time_get_nano();
+
+   if (!kk_variant_is_loadable(dev, parent, variant)) {
+      kk_variant_log("skip", key, 0, 0, 0, "not loadable");
+      return;
+   }
+
+   kk_pack_variant_msl(variant);
+
+   struct kk_msl_pool pool;
+   kk_msl_pool_init(&pool, &kk_variant_disk_ops, cache);
+   struct blob blob;
+   blob_init(&blob);
+   kk_variant_descriptor_begin(&blob);
+
+   uint32_t count = 0;
+   bool ok = true;
+   for (uint32_t stage = 0; stage < MESA_SHADER_STAGES && ok; stage++) {
+      const struct kk_shader *shader = variant->shaders[stage];
+      if (shader == NULL)
+         continue;
+
+      struct blob shader_blob;
+      blob_init(&shader_blob);
+      ok = kk_shader_serialize_impl(&dev->vk, &shader->vk, &shader_blob, &pool);
+      if (ok) {
+         kk_variant_descriptor_add_stage(&blob, stage, &shader_blob);
+         count++;
+      }
+      blob_finish(&shader_blob);
+   }
+
+   STATIC_ASSERT(sizeof(instance->driver_build_sha) == KK_VARIANT_BUILD_ID_SIZE);
+   ok = ok && !pool.failed && count > 0 &&
+        kk_variant_descriptor_end(&blob, instance->driver_build_sha, key, count);
+   kk_msl_pool_finish(&pool);
+   if (!ok) {
+      blob_finish(&blob);
+      return;
+   }
+
+   void *data = NULL;
+   size_t size = 0;
+   blob_finish_get_buffer(&blob, &data, &size);
+
+   /* The cache never replaces an entry that exists, and this one was not
+    * found usable, so a damaged or truncated file must go for the new one to
+    * land. */
+   cache_key cache_key;
+   kk_variant_cache_key(cache, key, cache_key);
+   disk_cache_remove(cache->disk, cache_key);
+   disk_cache_put_nocopy(cache->disk, cache_key, data, size, NULL);
+
+   kk_variant_log("store", key, (os_time_get_nano() - start) / 1000, size,
+                  count, NULL);
+}
+
+static void
+kk_variant_free_partial(struct kk_device *dev,
+                        struct kk_linked_graphics_pipeline *variant)
+{
+   for (uint32_t stage = 0; stage < MESA_SHADER_STAGES; stage++) {
+      if (variant->shaders[stage] != NULL)
+         kk_shader_destroy(&dev->vk, variant->shaders[stage], &dev->vk.alloc);
+   }
+   vk_free(&dev->vk.alloc, variant);
+}
+
+/* Whether a variant of `parent` was found on disk and built from it.  An
+ * entry that is not what its key names, that holds what no writer wrote or
+ * what is not a variant of this parent, or that Metal cannot build, counts as
+ * absent, and the variant is translated again. */
+static bool
+kk_variant_cache_load(struct kk_device *dev,
+                      const struct kk_linked_graphics_pipeline *parent,
+                      const blake3_hash key,
+                      struct kk_linked_graphics_pipeline **variant_out)
+{
+   struct kk_physical_device *pdev = kk_device_physical(dev);
+   struct kk_variant_cache *cache = pdev->variant_cache;
+   struct kk_instance *instance = kk_physical_device_instance(pdev);
+   const uint64_t start = os_time_get_nano();
+
+   cache_key cache_key;
+   kk_variant_cache_key(cache, key, cache_key);
+   size_t size = 0;
+   uint8_t *data = disk_cache_get(cache->disk, cache_key, &size);
+   if (data == NULL) {
+      kk_variant_log("miss", key, 0, 0, 0, NULL);
+      return false;
+   }
+
+   uint32_t parent_stages = 0;
+   for (uint32_t i = 0; i < parent->dynamic.shader_count; i++)
+      parent_stages |= BITFIELD_BIT(parent->dynamic.sources[i].stage);
+
+   struct kk_msl_pool pool;
+   kk_msl_pool_init(&pool, &kk_variant_disk_ops, cache);
+   struct kk_linked_graphics_pipeline *variant = NULL;
+   struct blob_reader payload;
+   uint32_t count = 0;
+   enum kk_variant_status status = kk_variant_descriptor_open(
+      data, size, instance->driver_build_sha, key, MESA_SHADER_STAGES,
+      &payload, &count);
+   if (status != KK_VARIANT_OK)
+      goto invalid;
+
+   /* A variant has the stages of its parent and one frame for each. */
+   if (count != parent->dynamic.shader_count) {
+      status = KK_VARIANT_BAD_COUNT;
+      goto invalid;
+   }
+
+   variant = vk_zalloc(&dev->vk.alloc, sizeof(*variant), 8,
+                       VK_SYSTEM_ALLOCATION_SCOPE_DEVICE);
+   if (variant == NULL) {
+      status = KK_VARIANT_NO_MEMORY;
+      goto invalid;
+   }
+
+   for (uint32_t i = 0; i < count; i++) {
+      uint32_t stage;
+      struct blob_reader shader_reader;
+      status = kk_variant_descriptor_next_stage(&payload, MESA_SHADER_STAGES,
+                                                &stage, &shader_reader);
+      if (status != KK_VARIANT_OK)
+         goto invalid;
+      if (!(parent_stages & BITFIELD_BIT(stage)) ||
+          variant->shaders[stage] != NULL) {
+         status = KK_VARIANT_BAD_STAGE;
+         goto invalid;
+      }
+
+      struct vk_shader *loaded = NULL;
+      bool bad_info = false;
+      if (kk_deserialize_shader_impl(&dev->vk, &shader_reader, 0,
+                                     &dev->vk.alloc, &loaded, true, &pool,
+                                     &bad_info) != VK_SUCCESS) {
+         status = bad_info ? KK_VARIANT_BAD_INFO : KK_VARIANT_BAD_TEXT;
+         goto invalid;
+      }
+      struct kk_shader *shader = container_of(loaded, struct kk_shader, vk);
+      variant->shaders[stage] = shader;
+      if (shader->info.stage != stage || shader->info.deferred) {
+         status = KK_VARIANT_BAD_STAGE;
+         goto invalid;
+      }
+
+      /* The shader is all of its frame. */
+      if (shader_reader.current != shader_reader.end) {
+         status = KK_VARIANT_BAD_SIZE;
+         goto invalid;
+      }
+   }
+   status = kk_variant_descriptor_close(&payload);
+   if (status != KK_VARIANT_OK)
+      goto invalid;
+
+   /* The parent has a vertex shader (a variant is made of its vertex input),
+    * and so has every variant of it. */
+   if (variant->shaders[MESA_SHADER_VERTEX] == NULL) {
+      status = KK_VARIANT_BAD_STAGE;
+      goto invalid;
+   }
+
+   /* A variant of a dynamic vertex-input pipeline fetches its vertices through
+    * the driver's own lowering, never through Metal's vertex descriptor
+    * (kk_vertex_input_is_metal_expressible refuses the dynamic state). */
+   const struct kk_shader *vertex = variant->shaders[MESA_SHADER_VERTEX];
+   if (vertex->info.vs.metal_vertex_fetch ||
+       !kk_loaded_variant_matches_parent(parent, vertex, parent_stages)) {
+      status = KK_VARIANT_BAD_INFO;
+      goto invalid;
+   }
+
+   kk_msl_pool_finish(&pool);
+   free(data);
+   kk_variant_log("load", key, (os_time_get_nano() - start) / 1000, size,
+                  count, NULL);
+   *variant_out = variant;
+   return true;
+
+invalid:
+   if (variant != NULL)
+      kk_variant_free_partial(dev, variant);
+   kk_msl_pool_finish(&pool);
+   free(data);
+   disk_cache_remove(cache->disk, cache_key);
+   kk_variant_log("invalid", key, 0, size, 0, kk_variant_status_name(status));
+   return false;
 }
 
