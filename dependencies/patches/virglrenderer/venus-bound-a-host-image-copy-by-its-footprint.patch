+/* The image side of a host image copy, with the device and image already
+ * replaced by the driver's handles. */
+struct vkr_host_copy_target {
+   struct vn_device_proc_table *vk;
+   VkDevice device;
+   const struct vkr_image *image;
+   VkImage handle;
+   VkHostImageCopyFlags flags;
+};
