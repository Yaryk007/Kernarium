+/* The block a host image copy moves for one aspect of an image's format.  A
+ * depth or stencil aspect copies as the Depth/Stencil Aspect Copy Table says
+ * and a plane as its compatible format, in the plane's own texels.  Anything
+ * else these tables cannot state exactly, such as a combined aspect, is sized
+ * at 32 bytes a texel, more than any format holds.
+ */
+#define VKR_HOST_COPY_MAX_BLOCK_SIZE 32
+
+static struct vkr_texel_block
+vkr_host_copy_block(VkFormat format, VkImageAspectFlags aspect)
+{
+   const struct vkr_texel_block unknown = { 1, 1, 1, VKR_HOST_COPY_MAX_BLOCK_SIZE };
+   bool depth_stencil = true;
+   uint32_t depth_size = 0;
+
+   switch (format) {
+   case VK_FORMAT_S8_UINT:
+      break;
+   case VK_FORMAT_D16_UNORM:
+   case VK_FORMAT_D16_UNORM_S8_UINT:
+      depth_size = 2;
+      break;
+   case VK_FORMAT_X8_D24_UNORM_PACK32:
+   case VK_FORMAT_D24_UNORM_S8_UINT:
+   case VK_FORMAT_D32_SFLOAT:
+   case VK_FORMAT_D32_SFLOAT_S8_UINT:
+      depth_size = 4;
+      break;
+   default:
+      depth_stencil = false;
+      break;
+   }
+
+   if (depth_stencil) {
+      if (aspect == VK_IMAGE_ASPECT_STENCIL_BIT && format != VK_FORMAT_D16_UNORM &&
+          format != VK_FORMAT_X8_D24_UNORM_PACK32 && format != VK_FORMAT_D32_SFLOAT)
+         return (struct vkr_texel_block){ 1, 1, 1, 1 };
+      if (aspect == VK_IMAGE_ASPECT_DEPTH_BIT && depth_size)
+         return (struct vkr_texel_block){ 1, 1, 1, depth_size };
+      return unknown;
+   }
+
+   uint32_t plane;
+   switch (aspect) {
+   case VK_IMAGE_ASPECT_PLANE_0_BIT:
+      plane = 0;
+      break;
+   case VK_IMAGE_ASPECT_PLANE_1_BIT:
+      plane = 1;
+      break;
+   case VK_IMAGE_ASPECT_PLANE_2_BIT:
+      plane = 2;
+      break;
+   case VK_IMAGE_ASPECT_COLOR_BIT: {
+      struct vkr_texel_block block;
+      return vkr_format_texel_block(format, &block) ? block : unknown;
+   }
+   default:
+      return unknown;
+   }
+
+   const uint32_t plane_size = vkr_format_plane_size(format, plane);
+   return plane_size ? (struct vkr_texel_block){ 1, 1, 1, plane_size } : unknown;
+}
+
+/* The aspects an image of this format has, or 0 for a format these tables
+ * cannot describe, whose aspects the driver alone can state. */
+static VkImageAspectFlags
+vkr_host_copy_format_aspects(VkFormat format)
+{
+   switch (format) {
+   case VK_FORMAT_S8_UINT:
+      return VK_IMAGE_ASPECT_STENCIL_BIT;
+   case VK_FORMAT_D16_UNORM:
+   case VK_FORMAT_X8_D24_UNORM_PACK32:
+   case VK_FORMAT_D32_SFLOAT:
+      return VK_IMAGE_ASPECT_DEPTH_BIT;
+   case VK_FORMAT_D16_UNORM_S8_UINT:
+   case VK_FORMAT_D24_UNORM_S8_UINT:
+   case VK_FORMAT_D32_SFLOAT_S8_UINT:
+      return VK_IMAGE_ASPECT_DEPTH_BIT | VK_IMAGE_ASPECT_STENCIL_BIT;
+   default:
+      break;
+   }
+
+   if (vkr_format_plane_size(format, 0)) {
+      return VK_IMAGE_ASPECT_PLANE_0_BIT | VK_IMAGE_ASPECT_PLANE_1_BIT |
+             (vkr_format_plane_size(format, 2) ? VK_IMAGE_ASPECT_PLANE_2_BIT : 0);
+   }
+
+   struct vkr_texel_block block;
+   return vkr_format_texel_block(format, &block) ? VK_IMAGE_ASPECT_COLOR_BIT : 0;
+}
+
+/* The subsampling of the chroma planes (planes 1 and 2) of a multi-planar
+ * format: how many texels of plane 0 one texel of them spans across and down.
+ * Every other plane of every other format spans one. */
