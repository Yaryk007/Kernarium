+/* An extent of the plane a region names, at a mip level, as the driver lays it
+ * out: the image's extent divided by the plane's subsampling and rounded down,
+ * then halved per level down to one texel.  The driver sizes the plane that way
+ * (kk_image_layout_init(), u_minify()), so an image whose extent a chroma
+ * plane does not divide evenly has fewer texels than the rounded-up quotient. */
+static uint32_t
+vkr_host_copy_plane_extent(uint32_t extent, uint32_t subsampling, uint32_t level)
+{
+   return level < 32 ? MAX2((extent / subsampling) >> level, 1u) : 1u;
+}
+
+/* Whether a region of a host image copy lies in the image: in a mip level it
+ * has, in an aspect its format has, and within the extent that level has.  The
+ * driver reads the image's own tables by these numbers and never checks them. */
+static bool
+vkr_host_copy_region_is_in_image(const struct vkr_image *image,
+                                 const VkImageSubresourceLayers *subresource,
+                                 VkOffset3D offset,
+                                 VkExtent3D extent)
+{
+   if (subresource->mipLevel >= image->mip_levels) {
+      vkr_log("host image copy: mip level %u is past the image's %u levels",
+              subresource->mipLevel, image->mip_levels);
+      return false;
+   }
+
+   const VkImageAspectFlags aspect = subresource->aspectMask;
+   const VkImageAspectFlags aspects = vkr_host_copy_format_aspects(image->format);
+   if (!util_is_power_of_two_nonzero(aspect) || (aspects && (aspect & ~aspects))) {
+      vkr_log("host image copy: aspect 0x%x is not one aspect of the image", aspect);
+      return false;
+   }
+
+   /* The region is in the texels of the plane its aspect names. */
+   const uint32_t level = subresource->mipLevel;
+   uint32_t across, down;
+   vkr_host_copy_chroma_subsampling(image->format, aspect, &across, &down);
+   if (offset.x < 0 || offset.y < 0 || offset.z < 0 ||
+       (uint64_t)offset.x + extent.width >
+          vkr_host_copy_plane_extent(image->extent.width, across, level) ||
+       (uint64_t)offset.y + extent.height >
+          vkr_host_copy_plane_extent(image->extent.height, down, level) ||
+       (uint64_t)offset.z + extent.depth >
+          vkr_host_copy_plane_extent(image->extent.depth, 1, level)) {
+      vkr_log("host image copy: the region lies outside the image's extent at mip "
+              "level %u", level);
+      return false;
+   }
+
+   return true;
+}
+
+/* How many array layers a copy of these subresource layers reaches, or false
+ * when the layers lie outside the image. */
+static bool
+vkr_host_copy_layer_count(const struct vkr_image *image,
+                          const VkImageSubresourceLayers *subresource,
+                          uint32_t *count)
+{
+   if (subresource->baseArrayLayer >= image->array_layers)
+      return false;
+
+   const uint32_t available = image->array_layers - subresource->baseArrayLayer;
+   if (subresource->layerCount == VK_REMAINING_ARRAY_LAYERS) {
+      *count = available;
+      return true;
+   }
+   if (subresource->layerCount > available)
+      return false;
+   *count = subresource->layerCount;
+   return true;
+}
