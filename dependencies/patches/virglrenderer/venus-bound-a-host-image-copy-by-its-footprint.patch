+
+/* One texel block of a format: its dimensions in texels and its size in
+ * bytes. */
+struct vkr_texel_block {
+   uint8_t width;
+   uint8_t height;
+   uint8_t depth;
+   uint8_t size;
+};
+
+/* The two tables below restate the format table of the Vulkan registry
+ * (vk.xml), which Vulkan-Hpp's vulkan_format_traits.hpp also carries.  A
+ * format either lacks is sized conservatively by vkr_host_copy_block(). */
+static bool
+vkr_format_texel_block(VkFormat format, struct vkr_texel_block *block)
+{
+   switch (format) {
+   case VK_FORMAT_R4G4_UNORM_PACK8:
+   case VK_FORMAT_A8_UNORM:
+   case VK_FORMAT_R8_UNORM:
+   case VK_FORMAT_R8_SNORM:
