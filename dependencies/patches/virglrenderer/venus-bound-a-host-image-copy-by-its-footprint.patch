+/* The host memory one region of a host image copy reaches: the offset of its
+ * last texel block plus that block, addressed as Vulkan's buffer-image copies
+ * address memory.  With VK_HOST_IMAGE_COPY_MEMCPY_BIT the driver's own layout
+ * may reach further, so its memcpy size for the layers counts as well.  False
+ * when the region lies outside the image or its reach does not fit in size_t.
+ */
+static bool
+vkr_host_copy_footprint(const struct vkr_host_copy_target *target,
+                        const VkImageSubresourceLayers *subresource,
+                        uint32_t row_length,
+                        uint32_t image_height,
+                        VkOffset3D offset,
+                        VkExtent3D extent,
+                        size_t data_size,
+                        size_t *footprint)
+{
+   const struct vkr_image *image = target->image;
+   uint32_t layers;
+   if (!vkr_host_copy_layer_count(image, subresource, &layers) ||
+       !vkr_host_copy_region_is_in_image(image, subresource, offset, extent))
+      return false;
+
+   size_t reach = 0;
+   if (layers && extent.width && extent.height && extent.depth) {
+      const struct vkr_texel_block block =
+         vkr_host_copy_block(image->format, subresource->aspectMask);
+      const uint64_t row_blocks =
+         DIV_ROUND_UP((uint64_t)(row_length ? row_length : extent.width), block.width);
+      const uint64_t image_rows = DIV_ROUND_UP(
+         (uint64_t)(image_height ? image_height : extent.height), block.height);
+      const uint64_t width_blocks = DIV_ROUND_UP((uint64_t)extent.width, block.width);
+      const uint64_t height_blocks =
+         DIV_ROUND_UP((uint64_t)extent.height, block.height);
+      const uint64_t depth_blocks = DIV_ROUND_UP((uint64_t)extent.depth, block.depth);
+
+      size_t row_pitch, slice_pitch, layer_pitch, last_row, last_slice, last_layer,
+         row_bytes;
+      if (__builtin_mul_overflow(row_blocks, block.size, &row_pitch) ||
+          __builtin_mul_overflow(image_rows, row_pitch, &slice_pitch) ||
+          __builtin_mul_overflow(depth_blocks, slice_pitch, &layer_pitch) ||
+          __builtin_mul_overflow(height_blocks - 1, row_pitch, &last_row) ||
+          __builtin_mul_overflow(depth_blocks - 1, slice_pitch, &last_slice) ||
+          __builtin_mul_overflow((uint64_t)layers - 1, layer_pitch, &last_layer) ||
+          __builtin_mul_overflow(width_blocks, block.size, &row_bytes) ||
+          __builtin_add_overflow(last_row, last_slice, &reach) ||
+          __builtin_add_overflow(reach, last_layer, &reach) ||
+          __builtin_add_overflow(reach, row_bytes, &reach))
+         return false;
+   }
+
+   if (target->flags & VK_HOST_IMAGE_COPY_MEMCPY_BIT) {
+      if (!target->vk->GetImageSubresourceLayout2)
+         return false;
+
+      size_t memcpy_reach = 0;
+      for (uint32_t i = 0; i < layers; i++) {
+         const VkImageSubresource2 layer = {
+            .sType = VK_STRUCTURE_TYPE_IMAGE_SUBRESOURCE_2,
+            .imageSubresource = {
+               .aspectMask = subresource->aspectMask,
+               .mipLevel = subresource->mipLevel,
+               .arrayLayer = subresource->baseArrayLayer + i,
+            },
+         };
+         VkSubresourceHostMemcpySize size = {
+            .sType = VK_STRUCTURE_TYPE_SUBRESOURCE_HOST_MEMCPY_SIZE,
+         };
+         VkSubresourceLayout2 layout = {
+            .sType = VK_STRUCTURE_TYPE_SUBRESOURCE_LAYOUT_2,
+            .pNext = &size,
+         };
+         target->vk->GetImageSubresourceLayout2(target->device, target->handle,
+                                                &layer, &layout);
+         if (size.size > SIZE_MAX ||
+             __builtin_add_overflow(memcpy_reach, (size_t)size.size, &memcpy_reach))
+            return false;
+      }
+      reach = MAX2(reach, memcpy_reach);
+   }
+
+   /* The guest sizes its memory for the region it copies, and the footprint
+    * above is that size, or at most vkr_host_copy_block()'s largest texel
+    * block times it where the format is one the tables cannot state.  A
+    * region that reaches further asks for renderer memory the guest never
+    * accounted for, through a row length or image height it chose freely. */
+   if (reach > data_size &&
+       (data_size > SIZE_MAX / VKR_HOST_COPY_MAX_BLOCK_SIZE ||
+        reach > data_size * VKR_HOST_COPY_MAX_BLOCK_SIZE)) {
+      vkr_log("host image copy: the region reaches %zu bytes, past what its %zu "
+              "bytes of memory could hold", reach, data_size);
+      return false;
+   }
+
+   *footprint = reach;
+   return true;
+}
+
+/* The driver copies image to image through one temporary the size of the source
+ * plane: it reads the source region packed into it, then writes the same
+ * extent from it into the destination, over the layers of the source.  A
+ * region outside either image, layers that differ, or a destination that takes
+ * more bytes than the source gave would make it touch memory neither image has
+ * or read what it never wrote, so both sides are held to the checks of a copy
+ * to and from memory.  The destination's extent is the region's, as the driver
+ * reads it. */
+static bool
+vkr_host_copy_images_hold_regions(struct vn_device_proc_table *vk,
+                                  VkDevice device,
+                                  const VkCopyImageToImageInfo *info)
+{
+   const struct vkr_image *src = vkr_image_from_handle(info->srcImage);
+   const struct vkr_image *dst = vkr_image_from_handle(info->dstImage);
+   if (!src || !dst) {
+      vkr_log("host image copy: an image of an image-to-image copy is the null handle");
+      return false;
+   }
+   if (info->regionCount && !info->pRegions) {
+      vkr_log("host image copy: an image-to-image copy names regions and sends none");
+      return false;
+   }
+
+   const struct vkr_host_copy_target src_target = {
+      .vk = vk, .device = device, .image = src, .handle = info->srcImage, .flags = 0,
+   };
+   const struct vkr_host_copy_target dst_target = {
+      .vk = vk, .device = device, .image = dst, .handle = info->dstImage, .flags = 0,
+   };
+   for (uint32_t i = 0; i < info->regionCount; i++) {
+      const VkImageCopy2 *region = &info->pRegions[i];
+      size_t src_reach, dst_reach;
+      uint32_t src_layers, dst_layers;
+
+      if (!vkr_host_copy_layer_count(src, &region->srcSubresource, &src_layers) ||
+          !vkr_host_copy_footprint(&src_target, &region->srcSubresource, 0, 0,
+                                   region->srcOffset, region->extent, SIZE_MAX,
+                                   &src_reach)) {
+         vkr_log("host image copy: the source of an image-to-image copy does not hold "
+                 "its region");
+         return false;
+      }
+      if (!vkr_host_copy_layer_count(dst, &region->dstSubresource, &dst_layers) ||
+          !vkr_host_copy_footprint(&dst_target, &region->dstSubresource, 0, 0,
+                                   region->dstOffset, region->extent, SIZE_MAX,
+                                   &dst_reach)) {
+         vkr_log("host image copy: the destination of an image-to-image copy does not "
+                 "hold its region");
+         return false;
+      }
+      if (src_layers != dst_layers || dst_reach > src_reach) {
+         vkr_log("host image copy: the two sides of an image-to-image copy do not "
+                 "move the same layers and bytes");
+         return false;
+      }
+   }
+   return true;
+}
