+   case VK_FORMAT_R8_BOOL_ARM:
+   case VK_FORMAT_R8_SFLOAT_FPENCODING_FLOAT8E4M3_ARM:
+   case VK_FORMAT_R8_SFLOAT_FPENCODING_FLOAT8E5M2_ARM:
+      *block = (struct vkr_texel_block){1, 1, 1, 1};
+      return true;
