+   case VK_FORMAT_ASTC_4x4x4_UNORM_BLOCK_EXT:
+   case VK_FORMAT_ASTC_4x4x4_SRGB_BLOCK_EXT:
+   case VK_FORMAT_ASTC_4x4x4_SFLOAT_BLOCK_EXT:
