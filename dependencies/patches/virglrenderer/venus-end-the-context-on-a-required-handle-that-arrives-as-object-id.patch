diff --git a/src/venus/vkr_pipeline.c b/src/venus/vkr_pipeline.c
index d0d6f8364bf6c109bc31e5d01940853ce42669cc..16289f8d4d6dbbd1ef3ffe44322ce98bb195d8e2 100644
--- a/src/venus/vkr_pipeline.c
+++ b/src/venus/vkr_pipeline.c
@@ -105,6 +105,42 @@ vkr_dispatch_vkMergePipelineCaches(UNUSED struct vn_dispatch_context *dispatch,
                                        args->pSrcCaches);
 }
 
+/* A pipeline made of pipeline libraries chains a VkPipelineLibraryCreateInfoKHR,
+ * and the driver reads every library.  The codec looks each handle up and
+ * yields NULL for object id 0, which no pipeline has, leaving the refusal to
+ * the handler (an id the context never made is refused by the lookup itself).
+ * A null one is therefore a null pointer the driver would dereference.  The
+ * handles still hold the objects here; they are replaced by the driver's
+ * handles only when the call is forwarded.
+ *
+ * The renderer serves no VK_KHR_pipeline_binary, so no object names a binary,
+ * and a chain that carries binaries is refused whatever it names: a guest can
+ * enable the extension on a device by name, and the driver would read them. */
+static bool
+vkr_pipeline_chain_holds_handles(const void *pnext)
+{
+   for (const VkBaseInStructure *chain = pnext; chain; chain = chain->pNext) {
+      if (chain->sType == VK_STRUCTURE_TYPE_PIPELINE_BINARY_INFO_KHR) {
+         if (((const VkPipelineBinaryInfoKHR *)chain)->binaryCount) {
+            vkr_log("a pipeline create info names pipeline binaries");
+            return false;
+         }
+      } else if (chain->sType == VK_STRUCTURE_TYPE_PIPELINE_LIBRARY_CREATE_INFO_KHR) {
+         const VkPipelineLibraryCreateInfoKHR *info =
+            (const VkPipelineLibraryCreateInfoKHR *)chain;
+         if (info->libraryCount && !info->pLibraries)
+            return false;
+         for (uint32_t i = 0; i < info->libraryCount; i++) {
+            if (!info->pLibraries[i]) {
+               vkr_log("a pipeline library is the null handle");
+               return false;
+            }
+         }
+      }
+   }
+   return true;
+}
