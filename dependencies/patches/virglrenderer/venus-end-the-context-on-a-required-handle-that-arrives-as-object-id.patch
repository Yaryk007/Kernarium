diff --git a/src/venus/vkr_context.h b/src/venus/vkr_context.h
index 432ebbda29d271ddbca70208b25caa783b62ead1..becea074ecf6d2c9f5a7ef62f515bbc28f3abc51 100644
--- a/src/venus/vkr_context.h
+++ b/src/venus/vkr_context.h
@@ -197,6 +197,31 @@ vkr_context_get_fatal(struct vkr_context *ctx)
    return ctx->cs_fatal_error;
 }
 
+/* The codec yields NULL for a non-dispatchable handle that the guest sends as
+ * object id 0, and refuses only an id that names no object of the type (and,
+ * for the first argument of a command, id 0 as well).  A handle the
+ * specification does not allow to be VK_NULL_HANDLE therefore reaches its
+ * handler as a null pointer, which the renderer reads or the driver
+ * dereferences.  A handler that needs such a handle asks here: a null one ends
+ * the context, as an id that names no object does.  `slot` says which handle
+ * of the command it was. */
+static inline bool
+vkr_context_refuse_null_handle(struct vkr_context *ctx,
+                               const void *handle,
+                               const char *command,
+                               const char *slot)
+{
+   if (handle)
+      return false;
+
+   vkr_log("%s: %s is the null handle", command, slot);
+   vkr_context_set_fatal(ctx);
+   return true;
+}
+
+#define VKR_REFUSE_NULL_HANDLE(ctx, handle)                                              \
+   vkr_context_refuse_null_handle((ctx), (handle), __func__, #handle)
+
 /* Names the context whose commands the calling thread dispatches, or NULL
  * when it dispatches none. */
 void
