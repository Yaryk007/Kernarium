{
  "default-configuration": "Release",
  "configurations": [
    { "name": "Debug", "file": "Config/Andarium.xcconfig" },
    { "name": "Release", "file": "Config/Andarium.xcconfig" },
  ],
  "localizations": {
    "development": "en",
    "supported": [
      "Base",
      "ja",
      "zh-Hans",
      "zh-Hant",
    ],
  },
  "packages": [
    {
      "kind": "local",
      "path": "AndariumCore",
    }, {
      "kind": "local",
      "path": "../GuestHost/Core",
    },
  ],
  "files": [
    { "kind": "folder", "path": "Andarium/Shared", "target-membership": [ "Andarium", "AndariumPreview" ] },
    { "kind": "folder", "path": "Andarium/Preview", "target-membership": [ "AndariumPreview" ] },
    { "kind": "folder", "path": "Andarium/Live", "target-membership": [ "Andarium" ] },
    { "kind": "folder", "path": "../GuestHost/Sources", "target-membership": [ "Andarium" ] },
    { "path": "../GuestHost/Sources/UpdateNoticeViews.swift", "target-membership": [ "AndariumPreview/compile-sources" ] },
    { "kind": "folder", "path": "AndariumTests", "target-membership": [ "AndariumTests" ] },
    { "kind": "folder", "path": "AndariumUITests", "target-membership": [ "AndariumUITests" ] },
    { "kind": "folder", "path": "AndariumPreviewUITests", "target-membership": [ "AndariumPreviewUITests" ] },
    {
      "kind": "group",
      "path": "Config",
      "children": [
        { "path": "Andarium.entitlements" },
        { "path": "Andarium-Bridging-Header.h" },
        { "path": "Info.plist" },
        { "path": "PrivacyInfo.xcprivacy", "target-membership": [ "Andarium/resources" ] },
        { "path": "Andarium.xcconfig" },
        { "path": "Developer.local.xcconfig.example" },
        { "path": "../../GuestHost/Config/Update.xcconfig" },
        { "path": "../../GuestHost/Config/Update.local.xcconfig.example" },
      ],
    }, {
      "kind": "group",
      "path": "Localization",
      "children": [
        {
          "path": "Localizable.xcstrings",
          "target-membership": [
            "Andarium/resources",
            "AndariumPreview/resources",
          ],
        }, {
          "path": "InfoPlist.xcstrings",
          "target-membership": [
            "Andarium/resources",
            "AndariumPreview/resources",
          ],
        }, {
          "path": "WhatsNew.xcstrings",
          "target-membership": [
            "Andarium/resources",
            "AndariumPreview/resources",
          ],
        }, {
          "path": "JIT.xcstrings",
          "target-membership": [
            "Andarium/resources",
            "AndariumPreview/resources",
          ],
        }, {
          "path": "FollowX.xcstrings",
          "target-membership": [
            "Andarium/resources",
            "AndariumPreview/resources",
          ],
        }, {
          "path": "AppShortcuts.xcstrings",
          "target-membership": [
            "Andarium/resources",
            "AndariumPreview/resources",
          ],
        },
      ],
    }, {
      "kind": "group",
      "name": "Frameworks",
      "children": [
        { "path": "../.build/kernarium-xcframeworks/KRuntime_Android_6_18_4K.xcframework", "target-membership": [ { "build-phase": "Andarium/copy/Embed Frameworks", "code-sign-on-copy": true, "header-preservation": "remove-on-copy" } ] },
        { "path": "../.build/kernarium-xcframeworks/MesaEGL.xcframework", "target-membership": [ { "build-phase": "Andarium/copy/Embed Frameworks", "code-sign-on-copy": true, "header-preservation": "remove-on-copy" } ] },
        { "path": "../.build/kernarium-xcframeworks/MesaGallium.xcframework", "target-membership": [ { "build-phase": "Andarium/copy/Embed Frameworks", "code-sign-on-copy": true, "header-preservation": "remove-on-copy" } ] },
        { "path": "../.build/kernarium-xcframeworks/KosmicKrisp.xcframework" },
        { "path": "../.build/kernarium-xcframeworks/LibZstd.xcframework", "target-membership": [ "Andarium/frameworks" ] },
      ],
    },
    { "path": "AndariumCore" },
    { "path": "../GuestHost/Core" },
    {
      "kind": "group",
      "name": "Products",
      "children": [
        { "path": "<PRODUCTS>/Andarium.app", "id": "2B57E994CA98B64648047DE5", "type": "wrapper.application", "index": false },
        { "path": "<PRODUCTS>/AndariumPreview.app", "id": "F7B7BE3141FE6623A0E4497E", "type": "wrapper.application", "index": false },
        { "path": "<PRODUCTS>/AndariumTests.xctest", "id": "AE75CA0B879FBA6ECC773C6A", "type": "wrapper.cfbundle", "index": false },
        { "path": "<PRODUCTS>/AndariumUITests.xctest", "id": "4D6B3E8A1C5F7092A3B4C5D6", "type": "wrapper.cfbundle", "index": false },
        { "path": "<PRODUCTS>/AndariumPreviewUITests.xctest", "id": "C4E1A7D20B9F38E65A1D7C40", "type": "wrapper.cfbundle", "index": false },
      ],
    },
  ],
  "targets": [
    {
      "name": "Andarium",
      "id": "A10000000000000000000007",
      "product": "Products/Andarium.app",
      "product-type": "application",
      "build-phases": [
        {
          "kind": "script",
          "name": "Check Mac run location",
          "run-on-every-build": true,
          "shell": "/bin/sh",
          "script": "/usr/bin/env python3 -B \"$SRCROOT/../scripts/check-run-location.py\"\n",
        }, {
          "kind": "script",
          "name": "Check developer artwork inputs",
          "run-on-every-build": true,
          "shell": "/bin/sh",
          "script": [
            "need() {",
            "  [ -f \"$SRCROOT/Config/Local/$1\" ] || {",
            "    echo \"error: $2 needs $1 at Andarium/Config/Local/ (Config/Developer.local.xcconfig.example)\" >&2",
            "    exit 1",
            "  }",
            "}",
            "if [ \"$FOLLOW_X_LOGO_SOURCE\" = local ] && [ -n \"$FOLLOW_X_HANDLE\" ]; then",
            "  need x-logo.svg \"the X logo\"",
            "fi",
            "",
          ],
        }, {
          "kind": "script",
          "name": "Check document pickers",
          "run-on-every-build": true,
          "shell": "/bin/sh",
          "script": "/usr/bin/env python3 -B \"$SRCROOT/scripts/check-document-pickers.py\" \"$SRCROOT/Andarium\"\n",
        },
        "compile-sources",
        "frameworks",
        "resources",
        {
          "kind": "copy",
          "name": "Embed Frameworks",
          "bundle-base-path": "frameworks-directory",
        }, {
          "kind": "script",
          "name": "Embed KosmicKrisp (device only)",
          "run-on-every-build": true,
          "shell": "/bin/sh",
          "script": "\"$SRCROOT/../Kernarium/scripts/embed-device-framework.sh\" \"$SRCROOT/../.build/kernarium-xcframeworks/KosmicKrisp.xcframework\"\n",
        }, {
          "kind": "script",
          "name": "Embed UmlArm64Aot (when packaged)",
          "run-on-every-build": true,
          "shell": "/bin/sh",
          "script": "\"$SRCROOT/../Kernarium/scripts/embed-device-framework.sh\" --optional \"$SRCROOT/../.build/kernarium-xcframeworks/UmlArm64Aot.xcframework\"\n",
        }, {
          "kind": "script",
          "name": "Check embedded artifacts",
          "run-on-every-build": true,
          "shell": "/bin/sh",
          "script": [
            "case \"$CONFIGURATION\" in Release) ;; *) exit 0 ;; esac",
            "[ \"$ACTION\" = install ] || exit 0",
            "/usr/bin/env python3 -B \"$SRCROOT/../scripts/check-embedded-artifacts.py\" --app \"$TARGET_BUILD_DIR/$WRAPPER_NAME\" --downloaded-android --kernel android --aot &&",
            "/usr/bin/env python3 -B \"$SRCROOT/../scripts/check-no-aot-diagnostics.py\" \"$TARGET_BUILD_DIR/$WRAPPER_NAME\" &&",
            "/usr/bin/env python3 -B \"$SRCROOT/scripts/check-release-archive.py\" \"$TARGET_BUILD_DIR/$WRAPPER_NAME\"",
            "",
          ],
        },
      ],
      "package-product-members": [
        {
          "product-name": "AndariumCore",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "product-name": "GuestHostCore",
          "build-phase": { "build-phase": "frameworks" },
        },
      ],
      "build-settings": {
        "ASSETCATALOG_COMPILER_APPICON_NAME": "DuskJade",
        "ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME": "AccentColor",
        "CODE_SIGN_ENTITLEMENTS": "Config/Andarium.entitlements",
        "CODE_SIGN_STYLE": "Automatic",
        "CURRENT_PROJECT_VERSION": "16",
        "ENABLE_PREVIEWS": "YES",
        "ENABLE_USER_SCRIPT_SANDBOXING": "NO",
        "FRAMEWORK_SEARCH_PATHS": [
          "$(inherited)",
          "$(SRCROOT)/../.build/kernarium-xcframeworks",
        ],
        "GENERATE_INFOPLIST_FILE": "YES",
        "INFOPLIST_FILE": "Config/Info.plist",
        "INFOPLIST_KEY_CFBundleDisplayName": "Andarium",
        "INFOPLIST_KEY_NSCameraUsageDescription": "Andarium uses the camera only when you turn on Camera, so that apps in the virtual machine can use it.",
        "INFOPLIST_KEY_NSLocalNetworkUsageDescription": "Apps running in Andarium use this to connect to devices on your local network, such as printers, media servers and computers, and ADB over network uses it to let a computer on your network connect to Andarium. Internet access doesn't need it.",
        "INFOPLIST_KEY_NSLocationWhenInUseUsageDescription": "Andarium shares this device's location only when you turn on Location, so that apps in the virtual machine can use it.",
        "INFOPLIST_KEY_NSMicrophoneUsageDescription": "Andarium records from the microphone only when you turn on Microphone, so that apps in the virtual machine can use it.",
        "INFOPLIST_KEY_UIApplicationSceneManifest_Generation": "NO",
        "INFOPLIST_KEY_UIApplicationSupportsIndirectInputEvents": "YES",
        "INFOPLIST_KEY_UILaunchScreen_Generation": "YES",
        "INFOPLIST_KEY_UISupportedInterfaceOrientations_iPad": "UIInterfaceOrientationPortrait UIInterfaceOrientationPortraitUpsideDown UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight",
        "INFOPLIST_KEY_UISupportedInterfaceOrientations_iPhone": "UIInterfaceOrientationPortrait",
        "INFOPLIST_OTHER_PREPROCESSOR_FLAGS": "-traditional -undef",
        "INFOPLIST_PREPROCESS": "YES",
        "INFOPLIST_PREPROCESSOR_DEFINITIONS": "$(FOLLOW_X_PLIST_DEFINITION) $(UPDATE_PLIST_DEFINITION)",
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
          "@executable_path/Frameworks",
        ],
        "MARKETING_VERSION": "1.1",
        "PRODUCT_BUNDLE_IDENTIFIER": "com.imxieyi.andarium",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "SUPPORTED_PLATFORMS": "iphoneos iphonesimulator",
        "SUPPORTS_MACCATALYST": "NO",
        "SUPPORTS_MAC_DESIGNED_FOR_IPHONE_IPAD[config=Debug]": "YES",
        "SUPPORTS_MAC_DESIGNED_FOR_IPHONE_IPAD[config=Release]": "YES",
        "SWIFT_APPROACHABLE_CONCURRENCY": "YES",
        "SWIFT_DEFAULT_ACTOR_ISOLATION": "MainActor",
        "SWIFT_EMIT_LOC_STRINGS": "YES",
        "SWIFT_OBJC_BRIDGING_HEADER": "Config/Andarium-Bridging-Header.h",
        "SWIFT_UPCOMING_FEATURE_MEMBER_IMPORT_VISIBILITY": "YES",
        "SWIFT_VERSION": "5.0",
        "TARGETED_DEVICE_FAMILY": "1,2",
      },
    }, {
      "name": "AndariumTests",
      "id": "A10000000000000000000008",
      "product": "Products/AndariumTests.xctest",
      "product-type": "bundle.unit-test",
      "test-host-target": "Andarium",
      "dependencies": [
        "Andarium",
