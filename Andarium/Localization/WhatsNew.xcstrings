    },
    "Fixed apps failing to reach servers for a while after the network returns" : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ネットワークが復旧したあと、しばらくアプリがサーバに接続できない問題を修正しました"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "修复了网络恢复后应用在一段时间内无法连接服务器的问题"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "修正網路恢復後應用程式在一段時間內無法連線到伺服器的問題"
          }
        }
      }
    },
    "Fixed apps installed with Install APK not appearing on Android’s home screen" : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“APKをインストール”でインストールしたアプリがAndroidのホーム画面に表示されない問題を修正しました"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "修复了通过“安装APK”安装的应用未出现在Android主屏幕上的问题"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "修正透過「安裝APK」安裝的應用程式未出現在Android主畫面的問題"
          }
        }
      }
    },
    "Fixed connections hanging after this device moves from Wi-Fi to cellular data" : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このデバイスがWi-Fiからモバイルデータ通信に切り替わったあと、接続が止まったままになる問題を修正しました"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "修复了此设备从Wi-Fi切换到蜂窝数据后连接卡住的问题"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "修正此裝置從Wi-Fi切換到行動數據後連線卡住的問題"
          }
        }
      }
    },
    "Fixed crashes in some 3D games and apps" : {
      "extractionState" : "manual",
