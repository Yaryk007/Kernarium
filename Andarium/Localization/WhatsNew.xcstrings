          "stringUnit" : {
            "state" : "translated",
            "value" : "修正部分3D遊戲和應用程式當機的問題"
          }
        }
      }
    },
    "Fixed face scans failing in some apps that use the front camera" : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "前面カメラを使う一部のアプリで顔認証に失敗する問題を修正しました"
