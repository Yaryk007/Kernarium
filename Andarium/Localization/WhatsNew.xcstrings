          "stringUnit" : {
            "state" : "translated",
            "value" : "修正虛擬機器在許多iPhone上當機的問題"
          }
        }
      }
    },
    "Fixed the virtual machine not starting with more than 4 GiB of RAM" : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RAMが4 GiBを超えると仮想マシンが起動しない問題を修正しました"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "修复了虚拟机在RAM超过4 GiB时无法启动的问题"
          }
        },
        "zh-Hant" : {
