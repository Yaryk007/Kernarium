        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "修正網路連線突然關閉時當機的問題"
          }
        }
      }
    },
    "Fixed a crash when returning to Andarium from the background" : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
