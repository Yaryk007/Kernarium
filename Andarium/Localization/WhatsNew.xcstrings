            "value" : "修复了更多3D游戏和应用崩溃的问题"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "修正更多3D遊戲和應用程式當機的問題"
          }
        }
      }
    },
    "Fixed the camera preview freezing after you take a photo" : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "写真を撮ったあとにカメラのプレビューが止まる問題を修正しました"
          }
