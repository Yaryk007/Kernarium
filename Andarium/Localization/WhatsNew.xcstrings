    "If an app built for an Android version before 4.0 crashes, turn on Old app compatibility for it. Android then runs that app more like older versions did." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android 4.0より前のバージョン向けに作られたアプリがクラッシュする場合は、そのアプリの“古いアプリの互換性”をオンにしてください。Androidがそのアプリを以前のバージョンに近い方法で実行します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果为Android 4.0之前的版本开发的应用闪退，请为它打开“旧版应用兼容”。Android会以更接近旧版本的方式运行该应用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "若為Android 4.0之前的版本開發的應用程式閃退，請為它開啟「舊版應用程式相容性」。Android會以更接近舊版本的方式執行該應用程式。"
          }
        }
      }
    },
