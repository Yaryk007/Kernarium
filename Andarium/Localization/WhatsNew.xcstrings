        }
      }
    },
    "A camera recording now ends and is saved when you leave Andarium" : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Andariumを離れると、カメラの録画が終了して保存されるようになりました"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "离开Andarium时，相机视频录制现在会结束并保存"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "離開Andarium時，相機錄影現在會結束並儲存"
          }
        }
      }
    },
    "AOT" : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AOT"
          }
        },
        "zh-Hans" : {
