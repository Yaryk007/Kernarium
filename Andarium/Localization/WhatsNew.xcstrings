        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "修正從背景返回Andarium時當機的問題"
          }
        }
      }
    },
    "Fixed a crash when using the gyroscope" : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
