        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "修正部分使用前置相機的應用程式中臉部辨識失敗的問題"
          }
        }
      }
    },
    "Fixed high CPU use and heat after a network connection drops" : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ネットワーク接続が切れたあとにCPU使用率が高くなり発熱する問題を修正しました"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
