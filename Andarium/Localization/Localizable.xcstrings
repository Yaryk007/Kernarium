    },
    "Andarium system image is updated to %@. The next start finishes the update and takes a little longer." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Andariumのシステムイメージが%@にアップデートされました。次回の起動でアップデートが完了するため、通常より少し時間がかかります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Andarium系统镜像已更新到%@。下次启动将完成更新，耗时会稍长一些。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
