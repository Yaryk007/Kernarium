    "Deleting files in Android frees nothing a snapshot still keeps. Deleting or restoring a snapshot gives space back." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Androidでファイルを削除しても、スナップショットが保持している分の容量は解放されません。スナップショットを削除または復元すると、容量が戻ります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "删除Android中的文件不会释放快照仍保留的空间。删除或恢复快照才会归还空间。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "刪除Android中的檔案不會釋出快照仍保留的空間。刪除或回復快照才會歸還空間。"
          }
        }
      }
