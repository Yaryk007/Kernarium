          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "虚拟机没有响应。请重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "虛擬機器沒有回應。請再試一次。"
          }
        }
      }
    },
    "The virtual machine doesn’t have enough free space. Free some up in the virtual machine, or give it more storage with Resize." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仮想マシンの空き容量が足りません。仮想マシン内で容量を空けるか、“サイズを変更”でストレージを増やしてください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "虚拟机的可用空间不足。请在虚拟机中释放一些空间，或使用“调整大小”为其增加存储空间。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "虛擬機器的可用空間不足。請在虛擬機器中釋出一些空間，或使用「調整大小」為其增加儲存空間。"
          }
        }
      }
    },
    "The virtual machine is already making a bug report." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仮想マシンはすでにバグレポートを作成中です。"
