    },
    "Andarium is not allowed to use the microphone. Turning this on offers to open Settings." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Andariumはマイクの使用を許可されていません。オンにすると“設定”を開くよう案内されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
