        }
      }
    },
    "The virtual machine didn’t answer. Try again." : {
      "comment" : "Shown on the Old app compatibility page when the list of apps could not be read; the button below it is \"Try again\".",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
