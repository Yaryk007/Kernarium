    "Andarium is not allowed to use the camera. Turning this on offers to open Settings." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Andariumはカメラの使用を許可されていません。オンにすると“設定”を開くよう案内されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Andarium未获准使用相机。打开此开关会提示你前往“设置”。"
