        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "虛擬機器尚未回應。請在其啟動後再試一次。"
          }
        }
      }
    },
    "The virtual machine isn’t ready to change Android’s screen reader. Try again in a moment." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仮想マシンはまだAndroidのスクリーンリーダーを変更する準備ができていません。しばらくしてからもう一度お試しください。"
