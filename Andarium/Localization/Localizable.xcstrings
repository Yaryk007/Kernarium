          }
        }
      }
    },
    "Translated system libraries" : {
      "comment" : "Title of the page of notices, and of the row that opens it, for the Android system libraries that Andarium translates to machine code ahead of time.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "変換されたシステムライブラリ"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "转译的系统库"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "轉譯的系統程式庫"
          }
        }
      }
    },
    "Translated system libraries run faster. Turn off only to troubleshoot." : {
      "comment" : "The note beneath the AOT group on Home, in the footer style. AOT is a name and stays as it is. Says that the translated system libraries (Android's own libraries, run from machine code translated ahead of time) make Android faster, and that the switch is only for trouble-shooting.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "変換済みのシステムライブラリで高速化します。問題の調査時のみオフにしてください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "转译后的系统库运行更快。仅在排查问题时关闭。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "轉譯後的系統程式庫執行更快。僅在排解問題時關閉。"
          }
        }
      }
    },
    "Try Again" : {
