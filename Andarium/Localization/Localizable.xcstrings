          "stringUnit" : {
            "state" : "translated",
            "value" : "在同一网络上的电脑中运行："
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在同一網路上的電腦中執行："
          }
        }
      }
    },
    "Only %@ is free, and %@ is still running. Shut it down before the space runs out, or free up more space and check again. %@ needs %@ free to continue." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "空き容量は%1$@しかなく、%2$@はまだ実行中です。空き容量がなくなる前にシャットダウンするか、さらに空き容量を確保してからもう一度確認してください。%3$@が動作を続けるには%4$@の空き容量が必要です。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅有%1$@可用，而且%2$@仍在运行。请在空间用尽前将其关机，或释放更多空间后重新检查。%3$@需要%4$@可用空间才能继续运行。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "僅有%1$@可用，而且%2$@仍在執行。請在空間用盡前將其關機，或釋出更多空間後重新檢查。%3$@需要%4$@可用空間才能繼續執行。"
          }
        }
      }
    },
    "Only %@ is free. Free up more space, then resume. %@ needs %@ free to continue." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "空き容量は%1$@しかありません。さらに空き容量を確保してから再開してください。%2$@が動作を続けるには%3$@の空き容量が必要です。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅有%1$@可用。请释放更多空间，然后继续。%2$@需要%3$@可用空间才能恢复运行。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
