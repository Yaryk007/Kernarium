            "value" : "%@已匯入"
          }
        }
      }
    },
    "%@ is installed in the virtual machine, but not all of its data files were copied. The app may not work without them." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@を仮想マシンにインストールしましたが、一部のデータファイルはコピーされていません。データファイルがないと、アプリが動作しない場合があります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@已安装到虚拟机中，但并非所有数据文件都已拷贝。没有这些文件，应用可能无法运行。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@已安裝到虛擬機器中，但並非所有資料檔案都已拷貝。沒有這些檔案，應用程式可能無法運作。"
          }
        }
      }
    },
    "%@ is installed in the virtual machine, but not all of its data files were copied. The app may not work without them. Install the file again to copy them." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@を仮想マシンにインストールしましたが、一部のデータファイルはコピーされていません。データファイルがないと、アプリが動作しない場合があります。コピーするには、このファイルをもう一度インストールしてください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@已安装到虚拟机中，但并非所有数据文件都已拷贝。没有这些文件，应用可能无法运行。请再次安装此文件以拷贝这些文件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@已安裝到虛擬機器中，但並非所有資料檔案都已拷貝。沒有這些檔案，應用程式可能無法運作。請再次安裝此檔案以拷貝這些檔案。"
          }
        }
      }
    },
    "%@ is installed in the virtual machine." : {
