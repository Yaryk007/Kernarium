          }
        }
      }
    },
    "There is no virtual machine. The icon works again once the app is installed in a new virtual machine." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仮想マシンがありません。新しい仮想マシンにアプリをインストールすると、アイコンが再び使えるようになります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
