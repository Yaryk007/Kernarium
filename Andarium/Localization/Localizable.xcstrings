        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Andariumは“%1$@”（%2$@）の復元を完了できませんでした。起動すると復元が完了します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Andarium未能完成恢复“%1$@”（%2$@）。启动将完成恢复。"
