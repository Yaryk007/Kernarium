        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@でデベロッパをフォロー"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在%@上关注开发者"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在%@上追蹤開發者"
          }
        }
      }
    }
  },
  "version" : "1.0"
