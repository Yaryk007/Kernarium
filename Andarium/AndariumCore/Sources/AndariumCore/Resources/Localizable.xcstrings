          "stringUnit" : {
            "state" : "translated",
            "value" : "VRAM"
          }
        }
      }
    },
    "VRAM is graphics memory, separate from the virtual machine’s RAM." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VRAMはグラフィックスメモリで、仮想マシンのRAMとは別です。"
