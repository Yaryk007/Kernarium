        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "虛擬機器已結束：%1$@，已執行%2$@"
          }
        }
      }
    },
    "Virtual machine memory is high" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
