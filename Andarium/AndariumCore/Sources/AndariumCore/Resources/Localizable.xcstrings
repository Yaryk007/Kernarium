        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android因核心嚴重錯誤而停止。"
          }
        }
      }
    },
    "Android stopped with a kernel panic: %@." : {
      "comment" : "Home's card after a kernel panic. The argument is the kernel's own message, in English, which stays as it is.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Androidはカーネルパニックで停止しました。%@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android因内核严重错误而停止：%@。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android因核心嚴重錯誤而停止：%@。"
          }
        }
      }
    },
    "Android was using almost all the memory iOS allows Andarium. A smaller memory size is safer." : {
      "comment" : "Home's card after iOS ended Andarium because the memory it used came near the limit.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AndroidがiOSでAndariumに許可されているメモリのほぼすべてを使用していました。メモリサイズを小さくする方が安全です。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android几乎用尽了iOS允许Andarium使用的全部内存。较小的内存大小更安全。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android幾乎用盡了iOS允許Andarium使用的所有記憶體。較小的記憶體大小更安全。"
          }
        }
      }
    },
    "Android’s kernel crashed" : {
      "comment" : "Title of Home's card after Android's kernel stopped on an error of its own.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Androidのカーネルがクラッシュしました"
          }
        },
        "zh-Hans" : {
