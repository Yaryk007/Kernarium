                  "value" : "%lld個vCPU"
                }
              }
            }
          }
        }
      }
    },
    "Above %@, games may run out of graphics memory." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@を超えると、ゲームでグラフィックスメモリが不足する可能性があります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "超过%@时，游戏可能会耗尽显存。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "超過%@時，遊戲可能會耗盡繪圖記憶體。"
          }
        }
      }
    },
    "Andarium crashed" : {
      "comment" : "Title of Home's card after Andarium itself crashed while Android was running.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Andariumがクラッシュしました"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Andarium已崩溃"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Andarium已當機"
          }
        }
      }
    },
    "Andarium draws the virtual machine with Metal 4, which this %@ does not have, so the virtual machine cannot start here." : {
      "comment" : "%@ is the device name: iPhone, iPad or Mac.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AndariumはMetal 4で仮想マシンを描画しますが、この%@はMetal 4に対応していないため、ここでは仮想マシンを起動できません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Andarium使用Metal 4绘制虚拟机，而此%@不支持Metal 4，因此虚拟机无法在此启动。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Andarium使用Metal 4繪製虛擬機器，而此%@不支援Metal 4，因此虛擬機器無法在此啟動。"
          }
        }
      }
    },
    "Andarium ended while Android was running." : {
      "comment" : "Home's card after Andarium ended while Android was running, with no known cause.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Androidの実行中にAndariumが終了しました。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android运行期间，Andarium已结束。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android執行期間，Andarium已結束。"
          }
        }
      }
    },
    "Andarium stopped on an error of its own while Android was running." : {
      "comment" : "Home's card after Andarium itself crashed while Android was running.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Androidの実行中に、Andarium自身のエラーで停止しました。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android运行期间，Andarium因自身错误而停止。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android執行期間，Andarium因自身錯誤而停止。"
          }
        }
      }
    },
    "Andarium stopped unexpectedly" : {
      "comment" : "Title of Home's card after Andarium ended while Android was running, with no known cause.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Andariumが予期せず停止しました"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Andarium意外停止"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Andarium意外停止"
          }
        }
      }
    },
    "Android can’t install an app from a single .apk file of %@ or more." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Androidでは、%@以上の単一の.apkファイルからアプリをインストールできません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android无法安装大小为%@或以上的单个.apk文件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android無法安裝大小為%@或以上的單一.apk檔案。"
          }
        }
      }
    },
    "Android can’t install an app with a part of %@ or more." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Androidでは、%@以上のパーツを含むアプリをインストールできません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android无法安装包含大小为%@或以上部分的应用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android無法安裝包含大小為%@或以上部分的應用程式。"
          }
        }
      }
    },
    "Android could not resume" : {
      "comment" : "Title of Home's card after a start that could not bring back the memory Android saved when it was paused.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Androidを再開できませんでした"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android无法恢复运行"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android無法繼續執行"
          }
        }
      }
    },
    "Android ran out of graphics memory" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Androidのグラフィックスメモリが不足しました"
