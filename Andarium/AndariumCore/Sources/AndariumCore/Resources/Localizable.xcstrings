          }
        }
      }
    },
    "Virtual machine ended: %@" : {
      "comment" : "The line of the report the end screen offers to copy that says why the run ended. %@ is a clause such as \"it was stopped from the boot screen\".",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仮想マシンが終了しました：%@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "虚拟机已结束：%@"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "虛擬機器已結束：%@"
          }
        }
      }
    },
    "Virtual machine ended: %@ after %@" : {
      "comment" : "The same line when the run's length is known. %1$@ is the clause, %2$@ the time the run lasted, such as 3:17.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仮想マシンが終了しました：%1$@（%2$@経過）"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
