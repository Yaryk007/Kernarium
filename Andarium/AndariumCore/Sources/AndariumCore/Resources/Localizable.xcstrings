    "Android stopped unexpectedly." : {
      "comment" : "Home's card after a stop with no known cause.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Androidが予期せず停止しました。"
          }
        },
