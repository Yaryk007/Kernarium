    },
    "sentence.join" : {
      "comment" : "Joins two whole sentences: a space in English, none in Chinese and Japanese.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@%2$@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@%2$@"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@%2$@"
          }
        }
      }
    },
    "The virtual machine cannot start from %@: its name has a space, comma, colon or quotation mark." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仮想マシンは%@から起動できません。名前にスペース、カンマ、コロン、引用符が含まれています。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "虚拟机无法从%@启动：其名称含有空格、逗号、冒号或引号。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "虛擬機器無法從%@啟動：其名稱含有空格、逗號、冒號或引號。"
          }
        }
      }
    },
    "The virtual machine doesn’t have enough free space to install this app (%@ needed, %@ available). Free some up in the virtual machine, or give it more storage with Resize." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仮想マシンの空き容量が足りないため、このアプリをインストールできません（必要：%@、空き：%@）。仮想マシン内で容量を空けるか、“サイズを変更”でストレージを増やしてください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "虚拟机的可用空间不足，无法安装此应用（需要%@，可用%@）。请在虚拟机中释放一些空间，或使用“调整大小”为其增加存储空间。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "虛擬機器的可用空間不足，無法安裝此應用程式（需要%@，可用%@）。請在虛擬機器中釋出一些空間，或使用「調整大小」為其增加儲存空間。"
          }
        }
      }
    },
    "the virtual machine kept restarting" : {
      "comment" : "A clause of the line the end screen offers to copy, after \"Virtual machine ended:\".",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仮想マシンが再起動を繰り返しました"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "虚拟机一直在重新启动"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "虛擬機器一直在重新啟動"
          }
        }
      }
    },
    "The virtual machine’s data uses a newer layout than this app version can open. Erase the virtual machine to start again with this one." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仮想マシンのデータは、このバージョンのアプリでは開けない新しい形式です。仮想マシンを消去して、このバージョンで最初からやり直してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "虚拟机数据的格式比此App版本支持的更新。请抹掉虚拟机，以便用此版本重新开始。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "虛擬機器資料的格式比此App版本支援的更新。請清除虛擬機器，以便用此版本重新開始。"
          }
        }
      }
    },
    "The virtual machine’s files do not match this app version. Erase the virtual machine to start again." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仮想マシンのファイルがこのバージョンのアプリと一致しません。仮想マシンを消去して最初からやり直してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "虚拟机的文件与此App版本不匹配。请抹掉虚拟机以重新开始。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "虛擬機器的檔案與此App版本不相符。請清除虛擬機器以重新開始。"
          }
        }
      }
    },
    "There is not enough free storage to set up the virtual machine." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ストレージの空き容量が足りないため、仮想マシンを設定できません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可用存储空间不足，无法设置虚拟机。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可用儲存空間不足，無法設定虛擬機器。"
          }
        }
      }
    },
    "There isn’t enough free space on this %@ to install this app (%@ needed, %@ available). Free up space in Settings › General › %@ Storage and try again." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この%@の空き容量が足りないため、このアプリをインストールできません（必要：%@、空き：%@）。“設定”＞“一般”＞“%@ストレージ”で容量を空けてから、もう一度お試しください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此%@的可用空间不足，无法安装此应用（需要%@，可用%@）。请在“设置”>“通用”>“%@储存空间”中释放空间，然后重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此%@的可用空間不足，無法安裝此應用程式（需要%@，可用%@）。請在「設定」>「一般」>「%@儲存空間」中釋出空間，然後再試一次。"
          }
        }
      }
    },
    "There’s no app in this file. Choose an .apk, .apks, .xapk or .apkm file that holds an app." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このファイルにはアプリが含まれていません。アプリを含む.apk、.apks、.xapk、.apkmのいずれかのファイルを選択してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此文件中没有应用。请选择包含应用的.apk、.apks、.xapk或.apkm文件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此檔案中沒有應用程式。請選擇包含應用程式的.apk、.apks、.xapk或.apkm檔案。"
          }
        }
      }
    },
    "This app has no code for this device’s processor. Choose a version of the app made for ARM processors." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このアプリには、このデバイスのプロセッサ用のコードがありません。ARMプロセッサ用のバージョンのアプリを選択してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此应用没有适用于此设备处理器的代码。请选择适用于ARM处理器的应用版本。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此應用程式沒有適用於此裝置處理器的程式碼。請選擇適用於ARM處理器的應用程式版本。"
          }
        }
      }
    },
    "This app version is older than the one the virtual machine last started with, and its data does not go back. Install a newer version of Andarium, or erase the virtual machine to start again with this one." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このアプリのバージョンは、仮想マシンが前回起動したときのバージョンより古く、仮想マシンのデータを古いバージョンに戻すことはできません。新しいバージョンのAndariumをインストールするか、仮想マシンを消去してこのバージョンで最初からやり直してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此App版本比虚拟机上次启动时使用的版本更旧，且虚拟机数据无法降级到旧版本。请安装更高版本的Andarium，或抹掉虚拟机以使用此版本重新开始。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此App版本比虛擬機器上次啟動時使用的版本更舊，且虛擬機器資料無法降級回舊版本。請安裝較新版本的Andarium，或清除虛擬機器以使用此版本重新開始。"
          }
        }
      }
    },
    "This copy of Andarium does not carry a system." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このAndariumにはシステムが含まれていません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此Andarium副本不含系统。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此Andarium拷貝不含系統。"
          }
        }
      }
    },
    "This file is damaged or encrypted, so it can’t be installed. Download it again, or choose another file." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このファイルは破損しているか暗号化されているため、インストールできません。もう一度ダウンロードするか、別のファイルを選択してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此文件已损坏或已加密，因此无法安装。请重新下载，或选择其他文件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此檔案已損毀或已加密，因此無法安裝。請重新下載，或選擇其他檔案。"
          }
        }
      }
    },
    "This file is damaged, or the parts of the app don’t fit together. Download it again, or choose another file." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このファイルが破損しているか、アプリの各パーツが一致していません。もう一度ダウンロードするか、別のファイルを選択してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
