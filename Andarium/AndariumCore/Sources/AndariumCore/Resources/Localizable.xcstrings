    },
    "Android stopped with a kernel panic." : {
      "comment" : "Home's card after a kernel panic that left no message.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Androidはカーネルパニックで停止しました。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android因内核严重错误而停止。"
