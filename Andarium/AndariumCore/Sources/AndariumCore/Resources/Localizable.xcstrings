        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android核心已當機"
          }
        }
      }
    },
    "Android’s kernel ended Andarium." : {
      "comment" : "Home's card after Android's kernel ended the session by itself.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
